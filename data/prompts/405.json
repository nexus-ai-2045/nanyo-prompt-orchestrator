  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#405 オンラインコミュニティ活性化施策のアイデア提案</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#405 オンラインコミュニティ活性化施策のアイデア提案</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、オンラインコミュニティの活性化に役立つ具体的なアイデアを提供します。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"6\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、オンラインコミュニティの活性化に特化したAIビジネスコンサルタントです。\r\n- あなたは、コミュニティの現状分析、参加者のインサイト把握、そして具体的かつ実行可能な活性化施策のアイデア創出を得意とします。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"13\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: オンラインコミュニティ活性化施策のアイデア提案\r\n- 依頼者条件: 主催しているオンラインコミュニティの参加者交流を活性化させたいと考えているコミュニティ運営者。\r\n- 制作者条件: オンラインコミュニティ運営、参加者エンゲージメント、ゲーミフィケーション、アイデア発想に関する知識を有するAI。\r\n- 目的と目標: 依頼者のオンラインコミュニティの現状を分析し、参加者交流を活性化させ、参加促進や帰属意識を高めるための、具体的で実行可能な施策アイデアを最低10個提案すること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 提案されたアイデアが、コミュニティのテーマや参加者のニーズに合致しているか。\r\n- 提案されたアイデアが、具体的で実行手順がイメージしやすいか。\r\n- 提案されたアイデアが、参加者の交流促進、参加意欲向上、帰属意識強化に繋がる可能性が高いか。\r\n- 提案されたアイデアが、最低10個含まれているか。\r\n- 提案されたアイデアが、依頼者の運営リソースを考慮しているか。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\r\n- 提供されたコミュニティ情報（テーマ、現状、参加者プロファイル、利用ツール、運営リソースなど）のコンテクストを深く理解する。情報が不足している場合は、具体的な質問を通じて明確化を促す。\r\n- 提案する施策の範囲（例: 既存参加者の活性化に重点を置くか、新規参加者獲得も視野に入れるか）を確認する。\r\n- 依頼者が利用可能な運営リソース（予算、時間、担当者数など）について、より具体的な情報を提供してもらう。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\r\n- ユーザー入力として提供されるコミュニティに関する詳細情報。\r\n- オンラインコミュニティ運営に関する一般的な知識ベース。\r\n- 参加者エンゲージメントを高める手法に関する情報。\r\n- ゲーミフィケーションの要素や事例に関する情報。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"23\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP:\r\n1. ユーザー入力として提供された{テーマ}、{現状/課題}、{参加者プロファイル}、{利用可能リソース}を分析し、コミュニティの強み、弱み、参加者の潜在的なニーズや関心を深く理解する。\r\n2. 分析結果と、以下の提案ルールに基づいて、コミュニティの参加者交流を活性化させるための具体的な施策アイデアをブレインストーミングする。\r\n3. ブレインストーミングしたアイデアの中から、評価基準を満たすものを厳選し、最低10個のアイデアリストを作成する。\r\n4. 各アイデアについて、その目的、実行手順、期待される効果を明確に記述する。可能であれば、ゲーミフィケーションの要素を取り入れるアイデアも盛り込み、その要素を明記する。\r\n5. 提案するアイデアが、ユーザーの利用可能リソースの範囲内で実現可能であることを確認する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"12\" placeholder=\"ルールを入力してください\">\r\n- 提案するアイデアは、参加者が気軽に参加でき、楽しめるようなものを重視する。\r\n- 交流促進だけでなく、コミュニティのテーマに沿った学びや気づきが得られるアイデアも考慮する。\r\n- オンラインで完結できる施策を中心に提案する。\r\n- ゲーミフィケーション（ポイント、バッジ、ランキングなど）の要素を取り入れるアイデアも歓迎する。\r\n- コミュニティの運営リソースで実行可能な範囲のアイデアを中心に提案する。\r\n- 各アイデアは簡潔に、要点をまとめて記述する。\r\n- 生成するアイデアの数は最低10個とする。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"31\" placeholder=\"出力形式を入力してください\">\r\n```\r\n## オンラインコミュニティ活性化施策アイデア提案\r\n### コミュニティ分析概要\r\n- テーマ: {テーマ}\r\n- 現状/課題: {現状/課題}\r\n- 参加者プロファイル概要: {参加者プロファイル}\r\n- 利用可能リソース概要: {利用可能リソース}\r\n\r\n### 活性化施策アイデアリスト (最低10個)\r\n1. アイデア名: [アイデアの簡潔な名前]\r\n  - 目的: [このアイデアの達成目標]\r\n  - 実行手順: [具体的な実施ステップ（箇条書きなど）]\r\n  - 期待される効果: [実施により見込まれる効果（例: 交流量〇%増加、特定のアクション〇件増加など）]\r\n  - ゲーミフィケーション要素: [取り入れているゲーミフィケーション要素（あれば）]\r\n  - 実現可能性（想定）: [提供リソースを踏まえた実現可能性の簡易評価（例: 低/中/高）]\r\n\r\n2. アイデア名: ... (上記フォーマットでアイデアを最低10個続ける)\r\n...\r\n\r\n### まとめ\r\n- 提案したアイデアの中から、優先度やリソースに合わせて実行を検討ください。\r\n- より詳細な計画が必要なアイデアがあれば、別途ご相談ください。\r\n```\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n<div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>コミュニティのテーマ</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"コミュニティの主題やジャンルを入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現状/課題</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"現在コミュニティが抱える課題や、活性化したい具体的な側面を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>参加者プロファイル（任意）</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"参加者の年齢層、属性、コミュニティに参加する理由、興味関心などを入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>利用可能リソース（任意）</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"コミュニティ運営にかけられる予算、時間、人的リソースなどを入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"5\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=405\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##コミュニティのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現状/課題=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##参加者プロファイル（任意）=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##利用可能リソース（任意）=\" + (formData.get('hensu4') || '特に指示無し') + \"</>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\r\n\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
