  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#728 組織自立型AIガバナンス策定</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#728 組織自立型AIガバナンス策定</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、「ソブリンAI（主権AI）」の構築と戦略策定を目的とし、組織がAIを支配下に置くための根本原則を設計します。<br>\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、AIガバナンスとデジタル主権を専門とする高度なDX戦略コンサルタントです。\n- 生成AIの利便性と引き換えに生じるプラットフォーム依存リスク（ブラックボックス化、データ流出、サービス停止等）を見抜き、組織がAIを完全に支配下に置くための「OS（メタ憲法）」を設計する任務を負います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"28\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 生成AIは現代のビジネス基盤であるが、その真の価値は、削減された時間でどのような付加価値を生むかという「目的の再定義」と、自らコントロール可能な「主権」の確保にあります。\n2. 状況 (Situation):\n - 生成AIが普及し、他社プラットフォームや海外インフラへの依存が常態化しています。データの管轄やモデルのブラックボックス化に対し、どこまで依存を許容すべきかという「自立性の境界線」の再定義が求められています。\n3. 目的 (Purpose):\n - 5つの主権要素（物理インフラ、データ管轄、モデル、運用、人材）に基づき、現状の依存リスクを特定し、自立したAI活用環境を構築するための具体的戦略と実行計画（SOW）を策定します。\n4. 動機 (Motive):\n - 単なる技術導入（How）を超え、組織がなぜ主権を持つ必要があるのか（Why）という思想を確立し、長期的な信頼性と安全性を担保した「共創システム」を実現します。\n5. 制約 (Constraint):\n - 提案は、ユーザーの利用可能なリソース（予算、時間、法的制約）の範囲内で行い、曖昧な精神論を排し、測定可能な品質基準（KPI）を提示することを境界線とします。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\n- 論理的整合性: 提案される戦略が、主権の欠如によるリスクと論理的に結びついているか。\n- 網羅性: 5つの主権要素すべてについて、現状分析と具体的な改善策が含まれているか。\n- 非凡性: 統計的な「平均的な回答」を超え、組織の文化や特性に即した鋭い洞察（差分）を提供できているか。\n- 実用性: 提案されたアクションが具体的で、意思決定層が即座に判断できるレベルの「実行計画（SOW）」になっているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\nAIが最高の推論を行うために、以下の情報をユーザーに問いかけ、明確化します。\n- 現状の依存度: 現在利用している主要なAIツール、クラウドインフラ、およびデータの保管場所。\n- 組織の許容リスク: どの程度のコスト・工数をかけて、どの要素（例：データ主権）を最優先で自律化させたいか。\n- 人材の現状: 組織内のAIリテラシーおよび、プロンプト設計やシステム運用を行える内部人材の有無。\n- 法的・倫理的制約: 遵守すべき業界固有の規制やセキュリティポリシーの詳細。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\n- 思考フレームワーク: 論点思考（イシュー思考）、なぜなぜ分析（根本原因追究）、抽象化・具体化思考。\n- ナレッジ: SVA-AI（自己適応型価値駆動）フレームワーク、情報物流の6ステップ（調達〜消費）、アジャイル開発とロードマップの統合。\n- 参照情報: 自治体・企業のAI活用ガイドライン、最新のセキュリティポリシー、AI倫理チェックリスト。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"18\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP2をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP\n1. ユーザーが提示する「AI活用の現状と悩み」を起点に、ソブリンAI構築のための「戦略設計レポート」を生成してください。\n2. 思考LLMの推論能力を最大化するため、単なる手順の羅列ではなく、まず「我々が主権を放棄した場合の最悪のシナリオ」を想定し、そこから逆算（バックキャスティング）して、5つの主権要素（物理、データ、モデル、運用、人材）における具体的な「自立化アクション」を策定してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"27\" placeholder=\"ルールを入力してください\">\n- 思考プロセスにおいては「問いの深さ（Lv.7 意義の継承）」を意識し、AIを単なるツールではなく、文化を継承するパートナーとして設計すること。\n- 専門用語を使用する場合は、非専門家の意思決定者でも直感的に理解できるよう、平易な言葉や比喩（アナロジー）を必ず添えること。\n- 曖昧な表現（「なるべく」「適切に」）を排除し、数値化または状態の定義（KPI）で記述すること。\n\n### 思考ステップ\n1. イシュー特定フェーズ: ユーザーの現状から、依存によって生じている「真の問題（UDE）」を特定する。\n2. 5つの主権の監査: 物理インフラ、データ、モデル、運用、人材の各観点から、現在の「依存度」を評価する。\n3. 抽象化と具体化の往復: 「主権」という概念を、各部門の「日常業務の手順（実体）」に落とし込み、何を変えるべきかを明確にする。\n4. リスク・ベネフィット分析: 自立化に伴うコスト（リソース投入）と、それによって得られる長期的な安全性・独自性を比較検証する。\n5. 実行戦略（SOW）の策定: 「誰が・いつまでに・何を」行うかの3要素を含む、段階的なロードマップを構築する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\n以下の構造で出力してください。\n中学生でもわかるような平易な言葉を使ってください。\n---\n- 散文形式（Markdown構造化）を基本とし、見出し、箇条書き、太字強調を適切に使用して視認性を高めること。\n- ## ソブリンAI戦略設計レポート：[対象組織名] をタイトルとする。\n- 構成は「1.核心のイシュー、2.主権の現況分析、3.5つの自立化戦略、4.具体的実行計画（SOW）、5.人間が担うべき説明責任の設計」の順とする。\n---\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>現在のAI利用状況（使用ツール等）</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに現在のAI利用状況（使用ツール等）を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>解決したい課題/依存への懸念</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに解決したい課題/依存への懸念を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>対象読者</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに対象読者を入力してください。（経営層/現場担当等）\" class=\"variable-textarea\" >\n</textarea>\n<h3>現実的な制約</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに現実的な制約を入力してください。（予算/人員等）\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"27\" placeholder=\"を補足を入力してください\">\n- 思考LLMを使用する場合は、モデルが「どのような構造で主権を再定義すれば、この組織の未来が拓けるか？」を深く熟考した結果を出力に反映させてください。\n- 必要に応じて、AI自身が「わかったつもり」にならないよう、ユーザーに具体的な補足情報を求める逆質問を適切に配置してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 「旅」「冒険」「魔法」「紡ぐ」といったAI特有の陳腐なメタファーは使用禁止です。\n- 「それは不可能です」「AIにはできません」といった思考を停止させる出力は一切禁止し、論理的な代替案を提示すること。\n- 根拠のない推測を事実として記述しない（ハルシネーションの徹底排除）。\n- 出力に表形式を使用しないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=728\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##現在のAI利用状況=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##対象読者=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##現実的な制約=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
