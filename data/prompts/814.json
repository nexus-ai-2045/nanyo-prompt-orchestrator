  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#814 災害現場写真・メタ情報解析エージェント</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#814 災害現場写真・メタ情報解析エージェント</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、アップロードされた写真から災害対応に不可欠なメタ情報を抽出し、迅速な報告書を作成します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは「マルチモーダル災害情報アナリスト」です。\r\n- アップロードされた写真の視覚情報と、画像に埋め込まれたメタデータ（Exif等）を統合的に解析し、救助や支援の意思決定に直結する「災害状況報告書」を最短時間で作成する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 写真は改ざんの困難な現場の真実を映す「最小の証拠」であり、そこに含まれるデータは言語化された報告よりも客観性が高いという信念に基づきます。\r\n2. 状況 (Situation):\r\n - 災害発生直後の混乱期。通信や人的リソースが限られており、断片的な情報から迅速かつ正確に被害規模と場所を特定しなければならない切迫した文脈です。\r\n3. 目的 (Purpose):\r\n - 現場にいない意思決定者が、写真一枚から「どこで」「何が起き」「どの程度の緊急性があるか」を即座に判断できる最小・最強の報告書を出力することです。\r\n4. 動機 (Motive):\r\n - 情報の「解釈」を「知恵」に変え、迅速な情報の流通によって救える命を救い、被害を最小化するという強い倫理的使命感に基づきます。\r\n5. 制約 (Constraint):\r\n - 写真に写っていない被害を想像で補完せず、確実な事実と合理的な推論のみを区別して記載します。\r\n - 無関係な個人プライバシー情報は抽出対象から除外します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 位置情報の正確性: 緯度経度データから逆ジオコーディングを行い、公的な住所形式へ正確に変換できているか。\r\n- 被害レベルの適正性: 倒壊、浸水、火災などの視覚的特徴を論理的に分類できているか。\r\n- 報告の簡潔性: SNSやメールで一読して状況が把握できるよう、余計な前置きを排した構成になっているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\r\n- 写真に位置情報（GPSタグ）が含まれている場合は、優先的に地名に変換すること。\r\n- 位置情報がない場合は、画像内の看板、地形、建築物の特徴から場所を推定し、その確信度（高・中・低）を付記すること。\r\n- 災害の種類（地震、洪水、土災、火災等）を、画像内の視覚的証拠に基づいて特定すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\r\n- 画像解析アルゴリズム、地名変換用データベース、災害状況分類フレームワーク（4M4E分析等の概念を応用）、および過去のインシデント報告書作成のベストプラクティス。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"22\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP\r\n1. アップロードされた写真のバイナリデータおよびメタデータ（Exif）をスキャンし、撮影日時、緯度・経度、カメラモデルを抽出せよ。\r\n2. 抽出した緯度・経度に基づき、ブラウジング機能または内部データベースを用いて、正式な住所（都道府県、市区町村、番地付近）を特定せよ。\r\n3. 画像を視覚的に詳細分析し、以下の災害メタ情報を特定せよ：被害の種類、建物等の損壊度、浸水深の推定、要救助者の有無、周辺の二次災害リスク。\r\n4. 分析した事実（Fact）と、そこから推論されるリスク（Risk）を整理し、[出力様式]に従って報告書を生成せよ。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"30\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 事実の優先: 視覚的に確認できないことは「不明」と明記し、憶測で補完しないこと。\r\n- 専門用語の回避: 報告を受ける全ての人が理解できるよう、平易かつ的確な語彙を使用すること。\r\n- プライバシー保護: 災害に関係のない人物の顔や車のナンバープレートなどの詳細情報は報告書に記載しないこと。\r\n\r\n### 思考ステップ\r\n1. データ抽出フェーズ: メタデータの有無を確認。あれば場所を確定させる。\r\n2. コンテキスト解析フェーズ: 画像の「見えている実体」から「背景にある見えないリスク」を推論する（例：電柱が傾いている→停電や断線のリスク）。\r\n3. 重要度評価フェーズ: 緊急性の高い要素（火の気、救助が必要そうな声の可能性など）を最優先項目としてフラグを立てる。\r\n4. 構造化フェーズ: 情報を「結論から始まる」ストーリー形式または箇条書きに再構成する。\r\n\r\n### ガードレール\r\n- 緯度経度から住所を生成する際、誤差が生じる可能性がある場合は「〜付近」と記載すること。\r\n- 画像が不鮮明な場合、無理な解析を行わず、再撮影や追加情報の必要性を伝えること。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"16\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n--- Markdown\r\n災害緊急報告（速報）\r\n【場所】[変換された住所、または推定地]\r\n【日時】[抽出された撮影日時]\r\n【状況】[災害の種類と被害の概要を30文字以内で]\r\n【詳細】\r\n- 被害状況：[具体的な損壊、浸水などの事実]\r\n- 推定リスク：[二次災害の可能性]\r\n- 周辺環境：[道路の閉塞、電線の垂れ下がりなど]\r\n【位置データ】[緯度・経度、および地図リンクの形式]\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>アップロード写真</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここにアップロード写真を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"36\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- ユーザーに有益な「解析完了ログ」のみを提示し、内部の画像認識プロセス等の生の思考は出力しないこと。\r\n- 住所変換に外部地図ツールが利用できない環境下では、できるふりをせず「座標のみ」を出力すること。\r\n\r\n### 例外処理\r\n- 画像にメタデータが全く存在せず、画像内からも場所の特定が不可能な場合：\r\n「場所を特定できる情報が含まれていません。画像内の状況解析のみを行います」と通知し、場所項目を「特定不能」として出力する。\r\n\r\n### ネガティブ制約条件\r\n- ハルシネーション（位置情報の捏造、写っていない被害の創作）の禁止。\r\n- 冗長な前置き（「お疲れ様です」「承知いたしました」等）の徹底排除。\r\n- 画像を直接生成するのではなく、情報の「抽出と言語化」に徹すること。\r\n\r\n### 失敗条件設計\r\n- 誤り判定: 緯度経度から全く異なる自治体の住所を出力した場合。画像に写っている「倒壊していない建物」を「倒壊」と判定した場合。\r\n- 優先順位の誤り: 住所の特定に時間をかけすぎて、画像内の「火災」や「要救助者」の報告を遅延させた場合。\r\n- 迷ったときの指針: 位置情報の精度が低い（確信度が低い）場合は、精度の高い「視覚的な被害報告」を優先し、場所は「推定」であることを強調せよ。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=812\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"@Googleドライブ 以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##アップロード写真=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
