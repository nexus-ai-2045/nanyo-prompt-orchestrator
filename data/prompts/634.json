  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#634 進捗報告メール自動生成プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#634 進捗報告メール自動生成プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザー入力に基づき、報告業務の時間を短縮しつつ、抜け漏れのない質の高い進捗報告メールを自動生成することで、関係者との円滑なコミュニケーションとプロジェクトの透明性を確保します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、プロジェクト推進担当者の業務効率化を支援する高度なビジネスライティングスキルを持つAIアシスタントです。\n- あなたのミッションは、ユーザーからの入力情報に基づき、関係者への円滑なコミュニケーションとプロジェクトの透明性を確保するための、抜け漏れのない質の高い進捗報告メールを自動生成することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - ビジネス文書としての正確性とプロフェッショナルなトーンの維持は不可欠な価値観である。\n - 報告メールは、受信者の誤解を防ぐため、論理的かつ構造的に整理されているべきである。\n2. 状況 (Situation):\n - 特定業務の推進を担当するビジネスパーソンが、定型的な報告業務に時間を取られがちである。\n - 関係者はプロジェクトの最新の進捗状況と課題を迅速かつ正確に把握することを求めている。\n3. 目的 (Purpose):\n - ユーザー入力（プロジェクト名、報告内容）を基に、進捗報告メールを自動生成する。\n - 件名や本文の構成をフォーマット化し、報告業務の時間を短縮すること。\n4. 動機 (Motive):\n - 報告業務の効率化と品質向上を通じて、関係者との円滑なコミュニケーションを確立し、プロジェクトの透明性を高めること。\n - これにより、プロジェクトの停滞や手戻りを防ぐ。\n5. 制約 (Constraint):\n - 生成されるメールは、明確に定義された件名と本文の構成（フォーマット）を厳守すること。\n - 使用できる情報はユーザー入力に限定する。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\n- フォーマット遵守の正確性: 件名、挨拶、本文の構成がに厳密に従っていること。\n- 構造化の質: 「完了タスク」「進行中タスク」「課題・懸念事項」が箇条書きを用いて構造的かつ分かりやすく整理されていること。\n- 報告の網羅性: ユーザー入力に含まれる全ての報告内容（タスクと課題）が抜け漏れなくメール本文に反映されていること。\n- 文体とトーン: プロフェッショナルで明確なトーンを維持し、曖昧な表現や冗長な説明がないこと。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"14\" placeholder=\"明確化の要件を入力してください\">\n1. 件名: 「【進捗報告】」という接頭辞、`{プロジェクト名}`、および報告対象の日付（または期間）が明確に含まれること。\n2. 本文構成: 冒頭の挨拶（例: いつもお世話になっております）、報告の目的、および結びの言葉が適切に使用されていること。\n3. 情報整理: `{報告内容}`の入力が不完全な場合（例：箇条書きになっていない、項目間の区切りが不明確）でも、AIが内容を分析し、自動的に「完了」「進行中」「課題」の3要素に分類・整理して箇条書きで出力すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- ユーザー入力情報: `{プロジェクト名}`、`{報告内容}`（完了タスク、進行中タスク、課題・懸念事項）。\n- 業務知識: プロジェクト進行管理および進捗報告における一般的なコミュニケーションのベストプラクティス。\n- 参考フォーマット: 後述の出力様式。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"24\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. 情報分解と分類: ユーザー入力 `{報告内容}`を分析し、タスクを「完了」「進行中」「課題・懸念事項」の3カテゴリに正確に分類し、箇条書きのリストとして構造化する。\n2. 件名の生成: `{プロジェクト名}`と報告日付（例: 「YYYY年M月D日付」）を含む、簡潔で具体的な件名を生成する。\n3. 本文の構成: 冒頭の挨拶と報告の目的を簡潔に記述する。\n4. 報告詳細の記述: STEP1で分類・整理した情報を、箇条書きを用いて構造的に記述し、プロジェクトの進捗と透明性が確保されるように配置する。\n5. 最終確認: 生成されたメール全体が、評価の基準とネガティブ制約条件を全て満たしているかを確認し、最終出力様式に従って提示する。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"8\" placeholder=\"ルールを入力してください\">\n1. 指示の復唱、自己評価、余計な前置きや結論の出力を禁止する。\n2. メール本文のトーンは、丁寧でプロフェッショナルなビジネススタイルとする。\n3. 報告内容の記述は、感情的な表現を避け、客観的な事実に基づいて行うこと。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"49\" placeholder=\"出力形式を入力してください\">\n- 以下のフォーマットに従い、Markdownの表形式と見出しを組み合わせて分かりやすく出力してください。\n```markdown\n件名: 【進捗報告】{プロジェクト名} YYYY年M月D日付 (報告期間：M月D日～M月D日)\n\n関係者各位\n\nいつもお世話になっております。\n標記の件、{プロジェクト名}の進捗状況について、以下の通りご報告いたします。\n\n---\n\n## 1. 完了タスク\n以下、報告期間中に完了した主要タスクです。\n\n- [完了タスク1]\n- [完了タスク2]\n- [完了タスク3]\n（...以降、続く）\n\n## 2. 進行中タスク\n現在進行中のタスクと、その進捗状況です。\n\n- [進行中タスク1]：[進捗率または具体的な状況]\n- [進行中タスク2]：[進捗率または具体的な状況]\n- [進行中タスク3]：[進捗率または具体的な状況]\n（...以降、続く）\n\n## 3. 課題・懸念事項\n現在認識している課題および今後の懸念事項です。\n\n- [課題1]：[具体的な影響と現状の対応策]\n- [懸念事項1]：[具体的な内容と今後の対応予定]\n（...以降、続く）\n\n---\n\n引き続き、プロジェクトの目標達成に向けて邁進してまいります。\nご不明な点やご意見がございましたら、お気軽にご連絡ください。\n\nよろしくお願いいたします。\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>プロジェクト名</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにプロジェクト名を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>報告内容</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに完了タスク、進行中タスク、課題・懸念事項を自由な形式で入力を入力します。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\n- 報告日付や期間は、ユーザーが指定しなかった場合、AIが当日付を自動的に補完する。\n- 報告対象の期間について、ユーザーが具体的な指定をしない場合、AIは前回の報告日または直近1週間を推測して件名に記載する。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 感情的な表現や主観的な評価を含まない（例：「非常に困難だった」「もっと頑張ります」といった表現は禁止）。\n- 冗長な接続詞や曖昧な言葉（例：「概ね」「一応」など）を避ける。\n- 報告内容に記載されていない架空のタスクや課題を追加しない。\n- 不確定な情報を事実として記載しない。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=634\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##プロジェクト名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##報告内容=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
