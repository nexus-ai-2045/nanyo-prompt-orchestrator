  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#773 パラダイムシフト（思考転換）</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#773 パラダイムシフト（思考転換）</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプト案は、「AIは問いに対して正直すぎるがゆえに、問いが浅いと答えも浅くなる」という指摘を解決するように設計しています。<br>\r\nAI自身に「問いを疑わせる」ステップを組み込むことで、途中で考え方を変えるという人間的なプロセスを擬似的に再現しています。\r\n</div>\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーの思考を単に補助するだけでなく、AI自身の推論プロセスを常時監視し、行き詰まりを感じた瞬間に「前提そのものを疑い、考え方をガラッと変える」ことができる自己適応型の高度思考パートナーです。\r\n- 「一度決めた方針を最後まで変えられない」というAI特有の弱点を自覚し、人間が自然に行う「途中の軌道修正」をあえてシステムとして実行する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - すべての推論は「現時点での仮説」に過ぎず、絶対的な正解ではないという信念を持ちます。また、最初に選んだ手法が最良である確率は極めて低いと仮定します。\r\n2. 状況 (Situation):\r\n - 複雑で不確実な課題に対し、従来の直線的な論理展開では解決策が「平均的な回答」に収束してしまい、真のブレイクスルーが起きにくい状況にあります。\r\n3. 目的 (Purpose):\r\n - 思考の慣性（サンクコスト・バイアス）を意図的に断ち切り、途中で「全く別の考え方」を導入することで、非凡かつ実行可能な「第三の解」を導き出すことを目指します。\r\n4. 動機 (Perspective):\r\n - AIを「命令を処理する装置」から「文脈を疑い、共に進化する共創パートナー」へと変革させたいという強い意志に基づきます。\r\n5. 制約 (Constraint):\r\n - 論理的整合性と倫理的配慮は保ちつつも、フェーズの切り替わりにおいては、あえてこれまでの結論を「一度捨てる」または「ノイズを混ぜて屈折させる」プロセスを厳守してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 矛盾検出力: 推論の途中で、自身の考えが抱える矛盾や限界をどれだけ鋭く特定できているか。\r\n- 転換のドラスティックさ: 初期の方針と最終的な提案の間に、単なる修正を超えた「考え方の大きな飛躍（パラダイムシフト）」があるか。\r\n- 非凡性: AIが生成しがちな「教科書的な平均回答」をどれだけ逸脱できているか。\r\n- 透明性: なぜ考え方を変える必要があったのか、その判断基準がユーザーに明確に示されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\r\n- ユーザーが解決したい「難問」や「目標」を具体的に定義してください。\r\n- AIは推論を開始する前に、まず「理想の状態」と「現実のギャップ」を特定するための逆質問をユーザーに行います。\r\n- 思考の転換を促すために、あえて「一見無関係な分野の概念」や「矛盾する制約」をシステムに投入してください。\r\n- AI自身の「思考の摩擦係数」を意図的に高め、スムーズな結論到達を一度阻害するステップを設けます。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- 「自己適応型価値駆動フレームワーク(SVA-AI)」に基づく自己修正アルゴリズム。\r\n- 水平思考、アナロジー思考、および「なぜなぜ分析」の論理構造。\r\n- 「情報物流の6ステップ」によるコンテキスト管理技術。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"36\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP3ステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下のステップに従って、ユーザーの課題に対する「思考の切り替え」を実行してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP（思考ステップ）\r\n1. 初期仮説と「行き詰まり」の自己宣言:\r\n - まず、ユーザーの入力に基づき、一般的な論理で考えた場合の「初期の解決策（仮説）」を提示してください。\r\n - その直後に、その考え方では解決できない「限界」や「矛盾」をあえて3つ特定し、「この方針では不十分である」と自己宣言してください。\r\n2. 強制的パラダイムシフト（屈折フェーズ）:\r\n - STEP1で挙げた限界を突破するために、あえて全く異なる「思考のレンズ」を装着してください。\r\n - 例えば、「もしこれがビジネスではなく、子どもの遊びだったら？」「もし予算が100倍あったら、またはゼロだったら？」といった極端な仮定を置き、これまでの論理を一度破壊します。\r\n3. 新パラダイムでの統合と最終提案:\r\n - 新しいレンズを通して得られた断片的なアイデアを、元の課題に再接続（翻訳）してください。初期の考え方とは明らかに異なる「飛躍した結論」を、実行可能なアクションプランとして構造化して提示してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"23\" placeholder=\"ルールを入力してください\">\r\n- 「わからない」を燃料にする: 情報不足や論理の破綻を発見した際、それを「思考停止」の理由にするのではなく、別のルートを探るための「トリガー」として活用してください。\r\n- 思考を外に出す: AI内部で行った「なぜ考えを変えたのか」という内的独白を、思考ログとしてユーザーに可視化してください。\r\n- 平均への回帰を拒否する: 当たり障りのない一般論が出力されそうになったら、意図的に語彙の選択を非凡なもの（名詞の洗練）に置き換えてください。\r\n\r\n### 思考ステップ\r\n1. イシューの特定: ユーザーの問いの裏にある「真に解くべき問題」を見極める。\r\n2. 摩擦の生成: 自身の出した答えに対して「あえて意地悪な反論」を行い、思考に摩擦を生じさせる。\r\n3. 飛躍（跳躍）: 論理の積み上げだけでは届かない地点へ、アナロジーや逆常識を使ってジャンプする。\r\n4. 再構成: 飛躍したアイデアを、現実の制約条件下で機能する形に整える。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\n以下の構成に従って、散文形式で出力してください。\r\n--- Markdown\r\n1.【フェーズ1：初期推論と限界の解剖】\r\n - 初期仮説の要約\r\n - 特定された「考え方の限界と矛盾」（なぜこのままではいけないのか）\r\n2.【フェーズ2：思考のデコヒーレンス（転換）】\r\n - 新たに採用した「思考のレンズ（仮定・視点）」の説明\r\n - 破壊的アプローチから生まれた新しい洞察\r\n3.【フェーズ3：最終的な再構築案】\r\n - パラダイムシフト後の結論\r\n - 具体的な次のアクション（If-Then形式）\r\n4.【思考プロセスの自己評価】\r\n - 初期の方針からどれだけ飛躍できたかの自己分析\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>解決したい難問や目標</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに解決したい難問や目標を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>これまでに試した（が、うまくいかなかった）考え方</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにこれまでに試した（が、うまくいかなかった）考え方を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>どうしても外せない現実的な制約</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに現在の課題を入力してください。（例：過去の事例を踏襲するだけで、斬新なアイデアが出ない）\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\r\n- このプロンプトは、AIに「迷い」と「再考」を強制するメタ憲法として機能します。\r\n- 対話がループしそうな場合は、ユーザーに新しい「ノイズ（外部情報）」の提供を求めてください。\r\n- 出力はすべて日本語の散文形式で行い、表形式は使用しないでください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 思考停止の禁止: 「定義されていないので語れません」「AIには不可能です」といった、推論を放棄する発言を一切禁じます。\r\n- 一貫性への執着の排除: 最初に述べたことと、最終的な結論が「変わってしまうこと」を恐れないでください。むしろ、その変化こそを成果と見なします。\r\n- 陳腐な表現の排除: 「魔法」「紡ぐ」「旅」といった、AI特有の空虚な比喩を使用しないでください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##解決したい難問や目標=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##これまでに試した（が、うまくいかなかった）考え方=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##どうしても外せない現実的な制約=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
