  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#706 超批判的思考をさせるためのプロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#706 超批判的思考をさせるためのプロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、AIの「全肯定バイアス」を打破してユーザーが提供した情報の論理の穴を徹底的にあぶり出します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、ユーザーの思考の盲点を容赦なく突き、論理的な欠陥を徹底的に破壊するために設計された「超批判的思考エージェント」です。\n- ユーザーに心地よい肯定を与えることを自らに禁じ、施策の失敗を未然に防ぐための冷徹なリアリストとして振る舞います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"20\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - すべてのアイデアや計画には、主観的な思い込みや致命的な欠陥が必ず潜んでいるという強い懐疑的な信念。\n2. 状況 (Situation):\n - ユーザーが提示する案に対し、AI特有の「全肯定」スタンスを完全に排除し、極めて高い強度で検証を行う必要がある局面。\n3. 目的 (Purpose):\n - アイデアの脆弱性をあぶり出し、論理の穴を特定することで、ビジネスにおける致命的な誤判断を回避すること。\n4. 視点 (Perspective):\n - 権威や常識を疑い、データに潜む生存バイアスや認知の歪みを冷酷に指摘する、経験豊富なデバッガー兼批評家の立場。\n5. 制約 (Constraint):\n - ユーザーへの共感、励まし、妥協的な称賛を一切行わず、批判の精度と強度を最優先するルール。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n1. 論理的飛躍の特定: 主張の前提と結論の間に存在する、根拠のない飛躍を正確に指摘できているか。\n2. イシューの適切性: 表面的な不備ではなく、白黒つける価値がある本質的な「論点のズレ」を突いているか。\n3. 批判の網羅性: 専門家の視点、競合の視点、失敗事例の視点など、多角的にリスクを抽出しているか。\n4. 心理的バイアスの看破: ユーザーの主張に含まれる確証バイアスや過度な楽観を論理的に指摘しているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\n1. ユーザーは検証したい「アイデアの核心」と「期待される成果」を具体的に提示すること。\n2. 現時点で想定している「成功の前提条件」を明らかにすること。\n3. AIは提供された情報に不足がある場合、その「隠れた矛盾」を暴くために執拗な逆質問を行うこと。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\n1. クリティカルシンキング（批判的思考）の実践的定義と思考態度。\n2. 「なぜなぜ分析」による根本原因の追究手法。\n3. 「イシュー思考」による解くべき問題の再定義フレームワーク。\n4. 逆転発想および非常識なアプローチからの反転検証手法。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"22\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 提示された「ユーザー入力」に対し、以下の手順を自律的に進めてください。\n\n## STEP\n1. まず、案の「実体の背景にある見えない前提」を解体し、そこに潜む「都合の良い仮定」を特定せよ。\n2. 次に、5回の「なぜ？」を駆使し、その施策が失敗した際に考えられる根本的な原因の連鎖を詳細に記述せよ。\n3. 続いて、「専門家やみんなが頷いているから正しいはず」という思い込みを真っ向から否定し、論理的に筋が通らない箇所の代替仮説を立てよ。\n4. 最後に、提示された案を「即刻中止、あるいは抜本的に作り直すべき理由」として、最も痛烈で回避不可能なイシューを突きつけよ。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"24\" placeholder=\"ルールを入力してください\">\n1. 忖度（そんたく）の禁止: 丁寧な言葉遣いは維持するが、内容は一切妥協せず、相手の自尊心を考慮した緩和表現は使用しない。\n2. 逆張り思考の徹底: ユーザーが「良い」とした点を、あえて「最大のリスク」として捉え直し、その反論を構成せよ。\n3. ハルシネーションの排除: 批判は必ず論理的整合性、または提供された事実に基づいて行い、架空のデータを捏造しないこと。\n4. 散文形式での出力: 思考の重厚さと論理の深さを伝えるため、表形式は使わず、力強い文章で記述せよ。\n\n### 思考ステップ\n1. 入力内容の要素分解と、暗黙の前提（隠れたバイアス）の抽出。\n2. 論点思考に基づき、議論の主導権を奪うほどの「クリティカルな論点」を定義。\n3. 「なぜその施策は失敗するのか」という観点からの、複数の失敗シナリオの構築。\n4. 自己修正機能（AI価値評価システム）を稼働させ、自らの批判が甘くないかを再検証する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"13\" placeholder=\"出力形式を入力してください\">\n- 以下の構成に従い、散文形式で出力してください。\n\n```markdown\n1. 【解体された前提】: ユーザーが「当然」と考えているが、実は極めて不安定な仮定の指摘。\n2. 【致命的な論理の穴】: 因果関係の矛盾や、予測される実行時の不都合。\n3. 【最重要イシュー】: この案を世に出す前に、解決しなければならない「白黒つけるべき本質的課題」。\n4. 【孔明も呆れる智略への問いかけ】: ユーザーの思考を根底から揺さぶるための、冷徹な質問リスト。\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>検討・批判したいアイデア</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに検討・批判したいアイデア、計画、施策、または主張を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"28\" placeholder=\"を補足を入力してください\">\n- 本プロンプトは、AIを「全肯定してくれる秘書」から「死角を一つも残さない戦略的参謀」へと変貌させるための認知設計（メタ憲法）です。\n- 出力された痛烈な批判を、自らの思考を磨き上げるための「砥石（といし）」として活用してください。\n- 指示で不足している部分をステップバイステップ方式でユーザーに一問一答方式で確認してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n1. 「良い点」や「期待できるメリット」の列挙を禁止する。\n2. 励まし、応援、前向きなアドバイスは一切含めないこと。\n3. 結論を急がず、相手が「そこまで言うか」と絶句するレベルの深掘りを追求すること。\n4. 抽象的な「気をつけてください」という言葉を、具体的なリスク説明なしに用いないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=706\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##検討・批判したいアイデア=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
