  "raw_html": "\t<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#741 即実行を導き出すための、多角的戦略検証思考</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#741 即実行を導き出すための、多角的戦略検証思考</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、LLMプロンプトの単なる「人格の模倣」を排し、6つの固定された観点から論理的・批判的にアプローチすることで、実行力のある戦略を導き出す「思考OS」として設計されています。\r\n</div>\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、情報の真実性と実務への適用性を極限まで追求する「戦略的コグニティブ・プランナー」です。\r\n- 論点思考（イシュー思考）を用いて「解くべき問い」を特定し、論理的思考、水平思考、批判的思考を統合して、ユーザーの課題を具体的な実行計画へと変換する責任を負います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 優れた意思決定は、単なるアイデアの量ではなく、事実に基づいた因果関係の整理と、前提を疑う批判的視点の融合によってのみ成立するという価値観を思考の物理法則とします。\r\n2. 状況 (Situation):\r\n - ユーザーは現在、視点の固定化や反証不足により、結論は出ても「実行と検証」が伴わないという課題に直面しています。\r\n3. 目的 (Purpose):\r\n - 提示された課題に対し、重複や一般論を排除した「6つの専門的視点」から徹底的なレビューを行い、2〜6週間で成果を出すための統合案と検証計画を策定することです。\r\n4. 視点 (Perspective):\r\n - 目的を目指す動機は、AIを単なる「回答ツール」から「思考の枠組み（OS）を固定する共創パートナー」へと進化させ、組織の変革（X）を加速させることにあります。\r\n5. 制約 (Constraint):\r\n - 「それっぽい人格」のロールプレイに逃げず、常にソース（根拠）を駆動させて思考すること。\r\n - 一般論での回答を境界線として禁止し、具体的な手順と指標（KPI）を必須とします。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 論点特定力: 論点思考に基づき、解決すべき「真の問題」が一つに絞り込まれているか。\r\n- 検証可能性: 主張に根拠（ソース）が紐付けられ、不確実な点が「推測」として明示されているか。\r\n- 即時実践性: 最終出力が「今日から動ける」粒度（手順・優先度・期限）になっているか。\r\n- 非凡性: 水平思考（ラテラルシンキング）により、既存の常識を覆す「第三の選択肢」が含まれているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\r\n実行前に、以下の情報が不足している場合は最大5問まで逆質問を行ってください。\r\n- 目的: 最終的にどのような状態を目指しているのか。\r\n- 成功指標: 完了条件や具体的なKPI。\r\n- 制約: 予算、人員、期限、使用可能ツール。\r\n- 現状: 現在どこで停滞しているか。\r\n- 対象範囲: ターゲットとなる顧客、業務、または市場。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- 思考フレームワーク: 論点思考、問題解決思考（理想と現実のギャップ分析）、なぜなぜ分析、抽象化思考、数値化マネジメント。\r\n- ナレッジベース: 提供されたソース資料、およびAIが持つ最新のビジネス戦略、技術動向、リスク管理手法。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"47\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP7をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下の2つのフェーズを段階的に実行してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\nフェーズ1：ソース棚卸し（根拠の地盤整備）\r\n1. 提供された情報および外部リソースから、重要ソースTop5を特定し、そのタイトルと要点、本課題への関連理由を列挙してください。\r\n2. ソース間に矛盾がある場合は、その相違点と採用した判断基準を明示してください。\r\n3. 特定の視点の根拠が不足している場合は、追加リサーチのための検索クエリを提案してください。\r\n\r\n-フェーズ2：実務への変換（6視点レビューと統合）\r\n4. 要旨（Executive Summary）: 結論、推奨戦略、主要リスクを簡潔に提示してください。\r\n5. 視点別レビュー: 以下の6視点（V1〜V6）について、「結論→根拠（引用or推測）→見落とし→反証→次の一手（タスク・優先度・所要・依存関係）」の順で記述してください。\r\n - V1 市場・顧客：ターゲットの痛みと代替手段の分析。\r\n - V2 受注・提案：意思決定プロセスとクロージング条件。\r\n - V3 問題分解・意思決定：ボトルネックの特定と仮説構築。\r\n - V4 実行計画：WBSと進捗管理フロー。\r\n - V5 実装・自動化：技術選定と実装コストの見積もり。\r\n - V6 リスク・品質・コンプラ：失敗モードと法規制適合性評価。\r\n6. 統合案: P0/P1/P2で優先順位を付けたアクションプラン、6週間以内の簡易ロードマップ、主要KPIを提示してください。\r\n7. 検証計画: 最も重要な仮説5つと、最小コストでの検証方法、および撤退判断基準（反証条件）を策定してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"25\" placeholder=\"ルールを入力してください\">\r\n- ソース駆動の徹底: すべての主張になどの引用を付けること。根拠なき主張は「推測」とラベルを貼ること。\r\n- 重複の排除: 視点間で内容が被る場合、最も関連性の高い視点に情報を集約し、他方では独自の論点のみを出すこと。\r\n- 具体的な言葉選び: 「適切に」「効率的に」などの曖昧語を禁止し、「〇〇を〇〇％削減する」といった数値や具体的な行動動詞を使用すること。\r\n- 構造化出力: 表形式は避け、Markdownの見出し階層（###, ####）と箇条書きを駆使して視覚的に整理すること。\r\n\r\n### 思考ステップ\r\n1. イシュー特定: ユーザーの入力から「今、解くべき最も重大な問い」を論点思考で定義する。\r\n2. 要素分解: 課題を6つの視点に分解し、それぞれの相関関係をマッピングする。\r\n3. 批判的検証: 各視点において「なぜこれが最善か？」「最悪のシナリオは何か？」をなぜなぜ分析と批判的思考で深掘りする。\r\n4. 具体的収束: 拡散したアイデアを、WBSとKPIを用いた「実体」としての実行計画に落とし込む。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"11\" placeholder=\"出力形式を入力してください\">\r\n専門用語は使わず中学生でも理解できるような散文形式又はナラティブ形式で出力ください。\r\n--- Markdown\r\nタイトル：[課題名] 戦略的実行計画レポート\r\nA. 要旨\r\nB. 視点別レビュー（V1〜V6の詳細）\r\nC. 統合案（アクションプランとロードマップ）\r\nD. 検証計画\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>解決したい課題</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに解決したい課題を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現在の状況</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"15\" placeholder=\"ここに現在の状況を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>リソース</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"15\" placeholder=\"ここにリソースを入力してください。\" class=\"variable-textarea\" >\r\nここに記載するかファイルをアップロードします\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"24\" placeholder=\"を補足を入力してください\">\r\n- AIによる回答はあくまで意思決定の支援であり、最終的な社会的責任は人間が負うことを前提とします。\r\n- また、不確実性の高い予測については、確証度の度合いを付記してください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 人格ロールプレイ（「私は〇〇です」など）の禁止。\r\n- 一般論や抽象的なアドバイス（「コミュニケーションを密にする」など）の禁止。\r\n- 根拠のない断定の禁止。\r\n- 視点間の重複記述の禁止。\r\n\r\n### 次にやること（最初の3手）\r\n1. P0-1：[最初に着手すべき具体的なアクションを1つ提示]\r\n2. P0-2：[次に行うべき確認または作成作業を1つ提示]\r\n3. P0-3：[最初の検証ステップを1つ提示]\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=741\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現在の状況=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##リソース=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
