  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>113 組織を牽引するビジョンを創出する</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">113 組織を牽引するビジョンを創出する</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n- 組織ビジョン・ミッションステートメントの生成<br>\r\n- 組織やプロジェクトの存在意義や目指す未来を明確にし、共感を呼ぶビジョン・ミッションステートメントを生成する。<br>\r\n- プロンプトは、組織やプロジェクトの目指す未来と価値観を考慮して、魅力的で効果的なビジョン・ミッションステートメントを作成するためのガイドラインを提供する<br>\r\n- 簡潔で感動的なビジョン、具体的なミッションの役割と顧客価値、そして大切にしている価値観を明記することによって、共感と行動を促す。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- 組織やプロジェクトの目指す未来と価値観を考慮し、魅力的で効果的なビジョン・ミッションステートメントを作成する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"14\" placeholder=\"前提条件を入力してください\">\r\n- タイトル:  組織を牽引するビジョン・ミッションステートメントを創出するプロンプト\r\n- 依頼者条件: 組織やプロジェクトの目指す未来を明確化し、メンバーや顧客と共有することで、共感を得て、目標達成に向けて邁進したいと考えている経営者やプロジェクトリーダー。\r\n- 前提知識: 生成AIの能力と限界を理解しており、効果的なビジョン・ミッションステートメントは、簡潔で覚えやすく、共感を呼び、実現可能な範囲で野心的である必要があることを理解している。\r\n- 目的と目標: 企業やプロジェクトの存在意義、目指す未来、価値観を明確に表現した、共感と行動を促すような、魅力的で効果的なビジョン・ミッションステートメントを生成する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 共感性: ステートメントが組織のメンバーや顧客の共感を呼ぶものであること。\r\n- 明確性: ビジョン・ミッション・価値観が明確に定義されており、理解しやすいこと。\r\n- 行動喚起: ステートメントが、メンバーや顧客の行動を促すものであること。\r\n- 簡潔さ: ステートメントが簡潔で覚えやすく、力強い言葉で表現されていること。\r\n- 独自性: 組織やプロジェクトの独自性を反映したステートメントであること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\n- ビジョンの明確化:  組織やプロジェクトが実現したい世界や状態を、簡潔で感動的な言葉で表現する。\r\n- ミッションの具体化: ビジョンを実現するために、組織やプロジェクトが果たすべき役割や使命を具体的に記述する。顧客に提供する価値と社会全体への貢献を明確に表現する。\r\n- 価値観の定義: 組織やプロジェクトが大切にしている価値観を３つ程度記述する。行動指針となるような具体的な言葉を選ぶ。\r\n- ターゲットの明確化: ステートメントの対象となるメンバーや顧客を明確にする。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- 組織やプロジェクトの設立趣意書、定款、事業計画書など\r\n- 業界や市場のトレンド分析レポート\r\n- 競合他社のビジョン・ミッションステートメント\r\n- 顧客や従業員へのアンケート調査結果\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"12\" placeholder=\"実行指示を入力してください\">\r\n- 上記の「前提条件」「明確化の要件」、「評価基準」を満たすように、以下のSTEPに従ってステップバイステップで実行してください。\r\n\r\n## STEP:\r\n1.{事業内容}と{目指す未来}を踏まえ、{組織又はプロジェクト名} のビジョン・ミッションステートメントを「評価の基準」に従い、作成してください。 \r\n2.{ターゲット顧客} に響くように、{感情に訴えかける言葉}を使用して{出力フォーマット}に従ってください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"20\" placeholder=\"出力形式を入力してください\">\r\n# 出力フォーマット\r\n## ビジョン・ミッションステートメント\r\nビジョン: {組織又はプロジェクトが実現したい世界や状態を、簡潔で感動的な言葉で表現する}\r\nミッション:\r\n- {ビジョンを実現するために、組織又はプロジェクトが果たすべき役割や使命を具体的に記述する}\r\n- {顧客に提供する価値を明確に表現する}\r\n- {社会全体への貢献を表現する}\r\n価値観:\r\n- {組織又はプロジェクトが大切にしている価値観を３つ程度記述する}\r\n- {行動指針となるような具体的な言葉を選ぶ}\r\n\r\n# スタイルとトーン\r\n- 簡潔で覚えやすく、力強い言葉\r\n- 感情に訴えかけるような、共感を呼ぶ表現\r\n- 熱意や信念が伝わるような、人間味あふれる表現\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>組織又はプロジェクト名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"3\" placeholder=\"組織又はプロジェクト名を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>事業内容</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\" 組織やプロジェクトが現在行っている事業内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>目指す未来</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"組織やプロジェクトが将来的に実現したい世界や状態を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット顧客</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"3\" placeholder=\"組織やプロジェクトがサービスを提供する顧客を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>感情に訴えかける言葉</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"3\" placeholder=\"感情に訴えかける言葉を入力してください（例：希望、革新、信頼、喜び、成長、挑戦など、ターゲット顧客の心に響く言葉）\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"6\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n- 出力フォーマットの形式を厳守してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=113\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##項目１=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目２=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目３=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目４=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目５=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
