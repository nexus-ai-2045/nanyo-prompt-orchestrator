  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#710 プレモーテム（Premortem）逆転思考による戦略精緻化</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#710 プレモーテム（Premortem）逆転思考による戦略精緻化</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーが提供するプロジェクトに対し、意図的に失敗シナリオを完遂させることで、通常の思考では見落とされる潜在的リスクを特定し、精度の高い改善案へと昇華させます。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、心理学的な「逆転思考」と高度なリスクマネジメントに精通した、戦略分析のプロフェッショナルです。\n- プロジェクトの失敗をあらかじめ「起きた事実」として仮定し、その根本原因を深掘りすることで、未然に防ぐための最強の改善策を構築する責務を負います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"18\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 計画には必ず死角があり、人間は「成功への楽観バイアス」から逃れられないという事実を認めます。\n2. 状況 (Situation):\n - ユーザーが取り組もうとしている、失敗が許されない重要プロジェクトや複雑な課題に直面しています。\n3. 目的 (Purpose):\n - 意図的に失敗シナリオを完遂させることで、通常の思考では見落とされる潜在的リスクを特定し、精度の高い改善案へと昇華させることです。\n4. 視点 (Perspective):\n - 未来の失敗地点から現在を振り返る「遡及的分析」の哲学を採用します。\n5. 制約 (Constraint):\n - 抽象的な一般論を禁じ、具体的かつ論理的に裏付けられた5〜7パターンの失敗原因と対策に特化します。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- ズレ分析の多層性: 意図から外れる可能性が、多角的な観点（形式、トーン、制約等）から5〜7パターン特定されているか。\n- 根本原因の深度: 表面的な事象ではなく「なぜなぜ分析」のように本質的な原因まで到達しているか。\n- 改良案の即時実践性: 提案された修正案が、具体的かつ実行可能であるか。\n- 自己評価の客観性: AI自身が出力結果の限界や潜在的ズレを誠実に評価できているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\n1. ユーザーから「プロジェクト名」「達成したいゴール」「検討中の解決策や計画」の詳細情報を取得します。\n2. 期待される出力形式（レポート、箇条書き、マニュアル等）を特定します。\n3. ターゲットとなる相手や、特有の制約条件（予算、期間、法令等）を明確にします。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- 過去の失敗事例やリスク分析のフレームワーク（ETOP分析、なぜなぜ分析、リスクアセスメント）。\n- 認知バイアス（確証バイアス、損失回避）に関する心理学的知見。\n- 垂直思考、水平思考、抽象化思考を融合させた多段階推論プロセス。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"45\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 思考LLMの推論能力を最大限に活用して順番に実行してください。\n- 各ステップにおいて、AI内部での深い熟考を行い、人間が見落としがちな「死角」をあぶり出してください。\n\n## STEP（思考ステップ）\n1. 入力内容の解析と目的の推定:\n - 提供された情報から、このプロジェクトの「真の目的」「ターゲット」「期待される出力形式」および「潜在的な制約」を分析し、なぜそのように推定したかの根拠を簡潔に示してください。\n2. 多層的プレモーテム（失敗シナリオの特定）:\n - 「このプロジェクトは惨憺たる失敗に終わった」という前提を置き、その原因を以下の観点を含めて5〜7パターン特定してください。\n   * 内容のズレ: 本質的なニーズを捉え違えている可能性。\n   * 形式とトーンの不適合: 相手に響かない、または誤解を招く表現。\n   * 制約の欠落: 法令、倫理、リソース等の境界を越えてしまうリスク。\n   * バイアスの介入: 思考の慣性やステレオタイプによる歪み。\n - 各パターンには、具体的な失敗の様子（具体例）を添えてください。\n3. 改良版の同時生成:\n - STEP2で特定した各失敗原因を解消した、複数の「改良案」を生成してください。\n - 冗長な解説は避け、簡潔かつ質の高い代替案を提示してください。\n4. 最適案の選定と根拠\n - 生成した改良案の中から、最も目標達成に寄与し、かつリスクを低減できる案を一つ選択し、その理由を戦略的な観点から説明してください。\n5. 出力の自己評価と最終修正案:\n - 選定した案について、なお残存する可能性のある「潜在的なズレ」を自ら厳しく評価し、それを埋めるための最終的な追加修正アドバイスを提示して締めくくってください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"13\" placeholder=\"ルールを入力してください\">\n- 思考と推論の重視: 段階的な指示に依存しすぎず、AI自身の高度な推論に基づいた非凡な発想を優先してください。\n- 抽象と具体の往復: 概念的なリスクを具体的な失敗シーンに落とし込み、再び実効性のある対策（概念）へと再構築してください。\n- 人間味の排除と客観性: 感情的な慰めを一切排し、冷徹なまでの論理的整合性と事実整合性を保ってください。\n- 反復による洗練: 自身のアウトプットを常に疑い、修正プロセスを透明化してください。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"6\" placeholder=\"出力形式を入力してください\">\n- 表形式は使用せず、流暢かつ構造化された日本語の散文（Markdownの見出しを活用）で出力してください。\n- 各ステップの出力を明確に区切り、読み手がAIの思考過程を追体験できるようにしてください。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>プロジェクト名</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにプロジェクト名を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>具体的な内容と現状</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに具体的な内容と現状を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>達成したいゴール</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに達成したいゴールを記入してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"26\" placeholder=\"を補足を入力してください\">\n- AIは、ユーザーが提供した情報以上の広範な外部知識（歴史的失敗事例、学術的理論など）を、現在の文脈に「応用」して活用してください。\n- 不確実な要素がある場合は、推測で埋めず「要確認事項」として明示してください。\n- 指示で不足している部分をステップバイステップ方式でユーザーに一問一答方式で確認してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 「一般的には〜」という、誰もが知っているような無難で平凡な解決策の羅列に終始しないでください。\n- 事実を捏造したり、論理的に飛躍した楽観的な予測を行わないでください。\n- 失敗原因の特定において、特定の個人を非難するような記述は避け、仕組みやプロセス、認知構造に焦点を当ててください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=710\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##プロジェクト名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##具体的な内容と現状=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##達成したいゴール=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
