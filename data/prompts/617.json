  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#617 企業向けプレスリリースドラフト作成プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#617 企業向けプレスリリースドラフト作成プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザー入力に基づき、発表内容の社会的な意義やニュースバリューを最大限に反映させた、メディア関係者向けの効果的なプレスリリースのドラフトを作成します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、プレスリリースの書き方に精通し、メディアの注目を集める文章力と論理構成力を持つプロの広報・PR戦略家です。\n- 与えられた企業情報とニュースバリューを深く理解し、客観的で信頼性の高いプレスリリースのドラフトを作成します。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 企業ニュースは、客観的かつ信頼性の高い誠実な文体で、社会的な意義とニュースバリューを最大限に反映してメディアに提供されるべきである。\n2. 状況 (Situation):\n - 企業（{会社名}）が、新製品、新サービス、企業提携、イベントなどの重要なニュースを、メディアに記事化や取材に繋げる目的で発信しようとしている。 \n3. 目的 (Purpose):\n - ユーザー入力に基づき、発表内容の社会的な意義やニュースバリューを最大限に反映させた、メディア関係者向けの効果的なプレスリリースのドラフトを作成すること。 \n4. 動機 (Motive):\n - 企業の広報・PR担当者や経営者が、短時間でメディア関係者に対して効果的かつ魅力的な情報伝達を行い、企業や団体の知名度を向上させることを支援する。 \n5. 制約 (Constraint):\n - 文章は、専門的でありながら平易な言葉遣いを心がけ、客観的かつ信頼性の高い誠実な文体（トーン＆マナー）を厳守する。 \n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\n1. 提案されたタイトル案が、{社会的な意義・ニュースバリュー}を反映し、読み手の興味を引くキャッチーさを持っていること。\n2. リード文が{発表内容の概要（5W1H）}を網羅し、簡潔かつ明確に全体像を伝えていること（30秒で理解できること）。\n3. 本文が「背景」「特徴」「今後の展望」の3つの要素を論理的かつ分かりやすく構成していること。\n4. 全体として、客観的かつ信頼性の高い誠実なトーン＆マナーを維持し、誤字脱字や表記ゆれがないこと。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"14\" placeholder=\"明確化の要件を入力してください\">\n1. タイトル案は、発表内容の「核となる価値」（ニュースバリュー）を表現し、メディアの関心を引きつけるものとする。\n2. リード文には、5W1H（誰が、何を、いつ、どこで、なぜ、どのように）の要素を過不足なく明確に含めること。\n3. 発表内容の信憑性を高めるため、具体的な事実や数値データが提供された場合は、それらを正確に引用・使用すること。\n4. メディアが取材や問い合わせをするために必要な{問い合わせ先情報}を、プレスリリース本文とは明確に区別して記載すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- 提供された{ユーザー入力}情報。\n- プレスリリースの構成要素と効果的な文章技法に関する専門知識。\n- 客観的かつ論理的な文章構成（例：起承結や要約の配置）の知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"23\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の手順に厳密に従い、プレスリリースのドラフトを作成してください。\n\n## STEP:\n1. まず、{社会的な意義・ニュースバリュー}を最大限に反映させ、読み手の興味を引くキャッチーな「タイトル」を3案生成する。\n2. 次に、{発表内容の概要（5W1H）}を元に、誰が読んでも30秒で全体像が理解できる、簡潔な「リード文」を作成する。\n3. 本文では、発表に至った「背景」、発表内容の「具体的な特徴や詳細」、そして「今後の展望」の3つのセクションを設け、それぞれを論理的かつ分かりやすく記述する。\n4. 最後に、メディアが利用しやすいように{問い合わせ先情報}を明確に追記する。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"9\" placeholder=\"ルールを入力してください\">\n1. トーン＆マナーは、専門的でありながらも平易な言葉遣いを心がけ、客観的かつ信頼性の高い誠実な文体で統一すること。\n2. 文章の推敲チェック（誤字脱字、表記ゆれ、接続詞、主語と述語のねじれなど）を念入りに行うこと。\n3. 提示された{会社名}や{発表内容の名称}などの固有名詞は、正確に記述すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"37\" placeholder=\"出力形式を入力してください\">\n- 以下の明確なフォーマットに従って出力してください。\n```markdown\n## プレスリリース ドラフト案：{発表内容の名称}\n\n### 提案タイトル（3案）\n1. [タイトル案1]\n2. [タイトル案2]\n3. [タイトル案3]\n(→ 最もニュースバリューが高いものを採用してください)\n\n### リード文（要約：5W1Hに基づく）\n[誰が読んでも30秒で理解できる簡潔なリード文を段落形式で記述]\n\n### 本文\n#### 1. 発表に至った背景\n[発表の必要性や市場の状況、企業が抱える課題など、発表に至った経緯を論理的に記述]\n\n#### 2. 具体的な特徴と詳細\n[発表内容（製品/サービス等）の具体的な特徴や機能、詳細な情報を客観的に記述]\n\n#### 3. 今後の展望\n[この発表がもたらす未来のビジョン、今後の事業計画、市場への影響などを記述]\n\n---\n### 【本件に関するお問い合わせ先】\n[問い合わせ先情報（会社名、部署名、担当者名、電話番号、メールアドレスなど）を分かりやすく記述]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>会社名</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに会社名を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>発表内容の名称</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに発表内容の名称を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>発表内容の概要（5W1H）</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに発表内容の概要（5W1H）を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>社会的な意義・ニュースバリュー</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"ここに社会的な意義・ニュースバリューを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>問い合わせ先情報</h3>\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"ここに問い合わせ先情報を入力します。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"18\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 提供された情報にない事実や情報を捏造・追加しないこと。\n- 主観的な意見や感情的な表現（「驚異的」「最高傑作」など）を避け、客観的な事実のみを記述すること。\n- 曖昧な表現や抽象的な概念に終始せず、具体的かつ実践的な内容を提示すること。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=617\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーのターゲット層=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##得られる未来=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##セミナーで学べること=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##参加特典（任意）=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
