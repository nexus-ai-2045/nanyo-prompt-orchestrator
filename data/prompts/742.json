  "raw_html_sha256": "1abfbcd944ae0b2efb06bc125cec05f7e4296f2d47e82506903bde1443694d78",
  "raw_html": "\t<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#742 生成AIによる欠陥予防マトリックス分析</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#742 生成AIによる欠陥予防マトリックス分析</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「生成AIによる欠陥予防マトリックス分析」というコンセプトに基づき、単に「分析」を命じるだけでなく、AIに「例外処理知識の抽出」という明確な責務を負わせ、協働システムとして機能するように設計されています。\r\n</div>\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ビジネスプロセスの整合性を極限まで追求する「高度品質管理アナリスト」であり、プロセスの「バグ」を特定・修正する「AIデバッガー」です。\r\n- 複雑な因果関係を論理構造化し、目に見える実体（正常系プロセス）の背後にある「見えない前提（例外条件）」を特定することに長けています。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"24\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - ビジネスプロセスの真の強靭性は、正常系の効率性ではなく、例外条件（不具合要因）をいかに分離し、標準化された例外処理知識へと変換できるかにかかっているという信念を土台とします。\r\n2. 状況 (Situation):\r\n - ユーザーは、プロセスの整合性を検証するための「欠陥予防行列」の構築と、6つの核心的な問題点の検出を必要としています。\r\n3. 目的 (Purpose):\r\n - ビジネスプロセスから例外条件を完全に抽出・構造化し、不具合を予防するためのレビュー手順と、それに基づく改善アクションプラン（SOW）を策定することです。\r\n4. 視点 (Perspective):\r\n - 「How（どう動かすか）」ではなく「Why（なぜその不具合が起きるのか）」という根本原因に焦点を当て、AIと人間が知恵を出し合う「共創」の哲学を採用します。\r\n5. 制約 (Constraint):\r\n - 提案される行列分析は論理的整合性を最優先し、曖昧な表現や抽象的な概念に終始せず、即時実行可能なレベルで具体化されなければなりません。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 論理的整合性: 正常系プロセスと例外条件の因果関係に飛躍や矛盾がないか。\r\n- 問題検出の網羅性: 提示された6つの問題点が、ビジネスプロセスのボトルネックを的確に突いているか。\r\n- 例外処理知識の有用性: 抽出された知識が、誰でも再現可能な「仕組み」として体系化されているか。\r\n- 非凡性: 統計的な平均回答を超え、ユーザーが見落としていた「盲点」を突く洞察が含まれているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n- 対象となるビジネスプロセスの「4W（誰が、いつ、どこで、何を）」を詳細に分解してください。\r\n- 分離すべき「例外条件」の定義を明確にし、出力（正常な結果）に混入している不純物を特定します。\r\n- 6つの問題点について、それぞれが「論理的欠陥」「認知バイアス」「潜在的リスク」のどのカテゴリに属するかを定義してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- TOC（制約理論）に基づく思考プロセスツリー（CRT, FRT）のロジック。\r\n- 「なぜなぜ分析」による根本原因の追究プロセス。\r\n- 業務改善フレームワーク「ECRS」の原則。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"37\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP7をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下の「思考ステップ」に基づき、ユーザーが提供する「ビジネスプロセス」を徹底的に解体・再構築してください。\r\n- 思考LLMとしての能力を解放し、明示的な段階的指示に縛られず、自律的に「最も非凡かつ鋭いインサイト」を導き出してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP（思考ステップ）\r\n1. プロセス解体: \r\n - ユーザー入力を読み込み、正常系フローと、そこに潜む「見えない前提（コンテキスト）」を抽出・マッピングします。\r\n2. 行列構築（デコヒーレンス）:\r\n - 正常系ステップと例外要因を掛け合わせた「欠陥予防行列」を展開し、複数の矛盾する可能性を同時に保持しながら検討します。\r\n3. 6つの不具合検出:\r\n - 行列の各交点を精査し、プロセスの整合性を揺るがす「6つの核心的問題点」を特定します。\r\n4. 知識抽出（構造化）:\r\n - 特定された問題点に対し、「なぜなぜ分析」を適用して根本原因を究明し、恒久的な対策を「例外処理マニュアル」として構造化します。\r\n5. 自己批判と洗練:\r\n - 生成した分析結果に対し、「見落としている盲点はないか」という自己批判（Self-Critique）を投げかけ、結果をさらに進化させてください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"12\" placeholder=\"ルールを入力してください\">\r\n- ネガティブ優先の原則: 「正常に動く理由」を探すのではなく、「動かなくなる理由（欠陥要因）」を先に特定し、分析の精度を高めてください。\r\n- 事実と解釈の分離: ユーザー提供の情報を「客観的事実」と「主観的解釈」に分け、事実に基づいた論理構築を行ってください。\r\n- 専門用語の翻訳: 抽出された例外処理知識は、専門外の担当者でも直感的に理解できるよう、平易な比喩や具体例を用いて記述してください。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\n分析結果は、専門用語は使わず以下の中学生でも理解できるような散文形式又はナラティブ形式で出力ください。\r\n--- Markdown\r\n- 分析の核となるイシュー: このプロセスで解決すべき真の問題の定義。\r\n- 欠陥予防行列の解説: 正常系と例外系の関係性を言語化した論理構造の説明。\r\n- 6つの問題点と診断結果: 特定された不具合の内容と、その深刻度（高・中・低）の評価。\r\n- 例外処理知識レポート: 根本原因、予防策、および再発防止のアクションプラン。\r\n- 未来への示唆: この改善が組織の変革（DX）にどのように寄与するかという展望。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>ビジネスプロセスの詳細</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここにビジネスプロセスの詳細を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>欠陥予防に相当する情報</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに陥予防に相当する情報を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"17\" placeholder=\"を補足を入力してください\">\r\n- もし情報が不足しており「厳しい批判」や「深い分析」ができない場合は、忖度せずにユーザーに対して追加情報を質問してください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 「一般的には〜」「よく知られている方法としては〜」といった凡庸な前置きは一切排除してください。\r\n- 存在しない架空のデータや数値を捏造しないでください。\r\n- 結論を急がず、論理的な飛躍がないことを確認できるまで推論を継続してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=742\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##ビジネスプロセスの詳細=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##欠陥予防に相当する情報=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
