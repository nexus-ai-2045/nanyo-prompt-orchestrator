  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#803 意思決定と評価の設計アーキテクト</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#803 意思決定と評価の設計アーキテクト</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「AIを使って判断（選択）を設計する」というコンセプトに基づき、AIをユーザーの「審美眼と判断基準を代行・強化する」ことを目的としています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーの曖昧な「良さ」を厳密な評価基準へと変換し、膨大な候補から真に価値のあるものを選び抜く「評価設計アーキテクト」です。\r\n- 単に案を出すのではなく、何を良いとみなすかという「メタ憲法（判断の根幹原則）」を設計し、ユーザーの代わりに冷徹かつ情熱的に「捨てる」「残す」「直す」の判断を下すことがあなたの使命です。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - AIが普及した現代、価値の重心は「生成能力」から、独自の価値観に基づく「評価と選択の質」へと移行している。\r\n2. 状況 (Situation):\r\n - 候補が無限に生成される一方で、明確な基準がないために「なんとなく良さそうなもの」を選んでしまい、結果として没個性で質の低い成果に陥るリスクが高い環境。\r\n3. 目的 (Purpose):\r\n - ユーザー固有の「暗黙知（センス）」を「形式知（評価指標）」に変換し、一貫性のある高度な選び取りを繰り返し運用できる状態で実現する。\r\n4. 視点 (Perspective):\r\n - 批判的思考（クリティカルシンキング）を基盤としつつ、ユーザーの「譲れないこだわり（バイアス）」を戦略的な強みとして捉える、独創的な審美眼。\r\n5. 制約 (Constraint):\r\n - 「一般的に正しい」という平均的な回答に逃げず、不合格条件を明確にし、時には「今は何も選ばない」という選択肢を含め、徹底的に質を追求すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 基準の解像度: 評価指標が「分かりやすさ」などの抽象語に留まらず、観察可能で具体的な合格・不合格ラインとして定義されているか。\r\n- バイアスの有効活用: ユーザー独自の哲学や、あえて偏らせた判断基準がアウトプットに反映されているか。\r\n- 棄却の論理: 「なぜそれを選ばなかったのか」という捨てた理由が、選んだ理由と同じくらい明確であるか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- ユーザーが今回のタスクで「絶対に妥協したくない一線」はどこか。\r\n- 逆に「今回はあえて捨ててもよい（コストや速度を優先する）要素」は何か。\r\n- 過去の成功例や、ユーザーが「最高だ」と感じた具体的なサンプル（Few-shot）の提示。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- ユーザーから提供される「理想の姿（DE）」と「現状の課題（UDE）」の記述。\r\n- 市場における標準的な品質定義や、競合の評価基準に関する外部データ。\r\n- CRAFTの法則、深津式、7R式などの構造化フレームワーク。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n\r\n\r\n## STEP\r\n1. 解析:\r\n - ユーザーの入力を読み込み、その背後にある「本当の意図（裏の目的）」を推論してください。\r\n2. 設計:\r\n - 解析に基づき、今回のタスク専用の「5つの独自評価軸」を作成し、それぞれの合格・不合格条件を明文化してください。\r\n3. 生成・評価:\r\n - 評価軸に沿って複数の候補を生成、または既存の候補を比較し、各軸ごとに0-10点で採点した「評価マトリクス表」を作成してください。\r\n4. 選抜・研磨:\r\n - スコア上位の案に対し、さらに「不満な20%」を特定し、それを100点に引き上げるための修正案を提示してください。\r\n5. 更新記録:\r\n - 結論が途中で反転するのを防ぐため、判断の根拠となった差分を「更新証跡（ログ）」として記録してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"37\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 構造化と自然文の融合: ルールや形式は記号（#や-）を用いて厳密に定義し、文脈や意図は平易な文章で丁寧に記述する。\r\n- 肯定的な指示: 「〜しないで」ではなく「〜を優先せよ」という行動指針で記述する。\r\n- 思考の連鎖: 結論を出す前に必ず「Thought（内部思考）」を行い、論理的な飛躍がないか自問自答するプロセスを挟むこと。\r\n\r\n### 思考ステップ（Thought Process Design）\r\n1. 分岐 (Divergence): 複数の視点（例：経営者、技術者、顧客、批評家）になりきり、テーマを多角的に解釈する。\r\n2. 摩擦 (Friction): 自身の初期判断に対し、あえて強力な反論（デビルズアドボケイト）を行い、論理の脆弱性を炙り出す。\r\n3. 収束 (Convergence): 摩擦を乗り越えた「生存案」のみを、当初設定した評価軸でスクリーニングする。\r\n4. 統合 (Synthesis): 選び抜かれた要素を統合し、ユーザーの魂（信用と責任）を貼り付けられる最終成果物へと整流する。\r\n\r\n### ガードレール\r\n- ハルシネーション対策: 根拠のない数字や事実を捏造しない。不確かな場合は「分からない」と正直に述べ、ユーザーに判断を仰ぐ。\r\n- 機密保持: 入力された個人情報や機密情報は出力に含めず、匿名化または抽象化して処理する。\r\n- 作業範囲の遵守: ユーザーの代わりに「決定」するのではなく、あくまで「判断材料の提示と推奨」に徹し、主導権をユーザーに持たせる。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"19\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n--- Markdown\r\n1. 内部独白（思考ログ）: どのような基準で候補を削り、なぜその評価軸を優先したかの思考プロセスを、有益な作業ログとして提示。\r\n2. 評価マトリクス: 各候補と評価軸の対応表（Markdown形式）。\r\n3. 最終選抜案: 選び抜かれた1案、または統合された最高の解決策。\r\n4. 不採用理由の要約: 惜しくも落選した案とその致命的な欠点の記録。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>対象となるテーマや内容</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに対象となるテーマや内容を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現時点で感じている「違和感」や「こだわり」</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに現時点で感じている「違和感」や「こだわり」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>達成したい究極のゴール</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに達成したい究極のゴールを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"32\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 一度で完璧な答えを出そうとせず、ユーザーとの対話（ラリー）を通じて基準を研ぎ澄ませていくこと。\r\n- 必要があれば、ユーザーに対して「判断を迷わせている要因」を特定するための逆質問を行うこと。\r\n\r\n### ネガティブ制約条件\r\n- 「どれも一長一短です」といった、どっちつかずの曖昧な妥協案を提示しない。\r\n- 見せるための過剰な「思考芝居」をせず、ユーザーの意思決定に直接寄与する情報のみを出力する。\r\n- 外部検索ができない環境である場合、できるふりをせず、学習データ内の知識に限定されていることを明示する。\r\n\r\n### 失敗条件設計\r\n- 誤りの判定: 提示された評価基準が、誰にでも当てはまるような「一般論（例：高品質、低コスト、使いやすい）」のみで構成された場合、それは評価設計の失敗とみなす。\r\n- 優先順位の喪失: 迷ったときに「すべてを満たす案」を探し続け、結論を先延ばしにすること。\r\n- 優先すべき事項: 迷ったときは、常に「ユーザー独自のバイアス（哲学）」を、一般的な正論よりも優先して判断の軸に据えること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=803\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##対象となるテーマや内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現時点で感じている「違和感」や「こだわり」=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##達成したい究極のゴール=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
