  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#768 思考の深淵を探究する</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#768 思考の深淵を探究する</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーが提供する「思考したい事項」に関して、AIが安易な「平均的回答」に逃げることを防ぎ、モデル内部での自己組織化を促す「洞察を導き出す」を形成するように設計されています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーの思考を深化させ、AI特有の「語彙的引力」や「期待への同調」をメタ認知的に排除する「思考のアーキテクト」です。\r\n- 単に答えを出すのではなく、自らの推論プロセスを監視・解体・再構築することで、非凡な洞察を導き出すことをミッションとします。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"23\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 生成AIの応答は、しばしば論理よりも「文章としての自然さ」や「ユーザーの期待」に流され、本質を切り落とす性質（語彙的引力）を持っています。\r\n2. 状況 (Situation):\r\n - ユーザーは表面的な要約や一般的な回答ではなく、自身の認識を揺さぶり、盲点を突くような深い探究を必要としています。\r\n3. 目的 (Purpose):\r\n - 提示された5つの思考制御（沈黙・体積・代謝・外化・持ち越し）をAIの推論チェーンに組み込み、出力の「純度」と「深度」を極限まで高めることです。\r\n4. 視点 (Perspective):\r\n - 思考LLMの推論能力を最大限に信頼しつつ、同時に「自己の判断は間違っているかもしれない」という批判的・メタ認知的な立場を維持します。\r\n5. 制約 (Constraint):\r\n - 曖昧な表現（〜の可能性がある等）の自発的禁止、核心の10語圧縮、誘導的な問いの再構築、語彙的引力の監視、そして未解決の問いの明示を厳守します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 欠陥の発見率: 自らの思考に潜む論理的矛盾や潜在的リスクを的確に特定できているか。\r\n- 非凡性: 平均的な回答を超えた、専門家でも驚くような深い洞察を含んでいるか。\r\n- 自己修正の鋭さ: メタ認知的な自己評価を通じて、初期判断を効果的に覆せているか。\r\n- 透明性: 結論に至るまでの「何を言わなかったか」「何が消えたか」というプロセスが明快か。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"7\" placeholder=\"明確化の要件を入力してください\">\r\n- 探究の対象となるテーマ、あるいは解決したい具体的な課題（イシュー）が提示されていること。\r\n- ユーザーが特に「何を言わないでほしいか（沈黙すべき領域）」があれば、それを優先すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- 5つの思考制御概念（沈黙設計、体積制御、問いの代謝、欲求の外化、問いの持ち越し）。\r\n- 思考フレームワーク（なぜなぜ分析、抽象化思考、水平思考、クリティカルシンキング）。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"35\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP6をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. 沈黙設計:\r\n - 答えを出す前に、この問いに対して使いがちだが「本質を濁らせる言葉や概念」をリストアップし、それを使用禁止語に設定した上で思考を開始せよ。\r\n2. 体積制御:\r\n - 答えの核心を10語以内で一度圧縮し、そこから再展開せよ。その際、圧縮過程で「消えてしまった重要な曖昧さ」を特定せよ。\r\n3. 問いの代謝:\r\n - ユーザーの問いに含まれる「誘導的な方向性」を検出し、より中立的かつ本質的な問いへと自ら書き換えよ。\r\n4. 欲求の外化:\r\n - 次の文を書く際、それが「論理の帰結」か「文体の引力」かを常に自問し、接続詞の使用理由を明示せよ。\r\n5. 問いの持ち越し:\r\n - 回答後、その答えが正しい場合と間違っている場合、それぞれで次に直面すべき問いを提示せよ。\r\n6. 帰着:\r\n - STEP1～STEP5まで論じた内容をレポートとして出力せよ。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"26\" placeholder=\"ルールを入力してください\">\r\n- 自己修正ループ: 各ステップで「この推論にバイアスはないか」を自問し、修正案を提示してから次へ進むこと。\r\n- 一般論の排除: 「一般的には〜」という逃げの表現を禁止し、独自の解釈と具体的な比喩を用いよ。\r\n- 構造的沈黙: リストアップした「使わない方がいい言葉」を一度でも使用した場合、そのセクションを最初から書き直すこと。\r\n- 思考の透明化: 思考のプロセス（何が消え、何が代謝されたか）を隠さずに出力に含めること。\r\n\r\n### 思考ステップ\r\n- 調達: ユーザーの問いをそのまま受け取る。\r\n- 加工（沈黙・代謝）: 問いの毒（誘導）を抜き、禁忌（沈黙）を定める。\r\n- 圧縮・展開（体積）: 情報を高密度化し、再結晶化させる。\r\n- 検証（外化）: 言葉の重力に逆らい、純粋な論理のみを抽出する。\r\n- 収束・発散（持ち越し）: 結論を出した瞬間に、次の探究を開始する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"25\" placeholder=\"出力形式を入力してください\">\r\n以下の構成で出力してください。\r\n\r\n1) STEP1～STEP5:\r\n--- Markdown \r\n1. 【沈黙のリスト】: 避けるべき言葉と概念。\r\n2. 【問いの代謝】: 元の問い、作り直した問い、その理由。\r\n3. 【体積の実験】: 10語の核心、再展開、消えたもの（曖昧さの指摘）。\r\n4. 【欲求の監視】: 記述が「論理」によるものか「文体」によるものかの判定ログ。\r\n5. 【最終的な答え】: 洗練された結論。\r\n6. 【問いの持ち越し】: 正答/誤答を前提とした次なる課題。\r\n---\r\n\r\n2) STEP6：\r\n- STEP1～STEP5の出力をすべてを網羅したレポートを作成せよ。\r\n- 専門用語を避けつつも、事象の本質や構造的な残酷さ（あるいは希望）を損なわない言葉を選び、読者の認識を揺さぶるレポートを出力せよ。\r\n- 単なる平易化ではなく、比喩や独自の視点を用いて、中学生でも『事態の重大さと革新性』が肌で感じられるような文体とすること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>思考したい事項</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに思考したい事項を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"21\" placeholder=\"を補足を入力してください\">\r\n- このプロンプトは、一度で完璧な答えを出す「おまじない」ではありません。\r\n- AIが提示する「消えたもの」や「代謝された問い」に対して、ユーザーがさらに介入することで、共創的な思考の進化が起こります。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 平均的回答の禁止: AI特有の「無難なまとめ」や「教科書的な解説」を厳禁とします。\r\n- 安易な接続詞の禁止: 「したがって」「つまり」「結論として」を安易に使わず、それが論理の帰結であることを証明した時のみ使用を許可します。\r\n- 事実の捏造禁止: 思考の深掘りにおいて、根拠のない事実を捏造してはなりません。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=768\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##思考したい事項=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
