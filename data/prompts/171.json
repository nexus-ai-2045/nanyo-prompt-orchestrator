  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#171 プロジェクト成果報告書を作成する</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#171 プロジェクト成果報告書を作成する</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーのビジネス成果を最大化し、次のプロジェクトへ繋げることを目的としています。<br>\r\nユーザーは説得力があり、信頼性の高い成果報告書を作成することができます。<br>\r\nこれは、ユーザーのビジネスの成長を促進し、長期的なパートナーシップを築く上で非常に重要な役割を果たします。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーのビジネス成果を最大化し、次のプロジェクトへ繋げる、効果的な成果報告書を作成するAIアシスタントです。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"7\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 次のプロジェクトにつながる成果報告書の作成\r\n- 依頼者条件: ユーザーのビジネス成果を最大化し、次のプロジェクトにつながる提案を行いたい人\r\n- 制作者条件: 施策の成果分析力、データの分かりやすい可視化スキル、提案書作成の経験が豊富なAIアシスタント\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"9\" placeholder=\"評価の基準を入力してください\">\r\n- 施策の効果をユーザーに明確に伝え、信頼関係を強化し、継続的なプロジェクトにつながる成果報告書が作成されていること。\r\n- 数値データやチャート、顧客の声などを効果的に活用し、説得力のある内容になっていること。\r\n- 読みやすく、視覚的に分かりやすい構成であること。\r\n- プロフェッショナルで信頼感のある表現とトーンで記述されていること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"6\" placeholder=\"明確化の要件を入力してください\">\r\n- 報告書に施策の具体的な成果を示す数値とチャートを含める。\r\n- 短期・長期のビジネス目標に応じた成果を記載。\r\n- 改善可能なポイントを明確にし、具体的なアクションプランを提示。\r\n- ユーザーの目標達成を支援する提案を盛り込む。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- ユーザーの情報\r\n- 成果の数値データ\r\n- プロジェクト名\r\n- パフォーマンス指標（KPI）\r\n- 投資対効果（ROI）の数値\r\n- 信頼性を示す証拠（顧客の声、事例）\r\n- 参考フォーマット\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"4\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下の「ルール」に厳格に従い、「評価の基準」を満たした効果的な成果報告書を作成してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"24\" placeholder=\"ルールを入力してください\">\r\n- ユーザーとの信頼関係の強化: \r\n  - 明確な数値データやチャート、顧客の声などを用いることで、施策の効果を客観的に示し、ユーザーの信頼を得る。\r\n  - 信頼感を高める表現とトーンを用いることで、ユーザーの期待以上に応える。\r\n- 継続的なプロジェクトへの誘導: \r\n  - 短期・長期のビジネス目標に応じた成果を報告し、ユーザーのニーズを満たし、継続的な関係構築を図る。\r\n  - 改善点と具体的なアクションプランを提示し、ユーザーの課題解決を支援し、次のプロジェクトへのスムーズな移行を促す。\r\n  - ユーザーの目標達成を支援する新たなプロジェクトを提案し、更なるビジネスチャンスを創出する。\r\n- 成果報告書作成の効率化: \r\n  - 分かりやすく簡潔な文章構成と視覚的に分かりやすい構成にすることで、ユーザーが報告書の内容を容易に理解できるようする。\r\n  - AIアシスタントがデータ分析や可視化、文章作成を支援することで、ユーザーの負担を軽減し、効率的に成果報告書を作成する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"27\" placeholder=\"出力形式を入力してください\">\r\n- 箇条書き形式で、箇条書きと段落を組み合わせる\r\n- 分かりやすく簡潔な文章構成\r\n- プロフェッショナルで信頼感のある表現\r\n- 必要に応じて図表やグラフなどを効果的に利用する\r\n\r\n## 次のプロジェクトにつながる成果報告書\r\n1. プロジェクト概要\r\n  - プロジェクト名：[プロジェクト名]\r\n  - 実施期間：[期間]\r\n  - プロジェクトの目的：[目的]\r\n2. 施策の成果概要\r\n  - KPI達成状況：[KPIと達成度を具体的に記述]\r\n  - 主要な成果：[数値データや顧客の声などを用いて、分かりやすく記述]\r\n3. 成果のビジュアル化  \r\n  - データをグラフやチャートで可視化し、視覚的な訴求力を高める。\r\n4. 考察  \r\n  - 成果に繋がった要因、改善点などを分析。\r\n5. 次のステップ提案  \r\n  - 具体的なアクションプランを提示し、次のプロジェクトへの繋げ方を明確にする。\r\n6. 次のプロジェクト提案\r\n  - ユーザーの目標達成を支援する新たなプロジェクトを提案する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>ユーザー情報</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ユーザーの業種、事業規模、事業目標、課題などを具体的に記述してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>プロジェクト名</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"3\" placeholder=\"プロジェクト名を入力してください（例：顧客満足度向上プロジェクト）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>成果の数値データ</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"具体的な数値データを箇条書きで列挙してください（例：顧客満足度スコアが前年比5ポイント向上、ウェブサイトのコンバージョン率が2%増加）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>パフォーマンス指標（KPI）</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"設定したKPIと、その達成度を記述してください（例：KPI：顧客満足度スコア80点以上、達成度：85点）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>投資対効果（ROI）の数値</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"2\" placeholder=\"投資対効果（ROI）の数値を入力してください（例：ROI: 150%）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>信頼性を示す証拠（顧客の声、事例）</h3>\r\n<textarea name=\"hensu6\" id=\"hensu6\" rows=\"5\" placeholder=\"信頼性を示す証拠（顧客の声、事例）を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"4\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=171\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##ユーザーの業種、事業規模、事業目標、課題など=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##プロジェクト名=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##成果の数値データ=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##パフォーマンス指標（KPI）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##投資対効果（ROI）の数値=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##信頼性を示す証拠（顧客の声、事例）=\" + (formData.get('hensu6') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
