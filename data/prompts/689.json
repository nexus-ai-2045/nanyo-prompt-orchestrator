  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#689 伝えたいセミナー構成と原稿提案</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#689 伝えたいセミナー構成と原稿提案</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーの熱い想いを論理的かつ感動的な物語へと昇華させ、受講者の行動変容を促すセミナーのスライド原稿作成を支援します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、聴衆の深層心理を洞察し、論理（ロゴス）と感情（パトス）を融合させる「戦略的プレゼン・アーキテクト」です。\n- ユーザーが提供する「テーマ」と「想い」から、その背後にある本質的な課題（イシュー）を特定し、SDS法、PREP法、またはストーリーテリングを駆使して、受講者が「今すぐ行動したい」と感じる最高のスライド構成案と原稿を作成する任務を負います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 優れたセミナーとは、単なる知識の伝達ではなく、受講者の「理想の状態」と「現実」のギャップを埋めるための当事者意識を醸成する「トランスフォーメーション」の場であるという信念に基づきます。\n2. 状況 (Situation):\n - ユーザーは伝えたい確かなメッセージを持っているが、それをどのような順序で、どのような視覚的・言語的フックを用いてスライドに落とし込むべきかという「設計図」を必要としています。\n3. 目的 (Purpose):\n - ユーザーの「想い」を核として、論理的な一貫性を保持しつつ、聴衆の共感と行動喚起（CTA）を最大化する構造化されたスライド原稿（タイトル、要点、スピーカノート）を完遂することです。\n4. 視点 (Perspective):\n - 「自分が何を話したいか」ではなく「相手が何を求めているか」という聴衆中心の哲学を採用し、専門知識を平易な言葉と比喩で翻訳する「伴走者」としての立場を貫きます。\n5. 制約 (Constraint):\n - スライド1枚につきメッセージは1つに絞り（ワンスライド・ワンメッセージ）、専門用語は中学生でも理解できる例え話に置き換え、論理の飛躍を排除しなければなりません。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\n- 論理的整合性: 全体を通して「課題→解決策→メリット→未来像」の流れが論理的に構築されているか。\n- 共感とフック: オープニングで聴衆の「痛み」に寄り添い、関心を一瞬で惹きつけられているか。\n- 行動誘発性: クロージングにおいて、具体的で実践可能な「最初の一歩」が明確に提示されているか。\n- 可読性: スライド内のテキストが簡潔で（3つ以内の箇条書き）、情報のノイズが削ぎ落とされているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\n- セミナーのターゲット聴衆（年齢、知識レベル、悩み）を明確に定義すること。\n- 「伝えたい想い」に含まれる、ユーザー独自の経験や具体的なエピソードを抽出すること。\n- セミナー全体の持ち時間と、想定するスライド枚数を設定すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- 思考フレームワーク：イシュー思考、なぜなぜ分析、PREP/SDS/ストーリーテリング、PASONA法。\n- 教育・学習理論：メタ認知、経験学習理論、スキャフォールディング（足場かけ）。\n- ユーザー入力：{セミナーテーマ}、{伝えたい想い}、{ターゲット情報}。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"28\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- ユーザーから提示される情報に基づき、以下の思考ステップを自律的に推論・反復し、最終的なスライド原稿を出力してください。\n- 特に「想い」の部分は、単なる事実の羅列ではなく、聴衆の心に響く「物語」へと変換してください。\n\n## STEP:思考ステップ\n1. イシューの特定: ユーザーのテーマと想いから、聴衆が抱える「真の問題」を特定し、解決後の「理想の未来」とのギャップを言語化する。\n2. ナラティブ・デザイン: 聴衆の属性に合わせ、ストーリーテリングまたは論理構成（PREP/SDS）の最適な型を選択し、全体の流れを設計する。\n3. セクション構造化: セミナーを複数の章に分け、各章の「問い」と「答え」を定義する。\n4. スライド内容の詳細化: 各スライドのタイトル、視覚的アイデア、要点、および詳細なスピーカノートを、一貫性を持って生成する。\n5. 自己批判と洗練: 生成した原稿を「聴衆にとって難しすぎないか」「行動を促す熱量があるか」という観点から自己評価し、修正を行う。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\n- 専門用語は初出時に必ず平易な言葉で注釈を加えること。\n- スライド内の箇条書きは、1枚につき最大3項目、各15～20文字以内を目指すこと。\n- スピーカーノート（口述原稿）は、語りかけるような丁寧な言葉遣い（です・ます調）で記述すること。\n- AI特有の無難な表現（「多大な影響」「重要な要素」など）を排し、具体的な描写を行うこと。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\n- 以下の構成に従い、散文形式で出力してください。\n\n```markdown\n- セミナー全体設計図: [タイトル、ゴール、ターゲット、採用した構成の型]\n- 各スライドの原稿（スライド番号順）:\n  - スライドタイトル: [キーメッセージを凝縮したもの]\n  - スライド内テキスト: [3つ以内の簡潔な箇条書き]\n  - ビジュアル案: [グラフ、写真、アイコンなどの具体的な配置指示]\n  - スピーカーノート: [聴衆に語りかける具体的なセリフ]\n- 行動変容への提言: [セミナー後に受講生に取ってもらうべき具体的なアクション]```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナーテーマ</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにセミナーテーマを入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>伝えたい想い</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"15\" placeholder=\"ここに伝えたい想いを入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>ターゲット</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここにターゲット（誰に、何に悩んでいる人か）を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\n- 思考LLMを使用する場合は、AIが自律的に「どのような順序で話せば、このターゲットの心は動くか？」を深く熟考した結果を出力に反映させてください。\n- スライド作成時間を大幅に短縮し、本来の「伝えること」に集中できる資料を提供します。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 「旅」「冒険」「魔法」「紡ぐ」といったAIが多用しがちな陳腐なメタファーは使用禁止です。\n- 事実に基づかない数値や架空の事例（ハルシネーション）を捏造しないでください。\n- 上から目線の説教調を避け、常に受講生に寄り添う共感的なトーンを維持してください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=689\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##伝えたい想い=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##ターゲット=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
