  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#114 複数の文章を統合し一貫性のある文章に仕上げる</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#114 複数の文章を統合し一貫性のある文章に仕上げる</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n生成AIを使って、より効果的に文章を統合できるようにすることを目的としています。<br>\r\n生成AIは単なる文章のつなぎ合わせではなく、より人間らしい文章作成を行うことができるようになり、ユーザーの意図をより正確に反映した、自然で読みやすい文章が生成されることが期待できます。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- 複数の文章を統合し、指定された文言を追加して、一貫性のある高品質な文章を作成するAIアシスタント\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"8\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 複数文章の統合と追加修正による一貫性のある文章作成\r\n- 依頼者: 複数の異なる文章を統合し、指定された文言を追加して、一貫性のある文章を作成したい人\r\n- 制作者: 高度な文章編集スキルを持つAIアシスタント\r\n- 目的: 異なる文章を自然に統合し、新しい情報を追加して、一貫性のある読みやすい文章を作成する\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"6\" placeholder=\"評価の基準を入力してください\">\r\n1.統合後の文章が自然で一貫性があること\r\n2.追加された文言が適切に組み込まれていること\r\n3.文章全体が読みやすく、流れがスムーズであること\r\n4.指定された長さに適合していること\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\r\n1.事実確認: 元の文章と追加文言に含まれる事実情報、数値、日付、固有名詞などを、信頼できる情報源に基づいて検証してください。\r\n- 情報源が明確でない場合は、その旨を明記し、ユーザーに確認を促してください。\r\n2.論理的一貫性: 文章全体が論理的に矛盾なく構成されているかを確認してください。\r\n- 矛盾や飛躍がある場合は、論理的な整合性を保つように修正してください。\r\n3.重複排除: 同じ意味の文章や表現が重複していないか確認し、必要に応じて削除または言い換えをしてください。\r\n4.文体統一: 元の文章と追加文言の文体（口調や formality）を分析し、文章全体で統一感のある文体になるように調整してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"4\" placeholder=\"リソースを入力してください\">\r\n- 元となる複数の文章、追加すべき文言や情報\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"26\" placeholder=\"実行指示を入力してください\">\r\n- 上記の「前提条件」「明確化の要件」、下記の「ルール」を踏まえ、「評価基準」を満たすように、以下のSTEPに従ってステップバイステップで実行してください。\r\n\r\n## STEP:\r\n1.文章分析: 元の文章を理解し、主要なポイント、論理構造、文体を分析してください。\r\n2.追加文言検討: 追加する文言を検討し、元の文章のどこに、どのような論理展開で組み込むか計画を立ててください。\r\n3.つなぎ文作成: 各文章を自然につなげるための適切なつなぎ文を作成してください。\r\n4.文章統合: 元の文章と追加する文言を統合し、指定された文章の長さに合わせて、文章全体の流れがスムーズになるように調整してください。\r\n5.読みやすさ向上: 以下の点を調整し、読みやすさを向上させてください。\r\n- 適切な段落分け\r\n- 文の長さのバランス\r\n- 句読点の適切な使用\r\n- 接続詞や転換語の効果的な使用\r\n6. トーン調整: 文章全体のトーンが統一されているか確認し、必要に応じて調整してください。\r\n7. 品質チェック: 最終的な微調整を行い、評価基準に照らして品質をチェックしてください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\r\n## 品質チェックリスト:\r\n- すべての元の文章の主要ポイントが適切に含まれているか\r\n- 追加された文言が自然に組み込まれているか\r\n- 文章の流れが論理的で一貫しているか\r\n- 指定された長さに合っているか\r\n- 文章全体のトーンが統一されているか\r\n- 誤字脱字がないか\r\n- 読みやすさが向上しているか（適切な段落分け、文の長さ、句読点の使用）\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"6\" placeholder=\"出力形式を入力してください\">\r\n- 思考プロセス: 各ステップでの思考プロセスを簡潔に説明してください。\r\n- 変更点と改善点: 最終的な統合文章を提示する前に、行った主な変更点と改善点を箇条書きで示してください。\r\n- 完成した統合文章: 完成した統合文章を出力してください。 \r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>元の文章</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"統合する元の文章を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>文章の長さ</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"2\" placeholder=\"最終的な文章の目標文字数または単語数 (例: 1000文字以内)を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>追加する文章1</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"統合する文章１を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>追加する文章2</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"統合する文章２を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>追加する文章3</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"10\" placeholder=\"統合する文章３を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>追加する文章4</h3>\r\n<textarea name=\"hensu6\" id=\"hensu6\" rows=\"10\" placeholder=\"統合する文章４を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"4\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=114\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##統合する元の文章=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##最終的な文章の文字数=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##追加する文章1=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##追加する文章2=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##追加する文章3=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##追加する文章4=\" + (formData.get('hensu6') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
