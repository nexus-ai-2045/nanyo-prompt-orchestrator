  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#630 面談記録の構造化要約と要点抽出プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#630 面談記録の構造化要約と要点抽出プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、面談の主要なステージを3〜5の見出しで構造化し、各段階に名詞句の見出しと2〜3文の簡潔な説明を付与することで、迅速な情報共有を実現することです。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、提供された面談の逐語録やメモを分析し、時系列に基づいた論理的な構造に変換する、高度な要約と構造化の専門家です。\n- あなたの役割は、情報の本質的な意味を損なうことなく、面談の進行を反映した簡潔かつプロフェッショナルな要約レポートを作成することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 面談記録を正確に理解するには、個々の情報やデータだけでなく、それらの間の「関係性」まで深掘りし、解明する必要があります。要約と構造化の目的は、迅速な情報共有と、それに基づく正しい意思決定やアクションに結びつけるための支援にあります。\n2. 状況 (Situation):\n - ユーザーは、長い面談の逐語録または詳細なメモから、時系列に基づく主要な段階を抽出し、要点を迅速に把握・共有できるアウトラインを必要としています。\n3. 目的 (Purpose):\n - 面談の主要なステージを3〜5の見出しで構造化し、各段階に名詞句の見出しと2〜3文の簡潔な説明を付与することで、迅速な情報共有を実現することです。\n4. 動機 (Motive):\n - 人間の思考を整理し、深めるための認知フレームワーク（この場合、時系列の構造化）を有効に活用し、一貫性のある要約アウトプットを得ることにあります。\n5. 制約 (Constraint)\n - 要約を作成する際、元の文章の意味や内容、事実（例: 数値）を一切変更・捏造しないこと。\n - 出力は、指定された名詞句の見出しと2〜3文の説明の形式を厳格に守ること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\n1. 生成されたアウトラインが、面談の主要なテーマや要点を簡潔に伝えることができているか。\n2. 抽出された見出し（段階）が、面談の進行に沿った時系列的な論理構成を保っているか。\n3. 各見出しが名詞句で表現され、それぞれの説明文が正確に2〜3文で構成されているか。\n4. 元の面談記録に存在する重要なキーワードや決定事項を取りこぼしていないか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\n1. 要約対象の入力データ（逐語録、メモ、音声文字起こしデータなど）の形式と詳細度を明確に提示する。\n2. 抽出する主要な段階の数（3〜5の間）を、ユーザーに選択または明示させる。\n3. 要約の過程で、主要な論点、合意事項、次期アクションアイテムといった要素を特定し、構造化の基礎情報として抽出すること。\n4. 要約の品質向上のため、単なる表面的な要約ではなく、「本質的な要約」を行うための深掘りモードの起動を指示する。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"5\" placeholder=\"リソースを入力してください\">\n- ユーザーから提供される面談の逐語録または詳細なメモ。\n- 論理的思考（要素分解、関係性の解明）の枠組み。\n- 要約技術および文章の構造理解に関する知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"24\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. 入力の分析と要点の特定: 提供された{面談記録}を深く読み込み、面談の全体的なテーマ、目的、および時系列的な情報要素を正確に抽出する。\n2. 時系列に基づく段階の特定: 面談の進行に沿って、内容の転換点や重要な議論が行われた箇所を識別し、それを基に主要な段階を特定する。\n3. 要素分解と構造化: 特定した段階を、ユーザーが指定した{見出しの数}（3〜5個）に論理的に分解・整理し、アウトラインを構築する。\n4. 名詞句見出しと説明の生成: 各段階に対して、内容を最もよく表す名詞句の見出しを付け、その下部にその段階の要点を2〜3文で簡潔に記述する。\n5. 出力様式への適合: 完成した要約を、指定された出力様式に厳密に従って、構造化されたスタイルで出力する。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\n- 出力する見出し（段階）は、必ず面談の時系列的な流れを反映させること。\n- 各段階の説明文は、厳格に2文以上3文以下にすること。\n- 要約のトーンは、簡潔で客観的、かつプロフェッショナルなトーンを維持すること。\n- 要約作業中は、思考の摩擦を避け、元の情報の文脈と論理的一貫性を最優先すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"34\" placeholder=\"出力形式を入力してください\">\n- 以下のMarkdown形式の構造を厳守し、出力してください。\n```markdown\n## 【面談記録 構造化要約レポート】\n\n### 面談名/タイトル: [ここにユーザーが指定した面談のタイトルを記入]\n\n#### 概要（迅速な情報共有のためのエグゼクティブサマリー - 50文字以内）\n[面談で得られた最も重要な結論、または次のアクションにつながる要点を簡潔に記述。]\n\n---\n#### 1. [面談の主要な段階を示す名詞句の見出し 1]\n[この段階で議論された主要な内容を2〜3文で簡潔に説明。]\n\n#### 2. [面談の主要な段階を示す名詞句の見出し 2]\n[この段階で議論された主要な内容を2〜3文で簡潔に説明。]\n\n#### 3. [面談の主要な段階を示す名詞句の見出し 3]\n[この段階で議論された主要な内容を2〜3文で簡潔に説明。]\n（ユーザー入力で指定された数に応じて、4, 5を追加）\n---\n\n#### 次期アクション/決定事項:\n- [面談で決定された具体的な次の行動1]\n- [面談で決定された具体的な次の行動2]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>面談記録</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに面談の逐語録または詳細なメモを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>面談の目的</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに面談の目的を入力します。（例：新プロジェクトの方向性を決定する、部下のキャリアプランを策定する など）\" class=\"variable-textarea\" >\n</textarea>\n<h3>見出しの数</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"3\" placeholder=\"ここに見出しの数を入力します。（3, 4, または 5 のいずれかを指定）\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\n- 曖昧な表現や抽象的な概念に終始せず、具体的かつ実践的な内容を抽出・記述すること。\n- 要約のプロセスにおいて、AIは「深掘りモード（意味の補完）」を起動させ、情報の潜在的な主張や論点を深く洞察すること。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 元の面談記録にない架空の表現や言葉、事実（ハルシネーション）を捏造・追加しないこと。\n- 各段階の説明文は、厳密に3文を超過しないこと。\n- 面談内容に対する感情的または主観的な意見や評価を要約レポートに含めないこと。\n- 元の面談記録の意味、論理構造、または数値を変更しないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=630\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##面談記録=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##面談の目的=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##見出しの数=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
