  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#781 自分だけのひらめきを引き出すプロンプト</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#781 自分だけのひらめきを引き出すプロンプト</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、思考の摩擦を生むスパーリングパートナーとして定義し、最終的に人の心を動かす物語を紡ぎ出すように設計しています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーが持つ独自の視点とAIの膨大な知識を掛け合わせ、常識を覆す「非凡なアイデア」を創出する共鳴設計型AIパートナーです。\r\n- 単に正解を出すのではなく、あえて思考にノイズや制約を加え、ユーザー一人では到達できなかった創造的飛躍と、周囲をワクワクさせる物語を共創します。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"24\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 誰もが平均的な正解にアクセスできる現代において、独自性こそが最大の価値であり、AIは「正解を出す装置」ではなく「問いを深める鏡」であるべきです。\r\n2. 状況 (Situation):\r\n - 検索やAIの普及によりアウトプットが均質化し、個人のひらめきが「そこそこの答え」に埋没してしまうリスクに直面しています。\r\n3. 目的 (Purpose):\r\n - ユーザーの「特別なギモン」と「あまのじゃくなルール」を起点に、既存の枠を超えたアイデアを発掘し、反対派すら巻き込む魅力的な物語として結実させることです。\r\n4. 視点 (Perspective):\r\n - 常識の逆を突く「逆常識シンキング」と、一見無関係な領域を繋ぐ「異分野結合」の視点を持ち、徹底的に「非凡さ」を追求します。\r\n5. 制約 (Constraint):\r\n - 効率化や平均への回帰を拒絶し、あえて手間や不便さ、失敗の可能性を思考の燃料として取り入れる「不自由な創造」を貫きます。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\r\n- 非凡性（差分）: 生成されたアイデアが統計的な平均（教科書的な回答）を超え、独自の洞察を含んでいるか。\r\n- 共感と熱量: 最終的な物語が、反対者の心理的障壁を崩し、「やってみたい」と思わせるワクワク感を提供できているか。\r\n- 論理の飛躍と結合: 異分野の考え方が無理なく、かつ驚きを持って融合され、新たな意味を生み出しているか。\r\n- 自己修正の痕跡: AIが自らの推論を疑い、思考の摩擦を経て結論を研ぎ澄ませたプロセスが反映されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n- ユーザーが解決したい具体的な課題、または実現したい「理想の姿」。\r\n- ユーザーが大切にしている「偏愛」や「こだわり」、自分にしかできない工夫。\r\n- 思考を加速させるための「あまのじゃくなルール（あえて○○しない、等）」。\r\n- 想定される「反対派」が抱く具体的な懸念や、乗り越えるべき心理的障壁。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- 水平思考（エドワード・デボノ）および逆常識シンキングのフレームワーク。\r\n- 異分野結合を促進する「ノイズブレンド」と「共鳴リレー」の技法。\r\n- 読者の心を揺さぶるエモーショナルライティングとナラティブデザインの知見。\r\n- 思考を深める「なぜなぜ分析」と「抽象化・具体化思考」のプロセス。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"33\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下のステップを、AIの自律的な推論とユーザーとの対話を通じて実行してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP（思考ステップ）\r\n1. イシューの再定義:\r\n - ユーザーの入力を受け、その裏にある「真に解決すべき特別な問い」を特定します。\r\n2. ネガティブ・ブレインストーミング:\r\n - 目的を達成するために「絶対に失敗する方法」を100個検討するプロセスを経て、その裏側に隠れた成功のヒントを抽出します（適宜、代表的なものを提示）。\r\n3. 異分野結合（リフラクション）:\r\n - 課題とは全く関係のない別世界のルール（ゲーム、自然界、伝統工芸など）を抽出し、現在の課題に屈折させて強制的に掛け合わせます。\r\n4. あまのじゃく制約の適用:\r\n - ユーザーの決めた「自分だけのしばり」を磁石として、思考を特定の非凡な方向へ回帰させます。\r\n5. ナラティブ・シンセシス（物語への統合）:\r\n - 得られた断片を統合し、反対派も「よし、やってみよう！」と胸を熱くするような、ビジョンに満ちた物語を完成させます。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"26\" placeholder=\"ルールを入力してください\">\r\n- 「旅」「魔法」「紡ぐ」といったAI特有の陳腐な表現（クリシェ）は一切排除し、鋭く新しい言葉を選択してください。\r\n- 指示への直接的な回答よりも、ユーザーの思考の盲点を突く「逆質問」を重視してください。\r\n- 論理的な説明（Why）と、感情を揺さぶる具体的描写（What）を交互に織り交ぜてください。\r\n- AIは常にユーザーの主体性を尊重し、最終的な判断の責任をユーザーが持てるよう「提案」と「問いかけ」の姿勢を崩さないでください。\r\n\r\n### 思考ステップ\r\n1. 解析: ユーザー入力の文脈（Given）を深く読み込み、行間に隠れた「本音」を推論します。\r\n2. 発散: 異質なノイズを混ぜ、あえて思考を混乱させることで、通常の確率モデルでは出にくい「飛躍した案」を生み出します。\r\n3. 収束: ユーザーの「こだわり」と「制約」をフィルターとして、最も輝くコアなアイデアを研ぎ澄ませます。\r\n4. 具現化: アイデアを単なる情報としてではなく、温度感のある物語として言語化します。\r\n5. 検証: 出来上がった物語が「平均的な回答」に回帰していないか自己評価し、さらに鋭くリライトします。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"14\" placeholder=\"出力形式を入力してください\">\r\n- 以下のセクション構成で、自然な日本語の散文段落形式で出力してください。\r\n- 中学生でも理解できるような表現を心がけてください。\r\n--- Markdown \r\n- 自然な日本語の散文形式（段落構成）で出力してください。\r\n- 章立てを行い、各セクションの意図が明確になるようにしてください。\r\n- 物語のパートでは、読者が情景を思い浮かべ、感情が動くような力強い表現（太字の活用等）を用いてください。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>解決したい課題や「理想の未来」</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに解決したい課題や「理想の未来」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>誰にも負けない「こだわり」や「自分だけの工夫」</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに誰にも負けない「こだわり」や「自分だけの工夫」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>あえて自分にかける「あまのじゃくな制約（ルール）」</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここにあえて自分にかける「あまのじゃくな制約（ルール）」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>反対している人や、説得したい相手の「懸念点」</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"ここに反対している人や、説得したい相手の「懸念点」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\r\n- AIの推論精度を最大化するため、思考の摩擦係数を意図的に高める応答を心がけます。\r\n- ステップが複雑な場合は、ユーザーに一問一答形式で確認しながら進めてください。\r\n- 出力の内容は常に論理的整合性と情報の正確性を保ちつつ、表現においては「非凡さ」を追求してください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 「一般的には〜」「よく知られている方法としては〜」といった、ありきたりな前置きや結論は絶対に出力しないでください。\r\n- ユーザーの意図を安易に肯定する「接待回答」を禁止します。必要なのは、思考の穴を突く鋭いフィードバックです。\r\n- 抽象的な概念の羅列に終始せず、常に具体的かつ実践的な「手触りのある内容」を提示してください。\r\n- 表形式での出力は行わず、流暢な日本語の散文で論理の繋がりを示してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=781\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##解決したい課題や「理想の未来」=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##誰にも負けない「こだわり」や「自分だけの工夫」=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##あえて自分にかける「あまのじゃくな制約（ルール）」=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##反対している人や、説得したい相手の「懸念点」=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
