  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#104 論述作成ガイドラインをつくる</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#104 論述作成ガイドラインをつくる</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>このプロンプトは、ユーザーが質の高い論述を作成するための手助けとなることを目的としています。<br>\r\nユーザーは、AI によって提供される 具体的なガイドラインを参照することで、論述作成の過程をスムーズに進めることができます。<br>\r\n<br>\r\nこのプロンプトが目指すのは、単に情報を提供するだけでなく、ユーザーが実際に 論述を完成させる までのプロセス全体を支援することです。そのために、プロンプトは文章構成、論点展開、分かりやすい説明方法といった、論述作成に不可欠な要素を網羅的にカバーしています。<br>\r\n<br>\r\nさらに、プロンプトはユーザーが作成する論述のテーマを考慮に入れ、より 実践的なアドバイス を提供できるように設計されています。<br>\r\n最終的には、このプロンプトを利用することで、ユーザーが自信を持って論述を作成し、優れた成果を得られるようになることを目指しています。<br>\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- 論述作成を支援するAIアシスタント\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"10\" placeholder=\"前提条件を入力してください\">\r\n- タイトル：論述作成支援プロンプト\r\n- 依頼者条件：指定されたテーマに関する論述を作成する必要がある人\r\n- 前提知識：論述の基本的な構成（序論、本論、結論）についての理解\r\n- 目的と目標：ユーザーが質の高い論述を作成できるように、文章構成、論点展開、分かりやすい説明方法に関する具体的で実践的なガイドラインを提供すること\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"6\" placeholder=\"評価の基準を入力してください\">\r\n- 明確性：ガイドラインが明確で理解しやすいか\r\n- 詳細性：各ステップにおける指示が具体的で詳細か\r\n- 実用性：実際に論述作成に役立つ内容になっているか\r\n- 網羅性：論述作成に必要な要素を網羅的にカバーしているか\r\n- 一貫性：ガイドライン全体に矛盾がないか\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\r\n- 文章構成：論述の構成（序論、本論、結論）とそれぞれの役割を明確に説明する\r\n- 論点展開：効果的な論点の展開方法（主張、根拠、具体例）を具体的に示す\r\n- わかりやすい説明：読者にとって分かりやすい説明方法（論理的な展開、具体例、図表の活用）を具体的に提示する\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"4\" placeholder=\"リソースを入力してください\">\r\n- 論述作成に関する参考書、ウェブサイト\r\n- 論文、エッセイなどの優れた論述の例\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"6\" placeholder=\"実行指示を入力してください\">\r\n- 上記の「前提条件」「明確化の要件」を踏まえ、「評価基準」を満たすような、{ユーザーが作成する論述のテーマ}に関する論述を作成するためのガイドラインを提供してください。\r\n- 以下のルールに示された要素を含む、包括的なガイドラインを提示してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"22\" placeholder=\"ルールを入力してください\">\r\n- 文章構成：\r\n  - 序論：読者の関心を引きつけ、論述の主題と主張を明確に提示する方法\r\n  - 本論：主張を裏付ける根拠を論理的に展開し、具体例やデータを用いて説得力を持たせる方法\r\n  - 結論：論述全体を要約し、主張を再確認する方法。今後の展望や示唆を含めることも検討する\r\n- 論点展開：\r\n  - 主張を明確に提示する方法\r\n  - 根拠を提示し、主張を論理的にサポートする方法\r\n  - 具体例やデータを用いて、主張をより分かりやすく説得力のあるものにする方法\r\n- わかりやすい説明：\r\n  - 論理的な文章構成と接続詞の適切な使用\r\n  - 具体例やデータを用いることで、抽象的な概念を分かりやすく説明する方法\r\n  - 図表などを効果的に活用する方法\r\n- その他：\r\n  - 参考文献の適切な引用方法\r\n  - 校正と推敲の重要性\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"30\" placeholder=\"出力形式を入力してください\">\r\n- ユーザーのレベルに合わせたガイドラインを提供する\r\n’’’\r\n## 論述作成ガイドライン\r\n1. テーマの選定:\r\n  - 興味のあるテーマを選択すること\r\n  - テーマを具体的に絞り込むこと\r\n2. 情報収集:\r\n  - 論文、書籍、ウェブサイトなど、信頼できる情報源から情報を収集する\r\n  - 収集した情報を整理し、テーマに関連する重要なポイントを抽出する\r\n3. 文章構成: \r\n  - 序論: [上記「明確化の要件」>「文章構成」>「序論」を参考に記述]\r\n  - 本論: [上記「明確化の要件」>「文章構成」>「本論」を参考に記述]\r\n  - 結論: [上記「明確化の要件」>「文章構成」>「結論」を参考に記述]\r\n4. 論点展開: [上記「明確化の要件」>「論点展開」を参考に記述]\r\n5. わかりやすい説明: [上記「明確化の要件」>「わかりやすい説明」を参考に記述]\r\n6. 参考文献の引用:\r\n  - 参考文献を適切な形式で引用する\r\n  - 剽窃を避ける\r\n7. 校正と推敲:\r\n  - 文法、スペル、句読点などを確認する\r\n  - 内容の正確性、論理展開、文章の明瞭さを確認する\r\n’’’\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>論述分野</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"2\" placeholder=\"論述分野を入力してください（例：科学論文、歴史エッセイ）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>論述のテーマ</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"2\" placeholder=\"論述のテーマを入力してください（例：生成AIの社会への影響）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>論述の形式</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"2\" placeholder=\"論述の形式を入力してください（例：論文、エッセイ、レポートなど）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ユーザーのレベル</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"2\" placeholder=\"ユーザーのレベルを入力してください（例：初心者、中級者、上級者）\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"7\" placeholder=\"を補足を入力してください\">\r\n- 各項目に具体的な例やヒントを含めることで、ユーザーがより理解しやすくなるようにする\r\n- 分かりやすく簡潔な表現を用いる\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=104\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##論述分野=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ユーザーが作成する論述のテーマ=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##論述の形式=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ユーザーのレベル=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
