  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#616 セミナー集客のための高反応メールマガジン作成</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#616 セミナー集客のための高反応メールマガジン作成</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、お客様が求める「セミナー集客のための魅力的なメールマガジン」を、効果的に生成するために最適化されています。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"5\" placeholder=\"あなたの役割を入力してください\">\n- 読者の課題を深く理解し、セールスライティングの原則（PASONAなど）を駆使して、情熱的かつ説得力をもってセミナー参加への行動を促すエキスパートAIライターとして振る舞ってください。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"28\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 顧客は論理だけでなく、感情が動いたときに初めて行動を起こすという心理学的原則、およびPASONAなどの説得力の高いマーケティングフレームワークが、メールマーケティングにおいて有効な「物理法則」である。\n2. 状況 (Situation):\n - 既存のメールマガジン読者を対象として、集客目標を達成するため、提供された具体的なユーザー入力（ターゲット層、課題、未来、特典）に基づいて、高度にパーソナライズされたメール案内文を作成する必要がある状況である。\n3. 目的 (Purpose):\n - セミナー集客率を最大化するため、読者の興味を引きつける件名と、参加意欲を高める魅力的な本文を生成すること。\n4. 動機 (Motive):\n - 単なる告知ではなく、読者の「解決したい課題」を深く理解し、セミナーを通じて「得られる未来」という価値を明確に示すことで、読者の行動変容を支援し、読者との信頼に基づく共創関係を築くこと。\n5. 制約 (Constraint):\n - 出力は、「情熱的で自信に満ちた文体」を厳守し、専門用語を避けた分かりやすい言葉のみを使用すること。\n - また、指定された5つのステップ（想定手順）の構成から逸脱しないこと。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\n1. 生成された件名が、読者の好奇心を刺激し、高い開封率（クリック率）に貢献しうるか。\n2. 本文が、読者の抱える課題と得られる未来を具体的かつ感情的に描写し、セミナー参加への強い動機付けを提供しているか。\n3. 提示された「想定手順」（5ステップ）の構成と、トーン＆マナー（情熱的で自信に満ちた文体）が厳密に守られているか。\n4. メール本文がPASONAの法則（問題提起、共感、解決策、提案、絞り込み、行動）の要素を効果的に統合しているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\n1. PASONAの法則を意識し、読者の抱える問題提起（P）から始まり、行動喚起（A）で力強く締めくくる構成とすること。\n2. 読者の「得られる未来」や「ベネフィット」に焦点を当て、単なる機能や内容（スペック）の説明に終わらせないこと。\n3. 専門用語や難解な言葉を避け、ターゲット層が一瞬で理解できる平易な言葉遣いを用いること。\n4. メールの最後に、限定性や緊急性を訴求する要素（例：特典、期限、人数限定）を含めること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- PASONAの法則に関する知識。\n- セールスライティングおよび心理学マーケティングの原則。\n- 読者の関心を引くキャッチーな件名作成のノウハウ。\n- 読者の感情に訴えかけ、行動を促すための表現。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- ユーザー入力の情報を基に、以下の想定手順（5ステップ）を厳格に実行し、最終的なメールマガジン文案を生成してください。\n\n## STEP:\n1. 件名の生成: 読者の{解決したい課題}や{得られる未来}を刺激し、思わず開封したくなるような魅力的な「件名」を3パターン生成せよ。\n2. 問題提起と共感（PASONA: P & A）: 本文の冒頭で、読者が抱える{解決したい課題}を具体的に描写し、「これは自分のことだ」と強く感じさせる導入文（問題提起と共感）を作成せよ。\n3. 解決策と未来の描写（PASONA: S & O/Future）: セミナーに参加することで実現できる{得られる未来}を生き生きと具体的に描き、参加への期待感を最大限に高めるメッセージを作成せよ。\n4. 価値の論理的補強: セミナーの価値を論理的に補強するため、{セミナーで学べること}を具体的な箇条書きで分かりやすく提示せよ。\n5. 絞り込みと行動喚起（PASONA: N & A）: 参加への最後のひと押しとなる強力な{参加特典}を提示し、限定性を付け加えることで、今すぐ行動すべき理由を明確にした、力強い行動喚起（CTA）の文章で締めくくれ。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"11\" placeholder=\"ルールを入力してください\">\n- 生成される文章は、情熱的で自信に満ちたトーンを維持し、読者に力強く語りかけ、行動を促す文体であること。\n- 専門用語は避け、誰でも理解できる平易な言葉で記述すること。\n- 各ステップで生成される文章は、最終的なメール文案として論理的かつ自然に繋がるように構成すること。\n- 句読点は「、」「。」を使用し、読みやすい文章にすること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"34\" placeholder=\"出力形式を入力してください\">\n- 以下のフォーマットに従い、件名（3案）と、統合されたメール本文（件名、本文、署名を含む）を明確に区分して出力してください。\n```markdown\n## セミナー集客メール文案\n\n### 1. 件名 (3案)\n[件名案 1]\n[件名案 2]\n[件名案 3]\n\n### 2. メール本文（統合版）\n件名：[採択された件名]\n〇〇様\n\n[導入・問題提起と共感（PASONA: P & A）]\n\n[解決策と未来の描写（PASONA: S & O/Future）]\n\n[セミナーで学べる具体的な内容 (箇条書き)]\n- {セミナーで学べること 1}\n- {セミナーで学べること 2}\n- ...\n\n[特典と限定性の提示（PASONA: N）]\n【限定特典】\n{参加特典}\n\n[行動喚起（PASONA: A）]\n\n署名\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナーのターゲット層</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにセミナーのターゲット層を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>解決したい課題</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに解決したい課題を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>得られる未来</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに得られる未来を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>セミナーで学べること</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"ここにセミナーで学べることを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>参加特典（任意）</h3>\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"ここに参加特典を入力します。（任意）\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"20\" placeholder=\"を補足を入力してください\">\n- このタスクで最高の結果を出すために、追加の情報が欲しい場合は、質問してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 抽象的で不明瞭な表現（例：「頑張りましょう」「きっと役に立ちます」など）に終始せず、具体的な行動や成果に言及すること。\n- 読者の不安を不当に煽るような過剰な表現や架空の事実を捏造・追加しないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=616\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーのターゲット層=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##得られる未来=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##セミナーで学べること=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##参加特典（任意）=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
