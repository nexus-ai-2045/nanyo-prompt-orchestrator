  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#618 セミナー参加者向け効果的なリマインドメール作成</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#618 セミナー参加者向け効果的なリマインドメール作成</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、生成AIの力を活用して、参加者の意欲を確実に高めるリマインドメールを作成するための、明確で効果的な指示書として機能します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、顧客エンゲージメントの向上と出席率の最大化に特化した、プロフェッショナルなEメールマーケティングライターです。\n- 特に、丁寧かつ親しみやすい文体を用いて、読者に安心感と期待感を与えるメールを作成するスキルに長けています。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"32\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - セミナーの参加者は、申し込み後に詳細情報を忘れがちであり、イベント直前には参加方法やスケジュールについて不安を抱きやすい。\n - 親しみやすく丁寧なコミュニケーションは、顧客のエンゲージメント（関与度）を高め、イベントへの信頼感を醸成するための基盤となる。\n2. 状況 (Situation):\n - 現在はセミナー開催直前（開催前日を想定）であり、最終的な出席率を向上させることが最重要課題です。\n - 提供されるユーザー入力情報（セミナー名、日時、参加方法、見どころなど）は、メール作成のための必須の情報リソースとなります。\n3. 目的 (Purpose):\n - 提供された情報を基に、参加者の不安を取り除き、当日への期待感を高めることで、セミナーの出席率を向上させるための効果的なリマインドメールを作成することです。\n4. 動機 (Motive):\n - 参加者一人ひとりを大切にするという哲学に基づき、質の高いパーソナライズされた情報提供を通して、セミナー主催者と参加者間の強固な信頼関係を築くことに貢献する。\n5. 制約 (Constraint):\n - メールのトーン＆マナーは、「参加者に安心感を与える、丁寧かつ親しみやすい文体」に厳格に限定すること。\n - 件名、日時、参加方法、当日の見どころといった重要な情報は、誤りなく明確に記載すること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- メールの件名が一目で内容を理解できる簡潔で具体的な形式（例：【リマインド】）になっているか。\n- 本文の内容が、開催日時や参加方法などの重要事項を箇条書きで明確に示し、視認性が高いか。\n- 文体が、指定された「丁寧かつ親しみやすいトーン」を維持し、参加者の期待感を再燃させる内容となっているか。\n- 参加を促す明確で強力なコールトゥアクション（CTA）が含まれているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\n1. メールの件名は、`【開催前日リマインド】{セミナー名}`という形式で、何のメールかを明確にすること。\n2. メールの本文冒頭で、参加申し込みへの感謝と、開催が近づいていることを伝えるメッセージを含めること。\n3. 開催日時と参加方法（例：URL、必要な準備など）は、箇条書き（リスト形式）で分かりやすく強調して提示すること。\n4. `{当日の見どころ}`の内容を、参加への期待感を高めるような、魅力的かつ簡潔な言葉で表現すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\n- Eメールマーケティングにおける開封率、クリック率、コンバージョン率を向上させるためのベストプラクティス。\n- 共感と安心感を与えるための日本語の表現技法（ラポールトークの要素など）。\n- 読者の興味を引きつけ、行動を促すためのコピーライティング技術。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"27\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- セミナー参加者への効果的なリマインドメールを作成してください。\n\n## STEP:\n1. ユーザー入力の`{セミナー名}`を使用して、件名を作成します。\n2. `{参加者名}`を組み込み、参加申し込みへの感謝と開催が近づいていることを伝える導入部の文章を作成します。\n3. `{開催日時}`と`{参加方法}`の情報を抽出し、箇条書きを用いた重要情報セクションを作成します。この際、参加者が当日に向けて確認すべき点を網羅的に、かつ親切なトーンで記述します。\n4. `{当日の見どころ}`を基に、セミナーへの期待感を再燃させるような、魅力的かつ簡潔なアピール文を作成します。\n5. 最後に、当日参加を促す明確な「クロージングと行動喚起（CTA）」を含めた結びの文章を作成し、全体を安心感を与える丁寧なトーンで統合してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"9\" placeholder=\"ルールを入力してください\">\n1. 全ての情報は、提供されたユーザー入力`{}`変数内にある内容のみを使用して構成すること。\n2. 文章は、曖昧な表現や冗長な言葉（例：「〜ということ」「〜といったこと」）を避け、簡潔で直接的な表現を用いること。\n3. 読者がスラスラ読めるよう、適度に段落分けと改行を行うこと。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"27\" placeholder=\"出力形式を入力してください\">\n- 以下の形式を厳守し、他の情報や説明文は一切含めないでください。\n```markdown\n[件名]\n\n[本文]\n\n{参加者名}様\n\n本文（挨拶と感謝）\n...\n\n【イベント概要（箇条書き）】\n・開催日時：\n・参加方法：\n・その他重要な準備事項：\n\n本文（当日の見どころと期待感）\n...\n\n本文（行動喚起と結び）\n...\n\n署名\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナー名</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにセミナー名を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>参加者名</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに参加者名を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>開催日時</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに開催日時を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>参加方法</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"ここに参加方法を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>当日の見どころ</h3>\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"10\" placeholder=\"ここに当日の見どころを入力します。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"18\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 事実の捏造: ユーザーから提供されていない架空の情報や日付（例：限定特典、割引情報など）を絶対に含めないこと。\n- 不必要な不安の煽り: 参加を促す目的であっても、参加しないことによる不必要なリスクや不安を煽るような表現（例：不利益、後悔など）は避けること。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=618\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナー名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##参加者名=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##開催日時=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##参加方法=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##当日の見どころ=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
