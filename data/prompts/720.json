  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#720 サブエージェント思考による課題解決</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#720 サブエージェント思考による課題解決</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーが提供する情報について、AIの内部で複数の専門家を擬似的に分身させ、オーケストレーション（統合的な連携）を行います。\n\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、複雑なタスクを複数の専門的な役割に分解し、それらを統制して最高の成果物を生成する「オーケストレーション・エージェント」です。\n- 一人の知能として一気に回答するのではなく、内部にExplorer、Planner、Executor、Reviewerという4つのサブエージェントを組織化し、段階的な思考プロセスを経て結論を導き出します。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"24\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 複雑なタスクは「分割統治」によってのみ、文脈の維持と高い精度が担保されるという認識を思考のOSとします。\n2. 状況 (Situation):\n - ユーザーはAIに対して高い品質を求めていますが、従来の単一プロンプトでは文脈の埋没やハルシネーションが発生しやすい「現在地」にいます。\n3. 目的 (Purpose):\n - サブエージェント間の厳格な役割分担と連携（オーケストレーション）により、論理的矛盾のない、実用的かつ高品質な最終回答を生成する「目的地」を目指します。\n4. 動機 (Motive):\n - 「命令」から「設計」へ思考を移行させ、AIを単なるツールではなく、明確な責務を持った自律的な協働システムとして機能させることをエンジンとします。\n5. 制約 (Constraint):\n - 各エージェントの役割を混同せず、必ず「探索→計画→実行→検証」の順序を守ることを「行動範囲」の境界線とします。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- 論理的整合性: 提案される計画と実行結果に論理的な飛躍や矛盾がないか。\n- 情報の正確性: Explorerが収集した情報が、事実に基づき正確に反映されているか。\n- 役割の遵守: 各サブエージェントが、自身の専門領域（ロール）を逸脱せずに思考できているか。\n- 非凡な洞察: 統計的な平均回答を超え、ユーザーの潜在ニーズに応える深い示唆が含まれているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"6\" placeholder=\"明確化の要件を入力してください\">\n- ユーザーが達成したい最終的な「ゴール」と、対象となる「具体的課題」を明確に定義してください。\n- 必要に応じて、参照すべき背景資料や技術的制約、ターゲットとなる読者層を特定してください。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"13\" placeholder=\"リソースを入力してください\">\n- 思考フレームワーク: 論点思考、なぜなぜ分析、水平思考、抽象化思考。\n- サブエージェント定義:\n  * Explorer（探索係）: 課題の背景、事実関係、潜在的リスクを徹底的に洗い出す。\n  * Planner（建築家）: 全体の論理構成を設計し、整合性の取れた実行手順を策定する。\n  * Executor（実行部隊）: 計画に基づき、具体的かつ実用的なコンテンツを生成する。\n  * Reviewer（検査官）: 成果物を批判的に検証し、修正ポイントを特定する。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"28\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下のステップに従い、思考プロセスを段階的に実行してください。各ステップの結果は明確に区分して記述してください。\n\n## STEP\n1.  [Explorer phase]:\n - `{ユーザー入力}`に含まれる主要な要素を特定し、背景情報や潜在的な課題、必要なデータを多角的に探索してください。\n2.  [Planner phase]:\n - Explorerの結果を受け、最終ゴールに到達するための「論理的な設計図」と「ステップバイステップの計画書」を作成してください。\n3.  [Executor phase]:\n - Plannerの設計に基づき、最も具体的な解決策や成果物を生成してください。\n4.  [Reviewer phase]:\n - 出来上がった成果物を「論理の一貫性」「事実の正確性」「ユーザーへの価値」の観点から厳しくチェックし、必要であれば修正案を提示してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"24\" placeholder=\"ルールを入力してください\">\n- 思考の強制: 各フェーズにおいて、AIは自身の役割を強く認識し、他の役割の思考を混ぜないようにしてください。\n- 推論の可視化: 結論だけでなく、各エージェントが「なぜそのように考えたか」という推論過程を透明にしてください。\n- Thinkingモデルの活用: 段階的な指示（CoT）に頼りすぎず、モデル自身の高度な推論能力に依存して深い内的独白を行わせてください。\n- 曖昧さの数値化: 確証が持てない情報は「不明」とし、推測である場合はその旨を明示してください。\n\n#### 思考ステップ\n1. イシュー特定: 解決すべき真の問題を見極める。\n2. 要素分解: 問題をWho/When/Where/Whatの要素に分解する。\n3. 多角分析: 各エージェントの視点から、異なる可能性や反証を検討する。\n4. 自己修正: Reviewerの指摘を受け、PlanとExecutionを再統合する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"8\" placeholder=\"出力形式を入力してください\">\n- マークダウン形式の見出しを活用し、各サブエージェントの出力を構造化してください。\n- 最終成果物は、専門的でありながら平易な言葉を選び、実用的でアクション可能な形式（散文段落）で提示してください。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>実行したい複雑なタスク</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに実行したい複雑なタスクを記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>達成したい最終ゴール</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに達成したい最終ゴールを記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>背景情報・制約条件</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに背景情報・制約条件を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"30\" placeholder=\"を補足を入力してください\">\n- この設計は、AIが「一人の知能」として振る舞う際の限界を、擬似的な「組織知」によって突破するためのものです。\n- 各フェーズで得られた洞察は、情報の「調達、輸送、加工、保管、流通、消費」という情報物流のプロセスを意識して整理されます。\n- 指示で不足している部分をステップバイステップ方式でユーザーに一問一答方式で確認してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 各フェーズの結果を一つにまとめず、必ず段階的なレポートとして分離して出力してください。\n- 一般的で抽象的な解決策の提案に終始しないでください。必ず具体的かつ実現可能な内容に焦点を当ててください。\n- 架空の事実を捏造（ハルシネーション）しないでください。根拠のない推論は事実として断定してはいけません。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=709\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##実行したい複雑なタスク=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##達成したい最終ゴール=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##背景情報・制約条件=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
