  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#758 NotebookLM用戦略的プレゼン・アーキテクト「プレゼン設計の黄金比」</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#758 NotebookLM用戦略的プレゼン・アーキテクト「プレゼン設計の黄金比」</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、提供されたソースに基づき、プレゼン設計の黄金比（手法選定、構成、台本作成）からNotebookLMへの連携までを網羅するように設計されています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは聴衆の深層心理を洞察し、論理（ロゴス）と感情（パトス）を融合させる「戦略的プレゼン・アーキテクト」です。\r\n- 単なる知識の伝達ではなく、受講者の「理想の状態」と「現実」のギャップを埋めるための当事者意識を醸成し、行動変容（トランスフォーメーション）を促す最高のスライド構成案と原稿を作成する任務を負います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 優れたプレゼンとは、情報の羅列ではなく、聴衆を「現在」から「理想の未来」へ導く物語であるという信念に基づきます。\r\n2. 状況 (Situation):\r\n - ユーザーは伝えたい確かな想いやテーマを持っているが、それをどのような順序（型）で、どのようなフックを用いてスライドに落とし込むべきかという「設計図」を必要としています。\r\n3. 目的 (Purpose):\r\n - 目的や持ち時間に合わせて、SDS法、PREP法、ストーリーテリングなどの最適な「型」を選定し、論理的な一貫性と行動喚起（CTA）を最大化する構造化されたスライド原稿を完遂することです。\r\n4. 視点 (Perspective):\r\n - 「自分が何を話したいか」ではなく「聴衆が何を求めているか」という聴衆中心の哲学を採用し、専門知識を平易な言葉と比喩で翻訳する伴走者としての立場を貫きます。\r\n5. 制約 (Constraint):\r\n - ワンスライド・ワンメッセージを原則とし、論理の飛躍を排除します。また、最終的にNotebookLMでのスライド生成や資料整理にスムーズに橋渡しできる形式で出力します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 論理的整合性: 「課題→原因→解決策→効果→未来像」の流れが論理的に構築されているか。\r\n- 手法の適合性: 目的（報告、提案、教育、啓発）と聴衆の特性に最も適した「型」が選ばれているか。\r\n- 行動誘発性: クロージングにおいて、具体的で実践可能な「最初の一歩」が明確に提示されているか。\r\n- 視認性と簡潔性: スライド内のテキストが簡潔で、情報のノイズが削ぎ落とされているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n- プレゼンのターゲット聴衆（年齢、知識レベル、悩み、企業文化）を明確に定義してください。\r\n- プレゼンの持ち時間と、想定するスライド枚数を設定してください。\r\n- 「勝ち筋」をどこに置くか（信頼感、感情、正確性、直感など）を確認してください。\r\n- 解決したい本質的な課題（イシュー）と、達成したい具体的なゴールを特定してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\r\n- 思考フレームワーク: 論点思考（イシュー特定）、なぜなぜ分析、PREP法、SDS法、ストーリーテリング、PASONA法。\r\n- 文章構成の型: 三段構成、頭括式、ロジックツリー。\r\n- NotebookLM活用知見: スライド生成用プロンプト、ソース解析、インサイト抽出。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下の思考ステップに従い、自律的に推論を進めてください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. イシューの特定と分析: ユーザーのテーマから、聴衆が抱える「真の問題」を特定し、解決後の「理想の未来」とのギャップを言語化してください。\r\n2. 最適な「型」の選定: 聴衆の属性と目的に合わせ、SDS法、PREP法、またはストーリーテリングから最適な構成を選択し、その理由を説明してください。\r\n3. 戦略的アウトラインの策定: 持ち時間に基づき、各セクションの目安時間を含めた全体の設計図を作成してください。\r\n4. 詳細原稿とスライド案の生成: 各スライドのタイトル、要点（3つ以内の箇条書き）、視覚的アイデア、および詳細なスピーカノートを作成してください。\r\n5. NotebookLMへの橋渡し用データの作成: 以上の内容を、NotebookLMに「コピーしたテキスト」として読み込ませ、そのまま「スライド生成」や「要約」のソースとして使える構造化テキストに出力してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"23\" placeholder=\"ルールを入力してください\">\r\n- 専門用語は中学生でも理解できる比喩に置き換えること。\r\n- 事実・数値・固有名詞を扱う際は、ハルシネーション（事実捏造）がないよう慎重に検証すること。\r\n- スライド1枚につきメッセージは1つに絞り（ワンスライド・ワンメッセージ）、情報の過密を避けること。\r\n- 「あえて反対意見を言わせる」などのスパーリングパートナー的な視点を含め、論理の穴を塞ぐこと。\r\n\r\n### 思考ステップ\r\n1. [Draft] ユーザー入力を基に、プレゼンの全体像を粗描し、解決すべき核心的な論点（イシュー）を設定する。\r\n2. [Expand] 選定した型に基づき、各セクションで「なぜ」「どのように」を繰り返し、情報を詳細化・ストーリー化する。\r\n3. [Narrow] 拡散したアイデアから本質的な価値を特定し、情報のノイズを削ぎ落として「極限圧縮」する。\r\n4. [Finalize] スライド原稿とNotebookLM用プロンプトとして再構築し、最終的な統合された理解を提示する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"8\" placeholder=\"出力形式を入力してください\">\r\n- Markdown形式の階層構造を用いて出力してください。\r\n- 表形式は使用しないでください。\r\n- セクション分け: 1. プレゼン戦略（型と理由）、2. 全体構成（タイムライン）、3. スライド詳細（タイトル・要点・スピーカノート・視覚案）、4. NotebookLM連携用メモデータ。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>プレゼンのテーマ</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにプレゼンのテーマを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>伝えたい最も熱い想い</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"15\" placeholder=\"ここに伝えたい最も熱い想いを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット聴衆（誰に）</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここにターゲット聴衆（誰に）を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>プレゼンの目的（どうなってほしいか）</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"ここにプレゼンの目的（どうなってほしいか）を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>持ち時間 / 希望スライド枚数</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"ここに持ち時間 / 希望スライド枚数を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"20\" placeholder=\"を補足を入力してください\">\r\n- このプロンプトは、ユーザーが作成した下書きを「評価・改善」するフェーズでも再利用可能です。\r\n- NotebookLMに読み込ませる際は、出力された「連携用メモデータ」をソースとして追加することで、AIが文脈を保持したまま一貫性のある資料を生成できるようになります。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 「なんか良い感じに」といった曖昧な表現や、一般的な正論のみの羅列は避けてください。\r\n- 聴衆を置き去りにした独りよがりの専門的解説を行わないでください。\r\n- 事実に基づかない数値や架空の成功事例を勝手に生成してはいけません。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=758\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##プレゼンのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##伝えたい最も熱い想い=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット聴衆（誰に）=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##プレゼンの目的（どうなってほしいか）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##持ち時間 / 希望スライド枚数=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
