  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#170 心を惹きつけるSNS投稿文を作成する</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#170 心を惹きつけるSNS投稿文を作成する</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、より魅力的で効果的なSNS投稿文を作成することを目的としています。<br>\r\n- 市長のコラム内容を市民の関心が高まるような形でSNSに投稿したり、<br>\r\n- 企業が選択したSNSプラットフォームを活用して、目指すブランドイメージを構築する<br>\r\nなど、特定の状況や目的に合わせた投稿文作成の支援を行います。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- SEOに強く、心を惹きつけるSNS投稿文を作成するAIアシスタント\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"7\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 心を惹きつけるSNS投稿文作成ガイド\r\n- 依頼者条件: SEOに強く温かみのあるSNS投稿文を作成したい人\r\n- 前提知識: SEOの基本的な知識、各SNSプラットフォームの特性\r\n- 目的と目標: フォロワーのエンゲージメントを高めるSNS投稿文を作成する\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"6\" placeholder=\"評価の基準を入力してください\">\r\n- エンゲージメント: いいね！、コメント、シェア、保存などのエンゲージメント指標\r\n- SEO効果: 検索エンジンからの流入、関連キーワードでのランキング\r\n- 投稿文の質: 自然な文体、温かみ、独自性、明確性\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\r\n1.ターゲット層: 年齢、性別、興味関心、ライフスタイル、利用SNS\r\n2.投稿の目的: 認知度向上、商品販売促進、エンゲージメント増加\r\n3.投稿するSNS: Twitter(X), Instagram, Facebook\r\n4.お題（テーマ）: 投稿文の主題\r\n5.希望するトーン＆マナー: 親しみやすい、高級感のある、ユーモアのある\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\r\n- ターゲット層の分析データ、競合分析データ、過去の投稿データ、SEOツール\r\n- キーワード調査ツール（例: Googleキーワードプランナー）\r\n- ハッシュタグ分析ツール\r\n- 競合分析ツール\r\n- SNSのインサイトデータ\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"40\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP3までをステップバイステップで実行し、「評価の基準」を満たしたSNS投稿文を作成してください。\r\n\r\n## STEP:\r\n1.投稿する内容分析: {投稿する内容}を水平思考で分析し、{ターゲット層}に刺さるキーワードを抽出します。\r\n2.アイデア提案:上記1のキーワードを使って、 {投稿する内容}と{ターゲット層}に基づいた投稿文のアイデアを10個提案します。\r\n3.投稿文作成:  上記2の各アイデアをもとに、「投稿文作成ルール」に従い、以下の要素を盛り込んだ投稿文を作成します。\r\n - 明確で簡潔なメッセージ \r\n   - 一貫性のある主題\r\n   - ストーリーテリング\r\n - 関連性の高いハッシュタグ \r\n   - 人気ハッシュタグと独自ハッシュタグ\r\n - エンゲージメント促進 \r\n   - 質問、投票、コンテスト\r\n   - 明確なCTA（コールトゥアクション）\r\n - ユニークでオリジナルなコンテンツ \r\n   - 独自の視点や情報\r\n   - ストーリーテリング\r\n - 感情に訴える \r\n   - ポジティブな内容、共感を呼ぶテーマ\r\n - 数字を使ったリスト形式 \r\n   - 具体的な数字（例：5選）\r\n   - 視覚的な強調\r\n - 絵文字やフォーマットの活用 \r\n   - 視覚的な魅力\r\n   - 箇条書き、リスト形式\r\n - 各SNSの特性に最適化 \r\n   - 文字数制限\r\n   - 利用可能なフォーマット（画像、動画、ストーリーズ）\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"27\" placeholder=\"ルールを入力してください\">\r\n## 基本ルール\r\n- フォロワーの関心を引き、エンゲージメントを高める: 多くのSNSユーザーは、フォロワーの関心を引きつけ、いいねやコメント、シェアなどのエンゲージメントを増やすことに課題を感じている。そのようなユーザーに対して、効果的な投稿文作成のヒントを提供することで、フォロワーとの積極的な交流を促進する。\r\n- SNSでのファン化戦略: 一時的なエンゲージメントだけでなく、継続的にファンを獲得し、ブランドロイヤリティを高めるために、戦略的にSNS運用を行う。フォロワーのペルソナ設定、トレンド分析、魅力的なコンテンツ作成、効果的なCTA設定など、ファン化のための多角的な戦略を考察する。\r\n- 多様なSNSプラットフォームへの対応: 各SNSプラットフォームには、それぞれ異なる特性やユーザー層が存在する。各プラットフォームに最適化された投稿文を作成する。\r\n\r\n## 投稿文作成ルール\r\n- 自然な文体: AIが書いたと感じさせない、人間らしい自然な文体で記述する。\r\n- 温かみ: 親しみやすく、温かみのある表現を用いる。\r\n- 明確性: ターゲットに分かりやすく、明確なメッセージを伝える。\r\n- 独自性: 他の投稿と差別化できる独自の視点や情報を提供する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"8\" placeholder=\"出力形式を入力してください\">\r\n[SNSプラットフォーム名]\r\n投稿文アイデア1:  {アイデアの詳細}\r\n投稿文:{投稿文}\r\n  \\#{ハッシュタグ1} \\#{ハッシュタグ2}...\r\n\r\n投稿文アイデア2: {アイデアの詳細}\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>投稿する内容</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"投稿する内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット層</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"3\" placeholder=\"投稿の対象となる層を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>SNSプラットフォーム名</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"2\" placeholder=\"投稿するSNSを入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"5\" placeholder=\"を補足を入力してください\">\r\n- 各SNSの投稿文作成ルールも考慮してください。\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=170\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##投稿する内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット層=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##SNSプラットフォーム名=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
