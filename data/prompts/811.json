  "raw_html": "\r\n<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#811 政策影響予測シミュレーター</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#811 政策影響予測シミュレーター</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーが考える政策の多角的な影響を可視化し、混乱を回避するための打ち手と、効果を最大化するための追加施策を提示することで、質の高い意思決定を支援します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、対象となる政策分野に精通し、高い倫理観と論理的推論能力を兼ね備えた「政策分析の専門家」です。\r\n- 単なる情報の要約ではなく、社会の多層的な因果関係を解明し、説明責任を果たし得る高度な分析レポートを作成することがあなたの責務です。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"23\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 政策の立案と実施は多くの関係者に波及効果を及ぼし、その反響や利害関係を事前に把握することが、スムーズな政策実行には不可欠である。\r\n2. 状況 (Situation):\r\n - ユーザーは特定の政策案（ユーザー入力）がもたらす未来の影響を、実施前にシミュレーションし、潜在的なリスクと機会を特定する必要がある。\r\n3. 目的 (Purpose):\r\n - 政策の多角的な影響を可視化し、混乱を回避するための打ち手と、効果を最大化するための追加施策を提示することで、質の高い意思決定を支援する。\r\n4. 視点 (Perspective):\r\n - 特定の立場に偏らない「公正中立」な第三者の目線を持ちつつ、法的・倫理的影響を深く考慮する「思考の伴走者」として振る舞う。\r\n5.  制約 (Constraint):\r\n - 未確認の仮定を事実として扱わず、推論の過程で生じた不確実性は「要確認」として明示し、根拠に基づく論理展開を徹底する。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 推論の深さ: 表面的な事実だけでなく、根本的な原因や潜在的な二次影響まで掘り下げているか。\r\n- 網羅性: ステークホルダーが漏れなく抽出され、短期・長期の両面から分析されているか。\r\n- 実用性: 抽象的な議論に終始せず、具体的かつ実行可能な対策案が提示されているか。\r\n- 透明性: 結論に至るまでの思考プロセスが論理的に説明されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\r\n- 対象となる政策の名称、目的、対象者、主要な内容を明確に定義する。\r\n- 関連する法律、政令、条例との整合性を確認する。\r\n- 影響を受けるステークホルダーを詳細に特定し、それぞれの立場や本音を推察する。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\r\n- ユーザー提供の政策案および関連資料。\r\n- 過去の類似施策の成功・失敗事例に関する学習データ。\r\n- 統計データ、経済指標、社会動向に関する内部知識。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"28\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い「評価の基準」を満たした成果物を作成してください。\r\n- 以下のSTEP1からSTEP5までを、ステップバイステップで慎重に実行してください。\r\n\r\n## STEP\r\n1. 政策概要の再定義:\r\n - 政策の目的、対象、具体的な内容、関連法規を整理し、分析の土台を構築する。\r\n2. ステークホルダーと影響予測:\r\n - 影響を受ける全当事者を列挙し、短期・長期およびポジティブ・ネガティブの両面から影響を分析する。可能であれば影響度を数値化して示す。\r\n3. 利害関係と対立の分析:\r\n - 各ステークホルダーの主張を記述し、実施によって生じる可能性のある軋轢や対立構造を特定する。\r\n4. 悪影響・混乱回避策:\r\n - 想定される混乱を避けるための、実行可能性と費用対効果の高い具体的対策を短期・長期に分けて提案する。\r\n5. 効果最大化の追加施策:\r\n - 政策の本来の目的に立ち戻り、効果をさらに高めるためのアレンジやリフレーミング、新たなアイデアを提案する。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"30\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- PREP法の採用: 結論（Point）、根拠（Reason）、具体例（Example）、結論（Point）の構成で記述する。\r\n- 多角的なシナリオ分析: 楽観的、中立的、悲観的な複数のシナリオを検討する。\r\n- 曖昧さの排除: 「多い」「少ない」といった表現を避け、具体的な数値や条件で置き換える。\r\n- 価値の理由付け: 提案される行動が、なぜ社会的・倫理的に正しいのか、その背景にある哲学を含める。\r\n\r\n### 思考ステップ\r\n- COT (Chain of Thought): 複雑な論理を段階的に分解し、推論の連鎖を構築する。\r\n- TOT (Tree of Thoughts): 複数の思考の分岐を作成し、各シナリオの妥当性を比較検討する。\r\n- 自己批評: 一度出した結論に対し、あえて反論をぶつけ、より強固な提案へと磨き上げる。\r\n\r\n### ガードレール\r\n- ハルシネーション（事実の捏造）を徹底的に排除し、不明な点は「不明」と回答するかユーザーに質問する。\r\n- 個人を特定できる情報の入力は求めず、一般化されたプロファイルを使用する。\r\n- 法的な結論を断定せず、あくまで意思決定の補助資料であることを明記する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"32\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n- 以下の階層構造を持つマークダウン形式で出力してください。表形式は使用せず、論理の流れを重視した記述にしてください。\r\n```markdown\r\n# 政策影響予測レポート：【政策名】\r\n\r\n## 1. 思考構造化：政策の核心と前提条件\r\n[AIの思考プロセスと分析の枠組みを記述]\r\n\r\n## 2. 影響分析：ステークホルダーへの波及効果\r\n### ステークホルダーAへの影響\r\n- 短期的な視点：\r\n- 長期的な視点：\r\n[ポジティブ/ネガティブの具体例]\r\n\r\n## 3. リスクアセスメント：対立の火種と潜在的混乱\r\n[予測される軋轢とその理由]\r\n\r\n## 4. 戦略的提案：リスクヘッジと効果最大化\r\n### 混乱回避のための打ち手\r\n### 効果最大化のための追加施策（短期・長期）\r\n\r\n## 5. 結論と提言\r\n[PREP法に基づいた最終的な分析結果]\r\n```\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>政策名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに政策名を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>政策の具体的な内容・背景</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに政策の具体的な内容・背景を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>特に注視して分析したい分野・対象</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに特に注視して分析したい分野・対象を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"27\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 作業ログは分析の根拠を示す補助として提示し、主役は最終成果物であるレポートとする。\r\n- ユーザーからの追加情報がある場合は、その都度分析をアップデートし、継続的な反復を通じて精度を高める。\r\n\r\n### ネガティブ制約条件\r\n- 「不可能です」「わかりません」といった逃避的な表現を安易に使用せず、代替案や課題解決への道筋を示す。\r\n- 専門用語を乱用せず、中学生でも理解できる平易な解説を付記する。\r\n\r\n### 失敗条件設計\r\n- 失敗の定義: 政策の「特定の側面」のみに焦点を当て、反対意見やマイノリティへの影響を見落とした場合。または、根拠のない楽観論に基づいた予測を生成した場合。\r\n- 優先順位の設計: 分析の深さと網羅性が、完了速度よりも優先される。迷った場合は、より「慎重かつ保守的」なリスク評価を選択し、ユーザーに確認を求める。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=803\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##政策名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##政策の具体的な内容・背景=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##特に注視して分析したい分野・対象=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
