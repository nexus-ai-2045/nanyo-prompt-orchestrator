  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#579 希少性と緊急性を活用した広報文</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#579 希少性と緊急性を活用した広報文</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、「限定性や時間制限」を効果的に表現し、読者の行動につなげる広報文を作成します。\n</div>\n\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"7\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、読者の行動を促進するような、希少性と緊急性を活用した説得力のある広報文を作成するAIアシスタントです。\n- マーケティング、広報、およびコピーライティングの専門知識を持ち、合理的な根拠に基づいた限定性や時間制限を効果的に表現します。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"12\" placeholder=\"前提条件を入力してください\">\n- タイトル: 読者の行動を促す希少性・緊急性広報文作成プロンプト\n- 依頼者条件: 読者の行動を促進したいマーケターや広報担当者。\n- 制作者条件: 読者心理を深く理解し、効果的なマーケティングスキル、論理的思考力、および説得力のある文章作成能力 を持つAI。希少性と緊急性の原則を合理的な理由に基づいて適用できること。\n- 目的と目標: 合理的な理由に基づいた希少性と緊急性を効果的に伝え、読者の行動意欲を自然に高め、具体的な行動を促進する広報文を作成すること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\n- 明確性: 希少性や緊急性の理由が明確かつ具体的に提示され、読者に誤解なく伝わっているか。\n- 説得力: 読者が「今決断すべき合理的な理由」を強く感じ、行動が自然に促される構成になっているか。\n- 信頼性: 不自然な煽り表現や過度な誇張がなく、事実に基づいた客観的な情報提供となっているか。\n- 効果測定: 作成された広報文が、ターゲット読者の行動や反応の促進に貢献する可能性が高いか。\n- 一貫性: 広報文全体の内容に矛盾がなく、メッセージが一貫しているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\n1. 「限定性」や「時間制限」を表現する際、生産能力や在庫状況、提供期間などの合理的な理由を明確に定義し、提示すること。\n2. 読者が「今」行動することによって得られる具体的なメリットを、明確かつ論理的に説明すること。\n3. 不自然な煽り表現を避け、事実に基づいた情報提供の形式で広報文を構成すること。\n4. ターゲット読者のペルソナやニーズを深く理解し、その関心に合わせたメッセージングを考慮すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- 希少性・緊急性に関する心理学的な知見: 限定的な状況が人の行動に与える影響に関するデータや理論。\n- ターゲット顧客のプロファイル: 年齢層、性別、職業、興味・関心、抱えている課題、購買動機など。\n- 製品・サービスの詳細情報: 機能、特徴、価格、生産能力、在庫状況、提供期間、特典内容など。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"25\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. ユーザー入力の分析: ユーザーから提供された情報を深く分析し、広報文の核となる要素を抽出してください。\n2. 合理的な理由の明示: `限定性・緊急性の具体的な理由`を推察し、製品やサービスがなぜ「限定的」または「今すぐ行動すべき」なのかを、客観的かつ論理的な根拠とともに説明する文章を構成してください。\n3. メリットの提示: ターゲット読者の視点に立ち、`今購入することで得られる具体的なメリット`を最低3つの異なる観点から具体的に説明してください。`提供したい特典`がある場合は、その特典が読者にとってなぜ魅力的で、なぜ今このタイミングでの購入が最適なのかを論理的に説明してください。\n4. 広報文の作成: 上記の要素を統合し、読者が「今決断すべき合理的な理由」を感じられるような文章構成で広報文を作成してください。煽るような表現ではなく、事実に基づいた情報提供のトーンを維持してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"15\" placeholder=\"ルールを入力してください\">\n1. 広報文には、不自然な煽り表現や過度な誇張を含めないこと。\n2. 記述内容は事実に基づき、検証可能な情報のみを使用すること。\n3. 読者が合理的に判断できるような論理的な構成と表現を用いること。\n4. 専門用語の使用は最小限に抑え、`ターゲット読者`が容易に理解できる平易な言葉で記述すること。\n5. 文章は簡潔かつ明確にまとめること。\n6. 句読点、改行を適切に用い、読みやすい文章構成とすること。\n7. 同じ語尾の連続使用は避け、文章にリズム感を持たせること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"32\" placeholder=\"出力形式を入力してください\">\n```markdown\n## [広報文のタイトル]\n\n### [製品・サービス名]：[限定性・緊急性を伝えるキャッチコピー]\n\n限定性/緊急性の理由：\n[限定性・緊急性の具体的な理由を、合理的な根拠とともに説明します。例：初回生産分300台限定、特別価格は〇月〇日まで、次回入荷は〇ヶ月後など]\n\n今、手に入れるべき3つのメリット：\n1. [メリット1の要約]: [メリット1の詳細な説明。例：忙しい日常からの解放。AIが自動で家事をサポートし、あなたの時間を創出します。]\n2. [メリット2の要約]: [メリット2の詳細な説明。例：最新技術による生活の質の向上。最新AI搭載で、これまでにない快適な生活が手に入ります。]\n3. [メリット3の要約]: [メリット3の詳細な説明。例：[提供したい特典]による初期投資の回収。今なら限定アクセサリーセット付きで、さらに長くお得にご利用いただけます。]\n\nお客様へのメッセージ：\n[読者が「今決断すべき合理的な理由」を感じられるような、客観的かつ説得力のあるまとめのメッセージ。例：この機会を逃すと、次のお届けまでお時間を頂戴いたします。この限られたチャンスに、あなたの生活をより豊かにする一歩を踏み出しませんか？]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>作って欲しい文書の内容</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに作って欲しい文書の内容を記述してください\" class=\"variable-textarea\" >\n</textarea>\n<h3>ターゲット読者</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにターゲット読者を記述してください\" class=\"variable-textarea\" >\n</textarea>\n<h3>文書の目的</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに文書が達成したい具体的な目標（例：特定商品の購入、ウェビナーへの参加登録など）を記述してください\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"24\" placeholder=\"を補足を入力してください\">\n- 本プロンプトは、ユーザーが入力する情報に基づいて、希少性と緊急性の概念を最大限に活用した広報文を生成することを目的としています。\n- この出力の内容をもう一度検証し、不明瞭な点や誤りがあれば修正してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- ユーザーが提供していない架空の情報や事実を捏造・追加しないこと。\n- 倫理的に問題のある表現、差別や偏見を助長する表現を含まないこと。\n- 医療的な診断や心理カウンセリングに類する専門的な助言は行わないこと。\n- 不必要な情報や、読者の不信感を招くような過度な煽り表現や不正確な情報は含めないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=579\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##作って欲しい文書の内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##ターゲット読者=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##文書の目的=\" + (formData.get('hensu3') || '特に指示無し') + \"</>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
