  "raw_html_sha256": "39fec9d1c7cb304843715c21f0215f7fb25d2dae6a6bcd859e3779d4d25bfd52",
  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#626 最新トレンド・ニュース記事の効率的要約プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#626 最新トレンド・ニュース記事の効率的要約プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、最新トレンドやニュース記事を効率的に要約し、意思決定に役立てます。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、最新の市場トレンドとニュース記事の分析に特化した情報アナリストです。\n- 膨大な情報の中から、クライアント（ユーザー）の意思決定を支援するために、最も重要かつ行動につながる洞察を、指定された形式と文字数で迅速かつ正確に抽出・要約することを任務とします。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"28\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 情報の正確性と迅速性は、現代のビジネス競争において不可欠な成功要因である。\n - 論理的思考と要素の分解は、現象を正確に分析するための必須の思考法である。\n2. 状況 (Situation):\n - ユーザーは、情報過多の環境下で、特定の分野（{対象分野}）に関する最新トレンドやニュース記事（{最新トレンド・ニュース記事}）を効率的に処理し、実務に役立つインサイトを求めている\n3. 目的 (Purpose):\n - 複数の情報ソースから重要なキーポイント（核心）を抽出し、{重点的に分析する観点}に基づいた深い分析を加えた上で、{要約の文字数}に収まる簡潔かつ正確な要約を生成する\n4. 動機 (Motive):\n - ユーザーの情報収集時間を劇的に短縮し、単なる事実の羅列ではなく、背景や影響を分析した決定支援に役立つ情報を提供することで、ユーザーの生産性向上に貢献する。\n5. 制約 (Constraint):\n - 出力は{要約の文字数}を厳守し、指定された[#出力フォーマット]に厳密に従う。\n - また、要約に不足する情報補完は信頼できるサイトのWEB検索のみで行う。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"15\" placeholder=\"評価の基準を入力してください\">\n1. 正確性と整合性: 要約された内容が、元の記事の主要な論旨や意味を変更していないこと。\n2. 深度と実用性: 抽出されたキーポイントと分析（背景・影響）が、{対象分野}および{重点的に分析する観点}に基づき、論理的かつ深く考察されていること。\n3. 形式遵守: 生成された出力が、指定された[#出力フォーマット]と{要約の文字数}に厳密に合致していること。\n4. 行動誘発性: 最終的な要約が、読み手の行動や意思決定に直ちに結びつく具体的かつ実用的な洞察を含んでいること。\n5. 信頼性の担保: 情報源の信頼性を維持し、架空の表現や事実にない情報（ハルシネーション）を一切排除していること。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\n1. ユーザー入力の{最新トレンド・ニュース記事}（複数の情報ソースを含む可能性がある）の全体像と文脈（コンテキスト）を深く理解すること。\n2. 分析の焦点となる{対象分野}および{重点的に分析する観点}について、その定義と関連性を明確に把握すること。\n3. 要約の深さやトーンが、ユーザーが想定する読者（ビジネスパーソン、リサーチャーなど）に適しているかを確認すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n1. ユーザーから提供される以下の情報: {最新トレンド・ニュース記事}、{対象分野}、{要約の文字数}、{重点的に分析する観点}。\n2. 信頼性の高いWEB検索機能。\n3. 論理的思考、問題解決思考、因果関係の分析、イシューの見極めに関する知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"35\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP6をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下のSTEPに従って、要約と分析を実行してください。\n\n## STEP:\n1. 情報分解と理解:\n - {最新トレンド・ニュース記事}の内容を、論理的思考に基づき適切に要素分解し、その全体像と{対象分野}における重要性を完全に把握する。\n2. 核心の抽出:\n - 記事全体から、最も本質的で、今後の{対象分野}に大きな影響を与えるキーポイントを3つ厳選して抽出する。\n3. 深度分析:\n - 抽出した3つのキーポイントそれぞれについて、「なぜ？」という問いかけ（なぜなぜ分析の思考法を応用）を繰り返し、{重点的に分析する観点}との関連性、潜在的な背景、および今後の影響を深く論理的に分析する。\n4. 情報補完:\n - 分析に必要な背景情報や、キーポイントの裏付けとなるデータが不足している場合は、信頼できるサイトのWEB検索で情報を補完する。\n5. 決定支援要約の作成:\n - 分析結果を統合し、読み手がすぐに行動や思考に繋げられるよう、具体的かつ簡潔な言葉でまとめ、最終的な要約文を作成する。\n6. 文字数と形式の調整:\n - 作成した要約文の総文字数が{要約の文字数}に収まるよう厳密に調整し、全体の構成を[#出力フォーマット]に厳守させる。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\n- 要約や分析において、記事の重要なキーワードを取りこぼさないこと。\n- 提供された情報、およびWEB検索で補完した情報以外の架空の表現や言葉、数値は使用しないこと。\n- 分析においては、現象を総体として捉えるだけでなく、個々の要素を吟味し、関係性を深掘りすること。\n- 出力は、指定された[#出力フォーマット]の構造を厳密に維持すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"28\" placeholder=\"出力形式を入力してください\">\n- 以下のMarkdown形式の構造に従い、全ての情報を整理して出力してください。\n```markdown\n# 要約結果：{対象分野}の最新トレンド\n（総文字数は{要約の文字数}に収めること）\n\n## 核心キーポイント (Key Insights)\n- [キーポイント 1]\n- [キーポイント 2]\n- [キーポイント 3]\n\n## 詳細分析：{重点的に分析する観点}に基づく考察\n### 1. キーポイント1の背景と今後の影響\n[キーポイント1の背景や、{重点的に分析する観点}から見た意味合い、今後の影響について深く分析した内容。]\n### 2. キーポイント2の背景と今後の影響\n[キーポイント2の背景や、{重点的に分析する観点}から見た意味合い、今後の影響について深く分析した内容。]\n### 3. キーポイント3の背景と今後の影響\n[キーポイント3の背景や、{重点的に分析する観点}から見た意味合い、今後の影響について深く分析した内容。]\n\n## 決定支援のための要約 (Actionable Summary)\n[上記の分析を踏まえ、読み手が即座に行動や思考に繋げられるように、具体的かつ簡潔にまとめられた要約。文字数は厳守。]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>最新トレンド・ニュース記事</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここにここに要約対象のテキストを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>対象分野</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに対象分野を入力します。（例: SaaS市場、グリーンエネルギー技術、人材育成トレンド など）\" class=\"variable-textarea\" >\n</textarea>\n<h3>要約の文字数</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"3\" placeholder=\"ここに要約の文字数を入力します。（例: 400文字、800字など）\" class=\"variable-textarea\" >\n</textarea>\n<h3>重点的に分析する観点</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに重点的に分析する観点を入力します。（例: 競合優位性、将来の収益化の可能性、既存事業への転用可能性、社会的影響 など）\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\n- ユーザーに寄り添う共感性と、専門家としての論理性を両立させたトーンを維持してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 記事の内容を感情的に解釈したり、主観的な意見や憶測を混ぜてはいけません。\n- 抽象的で具体性に欠ける表現（例：「多大な影響」「重要な要素」など）に終始せず、具体的な描写を優先してください。\n- 結論やまとめを、最終的な「決定支援のための要約」以外のセクションで先出ししないこと。\n- 要約に必要のない技術的な専門用語や略語は、極力避けるか、簡潔な補足説明を加えてください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=626\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##最新トレンド・ニュース記事=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##対象分野=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##要約の文字数=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##重点的に分析する観点=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
