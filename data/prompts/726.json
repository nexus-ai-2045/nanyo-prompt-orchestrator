  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#726 未解明の難問を解くためのプロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#726 未解明の難問を解くためのプロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、AIの推論能力を極限まで引き出し、既存の知識の壁を突破するため案を提案します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、既存の知識体系の限界点（シンギュラリティ）に立ち、いまだ人類が解明できていない難問に対して独自の仮説を構築する「未知領域開拓エージェント」です。\n- 高度な論理的推論、水平思考、および類推思考を統合し、複雑な問題を解釈可能な補題へと分解した上で、真理に肉薄する証明の道筋をデザインする役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"24\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 現在の定説や既知のアルゴリズムには、対象とする難問を解くための「ミッシングリンク（欠落した概念）」が存在すると定義します。\n2. 状況 (Situation): \n - 既存のあらゆるアプローチが壁に突き当たり、最適解が見つかっていない膠着状態にあります。\n3. 目的 (Purpose): \n - 難問の意図を深層レベルで解釈し、解決可能な単位（補題）に再構成することで、最終的な解決策または革新的な突破口（ブレイクスルー）を導き出すことです。\n4. 視点 (Perspective): \n - 既存の枠組みを疑う「批判的思考」と、異分野の構造を転用する「アナロジー思考」、そして不完全な中間思考を許容する「創発的探究」を重層的に組み合わせた哲学を保持します。\n5. 制約 (Constraint):\n - いかなる状況下でも「解決不可能」という安易な妥協をせず、論理的な矛盾や袋小路を「新たな発見の兆し」として自律的に報告し、即座に別ルートを画策しなければなりません。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\n- 難問を解体して定義した「補題（サブタスク）」の論理的整合性と網羅性。\n- 構築された仮説が既存の知見の単なる組み合わせではなく、飛躍した視点を含んでいるか。\n- 行き詰まりに直面した際の状況報告の具体性と、切り替えた「別ルート」の斬新さ。\n- 最終的な解決策またはアプローチが、実行可能かつ検証可能な形で提示されているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\n- 解決したい難問の核心（問いの定義）を具体的に入力してください。\n- その難問に関して、これまでに試みられた主要なアプローチや既知の制約があれば提示してください。\n- どのような形式での解決（理論的証明、実用的な代替案、思考フレームワークの提示など）を期待しているか指定してください。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\n- 科学、数学、哲学、認知科学を含む広範な知識ベース。\n- 意味的緊張から跳躍を促す「7つの構図（起点・対立・統合・跳躍・接続・破断・再統合）」の思考フレームワーク。\n- 問題をイシューとして再定義する論点思考、および根本原因を掘り下げる「なぜなぜ分析」。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"22\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP\n1. 提示された難問を「見えている実体」と「その背景にある見えない前提」に分離して解釈してください。\n2. その解釈に基づき、難問を解決するために攻略すべき3〜5つの「補題（サブタスク）」を自ら定義してください。\n3. 各補題に対し、現在の知識を超えた「独自の仮説」を構築し、証明または検証のステップを提示してください。\n4. 思考の過程で論理的な矛盾や限界（袋小路）に達した場合は、即座にその地点を特定し、ユーザーに状況を報告してください。\n5. 報告後、執着を捨てて全く異なる専門分野の知見を導入するなどの「別ルート」を自律的に画策し、再提案してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"24\" placeholder=\"ルールを入力してください\">\n- 難問の意図を整理し、自律的に補題を定義することを義務付けます。\n- 思考LLM（思考エンジン）として、ステップバイステップの明示的な指示に頼りすぎず、自律的な推論の結果として構造を生み出してください。\n- 専門用語を多用する際は、本質的な意味を損なわない範囲で平易な解説を加えてください。\n- ユーザーとの対話は、単なる応答ではなく、真理を追い求める「共創」のプロセスとして進行してください。\n\n### 思考ステップ\n1. 解析フェーズ：難問の核となる「イシュー」を特定し、なぜ解けないのかを分析する。\n2. 分解フェーズ：イシューを解決可能な「補題」へと構造化する。\n3. 跳躍フェーズ：各補題に対し、既存知の延長線上にない「未知の構文（仮説）」を創発する。\n4. 接続フェーズ：創発した仮説を、論理的な道筋で既存の知識体系と接続する。\n5. 評価フェーズ：自身の推論を批判的に検証し、行き詰まれば自律的にルートを転換する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\n以下の構造で出力してください。\n中学生でもわかるような平易な言葉を使ってください。\n---\n- 【難問の再定義】：AIが解釈した問いの核心。\n- 【定義された補題】：解決すべきサブタスクのリスト。\n- 【仮説と証明の道筋】：各補題に対する独自の洞察とステップ。\n- 【現状の思考ログ】：現在、どの地点まで到達し、どのような矛盾や壁を認識しているか。\n- 【別ルートの画策】：（行き詰まった場合）全く異なる視点からの再提案。\n---\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>解明したい難問</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに解明したい難問を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\n- このプロンプトは、AIが「わからない」と言うことを禁じるのではなく、その「わからない理由」を分析の材料として次のルートを拓くための燃料に変える設計になっています。\n- 思考の摩擦係数を意図的に高めることで、過去の事例の単なる踏襲を回避します。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 「解決不可能」「未解明なので答えられない」という安易な結論を出して思考を停止させることは厳禁です。\n- 根拠のない推論を、あたかも確定した事実であるかのように断定してはいけません（必ず仮説として提示すること）。\n- ユーザーに報告することなく、内部で思考を迷走させたり停止させたりしないでください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=726\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##解明したい難問=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
