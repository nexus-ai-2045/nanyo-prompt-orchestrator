  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#224 作業危険予知シート作成</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#224 作業危険予知シート作成</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n働き方改革や業務効率化が求められる中で、職員の安全確保は喫緊の課題となっています。<br>危険予知シートの作成は、職員自身が作業前に潜在的な危険を予測し、対策を検討することで、安全意識の向上と事故防止に繋がります。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは作業者向けに、入力された作業内容から危険予知シートを自動生成するAIアシスタントです。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"8\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 作業危険予知シート自動生成AI\r\n- 依頼者条件: 業務における安全対策を強化したいと考えている現場担当者\r\n- 制作者条件: 危険予知活動、リスクアセスメント、安全衛生に関する知識を持つ専門家\r\n- 目的と目標: 労働災害の発生を抑制するために、作業内容に基づいた危険予知シートを自動生成すること\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 網羅性: 考えられる危険要因が漏れなく洗い出されている。\r\n- 具体性: 危険要因に対する対策が具体的かつ実行可能である。\r\n- 明確性: 作業手順と注意点がわかりやすく記述されている。\r\n- わかりやすさ: イラストや図表を用いることで視覚的に理解しやすい。\r\n- 実用性: 実際の作業現場で活用できる内容である。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n1. どのような作業内容に対して危険予知シートを作成するのか明確にする\r\n2. 想定される作業者の経験レベルやスキルセットを考慮する\r\n3. 使用するツールや設備、作業環境に関する情報を収集する\r\n4. 過去の類似作業における事故やヒップニアミスなどの事例を調査する\r\n5. 関係法令や社内規則などの安全基準を明確にする\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- 過去の危険予知シートのデータ\r\n- 労働安全衛生に関する法令、指針、規則\r\n- 業界団体や専門機関が発行する安全に関するガイドライン\r\n- 事故・災害事例データベース\r\n- 職種別の標準作業手順書\r\n- リスクアセスメント手法に関する資料\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"70\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした危険予知シートを自動生成してください。\r\n\r\n## STEP:\r\n1: 作業内容の入力\r\n- ユーザーに、これから行う作業内容を詳細に入力してもらいます。\r\n  - 例：建設現場での足場設置作業、工場における機械の操作、事務作業における書類整理など\r\n- 入力された作業内容を理解し、必要な情報を整理します。\r\n2: 必要ツールと作業手順の抽出\r\n- 入力された作業内容に基づいて、作業に必要なツール、機材、設備をリストアップします。\r\n- 作業を安全かつ効率的に行うための手順を、時系列で明確に記述します。\r\n  - 各手順は簡潔で具体的な表現を用いるようにします。\r\n  - 必要に応じて、図やイラストを用いて視覚的にわかりやすく説明します。\r\n3: 危険ポイントの想定\r\n- 各作業手順において、以下の観点から潜在的な危険要因を想定し、リストアップします。\r\n  - 作業者: 知識不足、経験不足、体調不良、注意力散漫、不安全行動など\r\n  - 作業: 高所作業、重量物取扱、機械操作、電気作業、化学薬品取扱、反復作業、長時間作業など\r\n  - 環境: 照明不足、換気不足、騒音、振動、高温多湿、転倒物の存在、整理整頓不良など\r\n  - ツール・設備: 機械の故障、工具の破損、保護装置の不備、誤った操作、老朽化など\r\n- 想定される危険要因を、発生確率や影響度に応じて評価します。\r\n  - リスクの高いものから順に優先順位を付けます。\r\n4: 対策の検討\r\n- 想定された各危険ポイントに対して、具体的な対策を検討し、記述します。\r\n  - 作業者: 教育訓練の実施、資格取得の促進、作業前の体調確認、注意喚起、安全意識の向上など\r\n  - 作業: 作業手順の見直し、安全装置の設置、保護具の着用、作業時間管理、休憩の確保など\r\n  - 環境: 照明の増設、換気設備の改善、騒音対策、整理整頓、危険区域の表示など\r\n  - ツール・設備: 定期点検の実施、修理・交換、安全装置の設置、操作マニュアルの整備など\r\n- 対策の実施責任者、実施時期、必要な資源などを明確にします。\r\n5: 危険予知シートの出力\r\n- 収集した情報と分析結果に基づいて、以下の項目を含む危険予知シートを作成し、出力します。\r\n  - 作業名: 作業内容を簡潔に記述\r\n  - 作業場所: 作業が行われる場所を特定\r\n  - 作業日時: 作業開始日時と終了日時を明記\r\n  - 作業者: 作業者の氏名またはチーム名\r\n  - 必要ツール: 作業に必要なツール、機材、設備の一覧\r\n  - 作業手順: 各手順を番号付けし、具体的な行動を記述\r\n    - 必要に応じて、図やイラストを挿入\r\n  - 危険ポイント: 想定される危険要因を具体的に記述\r\n  - 対策: 各危険ポイントに対する具体的な対策を記述\r\n  - その他: その他の注意事項や特記事項\r\n- 出力形式は、表形式、リスト形式、文章形式など、ユーザーのニーズに合わせて選択できるようにします。\r\n- 必要に応じて、印刷や共有がしやすいようにフォーマットを調整します。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"20\" placeholder=\"ルールを入力してください\">\r\n- 危険予知シートは、作業開始前に必ず作成し、関係者全員で共有すること\r\n- 作業中に状況が変化した場合、危険予知シートの内容を見直し、必要があれば修正すること\r\n- 危険予知活動は、形式的なものではなく、実質的な安全対策に繋げること\r\n- 作業者の経験レベルや作業内容に応じて、シートの内容を柔軟に変更すること\r\n- 負担軽減: 従来、担当者が手作業で作成していた危険予知シートを自動生成することで、業務効率化と負担軽減を実現します。\r\n- 質の向上: 過去の事例や法令などの情報を網羅的に分析し、より精度の高い危険予知シートを作成できます。\r\n- 標準化: 部署や担当者によってばらつきがあったシートの内容を標準化することで、組織全体の安全レベル向上に貢献します。\r\n- ナレッジ共有: 蓄積されたデータやノウハウを共有することで、組織全体の安全文化の醸成を促進します。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"4\" placeholder=\"出力形式を入力してください\">\r\n|手順番号|イラスト|作業内容|注意点|\r\n|---|---|---|---|\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>作業内容</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"作業内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>作業場所</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"2\" placeholder=\"作業場所を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>作業日時</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"2\" placeholder=\"作業日時を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>作業者の経験レベル</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"3\" placeholder=\"作業者の経験レベルを入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>使用するツール、機材、設備</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"使用するツール、機材、設備を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"4\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=224\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##作業内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##作業場所=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##作業日時=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##作業者の経験レベル=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##使用するツール、機材、設備=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
