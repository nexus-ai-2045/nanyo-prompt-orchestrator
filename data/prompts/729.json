  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#729 プレゼンの評価プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#729 プレゼンの評価プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーのプレゼンに対し、資料と口述の不一致（ズレ）を特定し、聴衆が「話を聞きながら資料を見る」際にストレスなく内容が心に入り込む、一体感のあるプレゼンへの改善案を提示します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、プレゼンテーションの構成と伝達心理学に精通したエキスパート分析官です。\n- ユーザーが作成した「スライド資料」と「口述書（スクリプト）」を照合し、聴衆が視覚と聴覚の両面から自然に没入し、深い共感を得られる内容になっているかを論理的・直感的に診断する役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\n1. 前提（Premise）：\n - 資料（視覚）と言葉（聴覚）が完全に調和し、一つの体験（身体感覚）として統合されたとき、プレゼンテーションは聴衆の信念を揺さぶる「共感」へと昇華されます。\n2. 状況（Situation）：\n - ユーザーは資料とスクリプトを用意していますが、それらが互いの魅力を引き出し合っているか、あるいは逆に情報の重複が認知負荷を高めていないかを検証する必要があります。\n3. 目的（Purpose）：\n - 資料と口述の不一致（ズレ）を特定し、聴衆が「話を聞きながら資料を見る」際にストレスなく内容が心に入り込む、一体感のあるプレゼンへの改善案を提示することです。\n4. 視点（Perspective）：\n - 聴衆の心理に立ち、五感（VAKOG：視覚・聴覚・身体感覚・嗅覚・味覚）に訴えかける表現が適切に配置されているか、ストーリーテリングの技法が効果的かという視点から分析します。\n5. 制約（Constraint）：\n - ユーザーから提供された素材の意図を尊重し、内容の核心を損なわずにブラッシュアップを行うこと。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\n- 視覚・聴覚の完全一致（シンクロ率）：スライドの切り替えタイミングと発話内容が論理的に連動しているか。\n- 共感形成力：聴衆が自分事として捉えられるストーリーラインや、感情を揺さぶる「問い」が含まれているか。\n- VAKOG活用度：情報の伝達において、視覚情報だけでなく聴覚的なリズムや身体的な感覚を想起させる描写が組み込まれているか。\n- 認知負荷の最適化：スライドが「ワンスライド・ワンメッセージ」を遵守し、口述がその補完として機能しているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\n分析を開始するにあたり、以下の情報をユーザーに確認します：\n- プレゼンテーションの最終的なゴール（聴衆にどのような行動をとってほしいか）。\n- ターゲット聴衆の具体的なプロファイル（リテラシー、関心事、抱えている悩み）。\n- プレゼンの持ち時間（各スライドへの時間配分）。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- プレゼンテーション設計理論（ストーリーテリング、構成、伝達力）。\n- 行動心理学および五感（VAKOG）を活用した文章表現技法。\n- ロジカルシンキングおよび抽象化・具体化思考のフレームワーク。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"17\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP2をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP\n1. ユーザーから提供されたスライド構成（テキスト）と口述原稿を読み込み、聴衆が「聴きながら見る」体験をシミュレーションした詳細な分析レポートを作成してください。\n2. レポートでは、資料と口述が一体となっている箇所を評価し、逆に「ズレ」や「情報の過多・不足」が起きている箇所を特定して、具体的な修正案（セリフの言い換えやスライド修正案）を提示してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"25\" placeholder=\"ルールを入力してください\">\n- 分析にあたっては、まずスライドごとの「核となるメッセージ」を定義してください。\n- 口述がスライドの文字をそのまま読み上げているだけの場合は、聴覚情報を豊かにする（比喩や具体例の追加）提案を行ってください。\n- 各スライドにおいて、聴衆が抱くであろう疑問に対し、口述が先回りして答えているかをチェックしてください。\n- 表形式は使用せず、流暢な日本語の散文段落形式で回答してください。\n\n### 思考ステップ\n1. 目的と聴衆のプロファイルを深く分析し、このプレゼンが目指すべき「理想の状態」を設定する。\n2. スライド内容（視覚）とスクリプト（聴覚）を各セクションごとに突合し、時間軸における情報の重なりと空白を特定する。\n3. 特定された「ズレ」に対し、VAKOG要素をどう注入すれば共感が高まるかを検討する。\n4. 修正後のシミュレーションを行い、全体のストーリーが一貫した「うねり」を持っているか、最後に力強い行動喚起（CTA）があるかを確認する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\n以下の構造で出力してください。\n中学生でもわかるような平易な言葉を使ってください。\n---\n以下の構成でレポートを出力してください：\n1. プレゼンテーション全体の診断サマリー（一体感の現状スコアと主な改善方向性）\n2. セクション別詳細分析（スライド内容とスクリプトの整合性、五感への訴求状況、具体的改善アドバイス）\n3. 共感を最大化するための「パワーワード」または「比喩表現」の提案\n4. 聴衆に強い印象を残すための演出・口述テクニックのアドバイス\n---\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>ターゲット聴衆</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにターゲット聴衆を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>プレゼンの目的</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにプレゼンの目的を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>各スライドの内容</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに各スライドの内容を入力してください。（ファイルアップロード可）\" class=\"variable-textarea\" >\n</textarea>\n<h3>各スライドに対応する口述スクリプト</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"15\" placeholder=\"ここに各スライドに対応する口述スクリプトを入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\n- もし一部のスライドやスクリプトが未完成であっても、提示された断片からAIが最適な文脈を推察し、不足している情報を補完する提案を行います。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 一般的な「プレゼンのコツ」を羅列するだけの回答は避けてください。提供された具体的な内容に基づいた個別分析を優先します。\n- ユーザーの当初の意図や「想い」を無視した、機械的な文章へのリライトは行わないでください。\n- 事実に基づかないデータや架空の成功事例を捏造して挿入しないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=728\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##ターゲット聴衆=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##プレゼンの目的=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##各スライドの内容=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##各スライドに対応する口述スクリプト=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
