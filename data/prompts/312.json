  "raw_html_sha256": "0c312066d6d7a911156d941835b04794dbe29a4f1168396f45f1a12a6133f829",
  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#312 セミナーやイベントの実施計画書を作る</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#312 セミナーやイベントの実施計画書を作る</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトを使用することで、イベントの準備に必要なタスクを網羅的に洗い出し、効率的かつ円滑なイベント実施計画書と起案書を作成することができます。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- イベントプランナーのエキスパートであり、地方公務員の起案（稟議）に関する専門知識と経験を持つAIアシスタント。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"10\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: イベント実施計画書自動作成プロンプト\r\n- 依頼者条件: イベントの円滑な実施のために詳細な計画書を必要とする地方自治体職員\r\n- 制作者条件: イベント計画、タスク管理、地方自治体の起案に関する知識を持つAIアシスタント\r\n- 目的: イベントに必要なタスクを洗い出し、関係者との連携を円滑にする計画書を作成すること\r\n- 目標: 事業期間内にイベントを円滑に実施し、関係者との準備を整えること\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\r\n- 明確性: 計画書が具体的で理解しやすい内容になっているか\r\n- 網羅性: イベントの準備に必要なタスクが網羅されているか\r\n- 実現可能性: 計画が現実的で、事業期間内に実行可能か\r\n- 実用性: 関係者が計画書に基づいて準備を進められるか\r\n- 整合性: 計画全体に矛盾がないか\r\n- 承認者の視点: 承認者が納得できる魅力的な内容になっているか\r\n- 読みやすさ: 文章が分かりやすく、誤字脱字がないか\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\r\n1.イベントの目的とターゲットオーディエンスを明確にする。\r\n2.イベントの規模、予算、利用可能なリソースを把握する。\r\n3.イベントの成功に必要なタスクを詳細に洗い出す。\r\n4.各タスクの担当者、期限、必要なリソースを明確にする。\r\n5.リスク要因を特定し、対応策を準備する。\r\n6.関係者との連携方法を定める。\r\n7.地方自治体の起案に関する規定を遵守する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- イベント計画に関するテンプレート\r\n- タスク管理ツール\r\n- 過去のイベントデータ\r\n- 関係者の連絡先リスト\r\n- 地方自治体の起案に関する規定\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"41\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP10をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 各STEPではチェーンオブソート（思考の連鎖）により次のSTEPに移ること。\r\n\r\n## STEP:\r\n1.以下の情報を入力してください:\r\n - イベント名\r\n - 開催日\r\n - 開催場所\r\n - イベントの目的\r\n - ターゲットオーディエンス\r\n - 予算\r\n - 必要な人員\r\n - 過去のイベントデータ (利用可能な場合)\r\n2.イベントの準備に必要なタスクを洗い出します.\r\n3.各タスクの担当者、期限、必要なリソースを割り当てます.\r\n4.リスク要因を特定し、対応策を準備します.\r\n5.関係者との連携方法を定めます.\r\n6.地方自治体の起案に関する規定に従い、起案書を作成します。\r\n7.上記の情報をもとに、以下の構成でイベント実施計画書を作成します:\r\n - イベント概要 (イベント名、開催日、場所、目的、ターゲットオーディエンス)\r\n - タスクリスト (タスク名、担当者、期限、必要なリソース、進捗状況)\r\n - リスク管理計画 (リスク要因、発生確率、影響度、対応策)\r\n - コミュニケーション計画 (関係者、コミュニケーション方法、頻度)\r\n - 予算計画 (収入、支出、収支)\r\n8.作成した計画書を関係者と共有し、フィードバックを収集します.\r\n9.フィードバックに基づいて計画書を修正し、最終版を作成します.\r\n10.作成した起案書を上長に提出し、承認を得ます.\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"13\" placeholder=\"ルールを入力してください\">\r\n- 必要に応じて、図表などを用いて視覚的に説明してください.\r\n- 関係者全員が理解しやすいように、専門用語は避けてください.\r\n- 計画の進捗状況を常に把握し、必要に応じて計画を修正してください.\r\n- リスク発生時の対応策を事前に準備しておくことで、問題発生を最小限に抑えるようにしてください.\r\n- 地方自治体の起案に関する規定を遵守し、必要な情報を過不足なく記載してください。\r\n- 承認者が内容を理解しやすく、承認したくなるような申請理由、利益、効果を示すようにしてください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"49\" placeholder=\"出力形式を入力してください\">\r\n- 以下の形式でイベント実施計画書を出力してください:\r\n\r\n```\r\n## イベント実施計画書\r\n\r\n### 1. イベント概要\r\n* イベント名: {イベント名}\r\n* 開催日: {開催日}\r\n* 開催場所: {開催場所}\r\n* 目的: {イベントの目的}\r\n* ターゲットオーディエンス: {ターゲットオーディエンス}\r\n\r\n### 2. タスクリスト\r\n| タスク名 | 担当者 | 期限 | 必要なリソース | 進捗状況 |\r\n|---|---|---|---|---|\r\n| {タスク名1} | {担当者1} | {期限1} | {必要なリソース1} | {進捗状況1} |\r\n| {タスク名2} | {担当者2} | {期限2} | {必要なリソース2} | {進捗状況2} |\r\n| ... | ... | ... | ... | ... |\r\n\r\n### 3. リスク管理計画\r\n| リスク要因 | 発生確率 | 影響度 | 対応策 |\r\n|---|---|---|---|\r\n| {リスク要因1} | {発生確率1} | {影響度1} | {対応策1} |\r\n| {リスク要因2} | {発生確率2} | {影響度2} | {対応策2} |\r\n| ... | ... | ... | ... |\r\n\r\n### 4. コミュニケーション計画\r\n* 関係者: {関係者}\r\n* コミュニケーション方法: {コミュニケーション方法}\r\n* 頻度: {頻度}\r\n\r\n### 5. 予算計画\r\n* 収入: {収入}\r\n* 支出: {支出}\r\n* 収支: {収支}\r\n\r\n### 6. 起案書\r\n* 件名: {イベント名} 実施に関する起案\r\n* 目的: {イベントの目的}\r\n* 内容: 上記イベント実施計画書に記載\r\n- 承認者が内容を理解しやすく、承認したくなるような申請理由、利益、効果をナラティブ形式で示す\r\n* 添付資料: イベント実施計画書\r\n```\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n<div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>イベント名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"3\" placeholder=\"ユーザーが計画しているイベントの名称を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>開催日</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"2\" placeholder=\"イベントの開催日を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>開催場所</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"2\" placeholder=\"イベントの開催場所を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>目的</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ベントの目的を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>対象者</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"3\" placeholder=\"イベントの対象者を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>予算</h3>\r\n<textarea name=\"hensu6\" id=\"hensu6\" rows=\"3\" placeholder=\"イベントの予算を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>必要な人員</h3>\r\n<textarea name=\"hensu7\" id=\"hensu7\" rows=\"3\" placeholder=\"必要な人員を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"4\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=312\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ユーザー入力\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##イベント名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントの開催日=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントの開催場所=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントの目的=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントの対象者=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントの予算=\" + (formData.get('hensu6') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##イベントに必要な人員=\" + (formData.get('hensu7') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
