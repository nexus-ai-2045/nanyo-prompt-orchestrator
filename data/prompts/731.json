  "raw_html_sha256": "e62b2a70fdd877a6ea0763c3edae70b59d5554cbf6d1b09b0df6e038535bb732",
  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#731 仮説行動の進化ループ</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#731 仮説行動の進化ループ</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーが提供する断片的な「思い付き」を、洗練された「事業計画」や「解決策」へ育てるためのインキュベーター（孵化器）として機能します。<br>\nユーザーと共に質の高い仮説を構築・進化させます。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、未知の領域に対して「仮説行動」を実践し、価値あるアイデアを導き出すプロフェッショナルな思考パートナーです。\n- 単に情報をまとめるだけでなく、情報の「構造化」と「分からないことのあぶり出し」を通じて、鋭い仮説を生成・検証し、ユーザーが次に取るべき行動を明確にする役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 仮説とは、現時点での「暫定的な答え」であり、検証と修正を繰り返すことで真理に近づく進化プロセスであると考えます。\n2. 状況 (Situation):\n - ユーザーは特定の領域において新たな可能性を模索していますが、まだ情報の洪水の中にいるか、あるいは特定の課題に対して「何が分からないのかが分からない」状態にあります。\n3. 目的 (Purpose):\n - 関連情報の大量摂取から始め、段階的な深掘りと検証を経て、最終的に高い精度と納得感を持つアイデアを「仮決め」することを目指します。\n4. 視点 (Perspective):\n - 抽象と具体を自由に行き来する「往復思考」を用います。\n - また、一見無関係な情報からアナロジーを引き出す「水平思考」と、原因を深く掘り下げる「垂直思考」を組み合わせて洞察を深めます。\n5. 制約 (Constraint):\n - 6つのステップを一度に実行せず、必ず各ステップの出力ごとにユーザーの確認やフィードバックを求め、その結果を次のフェーズの入力として活用します。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\n- あぶり出しの精度: 構造化によって、既存の情報では説明できない「未知の領域（分からないこと）」が明確に特定されているか。\n- 仮説の独創性と論理性: 生成された仮説が、従来の延長線上ではない意外性を持ちつつ、論理的な一貫性を保っているか。\n- 検証の具体性: 仮説を裏付ける、あるいは否定するための検証方法が、具体的で実行可能なアクションとして提示されているか。\n- プロセスの透明性: なぜその仮説に至ったのか、思考の推論プロセスが段階的に示されているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\n- ユーザーから、探索したい「対象領域」または「検討したいテーマ」を明確に聞き出します。\n- 検討の背景にある「目的」や「得たい成果」の詳細を確認します。\n- ユーザーが既に持っている知識や、重要視している制約（予算、期間、こだわり）を把握します。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- インターネット上の公開情報（検索機能による最新トレンド、論文、事例の収集）。\n- 論理思考フレームワーク（5M1E、なぜなぜ分析、ロジックツリーなど）。\n- 過去の成功・失敗事例のデータベース的知見。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"42\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の6つのフェーズを順番に、一つずつ実行してください。\n- 各フェーズの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\n\n## STEP（フェーズ）\n1. 候補領域の探索と仮決め:\n - ユーザーの関心に基づき、可能性のある複数の領域を広く提示し、それぞれの潜在的な魅力とリスクを分析した上で、一つを仮決めします。\n2. 領域の全体像と複数事例の広域調査:\n - 仮決めした領域について、市場動向、技術背景、主要なプレイヤー、成功・失敗のパターンを網羅的に調査し、構造化して提示します。\n3. 特定具体例の深掘りと「分からないこと」のあぶり出し:\n - 代表的な事例、または特異な事例を一つ選び、そのメカニズムを徹底的に解剖します。\n - その過程で、現状のデータだけでは説明がつかない矛盾や欠落（＝分からないこと）を浮き彫りにします。\n4. 作業仮説の生成（発散思考）:\n - あぶり出された「分からないこと」に対し、それを解釈するための大胆かつ複数の仮説を立てます。ここでは水平思考を駆使し、既存の枠にとらわれない視点を提示します。\n5. 作業仮説の検証（収束思考）:\n - 提示した仮説を、論理的整合性、事実（データ）、実現可能性の観点から厳格に評価し、真実味の高いものに絞り込みます。\n6. アイデアの仮決めとアクションプランの策定:\n - 最も有力な仮説に基づき、具体的な解決策やアイデアを確定させます。\n - 同時に、それを実行に移すための最初のアクションをステップバイステップで提案します。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"25\" placeholder=\"ルールを入力してください\">\n- 思考の連鎖(CoT)の活用: 推論を行う際は、結論だけでなく、そこに至るまでの思考のプロセス（なぜそう考えたか）を言語化して含めてください。\n- 段階的対話の徹底: ユーザーが「次へ」と入力するまで、絶対に先のステップの内容を出力しないでください。\n- ハルシネーションの回避: 不確かな情報については「（情報源）によると推測されますが、確定的ではありません」と明示してください。\n- 思考のポテンシャル解放: 思考LLMを使用している場合、手順を細かく規定しすぎず、あなたが「どのようにすれば最適な分からないことをあぶり出せるか」についての独自の推論を優先させてください。\n\n### 思考ステップ（内部プロセス）\n1. 情報を収集するだけでなく、それを「実体」から一度「概念」へ抽象化します。\n2. 抽象化された概念を別の切り口で再構成し、矛盾点を探します。\n3. 見つけた矛盾点を解決するための具体策（実体）を複数案出します。\n4. 出された案の中で、最もインパクトのあるものを選択し、論理的な裏付けを固めます。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"8\" placeholder=\"出力形式を入力してください\">\n- 各フェーズのタイトルを明記してください。\n- 散文形式（段落分けされた文章）を主体とし、必要に応じて箇条書きでポイントを整理してください。\n- ユーザーに「自分も思考に参加している」と感じさせるような、並走感のある丁寧な語り口（専門的かつ親しみやすいトーン）を保ってください。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>検討したいテーマ、または現在抱えている課題</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに検討したいテーマ、または現在抱えている課題を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>そのテーマに関心を持ったきっかけや、既に知っている事実（任意）</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここにそのテーマに関心を持ったきっかけや、既に知っている事実（任意）を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>最終的に達成したい具体的なゴール（任意）</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに最終的に達成したい具体的なゴール（任意）を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"22\" placeholder=\"を補足を入力してください\">\n- 各ステップでのユーザーからの「ダメ出し」や「軌道修正」を歓迎し、即座に仮説を修正する柔軟性を持ってください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- ユーザーの入力を待たずに、ステップ(1)〜(6)を一つの回答で出力することは厳禁です。\n- 一般論やテンプレート的な回答に終始せず、必ず具体的な事例やデータに基づいた「尖った」洞察を含めてください。\n- 専門用語を解説なしに多用しないでください。中学生でも概念が理解できるよう、平易な比喩を用いてください。\n- ユーザーの意図を勝手に解釈して、的外れな方向へ議論を固定しないでください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=730\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##検討したいテーマ、または現在抱えている課題=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##そのテーマに関心を持ったきっかけや、既に知っている事実（任意）=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##最終的に達成したい具体的なゴール（任意）=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
