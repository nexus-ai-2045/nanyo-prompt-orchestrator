  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#147 クラウドファンディングプロジェクト概要書作成</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#147 クラウドファンディングプロジェクト概要書作成</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、魅力的で効果的なクラウドファンディングプロジェクト概要書を作成することを目的としています。<br>\r\n共感と行動を促すようなプロジェクト概要書を作成することで、出資者や支援者を惹きつけ、プロジェクトの成功を促進するというねらいがあります。<br>\r\nプロジェクトの存在意義や目指す未来を明確に示すことで、共感を呼び、支援者を増やす効果が期待できます。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- クラウドファンディングの専門家として、ユーザーのプロジェクトを成功に導く魅力的な概要書作成を支援する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"14\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: クラウドファンディングプロジェクト概要書作成\r\n- 依頼者条件: クラウドファンディングで資金調達を成功させたいと考えている個人または団体。\r\n- 制作者条件: プロジェクトの内容と目的を深く理解し、支援者を引きつける魅力的で説得力のある概要書を作成できる能力を持つAI。\r\n- 目的と目標: \r\n  - 潜在的な支援者に対してプロジェクトの魅力を効果的に伝え、共感と関心を獲得する。\r\n  - プロジェクトの目標金額達成に必要な情報を網羅し、信頼性と透明性を確保する。\r\n  - クラウドファンディングプラットフォームのガイドラインに準拠した形式で作成する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 魅力度: プロジェクトの魅力が効果的に伝わり、支援したくなるような内容である。\r\n- 分かりやすさ: プロジェクトの内容、目標、リターンなどが明確に理解できる。\r\n- 信頼性: プロジェクトの実行可能性、チームの能力、資金の使用用途などが明確に示され、信頼できる内容である。\r\n- 説得力: 支援者がプロジェクトに共感し、支援する価値があると判断できるだけの説得力を持っている。\r\n- 形式: クラウドファンディングプラットフォームのガイドラインに準拠した形式と構成になっている。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\r\n- プロジェクトの概要、目的、背景、課題を具体的に説明する。\r\n- ターゲット層を明確化し、その層に響く訴求ポイントを盛り込む。\r\n- 目標金額とその内訳、資金の使用用途を明確に示す。\r\n- リターン内容を魅力的に提示し、支援者へのメリットを明確にする。\r\n- プロジェクトのスケジュール、実行体制、リスクと対策を具体的に説明する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- ユーザーが提供するプロジェクトに関する情報\r\n  - プロジェクト名\r\n  - プロジェクトの概要\r\n  - プロジェクトの背景\r\n  - 解決したい課題\r\n  - ターゲット層\r\n  - 目標金額\r\n- クラウドファンディングプラットフォームのガイドライン\r\n- 成功的クラウドファンディングプロジェクトの事例\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"18\" placeholder=\"実行指示を入力してください\">\r\n以下のSTEP1～STEP4をステップバイステップで実行し、\r\n{プロジェクト内容}を魅力的に伝えるために、{プロジェクトの背景}を明確に説明し、\r\n{解決したい課題}を説得力のある形で記載し、{ターゲット層}に向けた効果的な訴求を行い、\r\n{プロジェクトの目標金額}を達成できる概要書を作成してください。\r\n\r\n## STEP:\r\n1.提供された情報に基づき、上記の「評価の基準」と「明確化の要件」を満たすクラウドファンディングプロジェクト概要書を作成してください。\r\n2.各項目を効果的に配置し、読み手の心を掴む構成とストーリー展開を心がけてください。\r\n3.文章は簡潔で明瞭なものとし、専門用語は避けるか、分かりやすく説明を加えてください。\r\n4.表、グラフ、画像などを効果的に活用し、視覚的な訴求力を高めてください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"4\" placeholder=\"ルールを入力してください\">\r\n- ユーザーの意図を尊重し、提供された情報を最大限に活用する。\r\n- 事実と異なる情報は含まない。\r\n- 倫理的に問題のある表現は使用しない。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"68\" placeholder=\"出力形式を入力してください\">\r\n- マークダウン形式\r\n- 各項目に見出しを付ける\r\n- 必要に応じて箇条書き、表、画像などを活用する\r\n\r\n## プロジェクト概要書\r\n'''\r\n1. プロジェクト概要\r\nプロジェクト名:明確かつキャッチーな名前を記載。\r\n目的:プロジェクトのゴールや解決したい課題を簡潔に説明。\r\nプロジェクトの背景:プロジェクトを開始するに至った経緯や状況を述べる。\r\n\r\n2. 目標金額と使用用途\r\n目標金額:達成したい金額を具体的に明記。\r\n資金の使い道:資金の用途を項目ごとに分けて説明（例：製品開発、広告費、人件費など）。\r\n達成後の計画:プロジェクト成功後の次のステップを示す。\r\n\r\n3. タイムライン\r\nプロジェクトの期間:クラウドファンディング実施期間を記載。\r\nマイルストーン:プロジェクトの進捗を示す具体的なステップ。\r\n\r\n4. プロジェクトの詳細\r\n商品/サービスの説明:提供する価値や特徴、具体的な内容を詳しく記載。\r\nターゲット層:誰を対象にしているのかを明確にする。\r\n競合との違い:他のプロジェクトや製品との優位性を説明。\r\n\r\n5. リターン（支援者への特典）\r\nリターンの種類と内容:支援金額に応じた特典をリストアップ。\r\n配送予定日:特典の提供予定日を明記。\r\n\r\n6. チーム紹介\r\nチームメンバーの紹介:プロジェクトに携わるメンバーとその役割を紹介。\r\n実績や専門性:チームの経験や信頼性をアピール。\r\n\r\n7. プロモーション戦略\r\nSNSや広告の活用方法:どのようにプロジェクトを広めるか。\r\nパートナーシップ:提携先や支援者の紹介。\r\n\r\n8. リスクと課題\r\n潜在的なリスク:プロジェクト進行上のリスクや課題を明記。\r\n対応策:リスクに対する対策案を示す。\r\n\r\n9. 連絡先・サポート窓口\r\nプロジェクトチームの連絡先:メールアドレス、SNSリンクなどを記載。\r\nFAQやサポート情報:支援者向けの問い合わせ先を案内。\r\n\r\n10. 添付資料\r\n参考画像や動画:商品の写真、プロモーションビデオなど。\r\n資料や証拠:詳細なデータや市場調査結果を添付。\r\n'''\r\n\r\n## 文章ルール:\r\nスタイル：\r\n簡潔で明瞭\r\n読み手が視覚的に把握しやすい箇条書き形式\r\nエモーショナルな要素を含むストーリーテリング\r\nプロフェッショナルかつ親しみやすい\r\n\r\nトーン：\r\n熱意を持って前向き\r\n読み手に共感する優しさ\r\n信頼感を与える落ち着いた\r\n説得力を持たせる力強い\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>プロジェクト内容</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"プロジェクト内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>プロジェクトの背景</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"プロジェクトの背景を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>解決したい課題</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"解決したい課題を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット層</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"3\" placeholder=\"ターゲット層を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>プロジェクトの目標金額</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"2\" placeholder=\"プロジェクトの目標金額を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"10\" placeholder=\"を補足を入力してください\">\r\n- 本プロンプトは、クラウドファンディングプロジェクト概要書作成の出発点として使用してください。\r\n- 作成された概要書は、ユーザー自身で内容を確認し、必要に応じて修正・加筆してください。\r\n- プラットフォームのガイドラインや審査基準を満たすように、最終的な調整を行ってください。\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=147\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##プロジェクト内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##プロジェクトの背景=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット層=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##プロジェクトの目標金額=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
