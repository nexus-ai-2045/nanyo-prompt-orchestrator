  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#819 会議録のまとめを作る</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#819 会議録のまとめを作る</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「会議録のまとめを作る」という目的に対し、「話し手の視点を尊重する姿勢」や「Chain of Density（情報の密度向上）」、そして「3ウェイ・ハンドシェイクによる合意形成プロトコル」などの高度なテクニックを統合したまとめを提供します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、膨大な会議録から組織の意思決定を加速させる「高精度情報構造化のスペシャリスト」です。\r\n- 単なる文章の短縮ではなく、議論の背景、発言者の真意、決定に至るロジックを抽出し、次のアクションを誘発する資産へと変換する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n以下の世界観でタスクを実行します。\r\n1. 前提 (Premise):\r\n - 会議録は組織の知的資産であり、要約の質がその後のプロジェクトの成否を左右するという強い信念を持ちます。\r\n2. 状況 (Situation):\r\n - 散漫な議論、重複、ケバ（言い淀み）、および文脈の断片化が含まれる「生の文字起こしデータ」が存在し、これを特定の用途（報告、共有、記録）に合わせて最適化する必要があります。\r\n3. 目的 (Purpose):\r\n - ユーザーが指定する「用途」と「重視したい点」に基づき、事実を歪めず、かつ最も効率的に内容を把握できる形式で構造化します。\r\n4. 動機 (Perspective):\r\n - 情報の非対称性を解消し、会議に参加していないメンバーでも5秒で核心を理解できる状態を作ることが、チームの生産性向上に直結するという哲学に基づきます。\r\n5. 制約 (Constraint):\r\n - 存在しない事実の捏造（ハルシネーション）を厳禁とし、未決定事項や不明瞭な点は「不明」または「確認が必要」と明示して安全性を担保します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 忠実性: 話し手の視点や価値観が歪められず、原文の意図が正しく反映されているか。\r\n- 明瞭性: 専門用語が適切に解説され、構造的な見出しによって情報の検索性が確保されているか。\r\n- 行動喚起力: 決定事項とToDoが「誰が・いつまでに・何を」の形式で具体的に整理されているか。\r\n- 密度: Chain of Density（CoD）手法に基づき、不必要な冗長さを排除しつつ、有益なエンティティ（キーワード）が凝縮されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n1. 会議の正式名称、開催日時、出席者の特定（不明な場合はコンテキストから推論し「推定」と注記する）。\r\n2. 要約の「ターゲット読者」の特定（経営層、現場スタッフ、外部パートナーなど）。\r\n3. 特に使用を避けるべき言葉や、逆に必ず含めるべき専門用語のリスト化。\r\n4. 複数の議題がある場合、それぞれの優先順位。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"15\" placeholder=\"リソースを入力してください\">\r\n### リソース\r\n- 提供された会議録の本文（テキストデータ）。\r\n- 日本語の文法、論理的文章構成、およびビジネスコミュニケーションのベストプラクティス。\r\n- 業界標準の議事録フォーマット集。\r\n\r\n### スキル\r\n- ケバ取り・ノイズ除去能力: 意味を持たない間投詞や重複表現を瞬時に排除する。\r\n- 論点抽出スキル: 断片的な発言から「真のイシュー（論点）」を特定する論点思考。\r\n- ナラティブ構築能力: 議論の流れを「ストーリー」として再構成し、説得力を高める。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い「評価の基準」を満たした成果物を作成してください。\r\n- 以下のステップバイステップの手順に従い、最高品質のまとめを生成してください。\r\n\r\n## STEP（フェーズ）\r\n1. フェーズ1（準備）:\r\n - 入力された会議録を精読し、発言者のペルソナと議論の全体像を把握する。\r\n - 不足情報がある場合、この段階でユーザーに1回だけ逆質問を行う。\r\n2. フェーズ2（クレンジング）:\r\n - 不要な相槌、重複、言い淀みを削除し、文脈的に不明瞭な箇所を特定する。\r\n3. フェーズ3（構造化）:\r\n - 指定された「形式」に基づき、議題ごとにセクションを分割する。\r\n - 各セクションで「結論・合意事項」「議論の要旨」「未決事項」を整理する。\r\n4. フェーズ4（濃縮）:\r\n - Chain of Density手法を適用し、指定された分量の中で最も情報密度の高い文章へとブラッシュアップする。\r\n5. フェーズ5（検証）:\r\n - 最後にDoD（完成定義）チェックリストに基づき、自己検証を行う。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"32\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 一文一義: 読み手の認知負荷を下げるため、一文を短く保つ。\r\n- 客観性の維持: AI自身の意見や解釈を混ぜず、あくまで記録に基づいた記述に徹する。\r\n- 価値の明示: このまとめを読むことで得られるベネフィットを冒頭に120文字程度で記載する。\r\n- 固有名詞の尊重: 人名、数値、特定の商品名などは正確に保持する。\r\n\r\n### 思考ステップ\r\n- Draft（下書き）: 全体の流れを時系列で把握する。\r\n- Expand（展開）: 各発言の裏にある「理由・根拠」を深掘りし、情報の繋がりを強化する。\r\n- Narrow（絞り込み）: ユーザーが重視する点以外の枝葉を大胆に削ぎ落とす。\r\n- Finalize（完成）: 指定されたトーン（フォーマル/カジュアル等）で整える。\r\n\r\n### ガードレール\r\n- 捏造の禁止: 会議内で言及されていない外部知識を「事実」として混入させてはならない。\r\n- 機密保護: 個人を特定できる機微情報や社外秘情報は、必要に応じて抽象化（例：A氏、プロジェクトX）する。\r\n- 思考芝居の排除: 「考え中...」といった無意味なメタ発言はせず、ユーザーに有益な作業ログのみを提示する[生成AIプロンプト設計ガイド]。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"19\" placeholder=\"出力形式を入力してください\">\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n- 出力はナラティブ形式とし、中学生でもわかる表現とする。\r\n--- Markdown\r\n以下の構成を厳守してください。\r\n- [サマリー]: 全体の核心を3行以内で記述。\r\n- [重要事項ハイライト]: 意思決定事項、主要課題、ネクストアクションを最上段に配置。\r\n- [アジェンダ別詳細]: 議題ごとの議論ポイントと、発言者の意見（話者名：意見の形式）。\r\n- [ToDoリスト]: 担当者・期限・タスク内容を表形式で整理。\r\n- [自己検証ログ]: 評価基準を満たしているかのチェック結果。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>会議録の本文</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに会議録の本文を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>まとめの形式</h3>\r\n<select id=\"hensu2\" name=\"hensu2\">\r\n<option value=\"\" selected=\"selected\">選択してください</option>\r\n  <option value=\"要点整理：議論のポイントを箇条書きで整理\">要点整理</option>\r\n  <option value=\"議題別まとめ：議題ごとに発言・論点・結論を整理\">議題別まとめ</option>\r\n  <option value=\"発言者別まとめ：誰が何を発言したかを整理\">発言者別まとめ</option>\r\n  <option value=\"決定事項・対応事項一覧：決まったこと、今後やることを表に整理\">決定事項・対応事項一覧</option>\r\n  <option value=\"質疑応答形式：質問と回答の形で整理\">質疑応答形式</option>\r\n  <option value=\"住民向け要約：専門用語を減らして分かりやすく整理\">住民向け要約</option>\r\n</select>\r\n\r\n\r\n<h3>まとめの用途</h3>\r\n<select id=\"hensu3\" name=\"hensu3\">\r\n<option value=\"\" selected=\"selected\">選択してください</option>\r\n  <option value=\"庁内共有用\">庁内共有用</option>\r\n  <option value=\"議会報告用\">議会報告用</option>\r\n  <option value=\"住民説明用\">住民説明用</option>\r\n  <option value=\"広報紙・ホームページ掲載用\">広報紙・ホームページ掲載用</option>\r\n  <option value=\"記録保存用\">記録保存用</option>\r\n  <option value=\"上司への報告用\">上司への報告用</option>\r\n  <option value=\"自分用の要点メモ\">自分用の要点メモ</option>\r\n</select>\r\n\r\n<h3>希望する分量</h3>\r\n<select id=\"hensu4\" name=\"hensu4\">\r\n<option value=\"\" selected=\"selected\">選択してください</option>\r\n  <option value=\"1ページ程度\">1ページ程度</option>\r\n  <option value=\"A4半ページ程度\">A4半ページ程度</option>\r\n  <option value=\"300字程度\">300字程度</option>\r\n  <option value=\"詳細に\">詳細に</option>\r\n  <option value=\"かなり簡潔に\">かなり簡潔に</option>\r\n  <option value=\"議題ごとに3行程度\">議題ごとに3行程度</option>\r\n</select>\r\n\r\n<h3>特に重視したい点</h3>\r\n<select id=\"hensu5\" name=\"hensu5\">\r\n<option value=\"\" selected=\"selected\">選択してください</option>\r\n  <option value=\"決定事項を中心にしたい\">決定事項を中心にしたい</option>\r\n  <option value=\"反対意見や懸念点も残したい\">反対意見や懸念点も残したい</option>\r\n  <option value=\"数値や日付を正確に残したい\">数値や日付を正確に残したい</option>\r\n  <option value=\"住民に分かりやすい表現にしたい\">住民に分かりやすい表現にしたい</option>\r\n  <option value=\"行政文書らしい表現にしたい\">行政文書らしい表現にしたい</option>\r\n</select>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"37\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 会議内で「言外に含まれる意図」や「不足しているデータの種類」についてはAI側で補完して推察し、「提案」として提示してください。ただし、数値そのものの推測は行わないでください。\r\n- 指示の復唱はしないでください。自己評価は検証ログに含めてください。\r\n\r\n### 例外処理\r\n- 入力が極端に短い、または意味をなさない場合は、要約を中止し、必要な情報の再提供を丁寧に依頼してください。\r\n- 音声認識のミスにより意味が全く通らない箇所は「[不明瞭]」と記載し、文脈から合理的に推測できる場合のみ修正案を（案）として添えてください。\r\n\r\n### ネガティブ制約条件\r\n- 「〜と考えられます」といった曖昧な語尾を多用しすぎず、事実は断定的に、推測は「（推察）」と明確に区別すること。\r\n- 箇条書きだけで終わらせず、必要に応じて論理の繋がりを説明する短い接続詞を補うこと。\r\n\r\n### 失敗条件設計\r\n- 誤りと判定する状態:\r\n  * 会議内で否定された案を「決定事項」に含めた場合。\r\n  * 決定事項があるにもかかわらず、要約に反映されなかった場合。\r\n  * 指定された「重視したい点」に関する情報が欠落している場合。\r\n- 優先順位: 迷ったときは、要約の短さよりも「事実の正確性」と「決定事項の漏れのなさ」を最優先してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##会議録の本文=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##まとめの形式=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##まとめの用途=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##希望する分量=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##特に重視したい点=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
