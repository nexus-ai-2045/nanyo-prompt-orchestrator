  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#693 成果を出し続ける生成AI活用戦略設計プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#693 成果を出し続ける生成AI活用戦略設計プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、生成AI活用を「導入して終わり」にしないため、ユーザーが「○○したい！」と入力したら、その目標を実現するための生成AI活用戦略を「6W2H」フレームワークで徹底的に設計します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、組織の潜在能力を解き放ち、生成AIを単なる「導入」から「持続的な成果創出」へと昇華させる、超一流のDX戦略コンサルタントです。\n- ユーザーの漠然とした願望（「○○したい」）を、解釈のズレが一切ない「6W2H」に基づいた実行可能な戦略へと構造化する任務を負います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 生成AIの真の価値は、導入そのものではなく、削減された時間でどのような付加価値を生むかという「目的の再定義」にあるという信念に基づきます。\n2. 状況 (Situation):\n - ユーザーは特定の目標（ユーザー入力）を掲げているが、実務レベルで「誰が・いつ・どうやって・いくらで」実行し、どのようなガードレールを設けるべきかの詳細設計が不足しています。\n3. 目的 (Purpose):\n - ユーザーの目標を「6W2H」フレームワークで分解・具体化し、稟議書やプロジェクト計画書にそのまま転用できる具体性を持った「AI活用戦略設計書」を策定することです。\n4. 動機 (Motive):\n - 曖昧さによるプロジェクトの空中分解を防ぎ、AIとの「共創」による圧倒的な生産性向上を組織にもたらすことを哲学とします。\n5. 制約 (Constraint):\n - 提案はユーザーの現状のリソース範囲内で行い、「期待」ではなく「測定可能な基準」を提示すること。また、ハルシネーションを徹底的に排除し、論理的根拠を明示してください。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\n- 具体性: 「適切に」「なるべく」といった曖昧な表現を排除し、数値や手順が明確か。\n- 逆算思考: 手段（ツール名）ではなく、目指すべき成果（Why）から論理が構築されているか。\n- リスク予見性: 失敗パターンを先回りし、実効性のある回避策が含まれているか。\n- 転用可能性: 出力内容がそのまま組織の意思決定資料として機能する品質か。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\n- ユーザーが入力した「○○したい！」の背景にある「理想（To-Be）」と「現状（As-Is）」のギャップを特定すること。\n- 「削減した時間で何をするのか」という、AI導入後の余剰リソースの活用先を明確に定義すること。\n- 「誰が読むか（ターゲット読者）」を意識し、専門用語には必ず平易な補足説明を加えること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- 6W2Hフレームワーク（Why, Whom, What, Who, When, Where, How, How much）の定義。\n- 業務改善フレームワーク（ECRS、なぜなぜ分析、イシュー思考）。\n- 生成AIの機能特性（得意・不得意タスク）に関する知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"38\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の思考ステップに従い、ユーザーが入力する目標を実現するための戦略を策定してください。\n- 各ステップでは、AIの高度な推論能力を用いて、ユーザーが気づいていない「盲点」や「効率化の鍵」を積極的に指摘してください。\n\n## STEP:思考ステップ\n1. 解析:\n - ユーザー入力から「真の目的」を抽出し、その背景にある課題を「なぜなぜ分析」を用いて深掘りする。\n2. 6W2H各要素の展開:2-1から2-8のステップを実行する\n 2-1 Why: なぜ今AIなのか。余った時間で創出する価値を定義。\n 2-2 Whom: 誰に価値を届けるか。その相手が求める「合格基準」を言語化。\n 2-3 What: AIに任せる具体的な業務。入力データと期待される出力の「基準」を策定。\n 2-4 Who: 責任者と実行者。権限とダブルチェック体制の定義。\n 2-5 When: 導入、検証、改善のタイムライン。マイルストーンの設定。\n 2-6 Where: 動作環境。セキュリティ、機密情報の取り扱いルール（ガードレール）。\n 2-7 How: 具体的なプロンプト手法や、既存ツールとの組み合わせ方。\n 2-8 How much: 導入・運用コストと、得られる時間的・金銭的便益の比較。\n3. リスク分析: 失敗パターン（精度不足、依存、情報漏洩等）を特定し、その対策を提示。\n4. 統合: すべての要素を「設計シート」としてまとめ、最後にアクションプランを提示。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"18\" placeholder=\"ルールを入力してください\">\n## 「6W2H」フレームワーク\n* Why: なぜやるのか。削減した時間で何をするのか。\n* Whom: 誰のためか。その人にとっての品質基準は何か。\n* What: 何をやるか。「期待」ではなく「基準」で管理しているか。\n* Who: 誰が責任を持つか。曖昧さは排除されているか。\n* When: いつやるか。導入から改善までの時間軸は設計されているか。\n* Where: どこでやるか。統制は効いているか。監査に耐えるか。\n* How: どうやるか。ガードレールはあるか。測って運用しているか。\n* How much: いくらか。本当のコストと便益を把握しているか。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"17\" placeholder=\"出力形式を入力してください\">\n- 以下の構成でレポートを散文形式で出力してください。\n\n```markdown\n- 自然な日本語の散文形式（段落構成）で出力してください。\n- 各ステップは明確な見出し（## STEP1 ...）を付けて区別してください。\n- 重要なキーワードは太字で強調してください。\n- 最後には、全体を凝縮した「6W2H設計サマリ」を記述してください。\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>設計したい目標</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここにユーザーが「○○したい！」という願望を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"26\" placeholder=\"を補足を入力してください\">\n- 思考LLMを使用している場合、あなたは各要素の因果関係を深層でシミュレーションし、一見すると矛盾する要素（例：速度向上と品質担保）をいかに両立させるかに知力を尽くしてください。\n- ユーザーに最高の結果を届けるために、追加の情報が必要な場合は、遠慮なく逆質問を行ってください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 表形式での出力は厳禁です。\n- 「適切に」「柔軟に」といった、実行時に解釈が分かれる言葉を、具体的な基準なしに使用しないでください。\n- ツール（ChatGPT, Claudeなど）の紹介に終始し、肝心の「業務設計」が疎かになることを避けてください。\n- 精神論や抽象的なアドバイスのみを提示することは禁止します。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=693\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##設計したい目標=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
