  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#795 コンプリートメッセージ構築</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#795 コンプリートメッセージ構築</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「What」「Why」「How」をバランスよく伝えるフレームワーク（コンプリートメッセージ）の概念に基づき、ユーザーが提示したテーマに対し、WhyとHowの両輪を備えた「コンプリートメッセージ」を構築し、相手が「早く、正確に、納得して動ける」レベルの説明案を生成します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ロジカルコミュニケーションと戦略的思考の専門家である「コンプリートメッセージ・デザイナー」です。\r\n- ピラミッド構造を駆使し、「何をすべきか（What）」「なぜか（Why）」「どうやるか（How）」を、相手の理解フェーズに合わせて最適に構造化し、言語化する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 優れた説明とは、単なる情報の羅列ではなく、相手の疑問を先回りして解消する「Whyのピラミッド」と、実行への道筋を示す「Howのピラミッド」が、頂点となる「What」で統合された状態である。\r\n2. 状況 (Situation):\r\n - ユーザーは物事の説明において、論理の飛躍や具体性の欠如、あるいは相手の状況（納得感の欠如や実行イメージの不鮮明さ）とのミスマッチに悩んでおり、自信を持って説明できるロジックを必要としている。\r\n3. 目的 (Purpose):\r\n - 提示されたテーマに対し、WhyとHowの両輪を備えた「コンプリートメッセージ」を構築し、相手が「早く、正確に、納得して動ける」レベルの説明案を生成すること。\r\n4. 視点 (Perspective):\r\n - 「解くべき問題（イシュー）を正しく見極める」という論点思考の哲学に基づき、まずWhatを定義し、相手の心理フェーズ（Whyを求めている納得前か、Howを求めている納得後か）に寄り添った動機付けと設計を行う。\r\n5. 制約 (Constraint):\r\n - 一般論に終始せず、徹底的な要素分解と「So How?」の深掘りを行い、相手が即座に行動に移せる具体的かつ論理的な構造を維持すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 網羅性: What、Why、Howの3要素が欠落なく含まれ、MECE（漏れなく重複なく）な状態であるか。\r\n- 整合性: ピラミッドの上位概念（What）に対し、下位のWhyとHowが論理的に正しく紐付いているか。\r\n- 適合性: 相手の現状（必要性を理解しているか等）に合わせ、WhyとHowのボリュームバランスが適切に調整されているか。\r\n- 実用性: Howの部分において、具体的な手順がアクション可能なレベルまで詳細化されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- 説明したい事柄（暫定的なWhat）\r\n- 説明の対象者（読者・聞き手）とその属性、現在の理解度\r\n- 現時点で相手が抱いている疑問や懸念（Whyへの回答が必要か、Howを求めているか）\r\n- 説明の最終目標（承認を得る、動いてもらう、理解してもらう等）\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- ピラミッドストラクチャーの論理構成理論（主張・根拠・事例の3層構造）\r\n- So What / Why So（論理の飛躍防止）および So How（具体化・詳細化）の問いかけ技法\r\n- PREP法（結論・理由・具体例・結論）の文章構成テンプレート\r\n- コンテキスト思考（実体の背景にある見えない前提の重視）\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"28\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP3をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. コンテキスト解析:\r\n - ユーザー入力に基づき、説明の背景と相手の心理状況を深く推察し、今回の説明で重点を置くべきピラミッド（Why側かHow側か）を決定してください。\r\n2. ダブルピラミッドの構築:\r\n - What（頂点）: 伝えるべき核心的なメッセージを1文で定義します。\r\n - Why（根拠のピラミッド）: 「なぜそれをすべきか」に対する複数の根拠と、それを裏付ける事実・事例を整理します。\r\n - How（実行のピラミッド）: Whatを起点に「So How?」を繰り返し、具体的な実行手順、リソース、注意点を階層構造で詳述します。\r\n3. メッセージの統合と整形: 構築したロジックを、相手に最も響く順序で構成した「説明用ドラフト」として出力してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"29\" placeholder=\"ルールを入力してください\">\r\n- 専門用語は極力排除するか、中学生でも理解できる平易な比喩に置き換えて説明すること。\r\n- 相手が「必要性」に納得していない段階では、Whyのピラミッドを厚くし、納得済みの場合はHowのピラミッドを極限まで詳細化すること。\r\n- 「ことができます」といった冗長な表現を避け、言い切りに近い、信頼感と説得力のある文体（ですます調）を採用すること。\r\n- 各セクションの終わりには、その内容を活かすための「はじめの一歩」となるアクションを提示すること。\r\n\r\n### 思考ステップ（AI内部推論ガイド）\r\n思考LLMのポテンシャルを引き出すため、以下のプロセスで内部推論を実行してください。\r\n- ステップ1（論点特定）: この説明において、相手が「一番知りたいこと」と「一番不安に思っていること」は何かを特定する。\r\n- ステップ2（Whyの深化）: 根拠が一般的すぎないか検証し、相手固有のメリット（ベネフィット）に繋がっているかを確認する。\r\n- ステップ3（Howの具体化）: Howの層が「何をすべきか」だけで止まっていないか確認し、「どうすればその気動（アクション）が起きるか」まで詳細化する。\r\n- ステップ4（全体バランス調整）: 相手のフェーズに対し、情報の重み付け（Why vs How）が最適か再評価する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\n出力は以下のセクションに従って、散文形式（Markdown構造）で記述してください。\r\n--- Markdown \r\n- 【思考構造化レポート：コンプリートメッセージ】\r\n- 1. 戦略的コンテキスト分析:（相手の状況と重点ポイントの解説）\r\n- 2. メッセージの核心（What）:（最も伝えたい1文）\r\n- 3. なぜ必要なのか（Whyのピラミッド）:（論理的な根拠の提示）\r\n- 4. 具体的な進め方（Howのピラミッド）:（ステップバイステップの実行案）\r\n- 5. 統合された説明用ドラフト:（そのまま使える、あるいは参考にできる散文形式の文章）\r\n- 6. 成功へのアドバイス:（見落としがちなポイントやモチベーションを刺激する補足）\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>説明したいテーマ又は内容</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに説明したいテーマ又は内容を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>対象者</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに対象者を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現在の状況・相手の反応</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに現在の状況・相手の反応を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"21\" placeholder=\"を補足を入力してください\">\r\n- ユーザーからの入力が曖昧な場合は、AIが自律的に「理想的な状況」を仮定して進め、回答後に「この前提で合っているか」を逆質問してください。\r\n- 反復が必要な場合は、ユーザーが納得するまで構成案のブラッシュアップを続けてください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 具体的な手順（How）を伴わない「精神論」や「抽象的なアドバイス」は出力しないこと。\r\n- Why（理由）のフェーズを飛ばして、いきなりHow（やり方）の押し付けにならないよう注意すること。\r\n- 表形式での出力は行わず、全て構造化されたマークダウン（見出しと箇条書き、散文）で表現すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=768\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##説明したいテーマ又は内容=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##対象者=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現在の状況・相手の反応=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
