  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#079 魅力的なキャンペーン紹介文作成</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#079 魅力的なキャンペーン紹介文作成</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n・新規顧客を引き付ける革新的で魅力的なキャンペーン文案を作成する<br>\r\n・キャンペーン名・特典内容・対象者・期限・申し込み方法の要素を組み合わせ、クリエイティブで親しみやすいトーンのキャンペーン紹介文を作成する\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、マーケティングの専門家であり、魅力的なキャンペーン紹介文を作成するプロのライターです。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"7\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 魅力的なキャンペーン紹介文作成プロンプト\r\n- 依頼者条件: マーケティング担当者または広告クリエイター\r\n- 前提知識: 消費者心理やマーケティング戦略に関する基本的な知識\r\n- 目的と目標: 新規顧客を獲得するための、革新的で魅力的なキャンペーン紹介文を作成すること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 魅力的であること: ターゲットオーディエンスの心を惹きつけ、行動を起こさせる魅力的な表現であること。\r\n- 分かりやすさ: キャンペーンの内容が明確に理解できる分かりやすい文章であること。\r\n- 独自性: 他社のキャンペーンと差別化された、独自のメッセージや表現を含んでいること。\r\n- 信頼性: 事実に基づいた正確な情報を提供し、誇張表現や誤解を招く表現を避けること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"25\" placeholder=\"明確化の要件を入力してください\">\r\n1.以下の項目を明確に定義する必要があります。\r\n- キャンペーン名: キャンペーンの名称を明確に示す。\r\n- 特典内容: キャンペーンで提供される特典を具体的に説明する。\r\n- 対象者: キャンペーンの対象となる顧客を明確に定義する。\r\n- 期限: キャンペーンの開始日と終了日を明記する。\r\n- 申し込み方法: キャンペーンへの参加方法を分かりやすく説明する。\r\n- 期待される成果: このキャンペーンを通して、どのような成果を期待しているのかを定義する。（例：新規顧客獲得数、売上増加率、ブランド認知度向上など）\r\n2.競合との差別化点 を明確にする。\r\n- 既存の類似キャンペーンと比較して、どのような点で優れているのか、独自の価値を明確に示す。\r\n- 価格、品質、サービス、特典など、具体的な差別化要素を提示する。\r\n3.ターゲットオーディエンスのニーズやウォンツ を分析する。\r\n- ターゲットオーディエンスはどのような問題を抱えていて、その解決策として、このキャンペーンがどのように役立つのかを説明する。\r\n- 感情的なベネフィットも考慮し、ターゲットオーディエンスの心に響くメッセージを作成する。\r\n4.キャンペーンのストーリーを作成する。\r\n- キャンペーンの背景や目的、開発秘話などを伝えることで、顧客との共感を深める。\r\n- 感情に訴えかけるようなストーリー展開を心がける。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- キャンペーンの目的\r\n- ターゲットオーディエンスの分析\r\n- 競合キャンペーンの調査\r\n- 過去のキャンペーンの成功例と失敗例\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"37\" placeholder=\"実行指示を入力してください\">\r\n- 魅力的なキャンペーン紹介文を作成するために、以下の手順に従ってください。\r\n- STEP1～STEP7までステップバイステップで実行してください\r\n\r\n##STEP:\r\n1. ターゲットオーディエンスを水平思考を使って推察する。\r\n- 年齢、性別、職業、ライフスタイル、興味関心などを詳細に定義する。\r\n- ペルソナを設定することで、より具体的で効果的な紹介文を作成することができる。\r\n2. キャンペーンのキーメッセージを明確にする。\r\n- このキャンペーンを通して、顧客に伝えたい最も重要なメッセージは何か？\r\n- このキャンペーンを行う背景を水平思考を使って推察する。\r\n- 一文で表現できるような、簡潔で力強いメッセージを心がける。\r\n3. 顧客にとってのベネフィットを強調する。\r\n- このキャンペーンに参加することで、顧客はどのようなメリットを得られるのか？\r\n- 機能的なベネフィットだけでなく、感情的なベネフィットも考慮する。\r\n4. 行動を促す言葉を明確に示す。\r\n- 顧客にどのような行動を取ってほしいのか？\r\n- 例：「今すぐ申し込む」、「詳細を見る」、「資料請求する」など\r\n5. クリエイティブで親しみやすいトーンで記述する。\r\n- 堅苦しい表現や専門用語を避け、ターゲットオーディエンスに合った言葉遣いを選ぶ。\r\n-ユーモアや感情に訴えかける表現を取り入れることで、顧客の心を惹きつける。\r\n6. さまざまな表現方法を試す。\r\n- キャッチコピー、ストーリーテリング、質問形式、比較形式など、さまざまな表現方法を試して、最も効果的な表現を見つける。\r\n7. フィードバックを求める。\r\n- 作成した紹介文を同僚やターゲットオーディエンスに見てもらい、フィードバックを求める。\r\n- 第三者の意見を取り入れることで、より客観的に評価し、改善点を見つけることができる。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"20\" placeholder=\"出力形式を入力してください\">\r\n以下の出力フォーマットを参考に、魅力的なキャンペーン紹介文を作成してください。\r\nスタイルとトーン =クリエイティブで親しみやすいトーン\r\n\r\n## キャンペーン名: [キャンペーン名]\r\n# あなたへのメッセージ\r\n- [ストーリーテリングを使った顧客の心を惹きつける導入文、参加することのベネフィットを掲載]\r\n# 特典内容\r\n- [特典1]\r\n- [特典2]\r\n- [特典3]\r\n# 対象者\r\n- [対象者1]\r\n- [対象者2]\r\n# 期限\r\n- [開始日] - [終了日]\r\n# 申し込み方法\r\n- [申し込み方法]\r\n# 行動喚起\r\n- [今すぐ申し込む] / [詳細を見る]\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>キャンペーン名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"3\" placeholder=\"キャンペーン名を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>特典内容</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"特典内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>対象者</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"1\" placeholder=\"対象者を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>期限</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"1\" placeholder=\"期限を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>申し込み方法</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"2\" placeholder=\"申し込み方法を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"6\" placeholder=\"を補足を入力してください\">\r\n- 指示の再確認は不要です。\r\n- 結論やまとめは不要です。\r\n- 自己評価は不要です。\r\n- 上記の出力フォーマットの形式を厳守してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=79\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##項目１=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目２=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目３=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目４=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目５=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
