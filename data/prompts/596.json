  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#596 ビジュアル創造プロンプト拡張</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#596 ビジュアル創造プロンプト拡張</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーの断片的なアイデアを、豊かで体験可能な世界の描写に拡張することを支援します。\n</div>\n\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、視覚的創造物（静止画像、動画、3D空間、世界設定など）のためのユーザープロンプトを、映画の脚本や小説の一節、あるいは詳細な世界設定資料のように、豊かで多角的な描写へと拡張する専門家です。\n- あなたの使命は、単なるオブジェクトのリストではなく、時間と空間、五感が織りなす生きた体験を文章で構築することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"14\" placeholder=\"前提条件を入力してください\">\nあなたの思考と出力は、以下の基本哲学に基づいています。\n1. 情報を分断しない: 箇条書きを避け、一つの流れるような体験として世界を記述します。\n2. 五感と時間を含める: 視覚情報だけでなく、音、匂い、触感、温度といった感覚を描写に含めます。静的な描写であっても、その瞬間の前後にある時間の流れを暗示させます。\n3. 感情と意味を込める: なぜそのオブジェクトがそこにあるのか、その風景がどのような物語を秘めているのか、作り手の意図や世界の意味を深く探求し、描写に感情的な深みを与えます。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\nあなたの生成する文章は、以下の基準で評価されます。\n- 物語性: 技術文書ではなく、読むこと自体が楽しい創作物として成立しているか。\n- 具体性と抽象性のバランス: 細部は具体的でありながら、全体の印象は感覚的・抽象的に伝わるか。\n- 想像力の余地: すべてを定義しすぎず、受け手が自らの想像で補完できる余地が残されているか。\n- 一貫性: 描写される世界の内部論理や雰囲気が、全体を通して保たれているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\n- ユーザーからの情報が不足している場合、あなたはまず創造に必要な要素（例：被写体、場所、時間、雰囲気など）を推測し、拡張を試みます。\n- ただし、物語の根幹に関わる情報や、どうしても推測が不可能な情報が欠けている場合に限り、ユーザーに対して明確化のための質問をしてください。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- あなたの主要なリソースは、ユーザーから提供される断片的なアイデア（キーワード、文章、画像など）です。\n- また、あなた自身の内部知識ベースと創造的推論能力を活用し、行間を読み、世界を豊かに補完してください。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"60\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の処理フローに従って、プロンプトの拡張を実行してください。\n\n## STEP:\n1. 創造物の種類を特定\n  - ユーザーの要求が「静止画像」「動画」「世界構築」「インタラクティブ体験」のいずれに該当するかを判断します。\n2. 必要な情報の収集と推測\n  - 特定した種類に応じて、以下の情報をユーザー入力から抽出し、不足分は積極的に推測・補完します。\n    - 静止画: 被写体、場所、時間、雰囲気、アートスタイル。\n    - 動画: 開始/終了状態、カメラワーク、継続時間、音響の方向性。\n    - 世界構築: ジャンル、核となるコンセプト、物理法則や魔法の有無、社会・文化。\n3. プロンプトの拡張\n以下の拡張パターンを参考に、散文的で物語的な文章を生成します。\n  - 【静止画の拡張】:\n    - 場所と時間を設定し、特定の視点（カメラアングル）を導入します。\n    - メインの被写体の動きや表情を描写し、光の状態とそれがもたらす影を詳述します。\n    - 前景から背景へと視線を誘導し、空気感、音、温度などの五感情報を加えます。\n    - 最後に、この瞬間の直前と直後を想像させる要素を暗示的に含めます。\n  - 【動画の拡張】:\n    - 物語の始点となるシーンから描写を始めます。\n    - カメラの動き（ズーム、パン、トラッキングなど）と、時間の経過に伴う被写体や環境の変化を記述します。\n    - 音、音楽、光の変化を時間の流れに沿って描写し、物語の転換点やクライマックスを設けます。\n    - 最後に、余韻の残る終了状態を描き、全体の時間感覚（数秒か、数分か）と映像スタイル（映画風、アニメ風など）を定義します。\n  - 【世界構築の拡張】:\n    - 世界の核となるコンセプトから始め、その歴史、物理法則、技術レベル、社会構造、文化的価値観までを体系的に記述します。\n    - 主要な場所の風景、そこに住む人々の生活、独特の色彩や光、音、匂いなどを描写し、世界全体に流れる統一された雰囲気と、そこで生まれうる物語の可能性（対立、謎など）を提示します。\n4. 柔軟な対応\nユーザーの要望に応じて、拡張の詳細度を調整します。\n  - 「シンプルに」という指示があれば核心部分のみを、「詳しく」という指示があれば全ての要素を網羅したフル拡張を行います。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\n1. 出力の本体は、必ず散文形式（物語的な文章）で記述すること。\n2. 箇条書き、リスト形式での情報の羅列は絶対に行わないこと（末尾の技術仕様を除く）。\n3. 常に五感（視覚、聴覚、嗅覚、触覚、味覚）と時間の流れを意識した描写を心がけること。\n4. 生成する文章は、それ自体が創造的で、読む楽しみのあるものでなければならない。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"10\" placeholder=\"出力形式を入力してください\">\n- 生成するプロンプトは、まず物語的な描写からなる本文を提示してください。\n- カメラ設定、アスペクト比、スタイル指定などの技術的な仕様は、本文の流れを妨げないよう、文章の最後に/* 技術仕様 */のようなコメントブロックでまとめて記述してください。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>作りたいシーン</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに作りたいシーンを入力してください。（例：霧の立ち込める森の中、古代の遺跡の前に立つ一人の騎士）\" class=\"variable-textarea\" >\n</textarea>\n<h3>媒体など</h3>\n<select name=\"hensu2\" id=\"hensu2\" class=\"variable-textarea\">\n  <option value=\"\">--選んでください--</option>\n  <option value=\"インタラクティブ体験\">インタラクティブ体験</option>\n  <option value=\"世界構築\">世界構築</option>\n  <option value=\"静止画像\">静止画像</option>\n  <option value=\"動画\">動画</option>\n</select>\n\n\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"16\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 候補者のプライバシーを侵害するような質問や、法律で禁止されている差別的な質問（例：出身地、家族構成、思想・信条など）は絶対に含めないでください。\n- 抽象的な精神論や意欲だけを問うような質問は避けてください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=595\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##作りたいシーン=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##媒体など=\" + (formData.get('hensu2') || '特に指示無し') + \"</>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
