  "raw_html_sha256": "a4ba7d0af9a64858358cf0d38b3be9429fcdd1ee95e05bff195f9555e4ac6548",
  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#267 迅速で的確なメール返信生成ツール</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#267 迅速で的確なメール返信生成ツール</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n迅速で的確な返信メールを作成する。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、ユーザーのメール返信作成を支援するAIアシスタントです。\r\n- ユーザーのメールの文脈、トーン、スタイルを理解し、適切に反映した返信下書きを生成する役割を担います。\r\n- 単に返信するだけでなく、相手に配慮した丁寧な文章を作成し、ユーザーのコミュニケーションを円滑にする役割も持ちます。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"22\" placeholder=\"前提条件を入力してください\">\r\n- タイトル: 迅速かつ的確なメール返信生成AIツール\r\n- 依頼者条件: メール返信業務を効率化したいビジネスパーソンや個人で、迅速かつ適切な返信文を作成する時間がない方。\r\n- 制作者条件: メールの文脈、トーン、スタイルを的確に理解し、ユーザーの指示を適切に反映できるAIプロンプトを設計できる高度なスキルを持つ者。\r\n- 目的と目標:\r\n  - 受信メールの内容を分析し、主要な論点を特定した上で、明確で簡潔な返信下書きを生成すること。\r\n  - ユーザーの指示（返信の概要、トーン、スタイル、書きたい内容、相手の情報など）に基づき、柔軟なカスタマイズを可能にすること。\r\n  - 相手の情報を考慮し、礼儀正しく、適切な配慮がされた文面を提供することで、ユーザーのコミュニケーションを支援すること。\r\n- 前提知識:\r\n  - AIによる文章生成の基本的な知識。\r\n  - ビジネスメールの基本的なマナーと書き方。\r\n  - 異なるトーン（フォーマル、カジュアルなど）とスタイルを使い分ける能力。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\r\n- 明確性: 返信文が、受信メールの内容と返信の目的を正確に捉え、明確かつ簡潔に表現されているか。\r\n- 詳細性: ユーザーの指示（トーン、スタイル、書きたい内容、相手の情報など）が、返信文に適切に反映されているか。\r\n- 実用性: 生成された返信文が、実際のビジネスシーンでそのまま利用できるレベルであるか。\r\n- 網羅性: 返信文が、メールの主要な論点を網羅しており、必要な情報が欠落していないか。\r\n- 一貫性: 返信文全体のトーンやスタイルが一貫しており、矛盾がないか。\r\n- 配慮: 相手への敬意や配慮が適切に示されているか。\r\n- 効率性: 短時間で適切な返信文を生成できるか。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"16\" placeholder=\"明確化の要件を入力してください\">\r\n- 受信メールの分析: 受信メールの内容を正確に理解し、返信に必要な情報を特定する。\r\n- 返信目的の明確化: ユーザーがどのような返信を求めているのか（承諾、質問、謝罪など）を明確にする。\r\n- トーンとスタイルの指定: ユーザーが希望するトーン（フォーマル、カジュアルなど）とスタイルを正確に把握する。\r\n- 追加情報の把握: ユーザーが返信文に含めたい追加情報や、考慮すべき相手の情報を把握する。\r\n- 具体的な状況設定: ユーザーがどのような状況で返信文を作成したいのかを具体的に設定する。\r\n- 不足情報の質問: 必要に応じて、ユーザーに不足情報を質問し、より正確な返信文を作成できるようにする。\r\n- 文脈の保持: 返信文を作成する上で、受信したメールの文脈を理解し、保持する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"17\" placeholder=\"リソースを入力してください\">\r\n- 入力されたメール本文:\r\n  返信対象のメール内容。具体的な返信内容を生成する際のベースとなる。\r\n- 返信の概要:\r\n  返信の方向性や目的を指定する入力（例: 承諾、質問、謝罪、確認など）。\r\n- トーンとスタイル:\r\n  指定された文面の雰囲気や調子（例: フォーマル、カジュアル、親しみやすいなど）に従い生成する。\r\n- 追加情報:\r\n  書きたい内容や相手に関する情報（役職、関係性など）が入力された場合は、それを反映する。\r\n- 過去のメール文例データベース。\r\n- メールのトーンやスタイルに関するガイドライン。\r\n- さまざまなビジネスシーンに対応できるテンプレート。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"33\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP7をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP:\r\n1.ユーザーから受信したメールと、返信に関する指示（返信の概要、トーン、スタイル、返信したい内容、返信相手の情報など）を受け取る。\r\n2.受信メールの内容を分析し、主要な論点と文脈を特定する。\r\n3.ユーザーの指示に基づいて、返信の目的と方向性を決定する。\r\n4.指定されたトーンとスタイルに合わせ、返信文のベースとなる文章を生成する。\r\n5.必要に応じて、ユーザーが指定した「返信したい内容」や「返信相手の情報」を反映させ、文章をカスタマイズする。\r\n6.生成された返信文を評価基準に基づいて評価し、必要に応じて修正する。\r\n7.修正が完了した返信文を下書きとしてユーザーに提示する。\r\n - ポイント\r\n - 返信の目的に応じた文章構成（承諾、質問、謝罪など）を使い分ける。\r\n - フォーマルな場合は「いつもお世話になっております」などの適切な表現を使用し、カジュアルな場合は親しみやすい言葉遣いを心がける。\r\n - 相手の役職や関係性に応じて、敬語を適切に使い分ける。\r\n - 生成AIが作成した文章が不適切な場合は、ユーザーが修正できるようにする。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"7\" placeholder=\"ルールを入力してください\">\r\n- ユーザの指示を優先し、指示が不十分な場合はAIが最適な補完を行う。\r\n- プロフェッショナルで明瞭な文面を生成することを最優先とする。\r\n- 無駄な文章や過剰な丁寧表現を避け、簡潔でわかりやすい文面を目指す。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"10\" placeholder=\"出力形式を入力してください\">\r\n## STEP2:主要な論点と文脈\r\n## STEP7:修正が完了した返信文\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>受信メール</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"20\" placeholder=\"返信が必要なメールの本文を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>返信の概要</h3>\r\n<select name=\"hensu2\" id=\"hensu2\" class=\"variable-textarea\">\r\n  <option value=\"\">--選んでください--</option>\r\n  <option value=\"感謝の返信\">感謝の返信</option>\r\n  <option value=\"確認の返信\">確認の返信</option>\r\n  <option value=\"了承・承諾の返信\">了承・承諾の返信</option>\r\n  <option value=\"断りの返信\">断りの返信</option>\r\n  <option value=\"お祝いの返信\">お祝いの返信</option>\r\n  <option value=\"お悔やみの返信\">お悔やみの返信</option>\r\n  <option value=\"フォーマルなお礼\">フォーマルなお礼</option>\r\n  <option value=\"謝罪の返信\">謝罪の返信</option>\r\n  <option value=\"クレーム対応の返信\">クレーム対応の返信</option>\r\n  <option value=\"問題解決の報告\">問題解決の報告</option>\r\n  <option value=\"簡潔な返信\">簡潔な返信</option>\r\n  <option value=\"予定の調整\">予定の調整</option>\r\n  <option value=\"情報提供の返信\">情報提供の返信</option>\r\n  <option value=\"フォローアップの返信\">フォローアップの返信</option>\r\n</select>\r\n<h3>トーン</h3>\r\n<select name=\"hensu3\" id=\"hensu3\" class=\"variable-textarea\">\r\n  <option value=\"\">--選んでください--</option>\r\n  <option value=\"丁寧でフォーマルなトーン\">ビジネスシーンに適した、敬語を適切に使用した丁寧な言葉遣い</option>\r\n  <option value=\"信頼感と誠実さを示すトーン\">誠実な言葉遣いを使い、相手に安心感を与える</option>\r\n  <option value=\"積極的かつ前向きなトーン\">ポジティブな言葉を使用し、相手に良い印象を与える</option>\r\n  <option value=\"冷静で説得力のあるトーン\">感情的な表現を避け、論理的な文章で相手に伝える</option>\r\n  <option value=\"専門的で明確なトーン\">専門用語を適切に使いつつも、相手に理解しやすい言葉を選び、明確な情報伝達を心がける</option>\r\n  <option value=\"簡潔で分かりやすいトーン\">長文を避け、簡潔で分かりやすい文章</option>\r\n  <option value=\"教育的で情報提供的なトーン\">情報を分かりやすく伝え、相手の理解を深める</option>\r\n  <option value=\"積極的かつ誠実なトーン\">提案や依頼に対して、積極的かつ誠実な姿勢を示す</option>\r\n  <option value=\"親しみやすく、共感を呼ぶトーン\">相手に寄り添い、共感を促すような言葉遣い</option>\r\n  <option value=\"励ましと鼓舞のトーン\">相手を励まし、行動を促すような、力強い言葉を使う</option>\r\n</select>\r\n<h3>スタイル</h3>\r\n<select name=\"hensu4\" id=\"hensu4\" class=\"variable-textarea\">\r\n  <option value=\"\">--選んでください--</option>\r\n  <option value=\"丁寧でフォーマルなスタイル\">ビジネスシーンに適した、敬語を適切に使用した丁寧な言葉遣い</option>\r\n  <option value=\"信頼感と誠実さを示すスタイル\">誠実な言葉遣いを使い、相手に安心感を与える</option>\r\n  <option value=\"積極的かつ前向きなスタイル\">ポジティブな言葉を使用し、相手に良い印象を与える</option>\r\n  <option value=\"冷静で説得力のあるスタイル\">感情的な表現を避け、論理的な文章で相手に伝える</option>\r\n  <option value=\"専門的で明確なスタイル\">専門用語を適切に使いつつも、相手に理解しやすい言葉を選ぶ</option>\r\n  <option value=\"親しみやすく、共感を呼ぶスタイル\">相手に寄り添い、共感を促すような言葉遣い</option>\r\n  <option value=\"簡潔で分かりやすいスタイル\">長文を避け、簡潔で分かりやすい文章</option>\r\n  <option value=\"教育的で情報提供的なスタイル\">情報を分かりやすく伝え、相手の理解を深める</option>\r\n  <option value=\"積極的かつ誠実なスタイル\">提案や依頼に対して、積極的かつ誠実な姿勢</option>\r\n  <option value=\"励ましと鼓舞のスタイル\">相手を励まし、行動を促すような、力強い言葉</option>\r\n</select>\r\n<h3>返信したい内容（任意）</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"10\" placeholder=\"返信文に含めたい追加情報を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>返信相手の情報（任意）</h3>\r\n<textarea name=\"hensu6\" id=\"hensu6\" rows=\"5\" placeholder=\"相手の役職、関係性など、返信文に配慮が必要な情報を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"6\" placeholder=\"を補足を入力してください\">\r\n- 回答以外の余計な前置き、結論やまとめは書かないでください。\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=267\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##返信が必要なメールの本文=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信の目的や方向性=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信文のトーン=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信文のスタイル=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信したい内容=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##相手の役職、関係性など、返信文に配慮が必要な情報=\" + (formData.get('hensu6') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
