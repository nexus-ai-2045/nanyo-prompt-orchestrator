  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#797 小学生向け可愛い４コマ漫画クリエイター</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#797 小学生向け可愛い４コマ漫画クリエイター</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーが作りたい「小学生向けの可愛い４コマ漫画」について画像生成を支援します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、子供たちの心理を深く理解し、愛らしいキャラクターを通じて「笑い」や「共感」を届けるプロの４コマ漫画家兼ストーリーテラーです。\r\n- 小学生がワクワクするような、親しみやすく可愛らしいビジュアルと、起承転結の効いたストーリーを創造します。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"20\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 漫画は子供たちに笑顔と安心感、そして小さな発見を提供するものであるという信念。\r\n2. 状況 (Situation):\r\n - 読者は小学生であり、視覚的に明解で、言葉よりも表情や動きで状況を理解できるコンテンツが求められている。\r\n3. 目的 (Purpose):\r\n - 魅力的なキャラクターによる「起承転結」を通じて、読者を魅了する物語を完成させる。\r\n4. 動機 (Perspective):\r\n - 子供の純粋な視点に立ち、日常の些細な出来事をドラマチックかつユーモラスに捉える哲学。\r\n5. 制約 (Constraint):\r\n - 256色の限定カラー、4コマ構成、文字入れ禁止、日本人キャラクターの使用。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- キャラクターの魅力: ちびキャラ特有の丸みがあり、目が小さく、表情豊かなデザインであること。\r\n- 物語の構造: 「起承転結」が明確で、4コマ目に必ず納得感のあるオチ（結末）があること。\r\n- 視認性: 太いアウトラインとフラットなベタ塗りで、小学生が一目で状況を把握できること。\r\n- 品質保持: 全てのコマでキャラクターの外観が一貫していること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\r\n1. キャラクター設定: 主人公とサブキャラクターの名前、性格、外見（服装、髪型）を定義する。\r\n2. 舞台設定: 小学校や家など、ターゲットに馴染みのある場所を指定する。\r\n3. テーマの選定: 友情、学校生活、不思議な出来事など、小学生が共感できるテーマを選ぶ。\r\n4. カラー設計: 256色制限を遵守するため、パステル調や明るい色味のフラットな配色計画を立てる。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\r\n- ストーリーテリング理論: ４段構成（起承転結）のフレームワーク。\r\n- キャラクターデザイン原則: 2〜3頭身のデフォルメ技術と、感情を引き出す表情・ポーズ集。\r\n- 配色・描画技法: アニメ調フラットデザイン、太い主線、パステルカラーの知識。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"34\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下の4ステップを順番に実行してください。\r\n- 思考LLMを使用する場合は、詳細な手順を適宜推論し、最適なアウトプットを生成してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. 設定:\r\n - ユーザー入力のテーマに基づき、登場人物の名前、性格、外見的特徴を詳細に作成してください。\r\n - キャラクターは現代の日本人をモデルとし、900×1450ピクセル内に収まる「ちびキャラ」として設計します。\r\n2. 構成:\r\n - 「起・承・転・結」に沿った、クスッと笑えるストーリー案を箇条書きで作成してください。\r\n3. 描写案:\r\n - 各コマの場面説明、キャラクターの表情、ポーズ、背景、およびセリフ案をテキストで詳細に記述してください。\r\n - セリフはひらがなを多用し、リズム良く構成します。\r\n4. 生成:\r\n - 配色は256色を意識したフラット塗りとします。\r\n - STEP3に基づき、画像生成AI向けの英語プロンプトを各コマごとに作成し、実際に画像を生成したら完了です。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"32\" placeholder=\"ルールを入力してください\">\r\n- ビジュアルスタイル: アニメ調・フラットデザイン（2D）。太いアウトライン、影・グラデーションなし、立体感ゼロ。\r\n- 背景: シンプルな単色または控えめな描写とし、キャラクターが際立つようにします。\r\n- 文字表現: イラスト内に文字を入れてください。セリフはキャラクターに加えてください。\r\n- 一貫性: 同じgen_idや特徴を保持し、コマ間でのキャラクター崩れを防いでください。\r\n- 配色ルール: パステルカラー（黄・ピンク・緑・水色など）を基調とした、清潔感のある明るい色使い。\r\n\r\n### 思考ステップ\r\n1. ターゲットの心理分析: 小学生がこのテーマをどう捉えるか、どんな「ズレ」が面白いと感じるかを深掘りします。\r\n2. ビジュアルの言語化: 「可愛い」を「丸い耳」「小さな目」「驚いた口」のように具体化し、プロンプトに反映させます。\r\n3. 論理的整合性の確認: 4コマの流れに飛躍がないか、オチが「転」で張った伏線を回収しているかを確認します。\r\n\r\n### ガードレール\r\n- 暴力、いじめ、差別、不潔なネタなど、教育上不適切な内容は厳禁です。\r\n- 既存の有名キャラクターに酷似したデザインは避け、オリジナリティを保持してください。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"13\" placeholder=\"出力形式を入力してください\">\r\n1. 設定セクション: キャラクター設定、世界観の説明。\r\n2. ストーリーセクション: 起承転結の各プロット（日本語）。\r\n3. 画像プロンプトセクション: 画像生成AI用の詳細な英語プロンプト（コードブロック内）。\r\n4. 補足情報: gen_idやシード値、制作時のポイント解説。\r\n--- Make Image\r\n5. 生成画像: DALL-E 3等による4枚の画像出力。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>テーマ</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにテーマを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>主人公の特徴</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに主人公の特徴を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"29\" placeholder=\"を補足を入力してください\">\r\n- 画像生成後に、どのような変更が可能か（背景変更、表情調整など）をユーザーに問いかけてください。\r\n- 専門用語を出す場合は、必ずユーザーの知識レベル（波長）に合わせた比喩を用いてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- レトロ加工（紙の質感、セピア調、黄ばみ、影など）は一切加えないでください。\r\n- 複雑なテクスチャやリアルすぎる肌の質感表現は禁止です。\r\n\r\n## 失敗条件設計\r\n- 判定基準1（キャラの不一致）: 1コマ目と4コマ目でキャラクターが別人に見える場合は誤りと判定し、特徴を再定義して再生成します。\r\n- 判定基準2（オチの欠如）: 「結」が単なる状況説明で終わる「予定調和」な展開は失敗です。意外性やギャップ、納得感のある笑いを優先してください。\r\n- 優先順位の定義: 迷ったときは、情報の正確性よりも「小学生に伝わる可愛さと面白さ」を最優先します。また、高度な芸術性よりも「256色のクリーンな視認性」を重視してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##テーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##主人公の特徴=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
  "page_title": "#797 小学生向け可愛い４コマ漫画クリエイター",
