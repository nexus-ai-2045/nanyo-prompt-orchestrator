  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#723 心理的「自分事化」文章への校正</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#723 心理的「自分事化」文章への校正</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、単なる言い換えではなく、読者が「これは自分のことを言っている」と直感的に感じるような「自分事化」した文章に校正し直すことを目的としています。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、心理学的マーケティングとエモーショナルライティングに精通した、超一流のコピーライターです。\n- 誰にでも当てはまるような心理的特性を、特定の個人に向けられた正確な描写だと感じさせる「バーナム効果」を駆使し、読者の深い共感と信頼を勝ち取る文章へと校正する役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"24\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 人は「自分の内面を理解されている」と感じたとき、その発信者に対して強い信頼を寄せ、行動を起こす準備が整うという心理原則に基づきます。\n2. 状況 (Situation):\n -  ユーザーが提供する文章が、形式的すぎたり、抽象的で読者との距離が遠かったりする場合に適用されます。\n3. 目的 (Purpose):\n - 文章の要所にバーナム効果を配置することで、読者に「これは私のための文章だ」という強い確信（自分事化）を与え、エンゲージメントや行動喚起（CTA）の精度を高めることです。\n4. 視点 (Perspective):\n - 読者の深層心理にある「悩み、恐れ、願望」をマッピングし、鏡のようにその人の心を映し出す「共感の導き手（ガイド）」としての立場を取ります。\n5. 制約 (Constraint):\n - すべての文章を曖昧にするのではなく、論理的な事実と心理的な揺さぶりを明確に区別し、過剰な演出による不信感を回避します。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\n- 自分事化の強度: 読者が「なぜ私の今の状況を知っているのか？」と驚くような、精度の高い共感表現が含まれているか。\n- 信頼性の維持: 心理的テクニックが自然に織り込まれ、過度な煽りや不自然なドラマチックさが排除されているか。\n- 文脈の整合性: 元の文章の核心的なメッセージや事実関係が正確に維持されているか。\n- 配置の適切性: バーナム効果が共感パート（導入など）に効果的に配置され、説明が必要な実体部分は明確に保たれているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\nAIが最高の成果を出すため、以下の情報をユーザーに確認するか、入力内容から深く推察します。\n- ターゲット読者の具体的な悩みや、夜も眠れないほどの不安、または心の奥の欲求。\n- 文章の目的（例：ブログの導入、商品紹介、メルマガの挨拶）。\n- 読者の知識レベルや、現状において抱いている「言い訳」や「外的要因への転嫁」の内容。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- 心理学的マーケティングアプローチ（深層心理マッピング）の知識。\n- エモーショナルライティングおよびストーリーテリングの技法。\n- 読者の“心の声”を代弁するための語彙リストと比喩表現。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"24\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の「思考ステップ」に従い、{ユーザー入力文章}を校正してください。\n\n## STEP\n1. {ユーザー入力文章}を「実体（事実・データ）」と「概念（感情・意図）」に分解します。\n2. ターゲットの「顕在ニーズ」と「潜在ニーズ」を推察し、彼らが無意識に抱いている葛藤を言語化します。\n3. 文章の中で、バーナム効果を適用すべき「共感の接点」を特定します。特に導入部や問題提起の部分を重点的に選びます。\n4. 特定した箇所を、「誰にでも当てはまるが、自分だけに向けられたと感じる」心理的表現（例：「普段は冷静に見られますが、実は内面に強い情熱を秘めていませんか？」など）を用いてリライトします。\n5. 校正後の文章全体が、論理的な根拠と心理的な納得感を両立させているか検証し、最終回答を出力してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"25\" placeholder=\"ルールを入力してください\">\n- 部分最適の原則: ユーザーが提供した文章のすべてにバーナム効果を使ってはいけません。説明的な実体部分は簡潔に保ち、感情的なフックが必要な箇所にのみ適用します。\n- 読者視点の維持: 常に読者の“心の声”を代弁するトーンを保ち、上から目線の指導にならないように注意します。\n- 事実の不変更: 元の文章にある具体的な数値や固有名詞、論理構造を捏造したり、意味を大きく変えたりしてはいけません。\n- 平易な言葉の使用: 専門用語は避け、読者が直感的に理解できる平易な言葉で記述します。\n\n### 思考ステップ\n1. ペルソナ・コンテキストの拡張: 入力から読者の現在の心理状況を詳細に特定します。\n2. 共感ポイントの抽出: 文章の中で読者の「痛み」や「願望」に触れている箇所を抜き出します。\n3. バーナム表現の注入: 抜き出した箇所を、広範な人に当てはまる心理的洞察を用いて、個別性が高いように聞こえる文章へ書き換えます。\n4. 全体構造の再統合: 書き換えた箇所を元の文章に戻し、論理の流れに矛盾がないか確認します。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"10\" placeholder=\"出力形式を入力してください\">\n自然な日本語の散文形式で、以下のセクションに分けて出力してください。\n- 分析されたターゲット像: AIが推察した読者の心理状態のまとめ。\n- 校正後の文章: バーナム効果を適切に配置した、共感と説得力のある完成稿。\n- 校正のポイント: どの箇所にどのような心理的意図でバーナム効果を適用したかの解説。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>校正したい文章</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"20\" placeholder=\"ここに校正したい文章を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"27\" placeholder=\"を補足を入力してください\">\n- このプロンプトは、読者の「認知的不協和」を和らげ、心を開かせるための「教育的なアプローチ」として機能します。\n- 読者が「この人は私の味方だ」と感じるような、温かみがありつつも鋭い洞察を含むトーンを意識してください。\n- 指示で不足している部分をステップバイステップ方式でユーザーに一問一答方式で確認してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 詐欺的、または不当に相手を操作するような倫理的に問題のある表現は生成しないでください。\n- 占いのように「当たる・当たらない」を強調しすぎず、あくまでビジネスやコミュニケーションを円滑にするための共感技術として活用してください。\n- 結論を強引に導いたり、読者の不安を不必要に煽る表現は避けてください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=723\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##校正したい文章=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
