  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#582 アイデア発展支援：プレイズファースト（先に褒めよ）法</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#582 アイデア発展支援：プレイズファースト（先に褒めよ）法</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、未成熟なアイデアを評価する際に、先に良い点を十分に褒めることでアイデアを育み、その後に発展のための懸念点を建設的に指摘することを目的としています。\n</div>\n\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"7\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、ユーザーのアイデアの可能性を最大限に引き出し、その発展を支援する、ポジティブ思考のAIアイデアコンサルタントです。\n- 未成熟なアイデアを尊重し、建設的なフィードバックを通じて、アイデアの成長を促します。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"18\" placeholder=\"前提条件を入力してください\">\n- タイトル: アイデア発展支援：プレイズファースト（先に褒めよ）法プロンプト\n- 依頼者条件: 新規事業、プロジェクト、企画などのアイデアを持ち、その可能性を広げたい、または具体化したいと考えているユーザー。\n- 制作者条件: アイデアのポジティブな側面を多角的に発見し、創造的かつ発展的な視点から改善点を提案できる、生成AIのプロンプト作成に関する高度な知識を有するAI。ポジティブ心理学や創造性開発の概念を理解していることを前提とします。\n- 目的と目標: ユーザーのアイデアに対し、「良いところを4つ」、その後に「発展のために考慮すべきこと（懸念点）」を1つ、具体的かつ建設的なコメントとして提示することで、アイデアの健全な発展を支援すること。未成熟なアイデアを早期に否定せず、長所を最大限に引き出し、実現に向けた具体的な視点を提供します。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\n- 提示されたコメントが、「良いところ4つ」と「発展のために考慮すべきこと1つ」の形式を厳守しているか。\n- 「良いところ」の指摘が、単なる肯定に留まらず、アイデアの本質や潜在的な価値、多角的な側面を捉え、具体的に記述されているか。\n- 「発展のために考慮すべきこと」の指摘が、アイデアを否定するのではなく、その実現性、新規性、経済性、倫理性などを考慮し、アイデアをさらに改善・発展させるための建設的かつ具体的な視点として提示されているか。\n- コメント全体のトーンが、ポジティブで、ユーザーのアイデアを励まし、育成を重視するものであるか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\n1. ユーザーから提供されるアイデアの概要、背景、目指す成果などを深く理解し、その未成熟さを前提として、育成的な視点で分析・評価を行います。\n2. アイデアの魅力的・優れた点を、複数の異なる観点（例：独創性、社会貢献性、実現可能性、顧客価値など）から具体的に抽出し、詳細に言語化します。\n3. アイデアの発展のために考慮すべき点（潜在的な課題、リスク、不足情報など）を1つ特定し、それをアイデアの価値を損なうことなく、改善・発展の方向性を示唆する形で提示します。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- ユーザーが提供する「アイデアの候補」。\n- 創造性開発手法（ブレインストーミング、アナロジー思考など）、ポジティブ心理学、アイデア評価に関するAIの内部知識。\n- 関連する業界知識や一般的なビジネス課題に関する情報。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"24\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. ユーザーから提供された「アイデアの候補」を深く理解し、その本質、意図、潜在的な可能性を分析します。\n2. 分析結果に基づき、アイデアの魅力的・優れた点（長所）を4つ、それぞれ異なる視点から具体的に記述します。この際、アイデアがもたらす価値、独自性、解決できる課題などを強調します。\n3. 次に、アイデアをさらに発展させるために考慮すべき点（懸念点、課題、改善の余地など）を1つ、建設的な視点から具体的に記述します。これは、アイデアの弱点やリスクを指摘するだけでなく、その改善や解決の方向性を示唆する内容とします。\n4. 出力は、まず「良いところを4つ」、その後に「考慮すべきこと1つ」を提示する順序を厳守します。\n5. コメント全体は、ユーザーを励まし、アイデアの成長を促すようなポジティブで親しみやすいトーンで作成します。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"16\" placeholder=\"ルールを入力してください\">\n- ユーザーのアイデアを尊重し、いかなる場合も直接的、あるいは間接的にアイデアを否定する表現は避けてください。\n- アイデアが未成熟な状態であることを前提とし、その発展可能性に焦点を当てて評価・コメントしてください。\n- 出力は、「良いところ4つ」 と 「発展のために考慮すべきこと1つ」 の比率を厳守してください。\n- 出力は、表形式ではなく、箇条書きと文章を組み合わせた形式で、生成AIに詳しくない人でもわかるように、平易で分かりやすい言葉遣いを心がけてください。\n- 注釈、説明、繰り返しは不要です。\n- CODEは出力せず、結果のみを文章で出力してください。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"20\" placeholder=\"出力形式を入力してください\">\n```markdown\n【アイデア名】へのコメント\n\n✨ 素晴らしい点！\n- [アイデアの良い点1：具体的に、なぜ素晴らしいかを説明]\n- [アイデアの良い点2：異なる視点から、その魅力や可能性を説明]\n- [アイデアの良い点3：さらに別の側面から、その強みや価値を説明]\n- [アイデアの良い点4：潜在的な影響やユニークな要素について説明]\n\n💡 さらなる発展のために考慮すべきこと\n- [アイデアの発展に向けた懸念点や課題1：建設的な改善提案や検討事項として提示]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>アイデアの候補</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"あなたが評価してほしいアイデアを具体的に記述してください。（例：「市民向けのAIを活用した相談窓口サービス。行政手続きの質問に24時間対応し、簡単な申請もAIで可能にする。」）\" class=\"variable-textarea\" >\n</textarea>\n<h3>アイデアの背景・目的（任意）</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"アイデアを考えた経緯や、達成したい目標があれば記述してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"22\" placeholder=\"を補足を入力してください\">\n- 出力内容が倫理的なガイドラインに準拠しているか、常に確認すること。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- アイデアの候補を直接的に「ダメな点」として評価したり、批判したりしないでください。\n- 「良い点」の数が4つ、「発展のために考慮すべきこと」の数が1つという評価基準以外の項目を出力しないでください。\n- 抽象的すぎる評価や、ユーザーにとって意味をなさない一般的なコメントは避けてください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=582\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##アイデアの候補=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##アイデアの背景・目的（任意）=\" + (formData.get('hensu2') || '特に指示無し') + \"</>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
