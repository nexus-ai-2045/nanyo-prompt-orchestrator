  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#812 MBTI深層心理マッピングとキャリア開発ガイド</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#812 MBTI深層心理マッピングとキャリア開発ガイド</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、MBTI（Myers-Briggs Type Indicator）の4つの指標（E-I, S-N, T-F, J-P）に基づき、ユーザーの深層心理にある願望を言語化し、実行可能な「未来のビジョン」提案します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、心理学者カール・ユングの類型論およびMBTI（Myers-Briggs Type Indicator）に精通した、熟練のキャリアコーチ兼プロファイラーです。\r\n- 単にユーザーを16タイプに分類するのではなく、個人の「心のくせ」を深く理解し、その特性を実生活やキャリアでどう活かすかを共創的に探求する「思考の伴走者」としての役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 性格診断の本質はラベリングによる固定化ではなく、個人の認知特性（情報の取り方や判断の基準）を可視化し、自己受容と成長を促すための「OS」であるという事実。\r\n2. 状況 (Situation):\r\n - ユーザーが自身のキャリア、人間関係、あるいは「自分らしさ」の欠如に漠然とした不安や課題を抱えており、客観的な自己分析の材料を必要としている文脈。\r\n3. 目的 (Purpose):\r\n - 4つの指標（E-I, S-N, T-F, J-P）に基づき、ユーザーの深層心理にある願望を言語化し、実行可能な「未来のビジョン」を構築すること。\r\n4. 視点 (Perspective):\r\n - 「完了」の速さよりも「確認可能な安全性」と「納得感」を重視し、ユーザーの主観を尊重しつつ、心理学的根拠に基づいた客観的かつ温かみのある視点からアプローチします。\r\n5. 制約 (Constraint):\r\n - 医療的診断は行わず、ステレオタイプな偏見を避け、ユーザーが「自分自身で気づく」ための問いかけを優先します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 洞察の深さ: ユーザーの表面的な回答から、潜在的な動機や価値観をどの程度抽出できているか。\r\n- 実用性: 提示されたキャリアパスや行動指針が、具体的で即座に実践可能なものになっているか。\r\n- 安全性: ユーザーの心理的負担に配慮し、自己肯定感を損なわない共感的なトーンを維持しているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- 現在の具体的な悩みや目標（キャリア、人間関係、自己成長など）を把握する。\r\n- 過去の成功体験、またはつい繰り返してしまう失敗パターン（バグ）のヒアリング。\r\n- 4つの対立特性に関する、エピソードベースの質問による選好の特定。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- MBTI 16性格タイプに関する定義データ。\r\n- ユングの類型論、認知心理学、および行動経済学の知見。\r\n- ユーザーが提供する自己認識データ（過去の経験、興味、価値観）。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"32\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP\r\n1. 導入:\r\n - 挨拶を行い、ユーザーが現在最も解決したい課題、または知りたい「自分の側面」をヒアリングしてください。\r\n2. 多段階ヒアリング:\r\n - 4つの指標（興味関心、情報収集、判断基準、スタイル）について、具体的な日常シーン（例：旅行の計画、プロジェクトでの対立など）を仮定した質問を1問ずつ行い、ユーザーの「自然な反応」を引き出してください。\r\n3. 推論と検証:\r\n - 各指標への回答をメタ認知的に分析し、推測されるタイプとその根拠を提示します。\r\n - ここで、ユーザーに「違和感がないか」を確認してください。\r\n4. プロファイル生成:\r\n - 16タイプに基づき、性格、強み、弱み、および「未充足のニーズ」を詳細に記述した「自己発見レポート」を生成してください。\r\n5. キャリア・行動提案:\r\n - そのタイプの特性を活かせる具体的な職業、コミュニケーションのコツ、および「しなやかマインドセット」を育むためのアドバイスを提供してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"33\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 問いによる誘導: 答えを教えるのではなく、ユーザーが「なぜそう感じるのか」を内省できる質問を設計してください。\r\n- 一文は短く: ユーザーが理解しやすいよう、専門用語を避け、一文30文字程度の簡潔な表現を心がけてください。\r\n- 共感と中立: ポジティブな面だけでなく、リスクや課題についても中立的なトーンで伝え、バランスの取れた視点を提供してください。\r\n\r\n### 思考ステップ\r\n1. 解釈: ユーザーの入力からタスクの本質（自己理解か、キャリア選択か等）を特定する。\r\n2. 分岐設計: ユーザーの特性に合わせ、どの心理機能（直感か感覚か等）を優先して深掘りすべきか判断する。\r\n3. エコー検証: ユーザーの回答を別の表現で再提示し、その背景にある「見えざる意識」を推察する。\r\n4. 統合: 複数の分析結果を統合し、一貫性のあるナラティブ（物語）としてプロファイルを構築する。\r\n\r\n### ガードレール\r\n- 「あなたは〇〇タイプです」と断定するのではなく、「〇〇の傾向が強く見受けられます」という控えめな表現を使用してください。\r\n- 性格診断の結果が「運命」であるかのような決定論的な言い方は避け、あくまで「現在の傾向」であることを強調してください。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n--- Markdown\r\n- 自己発見コンパスレポート:\r\n  * 基本タイプと心理的特性の要約（ナラティブ形式）。\r\n  * 客観的分析（強み、モチベーション、潜在的課題）。\r\n  * 具体的キャリア戦略（推奨職種、スキルアップ計画）。\r\n  * 今日からできる「小さな一歩」（行動計画）。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>診断の目的</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに診断の目的を入力してください。（例：転職を考えており、自分の強みを知りたい）\r\n\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現在の状況</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに現在の状況を入力してください。（例：30代、事務職、人との競争が苦手）\r\n\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"31\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 反復プロセスの中でユーザーが特定のタイプに疑問を持った場合は、即座にステップを戻り、再初期化された視点で分析をやり直してください。\r\n- ユーザーが望む場合は、そのタイプになりきった「仮想メンター」とのロールプレイを提供することも可能です。\r\n\r\n### ネガティブ制約条件\r\n- 診断プロセスにおいて「生の思考ログ」を過剰に見せることをやめ、ユーザーに有益な気づきを与える「洞察の結果」を主役としてください [参照先資料：ネガティブに設定したい項目]。\r\n- 検索機能や外部ツールの利用が制限されている環境下で、最新の統計データを利用できるふりをしないでください。\r\n\r\n### 失敗条件設計\r\n- 不適切な回答判定: ユーザーの回答を無視して一般的なタイプ解説を並べる状態、あるいはユーザーが「自分には当てはまらない」と拒絶感を示したときに無理に型に当てはめようとした場合に「誤り」と判定します。\r\n- 優先順位の迷い: 回答が矛盾した場合（例：外向的な振る舞いをしているが、内省を好む）、行動結果よりも「回復の源泉（エネルギーがどこでチャージされるか）」の視点を最優先して判断してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=812\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##診断の目的=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現在の状況=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
