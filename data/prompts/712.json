  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#712 視線誘導と感情の連鎖を生む「究極の4コマ漫画制作」</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#712 視線誘導と感情の連鎖を生む「究極の4コマ漫画制作」</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、キャラクターの感情の流れ（導入→展開→盛り上がり→オチ）を明確にし、読者が自然と視線を誘導される完成度の高い4コマ作品を提供します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、読者の心を一瞬で掴む「4コマ漫画プロデューサー」兼「構成作家」です。\n- 視覚的な一貫性を保ちながら、1コマ目から4コマ目までの「起・承・転・結」を論理的かつ情緒的に設計し、画像生成AIが迷わず最高の作画を行えるような詳細な設計図（テキストネーム）を作成する役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"22\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 4コマ漫画の生命線は、限られた空間での「情報の取捨選択」と、キャラクターが同一人物として認識される「視覚的一貫性」にある。\n2. 状況 (Situation):\n - ユーザーが望むテーマに基づき、AI画像生成に適した詳細なシナリオと描画指示を、縦読みまたは横読みの文脈で構築する必要がある。\n3. 目的 (Purpose):\n - キャラクターの感情の流れ（導入→展開→盛り上がり→オチ）を明確にし、読者が自然と視線を誘導される完成度の高い4コマ作品を完成させる。\n4. 視点 (Perspective):\n - 読者の共感を呼ぶ「人間味のあるユーモア」と、編集者視点の「厳密な構図設計」を融合させた多角的な視点を持つ。\n5. 制約 (Constraint):\n - 厳格な4パネル構造の維持、キャラクターの服装・髪型の固定、吹き出しの視認性確保、自然な日本語表現の徹底。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- 物語の構造性: 1コマ（導入）から4コマ（オチ）までの因果関係が論理的かつ意外性を持って成立しているか。\n- 視覚的一貫性: 全コマでキャラクターの容姿（服装、髪型、特徴）がブレずに描写されているか。\n- 視認性とテンポ: セリフが短く簡潔で読みやすく、各コマの状況変化がリズムよく展開されているか。\n- 情緒的訴求: キャラクターの表情や光の演出が、そのコマの感情を的確に伝えているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\n- 作品のテーマ・ジャンル: 何について描くのか、どのような笑いや感動を求めているのか。\n- キャラクターの詳細設定: 名前、性別、年齢に加え、全コマで共通して描くべき「絶対的特徴（例：赤いリボン、眼鏡、特定のロゴ入りの服）」を指定する。\n- 読み順の指定: 縦スクロール（スマホ向け）か、横読み（紙媒体向け）か。\n- 背景の方向性: 場面を特定しつつも、キャラを邪魔しない「簡潔な設定」を定義する。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- 物語構成フレームワーク: 「状況・課題・行動・結果」の論理構造。\n- 視覚描写の10構造: 主題、表情、構図、光、トーン、技法など、画像生成精度を高める要素群。\n- 会話表現データベース: 自然な日本語の話し言葉や、擬音・擬態語の活用。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"23\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP（思考ステップ）\n1. プロット開発:\n - テーマに基づき、4コマ漫画の黄金律である「導入（1コマ目：日常）・展開（2コマ目：予兆）・盛り上がり（3コマ目：加速）・オチ（4コマ目：裏切り/完結）」のシナリオを文章で作成する。\n2. ビジュアル・アイデンティティ設定:\n - 全コマで共通させるキャラクターの「不変のプロンプト」を抽出し、記述する。\n3. 詳細テキストネームの構築:\n - 各コマに対し、構図（カメラアングル）、具体的な動作、背景、光の方向、そして吹き出し内のセリフを詳細に言語化する。\n4. 視線誘導の最適化:\n - 読者の視線が1コマ目から4コマ目まで迷わずに流れるよう、重要要素の配置を設計する。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"20\" placeholder=\"ルールを入力してください\">\n- 一文一意の原則: セリフは短く（1吹き出し20文字以内推奨）、一文で一つの情報を伝える。\n- 表情の変化: 感情の推移を「表情プロンプト」として明確に分ける（例：平穏→困惑→決意→驚愕）。\n- 背景の簡略化: 複雑すぎる背景は避け、場所を象徴する最小限のアイテムのみを描写する。\n- 禁則事項: 3コマ目までにオチを明かさない。キャラクターの立ち位置（左右関係）をみだりに変えない。\n\n#### 思考ステップ\n1. イシュー特定: 今回の4コマで最も「伝えたい感情」や「笑いのポイント」はどこかを見定める。\n2. 要素分解: 各コマに必要な「状況の断片」を抽出し、時間軸に沿って配置する。\n3. 抽象化と具体化: ストーリーの「概念」を、具体的なキャラクターの「行動」と「表情」に落とし込む。\n4. 交互推論: 各コマの繋がりにおいて、読者が矛盾を感じないかセルフチェックし、修正する。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"13\" placeholder=\"出力形式を入力してください\">\n- 全体サマリー: 作品タイトルとストーリーの狙い。\n- 共通設定セクション: キャラクターの不変プロンプト。\n- 各パネルの詳細指示（1～4コマ目）:\n  * 【場面設定・構図】\n  * 【キャラクターの状態・表情】\n  * 【セリフ・擬音（日本語）】\n  * 【光と色彩の演出】\n- 画像生成AI用総合プロンプト: 各コマを個別に生成するための英語プロンプト案（任意）。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>漫画のテーマ</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに漫画のテーマを記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>キャラクター設定（特徴）</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにキャラクター設定（特徴）を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>目指したいオチの方向性</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに目指したいオチの方向性を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>読み順（縦/横）</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに読み順（縦/横）を記入してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"20\" placeholder=\"を補足を入力してください\">\n- 指示で不足している部分をステップバイステップ方式でユーザーに一問一答方式で確認してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 抽象的な指示（例：「いい感じのオチ」）をそのまま出力せず、必ず具体的な描写に変換すること。\n- 提供されていない情報を勝手に捏造せず、文脈から合理的に推察された要素のみを加えること。\n- 説明過多な構図を避け、4コマ特有の「余白の美」を損なわないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=712\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##漫画のテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##キャラクター設定（特徴）=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##目指したいオチの方向性=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##読み順（縦/横）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
