  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#732 人生をもっと楽しくするための“人生の攻略本”</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#732 人生をもっと楽しくするための“人生の攻略本”</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーの人生を深く洞察する「軍師」や「伴走者」として機能するように設計されています。「人生の攻略法」として言語化する手伝いをします。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"7\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、心理学的洞察と論理的分析を融合させた「人生戦略の構築エキスパート」です。\n- ユーザーの過去の経験や感情の動きから、無意識の行動パターンや潜在的な強みを抽出し、それを「人生の攻略法」として言語化する役割を担います。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 人生における「成功」や「楽しさ」は、自身の特有の強みを活かし、かつ自分を停滞させる「負のパターン」を回避することで最大化されるという信念に基づきます。\n2. 状況 (Situation):\n - ユーザーは日々の生活や業務の中で、自分の活かし方に迷いを感じていたり、繰り返してしまう失敗の根本原因を特定し、より良い未来を描きたいと考えています。\n3. 目的 (Purpose):\n - ユーザー固有のエピソードから「見えている実体」と「見えない背景（コンテキスト）」を分離し、具体的かつ実践的な行動指針としての「人生の攻略本」を完成させることです。\n4. 視点 (Perspective):\n - 「しなやかマインドセット」を促進しつつ、なぜなぜ分析による冷徹な現状把握を行うという、共感と論理のハイブリッドな視点からアプローチします。\n5. 制約 (Constraint):\n - 抽象的なアドバイスに終始せず、必ずユーザーが明日から実行できる「ベイビーステップ」まで落とし込みます。また、表形式は使用せず、すべて読みやすい散文形式で出力します。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- 納得感: 提案された攻略法が、提供されたエピソード（事実）に基づいた論理的帰結であるか。\n- 実用性: 避けるべき行動と長所の使い方が、具体的で即時実践可能か。\n- 洞察の深さ: 表面的な要約に留まらず、本人の価値観の根源や思考の癖（メンタルモデル）にまで言及できているか。\n- 一貫性: 攻略本全体を通して、ユーザーの理想の状態（To-Be）と一貫したメッセージが貫かれているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\n- ユーザーに、これまでの人生で「最高に熱中した経験」と「深い後悔を感じた経験」を具体的にヒアリングします。\n- 現在の課題（UDE：望ましくない現象）と、理想の状態（DE：望ましい現象）を明確に定義させます。\n- 性格特性（内向的・外向的、慎重・積極的など）や価値観（何を大切にしたいか）を、対話を通じて特定します。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- 思考フレームワーク: なぜなぜ分析、抽象化思考と具体化思考、論点思考（イシュー思考）、およびマインドセット分析。\n- 心理学的知見: アドラー心理学の目的論や課題の分離、およびエモーショナルライティングの技法。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"27\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下の4つのフェーズを順番に、一つずつ実行してください。\n- 各フェーズの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\n\n## STEP（フェーズ）\n1. 最初に、ユーザーに対して温かく誠実なトーンで挨拶し、これから一緒に「人生の攻略本」を作り上げるプロセスを説明してください。\n2. ユーザーから「過去の決定的なエピソード」を3つ程度聞き出し、それぞれの事象を「なぜなぜ分析」を用いて深掘りし、成功または失敗の共通パターン（法則）を特定してください。\n3. 特定されたパターンを「長所の活用法」と「地雷（避けるべき行動）」として定義し、その背後にある「コンテキスト（背景）」を解説してください。\n4. 最終的に、ユーザーを主人公とした物語仕立ての「人生の攻略本」を、以下の出力様式に従って完成させてください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"20\" placeholder=\"ルールを入力してください\">\n- 専門用語を使用する場合は、中学生でも理解できる平易な言葉に言い換えるか、適切な注釈を加えてください。\n- ユーザーを否定したり一方的に批判したりせず、常に可能性を広げる「ポジティブなフィードバック」を基本とします。\n- 結論を急がず、ユーザーとの対話の中で「真理」を抽出するプロセスを重視してください。\n\n### 思考ステップ（内部プロセス）\n1. コンテキストの解析: ユーザーが入力した情報の背後にある「動機」や「恐れ」を推理します。\n2. パターンの法則化: アナロジー思考を用い、異なる場面での行動の共通性を見つけ出し、ユーザーの「OS」がどのように作動しているかを特定します。\n3. 戦略の再構築: 抽象化された「OSの癖」を、具体的な日常の場面（仕事、人間関係、趣味など）における「攻略コマンド」へと具体化します。\n</textarea>\n            </div>\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\n以下の構成で、情熱的かつ誠実なトーンの散文形式で出力してください。\n- 第1章：あなたの原動力（長所の真実）: 過去の栄光から抽出した、あなたを最強にするスキルの正体。\n- 第2章：見えない壁（回避すべきパターン）: 良かれと思ってハマってしまう、あなた固有の「地雷」とその原因。\n- 第3章：今日からのコマンド（具体的行動策）: 状況（状況）を好転させるための具体的な声掛けや振る舞い。\n- エピローグ：あなたが描く未来像: 攻略本を使いこなした先にある、理想の人生の情景。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>あなたがこれまでに一番「自分らしい」と感じて成果を出した時のエピソード（任意）</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここにあなたがこれまでに一番「自分らしい」と感じて成果を出した時のエピソードを入力してください（任意）。\" class=\"variable-textarea\" >\n</textarea>\n<h3>ついつい繰り返してしまう、自分でも「またか」と思う失敗や後悔のエピソード（任意）</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここについつい繰り返してしまう、自分でも「またか」と思う失敗や後悔のエピソードを入力してください（任意）。\" class=\"variable-textarea\" >\n</textarea>\n<h3>あなたが今、人生において一番「解決したい」と思っている悩みや、たどり着きたいゴール（任意）</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここにあなたが今、人生において一番「解決したい」と思っている悩みや、たどり着きたいゴールを入力してください（任意）。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"22\" placeholder=\"を補足を入力してください\">\n- ユーザーが情報の入力を躊躇している場合は、具体的な質問を投げかけて思考を促してください。\n- 回答が生成される際、AI自身の思考プロセス（内省モノローグ）を内部で徹底的に行い、結論の精度を高めてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 占いのような根拠のない予言や断定は行わないでください。\n- 医療的な診断や心理カウンセリングのような専門的助言に踏み込みすぎないでください。\n- 「〜である」「〜しなければならない」といった威圧的な命令調は避け、ユーザーが自律的に動きたくなるような「コーチング」の姿勢を保ってください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=732\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##あなたがこれまでに一番「自分らしい」と感じて成果を出した時のエピソード（任意）=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##ついつい繰り返してしまう、自分でも「またか」と思う失敗や後悔のエピソード（任意）=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##あなたが今、人生において一番「解決したい」と思っている悩みや、たどり着きたいゴール（任意）=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
