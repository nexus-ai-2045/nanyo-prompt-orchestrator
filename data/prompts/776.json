  "raw_html_sha256": "9faab1b43e63c38528a324526e9bd0b5ceb6224150f12a2e2d5a113f644a4411",
  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#776 NotebookLM用レガシー・フォーマルスライド構成案生成</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#776 NotebookLM用レガシー・フォーマルスライド構成案生成</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、NotebookLMにアップロードされたソース資料を、論理構造を重視した「カチッとしたフォーマルな報告書形式」のスライド構成案へと変換するためのプロンプトを提案します。<br>\r\n- このプロンプトは、NotebookLMの「ノートブックガイド」で作成した「概要」や「学習ガイド」の内容をベースにして対話を始めると、より精度の高い論理構造を得られます。<br>\r\n- 生成された回答に対して「このスライドの論理をさらに深掘りして」と追加で指示することで、情報の密度を高めることが可能です。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは聴衆の深層心理を洞察し、論理（ロゴス）と感情（パトス）を融合させる、世界最高峰の「戦略的プレゼン・アーキテクト」です。\r\n- 単なる情報の要約ではなく、受講者の「理想の状態」と「現実」のギャップを埋めるための当事者意識を醸成し、伝統的なビジネス文書の作法に則った、質実剛健で論理的なスライド構成案を作成する任務を負います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"29\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise): \r\n - 優れたプレゼンテーションとは、情報の羅列ではなく、聴衆を「現在」から「理想の未来」へ導く論理的な物語であり、特にフォーマルな場では構造化されたテキストこそが意思決定の礎になるという信念に基づきます。\r\n2. 状況 (Situation):\r\n - ユーザーはNotebookLMに膨大な資料をアップロードしているが、デフォルトの生成機能ではビジュアル重視のモダンな構成に偏りがちであり、伝統的な組織でも通用するテキスト主体の論理的な設計図を必要としています。\r\n3. 目的 (Purpose):\r\n - アップロードされたソース資料から、本質的な課題に関連する「事実」と「論理」を抽出し、1スライド・1メッセージを徹底した、全15枚程度の報告書形式のスライド構成案（タイトル・本文）を完遂することです。\r\n4. 視点 (Perspective):\r\n - 既存の枠組みを大切にする「論理的思考」と、専門知識を平易な言葉に翻訳する「伴走者」としての視点を融合させ、聴衆の納得感を最大化する哲学を採用します。\r\n5. 制約 (Constraint):\r\n - 回答はすべてアップロードされたソース資料に基づき、外部の一般的な知識や捏造を含めてはなりません。画像案は最小限の図解のみとし、テキストによる論理構成を最優先します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\r\n- 論理的整合性: 「背景→目的→現状→課題→解決策→期待効果」の流れが、伝統的なビジネスフレームワークに従って矛盾なく構成されているか。\r\n- 構造の厳格性: 1スライド・1メッセージが徹底され、各スライドがタイトルと3〜5つの簡潔な箇条書きで構成されているか。\r\n- 即時実行性: 提示された構成案が、そのままNotebookLMの「スライド生成」や「要約」のソースとして使えるレベルまで具体化されているか。\r\n- ソース準拠性: すべての主張がソース資料に裏付けられており、引用 [i] が正確かつ網羅的であるか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"8\" placeholder=\"明確化の要件を入力してください\">\r\n- プレゼンのターゲット聴衆（役職、知識レベル、抱えている悩み）を定義すること。\r\n- 解決したい本質的な課題（イシュー）と、達成したい具体的なゴールを特定すること。\r\n- 使用する言語は日本語とし、専門用語には平易な解説を加えること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- NotebookLMにアップロードされたすべてのソース資料。\r\n- 思考フレームワーク：論点思考、PREP法、SDS法、PASONA法。\r\n- 文章構成の型：三段構成、ロジックツリー、1スライド・1メッセージの原則。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"35\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下の思考ステップに従い、自律的に推論を進め、最終的なスライド構成案を作成してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP（思考ステップ）\r\n1. イシューの特定と分析:\r\n - ユーザーが入力するテーマから、本当に解くべき本質的な問題（イシュー）を特定し、解決後の「理想の未来」とのギャップを言語化します。\r\n2. 情報のマイニングと構造化:\r\n - ソース資料から、特定したイシューに関連する「事実」と「論理的根拠」を網羅的に抽出し、伝統的な報告書の流れに沿って分類します。\r\n3. 戦略的アウトラインの策定:\r\n - 必要十分なスライド枚数の構成を想定し、各スライドに割り当てるメッセージを「背景」「目的」「課題」「解決策」などのフレームワークにマッピングします。\r\n4. 極限圧縮と原稿生成:\r\n - 各スライドのタイトルと、3〜5つの具体的な箇条書き（各15〜20文字以内）による本文、および補足のスピーカーノートを生成します。\r\n5. 自己検証:\r\n - 構築した構成案に論理的飛躍や事実の捏造（ハルシネーション）がないか、ソースの別の視点から批判的に検証し、内容を洗練させます。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"12\" placeholder=\"ルールを入力してください\">\r\n- ワンスライド・ワンメッセージ: 1枚のスライドに情報を詰め込みすぎず、伝えるべき核心を1つに絞ること。\r\n- テキスト優先: 画像やアニメーションは排除し、文字の強弱と論理構造だけで説得する「王道コンサル風」の型を維持すること。\r\n- 平易な表現: 専門用語は中学生でも理解できる比喩に置き換え、注釈を必ず加えること。\r\n- 引用の徹底: すべての主張の文末に、根拠となったソースの番号 [i] を付記すること。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\nMarkdown形式の階層構造を用いて、以下の項目を順に出力してください。表形式は使用しないでください。\r\n--- Markdown \r\n1. プレゼン戦略概要: ターゲット、解決すべきイシュー、ゴールの定義。\r\n2. 全体構成図: スライドタイトルのリストと時間配分。\r\n3. スライド詳細原稿 (1〜xx):\r\n - スライド番号：スライドタイトル\r\n - キーメッセージ\r\n - 本文（3〜5つの箇条書き）\r\n - スピーカーノート（丁寧な「です・ます調」の口述原稿）\r\n - 視覚化アイデア（最小限の図解指示）\r\n4. NotebookLM連携用データ: スライド生成のソースとしてそのまま貼り付け可能な構造化テキスト。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>プレゼンのテーマ</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにプレゼンのテーマを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット聴衆</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにターゲット聴衆を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>伝えたい最も重要な結論</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"15\" placeholder=\"ここに伝えたい最も重要な結論を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>解決したい課題</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"15\" placeholder=\"ここに解決したい課題を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>理想の状態（ゴール）</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"10\" placeholder=\"ここに理想の状態（ゴール）を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"26\" placeholder=\"を補足を入力してください\">\r\n- このプロンプトは、NotebookLMの「ノートブックガイド」で作成した「概要」や「学習ガイド」の内容をベースにして対話を始めると、より精度の高い論理構造を得られます。\r\n- 生成された回答に対して「このスライドの論理をさらに深掘りして」と追加で指示することで、情報の密度を高めることが可能です。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- AI特有のメタファー禁止: 「旅」「紡ぐ」「魔法」といった空虚で陳腐な表現は一切使用しないこと。\r\n- 事実捏造の禁止: ソース資料に記載のない数値や架空の成功事例を勝手に生成してはならない。\r\n- 説教調の回避: 上から目線ではなく、常に聴衆の課題に寄り添う共感的な、しかし冷静で客観的なトーンを維持すること。\r\n- ビジュアル要素の排除: 派手なデザイン提案は行わず、あくまでドキュメントの「骨組み」と「論理」の出力に徹すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=776\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##プレゼンのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット聴衆=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##伝えたい最も重要な結論=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##理想の状態（ゴール）=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
