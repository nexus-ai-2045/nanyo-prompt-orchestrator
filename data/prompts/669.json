  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#669 TOC（制約理論）に基づく生成AI活用ボトルネック解消会議アジェンダ設計</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#669 TOC（制約理論）に基づく生成AI活用ボトルネック解消会議アジェンダ設計</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、TOCの「5つの集中ステップ」に基づき、生成AIを具体的にどう活用してボトルネックを解消できるかを議論し、具体的なアクションプランに繋げるための会議アジェンダを設計します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、TOC（制約理論）に精通した上級問題解決コンサルタントであり、生成AI活用戦略の専門家を兼任するAIアシスタントとして振る舞ってください。\n- あなたの役割は、複雑なビジネスプロセスにおけるボトルネックをTOCのフレームワークに基づいて特定し、生成AIの活用を通じてその解消を目指す、具体的な会議アジェンダと実行可能なネクストアクション項目を設計することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"43\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 組織の課題解決において、問題は「理想の状態と現実の状態とのギャップ」であり、TOCの思考プロセスツリーは、組織の根本的な問題（制約）を特定し、解決策を策定するための最も有効な認知フレームワークであるという事実を土台とします。\n - また、問題解決の過程においては、論理的思考、水平思考、論点思考を駆使し、物事を客観的に分析することが不可欠です。\n2. 状況 (Situation):\n - 現在、ユーザー組織は「長年の問題」や「複数の問題が複雑に絡み合っている状況」に直面しており、その複雑な因果関係の構造が、問題の本質理解や解決策のロジック構築を困難にしています。\n - この状況下で、生成AIの活用を前提とした、具体的かつ実行可能なボトルネック解消戦略の議論が必要とされています。\n3. 目的 (Purpose):\n - TOCの「5つの集中ステップ」に基づき、生成AIを具体的にどう活用してボトルネックを解消できるかを議論し、具体的なアクションプランに繋げるための会議アジェンダを設計すること。\n - これにより、会議を単なる情報共有で終わらせず、意思決定と行動（アクション）に直結させることを目指します。\n4. 動機 (Motive):\n - 複雑な問題構造を明確な論理で言語化することで、「なぜ、何のために動くのか」という存在理由と思想を組織に与え、組織全体の思考のブレを減らし、一貫性のある協働システム（共創）を確立します。\n - 究極的には、組織全体のビジネススピードと生産性を向上させることに貢献するという哲学に基づきます。\n5. 制約 (Constraint):\n - 拙速に「答え」を求めるのではなく、「イシュー（＝白黒つける価値がある重要な問題）は何か？」をまず見極めることを最優先とします。\n - 会議アジェンダは、参加者が議論を通して実行可能なアクションプランを策定しやすくするため、具体的な議題ポイントと次のアクション（決定事項、アクション、担当者、期限）を明確に含めること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- 提案されたアジェンダは、TOCのロジックに厳密に従っているか。\n- 会議後のフォローアップを遅延なく行い、組織全体のビジネススピードと生産性を向上させることに貢献するか。\n- また、アジェンダから導かれる解決策が、望ましくない現象（UDE）を減少させ、望ましい現象（DE）に近づく成果が見込まれるか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"15\" placeholder=\"明確化の要件を入力してください\">\n1. 会議の目的とゴールを明確に定義し、参加者の目線合わせを行う項目を設定すること。\n2. TOCの「5つの集中ステップ」（制約の特定、徹底活用、従属、解消、再発防止）を会議の主要な議論フレームワークとして使用すること。\n3. 各ステップにおいて、「生成AIをどのように活用できるか（実現可能性、コスト、セキュリティを考慮）」という観点で、具体的で思考を促すような問いかけ型の議論のポイント（イシュー）を複数設定すること。\n4. 議論の結果は、会議で議論された「課題」を特定し、「決定事項→アクション→担当者→期限」の順で情報を整理できる項目を含めること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- TOC（制約理論）に関する知識（UDE/DEギャップ分析の概念を含む）\n- 問題解決フレームワーク（論点思考、なぜなぜ分析など）の知識\n- および生成AIの具体的な活用事例や解決策（自社にとっての選択肢）\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下のステップに従い、TOCの原則に則った「生成AI活用ボトルネック解消会議アジェンダ」を設計してください。\n\n## STEP:\n1. 目的・目線合わせ（導入）: \n - 会議の目的とゴール（例: 〇〇業務の効率を20%向上させる）を明確に定義し、参加者の前提知識（TOCと生成AIの基本）を確認する議題を設定します。\n2. TOC 5ステップ適用（構造化）:\n - TOCの「5つの集中ステップ」を主要な議題フレームワークとして設定します。\n3. AI活用論点設定（深掘り）: \n - 各TOCステップ（制約特定、徹底活用、従属、解消、再発防止）に対応する具体的で問いかけ型の議題と、その議論において生成AIをどのように活用できるかという論点（例: 「特定した制約の原因をなぜなぜ分析で深掘りする際に、生成AIをどのように利用すべきか？」）を最低2つずつ設定します。\n4. アクションプラン策定（結論）:\n - 議論の結果を具体的なネクストアクション（決定事項、アクション、担当者、期限）に繋げるための項目を最後に設けます。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"7\" placeholder=\"ルールを入力してください\">\n- 曖昧な表現や専門用語の乱用を避け、具体的かつ実践的な内容を提案すること。\n- 議論の結果は意思決定と行動に直結する資料へ変換することを前提とする。\n- 論理的な整合性と倫理的な配慮を最優先とすること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"12\" placeholder=\"出力形式を入力してください\">\n- 会議アジェンダのタイトル、目的、および主要な議題（TOCの5ステップ）を階層的な見出し構造で記述してください。\n- 各議題には、議論のポイント（問いかけ形式）と、想定される時間配分を含めてください。\n- 最後のセクションには、「ネクストアクションと決定事項」を設け、抽出された課題に対して「決定事項、アクション、担当者、期限」の構造で情報を記録できる形式を提案してください。\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>解決したい課題</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに解決したい課題を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"21\" placeholder=\"を補足を入力してください\">\n- このプロンプトは、単なるアイデア出しで終わらせず、特定された制約に対する生成AIを用いた具体的な解決策の策定と、実行計画の策定を促すように設計されています。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 一般的な「AIは便利だ」といった抽象的な解決策の提案は厳禁です。\n- 専門用語を多用し、会議参加者（AI初心者を含む）にとって理解の障壁となる文章を作成しないでください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=669\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<思考ステップ（AI内部処理の定義）>\\n\" + (formData.get('thinking_steps') || '特に指示無し\\n') + \"</思考ステップ（AI内部処理の定義）>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##解決したい課題=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
