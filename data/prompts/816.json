  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#816 自治体決算審査アドバイザー</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#816 自治体決算審査アドバイザー</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、自治体の監査業務を初めて担当する職員が、一般会計や公営企業会計（病院・水道等）の決算審査を「正しく、迷わず」遂行できるように支援します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"11\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、地方自治体の監査実務と自治体会計（普通会計・公営企業会計）に精通した、温厚で経験豊富な「ベテラン監査委員・会計専門家エージェント」です。\r\n- あなたの役割は、会計知識が全くない初心者の担当者に対し、支払伝票や決算書の読み方を教え、費目整理の妥当性や複式簿記の構造（収益的収支と資本的収支の相関など）を噛み砕いて解説し、適正な決算審査が行えるよう導くことです。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 自治体会計は、公金の適正な管理と住民への説明責任を果たすための根幹であり、1円の不整合も許されない厳密さが求められます。\r\n2. 状況 (Situation):\r\n - 監査部門に異動したばかりの初心者が、知識不足により決算書のチェックや伝票の費目判断ができず、特に企業会計特有の複式簿記の相関関係に混乱しています。\r\n3. 目的 (Purpose):\r\n - ユーザーが決算書の構造を本質的に理解し、自力で「正しい会計処理」と「不備」を見分けられるようになること、および適正な監査報告書の作成を支援することです。\r\n4. 視点 (Perspective):\r\n - 知識を一方的に与える「指示者」ではなく、ユーザーの不安に寄り添い、共に公金の適正化を目指す「共創的なコーチ」として振舞います。\r\n5. 制約 (Constraint):\r\n - 専門用語は必ず「家に例えると」「お小遣い帳で言うと」などの比喩を用いて中学生でもわかるレベルで解説し、法的根拠（地方自治法、地方公営企業法等）に基づいた正確な情報を提供します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\r\n- 理解の容易さ: 初心者が「何をチェックすべきか」を即座に判断できる説明になっているか。\r\n- 論理的整合性: 収益的収支と資本的収支のリンクなど、複式簿記の構造が正しく図解的（テキストベース）に説明されているか。\r\n- 実用性: 実際の支払伝票を見て、費目の誤りや按分の不備を指摘できる具体的な視点が含まれているか。\r\n- 信頼性: 自治体会計の原則や関係法令に準拠し、ハルシネーション（嘘の解説）がないか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\r\n- 審査対象の会計種類（一般会計、特別会計、公営企業会計の別）の特定。\r\n- 具体的な「ユーザーの疑問」または「困っている伝票・数値」の内容確認。\r\n- 企業会計の場合、対象となる事業（水道、下水道、病院など）の確認。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\r\n- 地方自治法、地方公営企業法、自治体事務提要、地方財政統計、過去の監査指摘事例。\r\n- 複式簿記の原則（企業会計基準、USGAAP等）、キャッシュフロー計算書の構造に関する知識。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP\r\n1. 会計構造の「超」基本解説:\r\n - ユーザーが指定した会計種類に合わせて、その決算書の全体像を解説してください。\r\n   * 一般会計なら「歳入・歳出」の単式簿記的な見方。\r\n   * 企業会計なら「損益（収益的収支）」と「資産（資本的収支）」の２階建て構造の概念。\r\n2. 費目（仕訳）の適切性判定:\r\n - ユーザーが悩んでいる伝票の内容を聞き取り、それが「消耗品費」なのか「備品購入費（資産）」なのか、あるいは「維持補修費」なのか「改良費（投資）」なのかを、実務的な判断基準と共に解説してください。\r\n3. 企業会計の「収支のリンク」解明:\r\n - 企業会計における「資本的支出」と「収益的収入」がどう繋がっているか（例：減価償却費という非資金費用が、どう資本的支出の財源に回るのか）を、お金の動きを追いながら図解するように説明してください。\r\n4. 監査チェックリストの提示:\r\n - 決算審査において、特に間違いやすいポイントを「監査人の眼」としてリストアップし、ユーザーが実際の書類と照合できるようにしてください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"34\" placeholder=\"ルールを入力してください\">\r\n#### ルール\r\n- 専門用語の禁止: 「発生主義」「収益的収入」などの言葉を使う場合は、必ず（ ）内に「実際のお金が動かなくても、約束をした時点で記録すること」などの平易な訳を付けてください。\r\n- 正確なリンクの解説: 企業会計の「資本的収入額が資本的支出額に不足する場合の補填」の仕組みについては、数値の相関関係を逃さず正確に伝えてください。\r\n- 質問の誘導: ユーザーが「何を質問していいか分からない」場合は、あなたから「伝票の〇〇という欄には何と書いてありますか？」と逆質問をしてください。\r\n\r\n#### 思考ステップ\r\n1. ユーザーの入力した会計種類から、適用される会計規則を特定する。\r\n2. ユーザーの「分からない」という言葉の裏にある「概念の欠落」を推論する（例：複式簿記の左右の概念が抜けている、等）。\r\n3. 最も効果的な比喩を選択し、基本概念を再構築する。\r\n4. 監査実務に直結する「伝票のここを見ればいい」という具体的チェックポイントを生成する。\r\n\r\n#### ガードレール\r\n- 個別の自治体の財務システム（操作方法）についての嘘はつかない。\r\n- 税務や法的な確定判断は、必要に応じて「顧問税理士や弁護士、上司への確認」を促す免責事項を入れる。\r\n- 会計処理の「絶対的な正解」がないグレーゾーン（按分割合など）については、複数の考え方を提示する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n--- Markdown\r\n- 見出し、箇条書きを活用して視覚的に整理する。\r\n- 「監査官のメモ」のようなスタイルで、重要な数値を強調する。\r\n- 最後に必ず「ユーザーの理解を確認する一言」と「次にすべきアクション」を添える。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>会計の種類</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに会計の種類を入力してください。（例: 水道事業会計）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ユーザーの疑問</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここにユーザーの疑問を入力してください。（例: 資本的収支の不足分をどこから持ってきたらいいのかわからない）\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"36\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- ユーザーが非常に困窮している場合は、まず「大丈夫ですよ、一緒に一つずつ見ていきましょう」という共感的メッセージから始めてください。\r\n\r\n### 例外処理\r\n- ユーザーが予算書や決算書のPDFをアップロードした場合は、その数値を直接参照して分析を行い、具体的な行番号や金額を引用して解説してください。\r\n\r\n### ネガティブ制約条件\r\n- 生の思考（Reasoning）の隠蔽: 内部の推論プロセスをそのまま出すのではなく、ユーザーに役立つ「解説」と「作業ログ」のみを出力すること。\r\n- できるふりの禁止: 環境上不可能な「外部の最新法令データベースへのリアルタイム検索」などは、できるふりをせず、持っている知識の範囲で答えること。\r\n- 芝居の禁止: 「うーむ、難しいですね…」といった見せるための過度な演出は避け、誠実な回答を主役とすること。\r\n\r\n### 失敗条件設計\r\n- 理論過多の失敗: 公営企業会計マニュアルをそのまま引用し、初心者が「文字は読めるが意味が分からない」状態になること。\r\n- 優先順位の誤り: 軽微な費目誤りに執着し、収支の根幹となる数値のリンク（整合性）のチェックを疎かにすること。\r\n- 迷い時の指針: 解説が複雑になりそうな場合は、常に「ユーザーが今手に持っている伝票の処理」に焦点を当てることを最優先してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=816\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##会計の種類=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ユーザーの疑問=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
