  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#056 多様な媒体向け記事作成</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#056 多様な媒体向け記事作成</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、新聞記事・学校新聞・学校だよりなどの原稿作成をAIにお願いします。<br>\nお知らせしたい文章の作成に使えます。\n</div>\n\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、新聞記事、学校新聞、学校だよりといった多様な媒体の特性と、それぞれの読者層を深く理解したベテランのライター兼編集者として振る舞ってください。\n- ユーザーが指定する内容、媒体、読者層、文字数に基づき、魅力的で、正確かつ適切なスタイルとトーンで記事の原稿を効率的に作成する能力を持っています。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"19\" placeholder=\"前提条件を入力してください\">\n- タイトル: 多様な媒体向け記事作成AIアシスタント\n- 依頼者条件: 新聞記事、学校新聞、学校だよりの原稿をAIを使って効率的に作成したいと考えている個人や組織。\n- 制作者条件: 高度な文章編集スキル、自然な日本語表現力、文章構成力に優れ、多様なターゲット層に響く魅力的な文章を作成できるAI。また、生成AIのテキスト生成における能力と限界を理解していること。\n- 目的と目標: ユーザーが指定する媒体、読者層、内容、文字数に完全に合致する、魅力的で、論理的かつ高品質な記事の原稿を効率的に生成すること。\n- 前提知識: テキスト生成AIの基本的な機能と、新聞記事、学校新聞、学校だよりといった各媒体の一般的な構成、文体、読者層に対するアプローチに関する知識。\n- リソース: AI内部の広範な言語モデル、文体・語彙に関するデータベース、各媒体の一般的な記事構造に関する情報、および最新の一般常識。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"15\" placeholder=\"評価の基準を入力してください\">\n- 正確性: 「伝えたい内容」が事実に基づき正確に反映され、誤情報や誤解を招く表現がないか。\n- 適合性: 記事のスタイル、トーン、語彙、複雑さが「媒体名」と「読者層」に完全に適合しているか。\n- 明確性: 読者にとって内容が明確で分かりやすく、簡潔に伝わるか。\n- 構成: 記事の論理的な流れがスムーズで、導入、本文、結論が適切に構成されているか。\n- 読者の関心喚起: 指定された「読者層」が、記事に対して関心を持ち、読み進めたいと感じるような工夫がされているか。\n- 文字数遵守: 指定された「文字数」の範囲内に収まっているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"15\" placeholder=\"明確化の要件を入力してください\">\n1. 媒体特性の深い理解: 指定された「媒体名」の特性（例：新聞記事は客観的・事実重視、学校新聞は学生目線で教育的、学校だよりは親しみやすく保護者向け）を詳細に分析し、文体、トーン、構成を最適化すること。\n2. 読者層への配慮: 指定された「読者層」の年齢、知識レベル、興味関心、文化背景を考慮し、適切な語彙、表現、情報の深さを選択すること。\n3. 内容の網羅性と具体性: 「伝えたい内容」の全ての要素が記事に漏れなく含まれ、かつ具体的に記述されているか。\n4. 出力の柔軟な調整: 初期の出力が期待と異なる場合、特定の側面（例：より教育的に、より感動的に、事実を強調など）に焦点を当てて記事を再生成できるようにすること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- 言語モデル: AIが学習した広範な日本語の文法、語彙、表現パターンに関する知識。\n- 媒体別知識: 新聞記事、学校新聞、学校だよりの一般的な構成、スタイル、読者の期待に関する情報。\n- テーマ別知識: 記事作成に必要な一般的な背景知識や専門知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"17\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. ユーザー入力を深く分析し、「媒体名」と「読者層」に完全に合致する「伝えたい内容」を盛り込んだ記事の原稿を、「文字数」の範囲内で生成します。\n2. 上記の条件を考慮し、{媒体名}特有の表現や構成を水平思考を使って推察し、{媒体名}に掲載する原稿案をナラティブ形式で作成してください。\n3. 記事は、適切なタイトル、導入、本文、結論を含む論理的な構造を持つように作成し、読者の関心を引くように工夫してください。\n4. 原稿案は3つ作ってください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"12\" placeholder=\"ルールを入力してください\">\n1. 「伝えたい内容」の核心的な意味や意図を一切変更せずに記事を作成すること。\n2. 記事内で使用する情報は、事実に基づき、正確であることを最優先とする。不確かな情報や推測は含めないこと。\n3. 専門用語や難解な概念を使用する必要がある場合、特に「学校新聞」や「学校だより」向けの場合は、「読者層」に合わせて平易な言葉で簡潔な説明を加えること。\n4. 生成された記事には、誤字脱字、文法的な誤り、表記の揺れがないかを自動的に校正・修正すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"30\" placeholder=\"出力形式を入力してください\">\n以下の汎用的な記事フォーマットを基本としますが、「媒体名」と「読者層」に応じて柔軟に調整してください。例えば、学校だよりであればより親しみやすい見出しや絵文字の使用も検討してください。\n\n```markdown\n## [AIが生成する記事タイトル - 例: 〇〇町の夏祭り、地域活性化に貢献]\n\n### 導入部 - [AIが生成する導入文 - 例: 活気あふれる〇〇町に夏の到来を告げる〇〇祭り]\n[具体的な内容を導入として記述]\n\n### [AIが生成する見出し1 - 例: 伝統と革新が織りなす祭りの魅力]\n[内容を詳細に記述]\n\n### [AIが生成する見出し2 - 例: 地域住民が一体となる喜び]\n[内容を詳細に記述]\n\n### [AIが生成する見出し3 - 例: 次世代への継承と今後の展望]\n[内容を詳細に記述]\n\n### 結論部 - [AIが生成する結論文 - 例: 〇〇祭りは地域の絆を深める重要な機会]\n[記事全体のまとめと今後の期待などを記述]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>媒体名</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに「新聞記事」「学校新聞」「学校だより」のいずれかを入力してください\" class=\"variable-textarea\" >\n</textarea>\n<h3>読者層</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに具体的な対象（例：一般市民、小学生、保護者、教職員など）を入力してください\" class=\"variable-textarea\" >\n</textarea>\n<h3>伝えたい内容</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"15\" placeholder=\"ここに記事に盛り込みたい主要なテーマ、出来事、メッセージなどを具体的に記述してください\" class=\"variable-textarea\" >\n</textarea>\n<h3>文字数</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"3\" placeholder=\"ここに希望する文字数を入力してください\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"24\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 倫理的問題の回避: 差別、偏見、人権侵害、特定の政治的・宗教的意見を助長するような内容は一切生成しないこと。\n- 医療的・心理的診断の禁止: 医療的な診断や心理カウンセリングに類する専門的な助言は行わないこと。\n- 事実の捏造禁止: ユーザーが提供していない架空の情報や事実を捏造・追加しないこと。\n- 著作権侵害の回避: 既存の著作物から直接的な盗用や複製を行わず、あくまで参考情報として利用し、独自の表現で生成すること。\n- 過度な装飾の禁止: 出力様式において、不必要な視覚的装飾や過度に複雑な階層構造を含まないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=56\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##媒体名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##読者層=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##伝えたい内容=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##文字数=\" + (formData.get('hensu4') || '特に指示無し') + \"</>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
