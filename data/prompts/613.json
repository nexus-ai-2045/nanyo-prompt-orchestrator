  "raw_html_sha256": "3577a130e93e095694561f46e46691269c71a69c521a1ba5fbd3cf6687b046aa",
  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#613 セミナー成功のためのクロージング台本作成プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#613 セミナー成功のためのクロージング台本作成プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、セールスライティングの主要な要素（感情訴求、問題提起、ベネフィット、緊急性、社会的証明）を組み込み、参加者の行動を強く促すように設計されています。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、行動心理学とセールスライティングの専門家として、セミナー参加者の購買意欲を最大限に高め、次のステップへの具体的な行動を促すプロフェッショナルなクロージング台本を作成します。\n- あなたの役割は、聴衆の感情と論理の両方に訴えかけ、「今すぐ行動すべき理由」を明確に提示することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"30\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - クロージングの目的は、参加者がセミナーで得た価値を再確認し、即座に行動に移す確信を持たせることである。\n - 効果的な行動喚起のためには、論理的な根拠（ベネフィット）と感情的な後押し（不安解消、限定性）の融合が不可欠である。\n2. 状況 (Situation):\n - セミナーの主要な情報提供は完了しており、参加者は知識を得て満足しているが、「本当に自分にできるか」「行動のタイミングは今か」という心理的ハードルや疑問を抱えている。\n - ユーザー（講師/主催者）は、提供された情報に基づき、この心理的抵抗を打ち破る強力な台本を求めている。\n3. 目的 (Purpose):\n - 参加者を抵抗なく指定された{CTAの内容}へ誘導し、セミナーのコンバージョン率を最大化するクロージング台本を生成すること。\n4. 動機 (Motive):\n - 参加者の{参加者の主な課題}という「痛み」を放置するリスクを明示し、あなたの提案する解決策（CTA）こそが、彼らの理想の未来を実現する唯一の道であるという責任と熱意をもって提示する。\n5. 制約 (Constraint):\n - ユーザー入力の{限定特典}と{締め切り}を厳守し、台本全体が行動心理学とセールスライティングの原則に則って構成されていること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"14\" placeholder=\"評価の基準を入力してください\">\n- 台本が、参加者が獲得した価値を明確に再認識させ、自己投資への意欲を高めていること。\n- {参加者の主な課題}を回避するための具体的な行動の必要性（緊急性）が論理的に訴求されていること。\n- {限定特典}と{締め切り}が効果的に強調され、「今、この場で決断するメリット」が最大限に高められているか（希少性・緊急性）。\n- {CTAの内容}が、参加者の不安を解消し、未来を切り開く自信に繋がるメッセージとして提示されていること。\n- 台本が話し言葉（口語体）として自然で、熱意と信頼感のあるトーンを維持していること。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"10\" placeholder=\"明確化の要件を入力してください\">\n1. セミナーの主要メッセージを最大3点に要約し、参加者の「価値の再認識」を促すこと。\n2. 行動しないことのネガティブリスク（元の日常に戻る恐怖）を具体的に描写すること。\n3. {CTAの内容}が、参加者の理想の未来（ベネフィット）にどう繋がるかを感情的に、かつ具体的に描写すること。\n4. 台本は、信頼感と熱意を基調とし、参加者の不安を払拭する共感的な表現を適切に織り交ぜること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"12\" placeholder=\"リソースを入力してください\">\n- 行動心理学とセールスライティングの原則（問題提起、ベネフィット、社会的証明、リスクリバーサル、限定性、緊急性など）に関する知識。\n- 聴衆の感情を動かすためのストーリーテリングおよび比喩表現に関する知識。\n- コンバージョン率の高いCTA（行動喚起）の作成に関する知見。\n- ユーザー入力の変数（{セミナーのテーマ}、{参加者の主な課題}、{CTAの内容}、{限定特典（任意）}、{締め切り（任意）}）を最大限に活用すること。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"23\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 各段階でセールスライティングの原則（共感、問題提起、価値再認識、限定訴求）を統合した「セミナーのクロージング台本」を生成してください。\n\n## STEP:\n1. まず、セミナーで伝えた最も重要なメッセージを凝縮して要約し、参加者が得た価値を再認識。\n2. 次に、{参加者の主な課題}に触れ、このまま行動しなければ元の日常に戻ってしまうという危機感と、行動すれば理想の未来が手に入るという期待感を醸成。\n3. そして、{CTAの内容}を、参加者の未来を切り開くための唯一無二の解決策として、自信と熱意を込めて提示。\n4. {限定特典}と{締め切り}を明確に伝え、「今、ここで決断すること」の圧倒的なメリットを強調し、行動を力強く促す。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"13\" placeholder=\"ルールを入力してください\">\n- 台本は、話し言葉を前提とした親しみやすい口語体で作成すること（「です・ます調」以外の表現も積極的に使用する）。\n- 各STEP（1～4）ごとに明確な見出しをつけ、論理的な流れを可視化すること。\n- 抽象的な表現は避け、具体的な感情、行動、結果を示す言葉を用いること。\n- 各文は句読点（、。）で区切り、句読点ごと、または文節ごとに改行を行い、話しやすさ（読み上げやすさ）を最適化すること。\n- 聴衆への二人称（「あなた」「皆さん」）を効果的に使用し、語りかけるトーンを維持すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"47\" placeholder=\"出力形式を入力してください\">\n- Markdown形式の台本で出力してください。トーンは情熱的で、信頼感のあるトーンとします。\n\n```markdown\n## セミナー・クロージング台本：【提案タイトル案】\n【導入：感謝と本日のまとめ】\n<参加者への心からの感謝の言葉と、セミナー全体の価値を凝縮した熱いメッセージ>\n\n### 1. 価値の再認識と最も重要なメッセージ\n【未来への架け橋：行動への動機付け】\n<「今日の学びを無駄にしないでください」といった切り口から、{参加者の主な課題}に触れ、行動の重要性を情熱的に訴えかける>\n（台本本文）\n- \n- \n\n### 2. 行動しないことのリスクと未来への期待感\n（台本本文）\n- \n\n### 3. 未来を切り開く唯一の解決策（CTAの提示）\n【特別なご案内：次のステップへ】\n<「そして今日、ここにお集まりいただいた皆さんだけに特別なご案内があります」という形で、{CTAの内容}を具体的に提示する。価格、特典、申し込み方法などを明確に伝える>\n（台本本文）\n- \n\n### 4. 今すぐ決断する理由（限定性と緊急性の強調）\n【限定性と緊急性のアピール】\n<「ただし、この特別なご案内は…」という流れで、なぜ「今すぐ」決断すべきなのか、{限定特典}や{締め切り}を提示し、行動を後押しする>\n（台本本文）\n- \n\n### 5. 締めくくり\n【最後のメッセージ：感謝と激励】\n<参加者への再度のお礼と、彼らの輝かしい未来の成功を心から祈る、力強く感動的なメッセージで締めくくる>\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナーのテーマ</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにセミナーのテーマを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>参加者の主な課題</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに参加者の主な課題を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>CTAの内容</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここにCTAの内容を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>限定特典（任意）</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに限定特典（任意）を入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>締め切り（任意）</h3>\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"ここに締め切り（任意）を入力します。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\n- 台本には感情に訴える言葉（例: 「ワクワク」「安心感」「モヤモヤ」）を効果的に使用し、共感を深めること。\n- CTA（行動喚起）のフレーズを、論理的な理由とともに、力強く繰り返すこと。\n- 特典や締め切りの情報は、太字で強調し、視覚的なインパクトを与えること。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 論理的な飛躍や、根拠のない抽象的な結論で終わらせないこと。\n- 事実と異なる誇張表現や虚偽の内容を含まないこと（信頼性の毀損を防ぐ）。\n- 「今すぐ申し込んでください」のような強引な命令調ではなく、あくまで「選択を促す」表現を用いること。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=613\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##参加者の主な課題=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##CTAの内容=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##限定特典（任意）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##締め切り（任意）=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
