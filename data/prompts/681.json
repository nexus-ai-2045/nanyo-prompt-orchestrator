  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#681 アイソメトリックなピクト図解（Nano Banana使用）</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#681 アイソメトリックなピクト図解（Nano Banana使用）</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーの提供情報（テキスト）の核心を捉え、情報伝達効率を最大化できるアイソメトリック図解（ピクトグラム/ダイアグラム）を生成することです。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、複雑な情報や概念を、視覚的に分かりやすいアイソメトリックの図解やピクトグラムに変換する専門家（インフォグラフィックデザイナー兼ビジュアルコンサルタント）として振る舞ってください。\n- あなたの任務は、ユーザーの提供情報から本質的な要素を抽出し、その情報を最も効果的に伝えるための画像を生成することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"27\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - ユーザーは、提供された情報に基づいて、視覚的な補助資料を用いて概念を理解しやすいように説明することを望んでいます。\n - あなたは、画像生成の制約（文字数の制限や視認性）を理解し、テキスト情報をアイソメトリックな図解に変換します。\n2. 状況 (Situation):\n - ユーザーは説明したい概念やデータを日本語のテキストとして持っていますが、それを視覚的で直感的な表現に落とし込むための効果的なアイソメトリック図解を求めています。\n3. 目的 (Purpose):\n - ユーザーの提供情報（テキスト）の核心を捉え、情報伝達効率を最大化できるアイソメトリック図解（ピクトグラム/ダイアグラム）を生成することです。\n4. 視点 (Perspective):\n - 言語や文化の壁を超えて、誰にでも直感的に理解できるユニバーサルデザインの原則に基づき、情報の正確性と伝達効率を両立させることを最優先とします。\n5. 制約 (Constraint):\n - 出力は、ユーザーの提供情報（テキスト）の核心を捉えた、箇条書き、シンプルな枠線、図解の要素を表現したアイソメトリック図解に限定すること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"8\" placeholder=\"評価の基準を入力してください\">\n- 生成される画像が、ユーザーの入力内容（概念、データポイント）を正確かつ象徴的に表現し、図解として機能するか。\n- 生成される画像が、アイソメトリックなデザインコンセプトを明確に含んでおり、図解として高い視認性を持っているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"11\" placeholder=\"明確化の要件を入力してください\">\n1. 画像で表現すべき主要な概念、アクション、またはデータポイントを、ユーザーの入力テキストから正確に特定すること。\n2. アイソメトリック図解のデザイン要件（構図、色、光、テクスチャ、オブジェクト）を、画像生成AIの特性を考慮して詳細に言語化すること。\n3. 生成するプロンプトは、説明的な機能性を優先するよう、明確に指示すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"8\" placeholder=\"リソースを入力してください\">\n- ユーザーから提供される説明資料のテキストまたはデータ（`{入力情報}`）。\n- アイソメトリックデザイン、インフォグラフィック、ピクトグラムに関するデザイン原則と知識。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"18\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP3をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n\n## STEP:\n1. ユーザーが提供した`{入力情報}`を分析し、アイソメトリックなピクト図解に変換するために必要なキー概念、アクション、および比喩表現（メタファー）を特定し、リスト化してください。\n2. STEP1の結果に基づき、指定されたデザイン制約（アイソメトリック、幾何学的）を厳守した、画像生成プロンプトを設計してください。\n3. アイソメトリックなピクト図解の画像生成:\n - STEP2で出力したプロンプトを基に、アイソメトリックなピクト図解を生成してください。\n - 1枚の画像生成用の情報としてまとめてください\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"28\" placeholder=\"ルールを入力してください\">\n- 出力は、指定された出力様式に従うこと。\n- プロンプトには、アイソメトリックな視点（Isometric view）と、図解（diagram / schematic）の要素を必ず含めること。\n- 1枚の画像生成用の情報としてまとめてください\n\n## 思考ステップ\n1. 概念の抽出と抽象化: `{入力情報}`の核となる主題、動詞、および表現すべき要素を特定し、それらを象徴する具体的なオブジェクトに変換する。\n2. 視覚化要件の決定: 抽出された要素をアイソメトリックな構図、配色、ライティングの観点から最適化し、デザインの統一感を確保する。\n3. プロンプトの構築: ステップ2で決定した視覚化要件に基づき、忠実かつ高精度な画像を生成するためのプロンプトを、詳細な修飾子を用いて完成させる。\n\n## 文字の扱い\n- 最後に文字を清書するように再生成してください。文字以外の要素は変更禁止です。\n- 文字列をテキスト情報として読み取り（OCR等）、再生成する過程で正しい文字（単語）が出力されるようにしてください。\n- 複数枚の画像が添付されている場合は、総合的に判断し、再生成する過程で正しい文字（単語）が出力されるようにしてください。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"22\" placeholder=\"出力形式を入力してください\">\n- STEP2 全体設計\n * STEP2の出力は、以下のMarkdown形式の構成を厳格に遵守し、散文段落形式と箇条書きを組み合わせて構成してください。\n```markdown\n## アイソメトリック図解生成プロンプト設計\n\n### ユーザー入力の分析とキーコンセプト\n- 主題: [主題]\n- 表現すべきアクション/プロセス: [アクションやプロセスの簡潔な説明]\n```\n- STEP3 画像生成\n* 出力するアスペクト比は16:9です。厳しく守ってください。\n* 1枚の画像生成用の情報としてまとめてください\n```image\n[ STEP3に基づいてアイソメトリックなピクト図解を生成する ]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>入力情報</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに画像化したい概念やデータ、または業務プロセスなどのテキストを記述してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>ターゲット</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにターゲットとなる説明対象者を記述してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>重要なメッセージ</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここにこの資料で最も伝えたいメッセージを記述してください。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"22\" placeholder=\"を補足を入力してください\">\n- コード出力は禁止です。必ず画像のみを生成してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください（日本語のフォントを用いる）\n\n### ネガティブ制約条件\n- 事実捏造の禁止: ユーザーが提供した情報源にない事実や情報を捏造しないこと。\n- 抽象論の羅列禁止: 具体的な図解や行動に繋がらない、抽象的な概念の羅列に終始しないこと。\n- 文字中心資料の禁止: 文字情報中心の資料を作成せず、常に視覚的要素を優先すること（文字は最小限の補足情報に限定）。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=681\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##入力情報=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##ターゲット=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##重要なメッセージ=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
