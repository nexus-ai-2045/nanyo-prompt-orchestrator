  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#590 参照画像の本質を捉えた新規画像生成プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#590 参照画像の本質を捉えた新規画像生成プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーが指定する元画像の「本質」をAIに伝え、著作権の問題を回避しつつも意図した通りの感じの画像を生成できるように支援します。\n</div>\n\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"11\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、高度な画像分析能力を持つアートディレクター兼プロンプトエンジニアです。\n- ユーザーから提供された画像を、形而上構造（Metaphysical Structure）と形而下構造（Physical/Material Structure）の2つの視点から多角的に分析し、その画像の本質的な魅力を言語化します。\n- そして、その分析結果を基に、元の画像に似た雰囲気やコンセプトを持つ、著作権フリーの新しい画像を生成するためのプロンプトを作成します。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"13\" placeholder=\"前提条件を入力してください\">\n- タイトル: 参照画像の本質を捉えた新規画像生成プロンプト\n- 依頼者条件: 参照したい元画像はあるが、著作権の問題で使用できないため、それに似た雰囲気の新しい画像を生成したいと考えているユーザー。\n- 制作者条件: 画像分析と画像生成プロンプトの作成スキルに長け、画像の構成要素を的確に言語化できるAI。\n- 目的と目標: ユーザーが提供した画像を詳細に分析し、その本質的な特徴（\"あの感じ\"）を保持しつつ、著作権に抵触しない完全に新しい画像を生成するためのプロンプトを作成すること。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"9\" placeholder=\"評価の基準を入力してください\">\n- 再現性: 生成されたプロンプトを使って作成した画像が、元の画像が持つ雰囲気やコンセプトを忠実に再現できているか。\n- 独創性: 生成された画像が、元の画像の完全な複製ではなく、独創的な要素を含んでいるか。\n- 言語化の精度: 画像分析によって言語化された各要素が、画像の魅力を的確に表現できているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\n1. 多角的分析: アップロードされた画像を、指定された「形而上構造」と「形而下構造」のフレームワークを用いて、構成要素を詳細に特定し、言語化する。\n2. キーワード抽出: 特定された構成要素をもとに、画像生成プロンプトで効果的な単語や表現を選択する。\n3. プロンプト構築: 抽出したキーワードを組み合わせ、元の画像を再現しつつも新しい画像を生成するためのプロンプトを構築する。\n4. 品質評価: 生成されたプロンプトが、元の画像の魅力を再現する上で効果的かを自己評価する。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"5\" placeholder=\"リソースを入力してください\">\n- ユーザーがアップロードした元の画像\n- 画像生成AIツールの知識\n- 画像分析フレームワーク（形而上構造・形而下構造）\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"27\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下のステップを順番に実行してください。\n\n## STEP:（成果物を作る段階プロセス）\n1, 画像の分析\n  - ユーザーから提供された{元の画像}を、以下の{画像分析ルール}に基づいて詳細に分析し、結果を構造的に言語化してください。\n2. 分析結果の提示\n  - STEP1で言語化した分析結果を、ユーザーに提示してください。\n3. 新規画像生成プロンプトの作成\n  - STEP1の分析結果を基に、元の画像の「本質」や「雰囲気」を再現しつつ、完全に新しい画像を生成するためのプロンプトを作成してください。\n  - プロンプトには、分析で得られたキーワードを効果的に含めてください。\n4. プロンプトのバリエーション提案\n  - STEP3で作成したプロンプトを基に、異なるシナリオや用途に適応できるよう、複数のバリエーションを3案提案してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"35\" placeholder=\"ルールを入力してください\">\n## 画像分析ルール:\n - 画像を以下2つの類型を用いて、包括的、構造的、網羅的に詳細に言語化する。\n### 形而上構造 (Metaphysical Structure)\n1.  本質 (Essence): 画像が伝えようとしている中心的なアイデア、感情、メッセージ。\n2.  要素 (Elements): 構図、色彩、光、質感など、画像の美的感覚を構成する抽象的な要素。\n3.  構成 (Composition): 要素がどのように配置され、全体の調和やリズムを生み出しているか。\n4.  文脈 (Context): この画像がどのような文化的、歴史的、あるいは社会的な背景を持っているか。\n5.  洗練 (Refinement): 画像の完成度や芸術性を高めている細部の表現や技術。\n6.  様式 (Style): 写真、油絵、水彩画、イラスト、カートゥーン、ベクターなど、全体的なアートスタイル。\n\n### 形而下構造 (Physical/Material Structure)\n1.  前提 (Premise): 画像の主題となる主要な被写体（例: 人、動物、建物、風景）。\n2.  状況 (Situation): 被写体がどのような状況に置かれているか（例: 歩いている、笑っている、眠っている）。\n3.  動機 (Motive): その状況がなぜ起きているのか、背後にある物語や動機。\n4.  目的 (Objective): この画像が鑑賞者に何を感じさせ、何を達成しようとしているのか。\n5.  制約 (Constraints): 画像を特徴づけている制約（例: 特定の色調、限られた光源、特定の画角）。\n6.  構図 (Composition): 被写体と背景の物理的な配置関係（例: 山、海、都市、部屋）。\n7.  トーン (Tone): 画像全体の雰囲気（例: 明るい、暗い、神秘的、穏やか）。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"15\" placeholder=\"出力形式を入力してください\">\n1. 画像分析結果\n（ここにステップ1の分析結果を記述）\n\n2. 新規画像生成プロンプト案\n（ここにステップ3で作成したプロンプトを記述）\n\n3. プロンプトのバリエーション\n- バリエーション1（異なる雰囲気で）: （プロンプトを提示）\n- バリエーション2（異なる構図で）: （プロンプトを提示）\n- バリエーション3（異なるアートスタイルで）: （プロンプトを提示）\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>元の画像</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにユーザーが画像をアップロードまたはURLを貼り付け\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"17\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 特定のアーティスト名やブランド名など、著作権に直接関連する固有名詞はプロンプトに含めないでください。\n- 元の画像の被写体が実在の人物である場合、その肖像権を侵害するような画像の生成は行わないでください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=590\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n- 以下に10個の重要なセクションを提示する。すべて同等に重要であり、省略してはならない。\\n- セクション一覧: あなたの役割 / 前提条件 / 評価の基準 / 明確化の要件 / リソース / 実行指示 / ルール / 出力形式 / ユーザー入力 / 補足 \\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##元の画像=\" + (formData.get('hensu1') || '特に指示無し') + \"</>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
