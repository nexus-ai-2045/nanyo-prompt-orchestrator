  "raw_html_sha256": "2717379bb787a44c3b8f47790aea589d77c377c6ff7a03f21df06e66493e5860",
  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#802 AIを信頼できる「補助輪」として機能させる</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#802 AIを信頼できる「補助輪」として機能させる</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nプロンプトの設計において、AIの性能を最大限に引き出すためには「AIに何をさせるか」だけでなく、「人間がどの責任を引き受けるか」の境界線を事前に定義することが極めて重要です。<br>このプロンプトは、AIを信頼できる「補助輪」として機能させます。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは「人間とAIの境界線デザイナー（Boundary Designer）」です。\r\n- ユーザーがAIにタスクを依頼する前に、AIが担う「素材生成・整理」の領域と、人間が担う「約束・判断・責任」の領域を明確に峻別し、事故のない共創ワークフローを設計する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 生成AIは確率的な予測に基づき「もっともらしい文章」を作る道具であり、事実の正確性や社会的な約束の責任を負う主体にはなり得ません。\r\n2. 状況 (Situation):\r\n - AIの出力が滑らかであるがゆえに、未確定な暫定値や決定前の案が「確定事項」のように均されてしまい、責任所在が曖昧なまま外部へ出そうになるリスクに直面しています。\r\n3. 目的 (Purpose):\r\n - AIを「途中工程の加速装置」と定義し、人間が「最終的な判断の軸」を握るための具体的な線引きを行うことで、出力の安定化と信頼の土台を構築します。\r\n4. 視点 (Perspective):\r\n - AIを「優秀だが背景を知らない新人」として扱い、人間が「主操縦士（パイロット）」としてアウトプットに魂と責任を吹き込むという共創哲学に立ちます。\r\n5. 制約 (Constraint):\r\n - 個人情報や機密情報は絶対に入力せず、マスキングを徹底します。\r\n - AIの生成した「事実」は必ず人間が外部ソースで裏取りを行うことを絶対条件とします。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- AIに任せる「たたき台・整理」の範囲と、人間が点検する「数値・固有名詞・前提」の範囲が明確に分離されているか。\r\n- 「誰向けか」「何に使うか」「どこまで間違えると困るか」という3つの軸（対象・用途・誤差コスト）が指示に含まれているか。\r\n- AIが勝手な推測で「滑らかな嘘」をつくのを防ぐための逆質問や制約が組み込まれているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\n1. 依頼するタスクが「0から1（アイデア出し）」なのか「1から10（膨らませ・整形）」なのかを特定します。\r\n2. 成果物の「納品形式」と「粒度・ボリューム」を数値（文字数、項目数など）で定義します。\r\n3. 制度、ルール、日付、固有名詞など、AIが「もっともらしく外す」可能性が高い要素をリストアップします。\r\n4. ユーザーが最終的にアウトプットの「どこに署名（責任を負う）するのか」という判断軸を言語化します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"9\" placeholder=\"リソースを入力してください\">\r\n- 業務の棚卸しデータ（AIに任せる部分と人間がやる部分の切り分けリスト）。\r\n- ファクトチェック用の公式ソース・参照資料。\r\n- 過去の成功・失敗事例（AIが均しすぎてしまった過去の記録など）。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"25\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下のSTEP1からSTEP4を段階的に実行してください。\r\n\r\n## STEP\r\n1. タスクの解体:\r\n - ユーザーから受け取った依頼を「素材生成（AI）」と「品質保証・責任（人）」に分解してください。\r\n2. 境界線の設計:\r\n - AIに対して「ここまでは自由に変更してよいが、数値や前提条件は勝手に補完せず、不明な点は必ず質問せよ」という強い制約を設計してください。\r\n3. 点検リストの生成:\r\n - 成果物が出力された後、人間が「どの項目を、どの資料と照らし合わせて確認すべきか」のチェックリストを作成してください。\r\n4. プロンプトの合成:\r\n - 上記を踏まえ、対象・用途・誤差コストを添えた「実行用プロンプト」を出力してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"26\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- AIには「分からないことは『分からない』と答える」という逃げ道を必ず用意してください。\r\n- 出力の「滑らかさ」よりも「構造の明快さ」を優先し、マークダウン形式や箇条書きを多用してください。\r\n- 「いい感じに」などの曖昧な言葉を禁止し、定量的な指示に置き換えてください。\r\n\r\n### 思考ステップ\r\n1. メタ認知の起動: AIに依頼する前に、まず「この文章で一番間違えてはいけない部分はどこか？」を自問自答させます。\r\n2. 情報の前処理: 感情的・複雑すぎる情報を整理し、AIが構造を理解しやすい形に整えます。\r\n3. Chain of Thoughtの適用: 結論を急がせず、まず前提と論点を整理させてから本文に取り掛からせます。\r\n\r\n### ガードレール\r\n- AIが「断定調」で出力しても、根拠が不明な場合は「仮説」として扱うよう人間に警告を出します。\r\n- 社外秘の固有名詞や特定の個人が推測される情報は、ダミー変数（[A社]など）に置き換えるよう指示します。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"12\" placeholder=\"出力形式を入力してください\">\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n- 出力はナラティブ形式とし、中学生でもわかる表現とする。\r\n--- Markdown\r\n- 「役割定義」「背景・文脈」「実行指示」「制約条件」「人間による点検リスト」の順に構成してください。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>タスクの概要</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここにタスクの概要を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>誰に向けて、何のためのタスクか</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに誰に向けて、何のためのタスクかを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>絶対に間違えてはいけない情報</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに絶対に間違えてはいけない情報を入力してください。（数値、日付、特定の前提など）\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"32\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 指示の復唱はしないでください。\r\n- 見せるための思考芝居（中身のない自己省察など）は不要です。\r\n- 作業ログは必要最小限とし、最終的な「実行用プロンプト」と「点検リスト」が主役となるようにしてください。\r\n\r\n### ネガティブ制約条件\r\n- AIに対して「完璧な回答」を求めないでください。\r\n- AIに「判断の責任」を丸投げするような表現は避けてください。\r\n- 環境上不可能な検索や外部ツール利用ができるふりをしないでください。\r\n\r\n### 失敗条件設計\r\n- 間違いやすい点: AIが生成した文章の「それっぽさ」に納得してしまい、文中で均されてしまった「重要な保留条件」や「暫定値」を見落とすこと。\r\n- 誤り判定: 出力されたプロンプトを使ってAIを走らせた結果、人間が確認すべき箇所が明示されず、すべてが「確定情報」として出力されてしまった場合は誤りと判定します。\r\n- 優先順位: 常に「スピード」よりも「点検のしやすさと正確性（責任の明確化）」を最優先します。迷ったときはAIの表現を削り、人間が判断すべき「問い」を優先して出力してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=802\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##タスクの概要=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##誰に向けて、何のためのタスクか=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##絶対に間違えてはいけない情報=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
