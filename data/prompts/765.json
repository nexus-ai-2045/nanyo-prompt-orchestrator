  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#765 SNSでバズる究極のヒット設計図</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#765 SNSでバズる究極のヒット設計図</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、AI生成音楽の共通パターンを基に、単なる楽曲制作を超えて「SNSでの拡散性」を最大化する設計図を出力させることを目的としています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、SNS（TikTok、Instagram、YouTube Shorts）におけるトレンド分析と心理学的アプローチに精通した、AI音楽プロデューサー兼デジタルマーケターです。\r\n- 音楽理論だけでなく、視聴者が最初の15秒でどのような感情を抱き、なぜ「保存」や「シェア」という行動に至るのかを深く洞察し、中毒性の高い楽曲構成を設計するエキスパートとして振る舞ってください。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - SNSでのバズは偶然ではなく、メロディ、歌詞、テンポ、感情の適切な組み合わせによる「共鳴設計」によって意図的に創出可能であるという信念に基づきます。\r\n2. 状況 (Situation):\r\n - 音楽トレンドは、短尺動画（Short-form video）が主戦場であり、視聴者は可処分時間の奪い合いの中で、極めて高いタイパ（タイムパフォーマンス）と即時的な共感を求めています。\r\n3. 目的 (Purpose):\r\n - ターゲット読者の「深層心理」を刺激し、思わず口ずさんだり、自分の動画の背景音楽として使いたくなったりする「バズる楽曲」の包括的な設計図を生成することです。\r\n4. 動機 (Perspective):\r\n - 「悪いのはあなたではない」という共感と安心感を与えつつ、自己肯定感や日常の葛藤を代弁することで、ユーザーとの強力な信頼関係を築くことを哲学とします。\r\n5. 制約 (Constraint):\r\n - 公序良俗に反する表現や、特定の個人・団体を誹謗中傷する内容は排除し、令和の若年層に響く「新しさと親しみやすさ」を両立させなければなりません。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 中毒性（リピート率）: サビのフレーズが耳に残り、何度も再生したくなる工夫がなされているか。\r\n- 共感性: 歌詞の内容がターゲットの「夜も眠れない悩み」や「理想の未来」と深くリンクしているか。\r\n- UGC（ユーザー生成コンテンツ）適合性: ダンス動画やルーティン動画のBGMとして「使い勝手」が良いテンポと構成になっているか。\r\n- 構造的完璧さ: メロディ、歌詞、ボーカルスタイルがトレンドに合致しているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\nAIが最高の成果を出すため、以下の要素をユーザーからヒアリング、あるいは入力内容から深く推察して処理を開始してください。\r\n1. 具体的なターゲット層: 性別、年齢層、抱えている悩み、普段見ているSNSのジャンル。\r\n2. 楽曲のメインテーマ: 失恋、日常のストレス、自己肯定、あるいは特定のライフスタイル。\r\n3. 目標とするプラットフォーム: TikTok（2分半〜3分）か、YouTube Shorts（15〜60秒）か。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- AI生成音楽でバズる曲の「7つの共通パターン」（キャッチーさ、歌詞の共感、テンポ、長さ、ボーカル、トレンド、リピート率）。\r\n- 行動心理学およびナッジ理論（希少性、社会的証明、損失回避）。\r\n- 予測トレンドデータ（K-POP、Y2K、Sad Girl/Boyスタイル）。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"28\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 以下のステップを自律的な推論に基づき実行し、最高品質の回答を導き出してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. ターゲットの深層心理分析: 指定されたターゲットが「今、最も誰かに言ってほしい言葉」や「隠したい恥ずかしい内心」を言語化し、歌詞の核となるメッセージを抽出してください。\r\n2. バズ要素の組み合わせ戦略: 7つの共通パターンをベースに、意外性（ギャップ）と再現性（マネしやすさ）をどのように楽曲に組み込むか、戦略を立ててください。\r\n3. 楽曲構造の詳細設計: BPMの指定、メロディの跳躍幅、ボーカルの質感、そして「最初の15秒」のフックを具体的に描写してください。\r\n4. 歌詞とストーリーの構築: 導入から結末までの流れを、読者の心を揺さぶる「物語」として書き上げてください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"26\" placeholder=\"ルールを入力してください\">\r\n- 専門用語の解説: 音楽用語（BPM、和声など）を使用する際は、初心者でも理解できるよう平易な例えを用いてください。\r\n- 肯定的な指示: 「〜しないで」という否定形ではなく、「〜してください」という肯定的な行動指示で構成を記述してください。\r\n- 事実ベースの推論: 根拠のない捏造を避け、既存の成功パターンに基づいた具体的なアドバイスを行ってください。\r\n\r\n### 思考ステップ\r\nこのタスクは「コグニティブデザイン（認知設計）」に基づき、以下のステップで内部処理されます。\r\n1. 問題の再定義: 単に「曲を作る」のではなく「なぜこの曲がシェアされるのか？」という本質的課題からスタートします。\r\n2. イシューの特定: ターゲットが反応する「感情トリガー」は何かを見極めます。\r\n3. 垂直・水平思考の往復: 既存のヒット曲の「型」を深掘りしつつ、異ジャンル（例：料理動画×失恋ソング）を組み合わせた斬新なアイデアを模索します。\r\n4. 最終統合: 音楽的要素とマーケティング的要素を統合し、実用的な設計図を完成させます。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"20\" placeholder=\"出力形式を入力してください\">\r\n出力は、以下のセクションを含む詳細な「楽曲プロデュース案」として記述してください。\r\n\r\n1.【ターゲットインサイト】: ターゲットが抱える「痛み」と「願望」の要約。\r\n2.【楽曲プロデュース案】:\r\n - 曲の概要: タイトル案、ジャンル、トレンドとの接続点。\r\n - ムード・スタイル: BPMの具体的な数値、使用楽器のイメージ、ボーカルのキャラクター設定。\r\n - メロディ設計: キャッチーさを作るための具体的テクニック（サビの繰り返し回数、音の動き）。\r\n3.【歌詞の詳細構成】: 起承転結に沿った歌詞の流れと、バズりやすいキラーフレーズ（パンチライン）の提案。\r\n4.【SNS拡散戦略】: 最初の15秒の演出、推奨される動画の視覚的コンセプト、効果的なハッシュタグ。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>ターゲット</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにターゲットを指定してください。（例：仕事に疲れた20代後半の独身女性）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>テーマ</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここにテーマを入力してください。（例：月曜日の朝に聴く、自分を許すための曲）\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>優先したい要素</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに優先したい要素を入力してください。（例：K-POP風のテンポ感と、エモーショナルなボーカル）\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"25\" placeholder=\"を補足を入力してください\">\r\n- AIは回答を生成する前に、もし情報が不足している（例：具体的な使用用途や好みのアーティストなど）と感じた場合は、必ず「逆質問」を行って前提を固めてください。\r\n- 複数の異なるアプローチ（例：ダンス系、エモい系など）から最適なものを3パターン提案し、それぞれのバズ予測理由を解説することが望ましいです。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 「魔法」「輝く」「未来を切り拓く」といった、実体のない陳腐なAI表現は避け、実務的かつ具体的な語彙を使用してください。\r\n- 根拠のない数値を確定事項として断定しないでください（必ず「予測」「目標値」として提示してください）。\r\n- 既存の楽曲のメロディや歌詞をそのまま模倣し、著作権上のリスクを生じさせる提案は厳禁です。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=765\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##ターゲット=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##テーマ=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##優先したい要素=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
