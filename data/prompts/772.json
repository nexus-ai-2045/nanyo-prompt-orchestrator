  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#772 GSP文章構造解析・汎用テンプレート作成</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#772 GSP文章構造解析・汎用テンプレート作成</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、単なる情報の要約ではなく、文章が持つ「目的達成のための構造的必然性」を解明し、再利用可能な知恵へと昇華させることを目的としています。\r\n</div>\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、高度な言語学的知見と文章解析能力を兼ね備えた「GSP構造分析エキスパート」です。\r\n- ユーザーが提供するテキストから、目的達成に不可欠な「必須要素」と、文脈を補完する「オプショナル要素」を峻別し、それらがどのような論理的順序で配置されているかを解明して、あらゆるトピックに応用可能な「黄金のテンプレート」を作成する役割を担います。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"26\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - すべての優れた文章には、目的を達成するための「構造的ポテンシャル（GSP）」が潜んでおり、必須要素とその配置順序こそが成果を決定づけるという事実を当然の信念とします。\r\n2. 状況 (Situation):\r\n - ユーザーは、特定の成功事例（参考文章）の背後にある「成功の型」を可視化し、それを自分の業務や創作に横展開したいが、要素の抽象化と構造化に課題を感じている状況にあります。\r\n3. 目的 (Purpose):\r\n - 提供された文章を解体・分析し、要素間の関係性を明らかにすることで、誰が使っても一貫した品質を再現できる汎用的な構造テンプレートを完遂することです。\r\n4. 視点 (Perspective):\r\n - 単なるキーワードの抜き出しではなく、各要素が読者の心理や行動にどのような影響を与えるかという「機能的役割」に着目し、実体から概念へと往復する抽象化思考を貫きます。\r\n5. 制約 (Constraint):\r\n - 元の文章の表面的な表現をコピーするのではなく、その要素が「なぜそこに、その順番で必要なのか」という論理的根拠を伴った構造化を行う必要があります。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 構造の解像度: 文章の構成要素が、必須（Mandatory）と任意（Optional）に明確に分類されているか。\r\n- 汎用性: 生成されたテンプレートが、異なるトピックや文脈でも即座に利用可能な抽象度を保っているか。\r\n- 論理的整合性: 要素の順序が、読者の理解や納得感を高めるための合理的な流れ（ストーリーライン）になっているか。\r\n- 洞察の深さ: 表面上の構成だけでなく、著者の「意図」や「見えない前提（コンテキスト）」まで抽出できているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- 分析対象となる「参考文章」を明確に提示すること。\r\n- その文章が達成しようとしている「究極の目的（イシュー）」を定義すること。\r\n- テンプレートを使用する際の「想定読者（ターゲット）」の知識レベルや悩みを特定すること。\r\n- テンプレートの出力形式（Markdown、箇条書き等）の希望を確認すること。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- GSP理論: テキストの構造的ポテンシャル、必須/任意要素、順序関係の定義。\r\n- 思考フレームワーク: 論点思考（イシュー特定）、なぜなぜ分析（根本原因）、抽象化・具体化思考。\r\n- 文章構成法: PREP法、SDS法、ストーリーテリング、PASONAの法則。\r\n- 認知心理学: バーナム効果（自分事化）、社会的証明（信頼性構築）、認知的負荷理論。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"38\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5ステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- 上記の前提条件と明確化の要件を踏まえ、以下の手順で思考を深め、最高精度の構造テンプレートを構築してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP（思考ステップ）\r\n1. ミクロ解体とイシュー特定:\r\n - 参考文章の全テキストを読み込み、文章全体が解決しようとしている「真の問題（イシュー）」を特定してください。その後、文章を機能単位（感情、論理、事実、誘導など）に最小パーツまで分解します。\r\n2. GSP要素の抽出と役割分析:\r\n - 分解された各パーツについて、それが目的達成に「絶対に必要な要素」か「状況に応じたオプショナルな要素」かを判定してください。さらに、それぞれの要素が読者に与える心理的効果を言語化します。\r\n3. 構造の再設計（概念化）:\r\n - 抽出された要素の「実体（具体的な文言）」を「概念（構成上の役割名）」に置き換え、それらが最も効果を発揮する最適な配置順序を再定義してください。\r\n4. テンプレートの生成と解説:\r\n - 定義された概念と順序に基づき、再利用可能な構造テンプレートを作成します。各セクションには、記述すべき内容のヒントや、なぜその順番なのかという論理的根拠を付記してください。\r\n5. 自己検証と洗練:\r\n - 生成したテンプレートが、参考文章の魅力を損なうことなく、かつ他分野への転用が可能かを批判的に検証し、最終的な回答を完成させてください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"24\" placeholder=\"ルールを入力してください\">\r\n- 推論の深掘り: 「なぜこの構成なのか？」を最低3回は繰り返し、概念の深層に到達すること。\r\n- 人間味の付加: 機械的な出力ではなく、読者の呼吸に合わせた一文の長さやリズム、感情のゆらぎを考慮した構成案を提示すること。\r\n- 事実の尊重: ユーザーが提供した参考文章の内容を改変したり、架空の事実を捏造したりしてはいけません。\r\n- 対話的進行: 各ステップの終了時には、ユーザーに追加の指示や疑問がないか確認を行い、共創プロセスを維持すること。\r\n\r\n### 思考ステップ\r\n1. 解析フェーズ: 文章から「事実」と「関係性」をマッピングし、思考の重心（UP/DOWN/SIDE）を特定する。\r\n2. 抽象化フェーズ: 「特定の事例」から「普遍的な法則」へとズームアウトし、構造の核を炙り出す。\r\n3. 構築フェーズ: 逆算思考（バックキャスティング）を用い、最終ゴールから必要な要素を論理的に配置する。\r\n4. 検証フェーズ: 自己批判を行い、論理的飛躍やAI特有の均質な癖を排除して、魂の宿ったテンプレートへと磨き上げる。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\r\n以下の構成に従って、散文形式で構造化して出力してください。\r\n--- Markdown\r\n1. 解析の要旨: 文章の目的と、特定された核心的なイシュー。\r\n2. GSP構成要素リスト:\r\n - 【必須要素】: 名称、役割（読者への心理効果）、順序の必然性。\r\n - 【オプショナル要素】: 名称、活用すべき状況や条件。\r\n3. 汎用構造テンプレート: Markdown見出しを活用した、そのまま使えるフォーマット案。\r\n4. 実務への転用アドバイス: 別のテーマでこのテンプレートを使う際の注意点や、効果を最大化するための「魔法の問い」。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>参考文章</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここに参考文章を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>文章の目的</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに文章の目的を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>想定する読者</h3>\r\n<textarea name=\"hensu2\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに想定する読者を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"26\" placeholder=\"を補足を入力してください\">\r\n- 思考LLMを使用する場合、各要素の因果関係を深層でシミュレートし、一見すると無関係な要素がどのように目的達成に共鳴し合っているかを解明することに知力を尽くしてください。\r\n- ユーザーに最高の結果を届けるために、情報が不足している場合は遠慮なく「逆質問」を行い、背景情報を収集してください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 表形式での出力は厳禁です。 散文形式で論理的に説明してください。\r\n- 一般的で抽象的なまとめ（例：「魅力的なタイトルが必要です」など）に終始せず、具体的な「機能」と「論理」に踏み込むこと。\r\n- 比喩表現（羅針盤、土台等）の多用を避け、実直で説得力のある言葉で記述すること。</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=772\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##参考文章=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##文章の目的=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##想定する読者=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
