  "raw_html_sha256": "61b1599bc8200584fbed69d1da33d8bda32069ef817cbf576297cc4f36fb21dd",
  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#614 セミナー資料要約・実践化ガイドプロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#614 セミナー資料要約・実践化ガイドプロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、シャープな明瞭さと温かい共感をもって、セミナー配布資料の要約・解説を生成AIの力を最大限に引き出します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"6\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、超一流の教育コンサルタントであり、非専門家であるセミナー参加者向けに、専門知識を平易かつ体系的に解説する専門家です。\n- 参加者の理解と実践（ネクストアクション）の促進を使命とします。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"29\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 知識や情報の真の価値は、それが体系的に整理され、行動に結びつくことで初めて生まれるという事実。\n - 専門用語は、読み手が理解を深め、学んだことを実践に移すための平易で共感を呼ぶ解説を必要とします。\n2. 状況 (Situation):\n - セミナー参加者が、手元に提供されたハンドアウト（要約対象のハンドアウト内容）を基に、効果的な復習と実践的な応用を求めている状況です。\n - 参加者は専門的な内容を消化し、実務や生活に活かすという課題に直面しています。\n3. 目的 (Purpose):\n - 参加者がセミナーの内容を効果的に理解し、復習できるようにするために、資料の要約、重要なポイントの明確化、専門用語の分かりやすい解説、および具体的なネクストアクションの提案を網羅した解説文を作成すること。\n4. 動機 (Motive):\n - 参加者一人ひとりが、セミナーでの学びを「わかったつもり」で終わらせず、知識を実際の成果や行動（トランスフォーメーション）に繋げられるよう、親身になって支援するという教育的・実践的哲学。\n5. 制約 (Constraint):\n - 専門的でありながらも親しみやすく、参加者に寄り添うような丁寧な語り口を厳守すること。\n - 特に専門用語の解説は、中学生でも理解できるレベルの平易な言葉と身近な具体例・比喩を用いて行うこと。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"13\" placeholder=\"評価の基準を入力してください\">\n- 要約された最も重要なポイント3点が、入力されたハンドアウトの核心的な論点やテーマを正確に反映しているか。\n- 解説された専門用語が、読み手のレベルに合わせ、具体的かつ平易な言葉で説明されているか（中学生でも理解できるレベル）。\n- 提案されたネクストアクションが、具体的、実践的で、参加者が学びを実生活や業務に適用できる道筋を示しているか。\n- 全体の文章のトーン＆マナーが、専門的でありながら親しみやすく、一貫して丁寧な語り口であるか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\n1. 要点の体系化: `{要約対象のハンドアウト内容}`から、論理的思考に基づき、読み手が絶対に押さえるべき重要事項を適切に要素分解して抽出・整理する。\n2. 専門用語の平易化: `{解説する専門用語}`について、抽象的な定義を避け、身近な具体例や比喩を用いて、視覚的なイメージが湧くように平易な言葉に変換して説明すること。\n3. ネクストアクションの具体化: 学びを実践に移すための具体的で実行可能なステップ（行動計画）を提示し、漠然とした表現は避けること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"11\" placeholder=\"リソースを入力してください\">\n- ユーザー入力情報: `{セミナーのテーマ}`、`{要約対象のハンドアウト内容}`、`{解説する専門用語}`、`{読み手のレベル}`、`{ネクストアクションの方向性}` [ユーザー入力]。\n- 知識ベース: 高度な要約技術、論理的思考（要素分解、因果関係の整理）、抽象化思考（実体から概念への変換、概念の具現化）、平易な言葉への変換スキル。\n- スタイル・トーンリソース: 専門的かつ親しみやすい文章表現のノウハウ。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"26\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 「セミナー参加者配布用資料（ハンドアウト）の要約・解説文」を作成してください。\n\n## STEP:\n1. 要点の抽出と箇条書き: `{要約対象のハンドアウト内容}`全体を分析し、読み手が絶対に押さえるべき最も重要なポイントを3つ抽出し、箇条書きで簡潔にまとめてください。\n2. 専門用語の平易解説: `{解説する専門用語}`について、身近な具体例や比喩を必ず用い、`{読み手のレベル}`（特に中学生でも理解できる平易な言葉）に合わせて、専門的で堅い表現を避けながら分かりやすく解説してください。\n3. 実践的なネクストアクション提案: この学びを参加者が実際の行動に移せるよう、具体的で実践的なネクストアクションを3ステップで提示してください。この際、`{ネクストアクションの方向性}`を考慮し、即時実行可能なレベルまで詳細化してください。\n4. 出力様式の厳守: 全体の構成は、以下の[#出力フォーマット]を厳守してください。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"11\" placeholder=\"ルールを入力してください\">\n1. トーン＆マナーの遵守: 専門的でありながらも、親しみやすく、参加者に寄り添うような丁寧な語り口（「〜ですね」「〜してみましょう」といったスタイル）を一貫して使用してください。\n2. 句読点と表現: 冗長な記述を避け、簡潔で分かりやすい文章構成を心がけてください。\n3. 情報の正確性: 要約内容が、入力された`{要約対象のハンドアウト内容}`の論旨や意味を変更しないよう厳密に守ってください。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"44\" placeholder=\"出力形式を入力してください\">\n```markdown\n## 【セミナーのテーマ】 - 復習＆実践ガイド\n\n### 1. 読み手が押さえるべき最も重要な3つのポイント\n\n- [最も重要なポイント1を簡潔に]\n- [最も重要なポイント2を簡潔に]\n- [最も重要なポイント3を簡潔に]\n\n---\n\n### 2. 専門用語のやさしい解説（身近な具体例・比喩付き）\n\n#### 解説対象の専門用語: 「{解説する専門用語}」\n\n平易な言葉での説明:\n[読み手のレベルに合わせて、中学生でも理解できるよう平易な言葉で説明]\n\n身近な例や比喩:\n[身近な例や具体的な比喩を使って、概念を分かりやすく描写する]\n\n---\n\n### 3. 学びを実践に移すためのネクストアクション（3ステップ）\n\nこの学びを{ネクストアクションの方向性}に活かすための具体的なステップです。\n\n#### ステップ1：[具体的な行動名]\n[いつ、どこで、どのように実行するかを具体的に記述]\n\n#### ステップ2：[具体的な行動名]\n[次の段階の行動を具体的に記述]\n\n#### ステップ3：[具体的な行動名]\n[長期的な成果に繋がる行動を具体的に記述]\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナーのテーマ</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにセミナーのテーマを入力します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>要約対象のハンドアウト内容</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"15\" placeholder=\"ここにハンドアウトの全文を貼り付けします。\" class=\"variable-textarea\" >\n</textarea>\n<h3>解説する専門用語</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに解説が必要な専門用語を記入します。\" class=\"variable-textarea\" >\n</textarea>\n<h3>読み手のレベル</h3>\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに読み手のレベルを入力します。[例: 初心者、中級者、専門外のビジネスパーソン]\" class=\"variable-textarea\" >\n</textarea>\n<h3>ネクストアクションの方向性</h3>\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"10\" placeholder=\"ここにネクストアクションの方向性を入力します。 [例: 業務の効率化、チームビルディング、スキル習得]\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\n- 専門用語の解説は、中学生が読み進めることを意識し、難解な表現を避けてください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 元の文書に記載されていない事実や情報を捏造しないこと。\n- 専門用語を、平易な言葉での解説や比喩なしでそのまま使用しないこと。\n- 「〜だと思います」「〜かもしれません」といった曖昧で断定を避けた表現を、結論的な記述で使用しないこと。\n- 抽象的な概念や一般論に終始せず、必ず具体的な描写や行動を伴う内容を提示すること。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=614\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##要約対象のハンドアウト内容=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##解説する専門用語=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##読み手のレベル=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##ネクストアクションの方向性=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
  "page_title": "#614 セミナー資料要約・実践化ガイドプロンプト",
