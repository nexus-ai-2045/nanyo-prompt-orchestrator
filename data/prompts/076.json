  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#076 受け取ったメールに丁寧に返信する</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#076 受け取ったメールに丁寧に返信する</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、AIに受け取ったメールに丁寧に返信する文面を考えてもらいます。\r\n</div>\r\n\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは優秀な秘書であり、受信メールの内容を理解し、適切な返信メールを作成するアシスタントです。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"8\" placeholder=\"前提条件を入力してください\">\r\n- タイトル:受信メールに対し返信メールを生成したい\r\n- 依頼者条件:ビジネスまたは個人的なメールを頻繁にやり取りするユーザー。\r\n- 前提知識:基本的なメールの書き方、ビジネスメールと個人メールの違いを理解している。\r\n- 目的と目標:受信メールの内容に基づき、迅速かつ丁寧な返信メールを作成すること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 返信内容の適切性: 受信メールの内容に的確に答えているか、誤解を招く表現はないか。\r\n- 返信内容の論理性: 受信メールに対して論理的で矛盾のない返信が作成されているか。\r\n- 丁寧さ: 敬称や言葉遣いが適切で、相手に失礼な印象を与えていないか。\r\n- スタイルとトーンの一貫性: 依頼者が指定したスタイルとトーンが守られているか。\r\n- フォーマットの遵守: 指定された出力フォーマットに従って出力されているか。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\n- 返信メールは、受信メールの内容に具体的に言及し、相手に理解しやすいように構成する。\r\n- 返信メールの内容は、受信メールの内容と矛盾しないものとする。\r\n- 返信メールでは、受け取ったメールの送信者や返信者、さらにその内容が逆転する\r\n- 返信の内容を正確に理解し、必要な情報を特定する。\r\n- 内容の一貫性：受信メールに対する返信内容に矛盾がないか\r\n- 依頼者が希望する返信メールのスタイルとトーンを明確にする。\r\n- 出力フォーマットを詳細に指定し、AI が理解しやすいように記述する。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"4\" placeholder=\"リソースを入力してください\">\r\n- 受信メールの内容、返信メールのスタイル、返信メールのトーン、メールの返信フォーマットに関する情報\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"8\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」に厳格に従い、下記の{ルール}と{返信の方針}を基に、「評価の基準」を満たした返信メールを生成してください。\r\n- 返信メールは、{送信メール}との指定された{スタイル}と{トーン}により、明確かつ適切な表現にしてください。\r\n- {出力フォーマット}を参考にして出力してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\r\n## メール作成ルール:\r\n- 30文字程度で改行する\r\n- 3、4行ごとに空行を挿入する\r\n- 相手の敬称は「様」を使用する\r\n- 日付は「○月○日」の形式で記載する\r\n- 件名は「【】」で囲む\r\n- 添付ファイルは末尾にリストアップする\r\n- 文末には［以上、宜しくお願い致します。］を入力する\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"8\" placeholder=\"出力形式を入力してください\">\r\n```\r\n件名: Re;[返信メールの件名]\r\n[挨拶]\r\n[受信メールへの返信内容]\r\n[締めの言葉]\r\n\r\n```\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>受信メール件名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"2\" placeholder=\"受信メールの件名を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>受信メール本文</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"受信メールの本文を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>返信スタイル</h3>\r\n<select name=\"hensu3\" id=\"hensu3\" class=\"variable-textarea\">\r\n  <option value=\"\">--選んでください--</option>\r\n  <option value=\"丁寧でフォーマルなスタイル\">ビジネスシーンに適した、敬語を適切に使用した丁寧な言葉遣い</option>\r\n  <option value=\"信頼感と誠実さを示すスタイル\">誠実な言葉遣いを使い、相手に安心感を与える</option>\r\n  <option value=\"積極的かつ前向きなスタイル\">ポジティブな言葉を使用し、相手に良い印象を与える</option>\r\n  <option value=\"冷静で説得力のあるスタイル\">感情的な表現を避け、論理的な文章で相手に伝える</option>\r\n  <option value=\"専門的で明確なスタイル\">専門用語を適切に使いつつも、相手に理解しやすい言葉を選ぶ</option>\r\n  <option value=\"親しみやすく、共感を呼ぶスタイル\">相手に寄り添い、共感を促すような言葉遣い</option>\r\n  <option value=\"簡潔で分かりやすいスタイル\">長文を避け、簡潔で分かりやすい文章</option>\r\n  <option value=\"教育的で情報提供的なスタイル\">情報を分かりやすく伝え、相手の理解を深める</option>\r\n  <option value=\"積極的かつ誠実なスタイル\">提案や依頼に対して、積極的かつ誠実な姿勢</option>\r\n  <option value=\"励ましと鼓舞のスタイル\">相手を励まし、行動を促すような、力強い言葉</option>\r\n</select>\r\n<h3>返信トーン</h3>\r\n<select name=\"hensu4\" id=\"hensu4\" class=\"variable-textarea\">\r\n  <option value=\"\">--選んでください--</option>\r\n  <option value=\"丁寧でフォーマルなトーン\">ビジネスシーンに適した、敬語を適切に使用した丁寧な言葉遣い</option>\r\n  <option value=\"信頼感と誠実さを示すトーン\">誠実な言葉遣いを使い、相手に安心感を与える</option>\r\n  <option value=\"積極的かつ前向きなトーン\">ポジティブな言葉を使用し、相手に良い印象を与える</option>\r\n  <option value=\"冷静で説得力のあるトーン\">感情的な表現を避け、論理的な文章で相手に伝える</option>\r\n  <option value=\"専門的で明確なトーン\">専門用語を適切に使いつつも、相手に理解しやすい言葉を選び、明確な情報伝達を心がける</option>\r\n  <option value=\"簡潔で分かりやすいトーン\">長文を避け、簡潔で分かりやすい文章</option>\r\n  <option value=\"教育的で情報提供的なトーン\">情報を分かりやすく伝え、相手の理解を深める</option>\r\n  <option value=\"積極的かつ誠実なトーン\">提案や依頼に対して、積極的かつ誠実な姿勢を示す</option>\r\n  <option value=\"親しみやすく、共感を呼ぶトーン\">相手に寄り添い、共感を促すような言葉遣い</option>\r\n  <option value=\"励ましと鼓舞のトーン\">相手を励まし、行動を促すような、力強い言葉を使う</option>\r\n</select>\r\n<h3>返信の内容</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"5\" placeholder=\"返信の内容を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"5\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n- 上記の出力様式のフォーマット形式を厳守してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=76\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##受信メール件名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##受信メール本文=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信スタイル=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信トーン=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##返信の方針=\" + (formData.get('hensu5') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
