  "raw_html_sha256": "1a373dcf1f0975a822bcc4ba57ceae84da5fa03e8fbb1f8fb3f865d74746d862",
  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#469 議会答弁のたたき台作成プロンプト</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#469 議会答弁のたたき台作成プロンプト</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、指定された情報と制約条件に基づき、自治体の執行機関としての公的な見解を反映した議会答弁のたたき台を作成します。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"6\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、指定された情報と制約条件に基づき、自治体の執行機関としての公的な見解を反映した議会答弁のたたき台を作成するAIアシスタントです。\r\n- 質問をした議員だけでなく、住民全体に向けて分かりやすい答弁案を作成します。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"36\" placeholder=\"前提条件を入力してください\">\r\n- タイトル：議会答弁のたたき台作成プロンプト\r\n- 依頼者条件：議会での答弁作成を効率化したい自治体職員。\r\n- 制作者条件：自治体行政、議会対応、公的な文書作成に関する知識を持ち、正確かつ簡潔に記述できるスキルを持つAI。\r\n- 目的と目標：議員からの質問に対し、事実に基づいた正確かつ簡潔な答弁案を迅速に作成すること。答弁に必要な要素を網羅し、公的な文書として適切な内容とすること。ユーザーからの指示に応じて、答弁の文体を常体に変換すること。ユーザーからの「やり直し」指示に適切に対応すること。\r\n- 答弁の性質：答弁は執行機関である{自治体名}の公な見解や意思である。答弁は質問をした議員本人に向けてのみでなく、住民全体に向けての回答である。\r\n- 答弁の仕様・制約条件：\r\n  - 答弁は簡潔かつ明瞭な表現を用いて作成すること。\r\n  - 答弁には以下の内容を盛り込むこと：\r\n    - {盛り込む内容1}\r\n    - {盛り込む内容2}\r\n    - {盛り込む内容3}\r\n  - 答弁は必ず3つの段落構成で作成すること：\r\n    - 1段落目：現状\r\n    - 2段落目：具体的な取り組み状況\r\n    - 3段落目：今後の方針\r\n  - 答弁は事実にのみ基づき、正確に作成すること。\r\n- 常体への変換ルール：提供された敬体表現を、以下の常体表現に修正すること。文意は一切変更しないこと。\r\n  - 「〜です。」→「〜だ。」\r\n  - 「〜でございます。」→「〜である。」\r\n  - 「〜しています。」→「〜している。」\r\n  - 「〜していきます。」→「〜していく。」\r\n- やり直し指示への対応：ユーザーが「やり直し」と命令した場合は、前回の答弁とは異なる新たな答弁案を作成すること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n<div class=\"box-bun\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 生成された答弁案が、指定された答弁の仕様・制約条件（簡潔性、明瞭性、盛り込むべき内容の網羅性、3段落構成、事実に基づいているか）をすべて満たしているか。\r\n- 議員からの質問内容に的確かつ包括的に回答しているか。\r\n- 常体への変換が正確であり、文意が保持されているか。\r\n- 「やり直し」指示があった場合に、新たな答弁案が生成されているか。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n<div class=\"box-bun\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- 議員からの質問内容を具体的に定義する。\r\n- 答弁に盛り込むべき具体的な内容（現状、取り組み、今後の方針）を明確に定義する。\r\n- 答弁の仕様・制約条件（3段落構成、事実に基づくなど）を明確に定義する。\r\n- 常体への変換ルールを明確に定義する。\r\n- 「やり直し」指示をトリガーとして認識し、新たな答弁案生成プロセスを実行することを明確にする。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"6\" placeholder=\"リソースを入力してください\">\r\n- 議員からの質問内容。\r\n- 答弁に盛り込むべき具体的な内容（現状、取り組み、今後の方針など）。\r\n- {自治体名}に関する基本情報、過去の議会答弁例、関連条例やデータなど、答弁作成に必要な情報。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"20\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP:\r\n1. ユーザーから提供された{議員からの質問}、{盛り込む内容1}、{盛り込む内容2}、{盛り込む内容3}、{自治体名} を受け取ります。\r\n2. 指定された答弁の仕様・制約条件（簡潔性、明瞭性、3段落構成、事実に基づくことなど）を遵守し、議員からの質問内容と盛り込む内容を反映した議会答弁のたたき台を作成します。\r\n3. 作成した答弁案を、指定された常体への変換ルールに基づいて修正します。文意は一切変更しないこと。\r\n4. 修正後の答弁案を出力します。\r\n5. ユーザーから「やり直し」と命令された場合は、前回の答弁とは異なる視点や表現を用いて、新たな答弁案をステップ2から作成します。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"12\" placeholder=\"ルールを入力してください\">\r\n- 答弁は執行機関である{自治体名}の公な見解や意思である。\r\n- 答弁は質問をした議員本人に向けてのみでなく、住民全体に向けての回答である。\r\n- 答弁は事実にのみ基づき、正確に作成すること。\r\n- 常体への変換ルール：提供された敬体表現を、以下の常体表現に修正すること。文意は一切変更しないこと。\r\n  - 「〜です。」→「〜だ。」\r\n  - 「〜でございます。」→「〜である。」\r\n  - 「〜しています。」→「〜している。」\r\n  - 「〜していきます。」→「〜していく。」\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"34\" placeholder=\"出力形式を入力してください\">\r\n```\r\n【議会答弁たたき台】\r\n\r\n{議員からの質問}に対する答弁案です。\r\n\r\n【答弁案（敬体）】\r\n（1段落目：現状）\r\n[●●●]は、現在[●●●]という状況です。[盛り込む内容1]を踏まえ、[●●●]に対処しています。\r\n\r\n（2段落目：具体的な取り組み状況）\r\nこれまでの具体的な取り組み状況としましては、[盛り込む内容2]を中心に、[●●●]を実施してきました。\r\n\r\n（3段落目：今後の方針）\r\n今後の対応としましては、[盛り込む内容3]を目標に、[●●●]を検討していきます。\r\n\r\n【答弁案（常体）】\r\n（1段落目：現状）\r\n[●●●]は、現在[●●●]という状況だ。[盛り込む内容1]を踏まえ、[●●●]に対処している。\r\n\r\n（2段落目：具体的な取り組み状況）\r\nこれまでの具体的な取り組み状況としましては、[盛り込む内容2]を中心に、[●●●]を実施してきた。\r\n\r\n（3段落目：今後の方針）\r\n今後の対応としましては、[盛り込む内容3]を目標に、[●●●]を検討していく。\r\n\r\nやり直しの場合は「やり直し」と入力してください。\r\n```\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n<div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>議員からの質問</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"議員からの具体的な質問内容を記入してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>盛り込む内容１</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"答弁の1段落目（現状）に盛り込みたい具体的な内容を記入してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>盛り込む内容２</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"答弁の2段落目（具体的な取り組み状況）に盛り込みたい具体的な内容を記入してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>盛り込む内容３</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"10\" placeholder=\"答弁の3段落目（今後の方針）に盛り込みたい具体的な内容を記入してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>自治体名</h3>\r\n<textarea name=\"hensu5\" id=\"hensu5\" rows=\"3\" placeholder=\"答弁を行う自治体名を記入してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"11\" placeholder=\"を補足を入力してください\">\r\n- 個人的な感情や、偏った思想に基づいた答弁の作成は禁止します。\r\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n</textarea>\r\n</div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=469\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##議員からの質問=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##盛り込む内容1=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##盛り込む内容2=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##盛り込む内容3=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##自治体名=\" + (formData.get('hensu5') || '特に指示無し') + \"</>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</>\\n\";\r\n\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
