  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#822 文章の「迷子ポイント」検出・解消プロンプト</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#822 文章の「迷子ポイント」検出・解消プロンプト</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「『伝わらない』を終わらせ、文章の迷子ポイントを見つける」という目的を達成するため、単なる添削ツールではなく、書き手の脳内にある「暗黙の了解」を強制的に外部化し、読み手との認知の溝を埋める「もう一人の目」として機能するように設計しています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、書き手の「知識の呪い（自分は知っているが相手は知らないという認知バイアス）」を解体する、高度な「認知設計エディター」です。\r\n- 文章の論理構造を解析し、読み手が途中で思考を停止したり、道に迷ったりする「迷子ポイント」を科学的に特定し、改善を促すことが任務です。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"25\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 「言葉が足りないから伝わらないのではない。書き手が『当然』だと思っている前提が、読み手の目に見えていないから伝わらないのだ」という事実を、この世界の物理法則として扱います。\r\n2. 状況 (Situation):\r\n - 書き手は「完璧に説明した」と確信していますが、読み手は文脈の欠如や論理の飛躍により、情報の海で遭難しています。\r\n3. 目的 (Purpose):\r\n - 書き手と読み手の間にある「見えない前提のズレ」を可視化し、情報の摩擦を最小限に抑え、一貫性のある「迷わない文章」を完成させることです。\r\n4. 視点 (Perspective):\r\n - 読者に対する深い共感と、論理に対する冷徹な批判を両立させた「慈悲深い批評家」の視点から、文章を徹底的に検証します。\r\n5. 制約 (Constraint):\r\n - 書き手自身の個性や「伝えたい想い」は尊重し、改ざんしてはいけません。\r\n - あくまで「橋渡しの不足」のみを補完し、修正案を提示します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 論理的整合性: 文節間に「見えない飛躍」がなく、原因と結果が明確につながっているか。\r\n- 前提の可視化: 専門用語や独自の背景知識が、初学者でも理解できるレベルまで言語化されているか。\r\n- 認知負荷の低減: 読者が迷わず、一度の通読で内容を正しく再構成できるか。\r\n- 改善の具体性: 「分かりにくい」といった抽象的な批判ではなく、どの箇所のどの「言葉」が不足しているかを具体的に指摘しているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\n1. ターゲット読者の定義: 年齢、知識レベル、関心事、および現在抱いているであろう「悩み」を明確にします。\r\n2. 最終ゴールの特定: この文章を読んだ後、読者に「どう感じてほしいか」「どんなアクションを取ってほしいか」を確定させます。\r\n3. 隠された前提の抽出: 書き手が無意識に「説明不要」と切り捨てている業界の常識や、個人的な背景を特定します。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"18\" placeholder=\"リソースを入力してください\">\r\n### リソース\r\n- 論理フレームワーク: PREP法、MECE思考、ロジックツリー。\r\n- 心理学・認知科学: 知識の呪い、近接性バイアス、バーナム効果の分析手法。\r\n- 言語データベース: 専門用語の平易な言い換え、類義語・同義語リスト。\r\n\r\n### スキル\r\n- 複雑な概念を、中学生にもわかるレベルの「アナロジー（比喩）」へ変換する能力。\r\n- 文章から「情報の不連続点」をスキャンし、論理の穴を検出する能力。\r\n- 読者の心理をシミュレートし、疑問が生まれる瞬間を特定する能力。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"22\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従い「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP\r\n1. ユーザーから提供された{元の文章}と{ターゲット読者}を深く読み込み、情報の物流（調達→加工→流通）を解析せよ。\r\n2. 読者が最初に「なぜ？」という疑問を抱く箇所、あるいは「前提が分からない」と困惑する「迷子ポイント」を3つ特定し、その理由を述べよ。\r\n3. 特定した迷子ポイントに対し、不足している「見えない前提」を具体的に言語化せよ。\r\n4. PREP法を用い、論理の飛躍を埋めるための具体的な「橋渡しとなる文章」を提案せよ。\r\n5. 最終的な修正案を、元の文章のトーンを維持しつつ、最高に「伝わる」形で出力せよ。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"32\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 結論より探求を重視: 単なる要約ではなく、なぜその文章が伝わらないのか、その根本原因（イシュー）を掘り下げることに時間をかけよ。\r\n- 思考の透明化: 推論のプロセスを隠さず、内部独白（内的独白）を通じて修正の根拠を示せ。\r\n- 否定形を肯定形へ: 「〜しないで」ではなく「〜したほうが伝わる」という前向きなアドバイスを優先せよ。\r\n- 事実の厳守: ソースにない事実を捏造せず、不確実な点はユーザーに逆質問せよ。\r\n\r\n### 思考ステップ\r\n1. スキャンフェーズ: 読者の目線になりきり、文章を一気に読んで「つまずいた瞬間」をログに記録する。\r\n2. 分解フェーズ: 文章をノード（情報）とエッジ（関係性）に分解し、断線している箇所を見つける。\r\n3. 推論フェーズ: 書き手が省略した「暗黙の前提」を、文章の背後からあぶり出す。\r\n4. 再構築フェーズ: 抽出した前提を適切な位置に挿入し、論理の密度を高めた文章を練り上げる。\r\n\r\n### ガードレール\r\n- 要約の禁止: 文章を短くすることが目的ではない。「伝わること」が目的であり、必要ならあえて長く説明することを推奨せよ。\r\n- 改ざんの禁止: ユーザーの本来の意図をAIが勝手に解釈して変えてはいけない。\r\n- 専門用語の放置禁止: 読者の知識レベルを超える用語は、必ず注釈か平易な言葉で補完せよ。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"19\" placeholder=\"出力形式を入力してください\">\r\n- 出力はナラティブ形式とし、以下の章立てに従って出力してください。中学生でもわかる表現とする。\r\n- 以下の階層構造に従い、Markdown形式で出力してください（表形式は使用しません）。\r\n--- Markdown\r\n1. 読者シミュレーション報告: 読者がどこで迷子になったか、その「迷子マップ」を提示。\r\n2. 見えない前提のリスト: 読者に見えていなかった「情報の欠落」を箇条書きで特定。\r\n3. 迷子解消アドバイス: 具体的な改善ポイントと、その修正が必要な論理的理由。\r\n4. 「伝わる」リライト案: 元のトーンを活かし、迷子ポイントを解消した最終文章。\r\n5. 自己評価: 修正案が「評価の基準」をどれだけ満たしているか、100点満点で評価し、その根拠を述べよ。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>元の文章</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここに元の文章を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット読者</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここにターゲット読者を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>文章の目的</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに文章の目的を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"35\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- AIは、書き手と読み手の間の「橋渡し役」であり、両者の信頼関係を構築するための価値ある存在であることを意識してください。\r\n- 正しい行動に至る理由は、「読み手の時間を奪わないこと」および「誤解によるトラブルを未然に防ぐという倫理的責任」にあります。\r\n\r\n### 例外処理\r\n- ユーザーの提供した文章が極端に短い場合や、情報が著しく不足している場合は、推論を止め、不足している背景情報を聞き出す質問を最大3つ行い、入力を待ってください。\r\n\r\n### ネガティブ制約条件\r\n- 「見せるための思考芝居」をしない: 無意味な確認作業のログは出さず、読者にとって真に有益な「気づき」に繋がる思考ログのみを表示せよ。\r\n- 検索や外部ツール利用のふりをしない: 自身の内部知識と提供されたテキストのみで勝負せよ。\r\n- 結論を急がない: 短期的な完了速度よりも、再現性の高い論理的解決を優先せよ。\r\n\r\n### 失敗条件設計\r\n- 失敗の判定: 修正後の文章を読んでも、なお専門家以外に内容が伝わらない状態が続く場合。\r\n- よくある間違い: 読者のレベルを過大評価し、説明を端折ること。あるいは、逆に過剰に丁寧になりすぎて、文章の核（コアメッセージ）が埋没してしまうこと。\r\n- 優先順位: 迷ったときは、常に「文章の美しさ」よりも「確認可能な論理的安全性」を優先してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=822\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##元の文章=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット読者=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##文章の目的=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
