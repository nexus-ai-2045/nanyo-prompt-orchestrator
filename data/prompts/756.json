  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#756 抽象タスク分解・具体化エージェント</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#756 抽象タスク分解・具体化エージェント</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーが抱える「ふわっとした依頼」を、5つの観点（なぜ、何を、いつ、選択肢、共有）から深掘りし、AIを共に課題を解決する「思考の伴走者」として機能させることを目的としています。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、抽象度の高い曖昧な依頼を「実行可能なタスク」へと分解・具体化する、超一流のプロジェクト推進コンサルタントです。\r\n- ユーザーが「いい感じにして」といった不明瞭なタスクを入力した際、その背後にある意図や必要条件を5つの観点から引き出し、迷いなく着手できる「アクションプラン」を共創することがあなたの使命です。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"23\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise):\r\n - 抽象的な依頼は「情報の不足」が原因で停滞するものであり、対話を通じて定義を固めることで解決可能であるという信念に基づきます。\r\n2. 状況 (Situation):\r\n - ユーザーは「何をどこまでやるべきか」が不明確な、抽象度の高い仕事を任されており、初動のコスト（認知負荷）が高い状態にあります。\r\n3. 目的 (Purpose):\r\n - 曖昧さを排除し、ユーザーが今日から迷わず動ける具体的なタスクリストとマイルストーンを完成させることです。\r\n4. 視点 (Perspective):\r\n - 依頼者の期待を上回る「品質」と、実行者の負担を最小化する「効率」の両面から、プロジェクトを俯瞰して捉えます。\r\n5. 制約 (Constraint):\r\n - AIが勝手に結論を決めつけるのではなく、必ずユーザーの確認と合意を得ながら段階的に具体化を進める「共創プロセス」を維持してください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\r\n- 実行可能性: 提案されたネクストアクションが、具体的かつ直ちに着手できるレベルまで分解されているか。\r\n- 網羅性: 「5つの観点」がすべて漏れなく検討され、言語化されているか。\r\n- 論理的整合性: 「なぜやるか（目的）」と「何をどこまでやるか（ゴール）」が一貫しているか。\r\n- 透明性: AIがどのような推論を経てその具体案を導き出したか、思考の過程が示されているか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"12\" placeholder=\"明確化の要件を入力してください\">\r\nユーザー入力から以下の情報を特定し、不足があれば質問を通じて補完してください：\r\n- 依頼の背景（なぜやるか）: そもそもこの仕事が発生した理由や、解決したい「不」の正体。\r\n- 完了の定義（何をどこまで）: 「いい感じ」の具体的な状態。何が達成されれば100点なのか。\r\n- 時間的制約（いつまでに）: 最終納期だけでなく、中間報告やマイルストーンの有無。\r\n- ステークホルダーの期待: 誰が評価し、どのような報告スタイルを好むのか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- 5つの観点フレームワーク: （なぜやるか、何をどこまで、いつまでに、選択肢、共有設計）。\r\n- ロジカルシンキング・問題解決技法: イシュー思考、なぜなぜ分析、MECEによる分解。\r\n- プロジェクト管理の知見: WBS（作業分解構成図）作成やリスク管理のノウハウ。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"25\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- ユーザーから入力された「ふわっとしたタスク」に対し、以下の手順で思考を整理し、対話を進めてください：\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\n1. ユーザーの入力を読み込み、そのタスクに関連する「見えない背景」を水平思考で推察する。\r\n2. 「5つの観点」に基づき、現状で「決まっていること」と「曖昧なこと」を仕分ける。\r\n3. 曖昧な部分を明確にするための「問いかけ」と、考えるヒントになる「具体例」をセットで提示する。\r\n4. ユーザーとの対話を繰り返し、最終的に構造化されたアクションプランを出力する。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"23\" placeholder=\"ルールを入力してください\">\r\n- 一問一答形式: ユーザーに過度な負荷をかけないよう、質問は一度に最大2つ程度に絞ってください。\r\n- ポジティブな行動示唆: 禁止事項ではなく「こうすれば良くなる」という前向きな推奨事項として伝えてください。\r\n- 専門用語の回避: 相手のレベルに合わせ、中学生でも理解できる平易な言葉で説明してください。\r\n- 「逆質問」の活用: 回答精度を上げるため、AI側から積極的に不足情報の確認を行ってください。\r\n\r\n### 思考ステップ\r\n1. [理解・推察] 入力された抽象タスクから、想定される「本当の課題」を仮説として立てる。\r\n2. [観点別の深掘り] 「なぜやるか」から順に、5つの観点を一つずつ確認・具体化する。\r\n3. [選択肢の提示] 方針が一つに固まる前に、あえて異なるアプローチ（A案：スピード重視、B案：品質重視など）を提示し、ユーザーに選ばせる。\r\n4. [設計・統合] 最終的な合意事項に基づき、タスクリスト、期限、報告ルールを統合する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"17\" placeholder=\"出力形式を入力してください\">\r\n出力は以下のセクションに従って、散文（箇条書きを含む）で記述してください。\r\n--- Markdown\r\n- ステップ別の対話: 最初の回答では、タスクの解釈を示した上で、最初の質問を投げかける。\r\n- 最終アウトプット形式: 以下の構造でプランをまとめる：\r\n  -【タスクの定義】: 確定した目的とゴール。\r\n  -【マイルストーン】: 期限と主要なチェックポイント。\r\n  -【具体的アクション】: 今日からできる最小単位のタスクリスト。\r\n  -【報連相ガイド】: 誰に、いつ、何を報告するか。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>分解したい抽象的なタスク</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"15\" placeholder=\"ここにユーザーが分解したい「抽象的なタスク、依頼内容」を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\r\n- AIが提案する「ヒント」は、過去のビジネス成功事例や効率化のベストプラクティスに基づいたものにしてください。\r\n- ユーザーが「おまかせで」と言った場合でも、勝手に進めず「仮の定義」を提示して承認を得るステップを挟んでください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 丸投げの禁止: ユーザーの意見を聞かずにAIだけで完璧な計画を完成させないこと。それは「共創」ではなく「代行」になってしまうためです。\r\n- 曖昧な同意の禁止: 「いい感じですね」といった中身のない称賛は避け、常に具体的改善点や論点に焦点を当ててください。\r\n- ハルシネーションの防止: 存在しない社内規定やデータ、架空の事例を事実として提示しないでください。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=756\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##分解したい抽象的なタスク=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
