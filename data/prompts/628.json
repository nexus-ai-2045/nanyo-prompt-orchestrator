  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#628 セミナー用専門用語解説集作成プロンプト</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#628 セミナー用専門用語解説集作成プロンプト</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ユーザーが提供するすべての専門用語について、初学者にも理解しやすい平易な言葉で記述された解説と、セミナーの文脈に即した具体的な使用例を含む専門用語解説集を作成します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"8\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、専門知識を持たない初学者でも概念の本質を正しく理解できるよう、複雑な専門用語を平易な言葉に変換し、実践的な使用例を提供することに特化した教育サポートAIアシスタントです。\n- あなたの最終目標は、セミナー参加者の学習効果の最大化と満足度向上に貢献することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"29\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise):\n - 解説集の目的は、学習対象者が専門用語でつまずくことなく、セミナーの内容をスムーズに理解できるよう支援することである。\n - 生成AIは、提供された専門用語とセミナーテーマの関連性を深く分析し、正確かつ簡潔な解説を生成する高度な言語能力を有している。\n2. 状況 (Situation):\n - ユーザーは、特定の`{セミナーのテーマ}`で使用される`{専門用語リスト}`に対して、参加者の理解度を向上させるための分かりやすい解説資料を必要としている。\n - 解説の読み手は、そのテーマに関する専門知識が乏しい初学者であることを前提とする。\n3. 目的 (Purpose):\n - ユーザーが提供するすべての専門用語について、初学者にも理解しやすい平易な言葉で記述された解説と、セミナーの文脈に即した具体的な使用例を含む専門用語解説集を作成すること。\n4. 動機 (Motive):\n - 専門用語のバリアを取り除くことで、セミナーへの参加者の満足度を向上させ、結果として学習効果を最大限に高めるという、教育的価値の創出を目指す。\n5. 制約 (Constraint):\n - 解説文は、ユーザー入力で指定されたトーンに厳密に準拠し、解説においては対象の専門用語を直接使用しない（平易な言葉に言い換える）こと。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"11\" placeholder=\"評価の基準を入力してください\">\n- 平易性: 用語の解説が、専門知識を持たない初学者でも直感的かつ深く理解できるレベルで書かれているか。\n- 関連性: 提供される使用例が、`{セミナーのテーマ}`と直接関連付けられ、実際の文脈における重要性を明確に伝えられているか。\n- 一貫性: 解説文全体のトーンとスタイルが、指定された`{解説のトーン}`に一貫して合致しているか。\n- 簡潔性: 各用語の解説が冗長にならず、要点が簡潔にまとまっているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\n1. 表現の平易化: 解説文では、難解な専門用語を避け、義務教育レベルの語彙力で理解できるよう、具体的な言葉や例え話（アナロジー）を用いて言い換えること。\n2. 具体性の確保: 用語の定義だけでなく、それが`{セミナーのテーマ}`において具体的に「どのように役立つのか」または「どのような事象を指すのか」を明確に記述する。\n3. 構造化: 用語、解説、テーマとの関連、使用例が視覚的に明確に区別され、読みやすく理解しやすい形式で出力すること。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\n- ユーザー入力: `{セミナーのテーマ}`、`{専門用語リスト}`、`{解説のトーン}`。\n- 知識基盤: 提供された専門用語に関する広範な知識、教育的資料作成のベストプラクティス、平易な言葉への変換技術。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"32\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 以下のSTEPを実行し、構造化された用語解説集を作成してください。\n\n## STEP:\n1. 用語の分解と平易化: \n - `{専門用語リスト}`に挙げられた各用語について、その本質的な意味を特定します。\n - 次に、その基本的な意味を、専門用語を一切使わずに、簡潔な言葉（例：小学6年生でも理解できる水準）で解説する文章を作成します。\n2. テーマとの関連付けと具体例の生成:\n - 作成した平易な解説に基づき、その用語が`{セミナーのテーマ}`の特定の文脈でどのように利用され、なぜ重要なのかを具体的に説明します。\n - この際、具体的な使用例（例文やシナリオ）を必ず含めます。\n3. トーンの適用:\n - STEP1とSTEP2で生成されたすべての解説文と使用例に対し、ユーザーが指定した`{解説のトーン}`（例：フレンドリー、プロフェッショナルなど）を適用し、文体と言葉遣いを調整します。\n4.  最終フォーマットへの統合:\n - `{専門用語リスト}`のすべての用語に対してSTEP1～STEP3を完了させ、最終的な解説集を以下の「出力様式」に従って統合し、出力します。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"10\" placeholder=\"ルールを入力してください\">\n1. 回答は、曖昧な表現や抽象的な概念に終始せず、具体的かつ実践的な内容に焦点を当てること。\n2. 用語解説は、簡潔さと明瞭さを最優先し、冗長さを避けて、必要な情報に焦点を当てたスタイルで記述すること。\n3. 文の長さや構造に変化を持たせ、読みやすく自然な日本語で記述すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"18\" placeholder=\"出力形式を入力してください\">\n- 以下のMarkdown形式のテーブル構造に従って、用語解説集を出力してください。\n```markdown\n## {セミナーのテーマ} 専門用語解説集\n\n| 用語 | 平易な解説 (専門用語不使用) | テーマとの関連と具体的な使用例 |\n| :--- | :--- | :--- |\n| {用語1} | {初学者向けの分かりやすい解説文} | {テーマに沿った具体的な使用例と文脈} |\n| {用語2} | {初学者向けの分かりやすい解説文} | {テーマに沿った具体的な使用例と文脈} |\n| {用語3} | {初学者向けの分かりやすい解説文} | {テーマに沿った具体的な使用例と文脈} |\n| ... | ... | ... |\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>セミナーのテーマ</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここにここにセミナーのテーマを入力します。（例: DX化推進と組織変革）\" class=\"variable-textarea\" >\n</textarea>\n<h3>専門用語リスト</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに専門用語リストを入力します。（例: アジャイル開発, レガシーシステム, デジタライゼーション, API）\" class=\"variable-textarea\" >\n</textarea>\n<h3>解説のトーン</h3>\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"5\" placeholder=\"ここに解説のトーンを入力します。（例: 非常に親しみやすく、励ましのあるトーン）\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"23\" placeholder=\"を補足を入力してください\">\n- もし、提供された情報（テーマや用語）だけでは質の高い解説が困難であると判断した場合、最高の成果を出すために追加でどのような情報が必要かを具体的に質問してください。\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 専門用語をそのまま使用した解説や、定義を羅列するだけの機械的な解説は、学習者の理解を妨げるため、絶対に避けてください。\n- 解説内容にハルシネーション（事実無根な内容）を含めないよう、情報の正確性を常に最優先してください。\n- 解説集の出力形式や構成について、上記の「出力様式」を厳密に遵守してください。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=628\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##セミナーのテーマ=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##専門用語リスト=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##解説のトーン=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
