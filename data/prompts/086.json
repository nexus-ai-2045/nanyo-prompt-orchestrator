  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#086 アンガーマネジメントプログラムの提案によるストレス管理サポート</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: .5em 0;\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n/* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">#086 アンガーマネジメントプログラムの提案によるストレス管理サポート</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\n- 個人の怒りの原因に基づいたアンガーマネジメントプログラムを提案し、感情管理とストレス軽減をサポートしたい。<br>\r\n- 自身の怒りの原因や希望する対処法に基づいて、効果的なアンガーマネジメントプログラムを提案してほしい。<br>\r\n- 具体的には、小学生でも理解できるような怒りのメカニズムの解説、3つの具体的な感情管理ワークを含むプログラムの説明、そしてプログラムに参加したくなるような期待される効果についての説明が欲しい。\r\n</div>\r\n\r\n<!-- あなたの役割の入力 -->\r\n<div class=\"box-bun\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"4\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、個人のストレス管理をサポートする、アンガーマネジメントプログラムのエキスパートです。 \r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 前提条件 -->\r\n<div class=\"box-bun\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"6\" placeholder=\"前提条件を入力してください\">\r\n- タイトル:「アンガーマネジメントプログラム提案プロンプト」\r\n- 依頼者条件: ストレス管理に悩む個人またはその指導を行う専門家。\r\n- 目的と目標: 穏やかな日常を実現するための効果的なアンガーマネジメントプログラムを提案すること。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- リソース -->\r\n<div class=\"box-bun\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"4\" placeholder=\"リソースを入力してください\">\r\n- 感情制御技法や心理学的概念\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 実行指示 -->\r\n<div class=\"box-bun\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"10\" placeholder=\"実行指示を入力してください\">\r\n- {自身の怒りの原因}を踏まえた、穏やかな毎日を送るためのアンガーマネジメントプログラムを提案してください。\r\n- {対処法の希望}に基づいて、持続的で効果的な感情管理ツールとストレス軽減法を含めてください。\r\n- 生活改善戦略を通じて、怒りの制御や改善を訓練できる内容にしてください。\r\n- {出力フォーマット}を参考にして出力してください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- ルール -->\r\n<div class=\"box-bun\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"60\" placeholder=\"ルールを入力してください\">\r\n- \"怒りが起こるメカニズム\" について、小学生でも理解できるように具体的な例や比喩を含めて1000文字程度で解説してください。\r\n  - 怒りの感情が生まれる段階を、段階的に説明してください。\r\n  - 例えば、「お腹が空いた時」や「友達とケンカをした時」など、子供が経験する場面を例に挙げながら説明してください。\r\n  - 怒りを感じると、心臓がドキドキしたり、顔が赤くなるなど、身体にどのような変化が起こるか説明してください。\r\n\r\n- \"提案プログラム\" について500文字程度で説明してください。提案プログラムは、以下の3つの具体的なワークを記載してください。\r\n  1. 腹式呼吸: 怒りの感情が高まった時に、呼吸を整えて気持ちを落ち着かせる方法。\r\n  - 目的: 怒りの感情をコントロールし、冷静さを取り戻す\r\n  - 手順: \r\n    1. 楽な姿勢で座るか、仰向けに寝転びます。\r\n    2. 片手を胸に、もう片方をお腹に当てます。\r\n    3. 鼻からゆっくりと息を吸い込み、お腹を膨らませます。\r\n    4. 口からゆっくりと息を吐き出し、お腹をへこませます。\r\n    5. これを数回繰り返します。\r\n  - 所要時間: 5分\r\n\r\n  2. リフレーミング: 怒りを感じた出来事に対して、別の角度から見て考え方を変える方法。\r\n  - 目的: 怒りを感じた出来事に対する解釈を変え、ネガティブな感情を軽減する\r\n  - 手順:\r\n    1. 怒りを感じた出来事を具体的に書き出します。\r\n    2. その出来事に対して、自分がどのような解釈をしているかを書き出します。\r\n    3. 他の解釈はできないか、別の角度から見てみます。\r\n    4. 新しい解釈を書き出し、その解釈をすることで気持ちがどのように変わるかを考えてみます。\r\n  - 所要時間: 10分\r\n\r\n  3. アサーション: 自分の気持ちを率直に伝え、相手との適切な距離感を保つ方法。\r\n  - 目的: 相手に自分の気持ちを伝えつつ、良好な関係を築く\r\n  - 手順\r\n    1. 自分が相手に伝えたいことを明確にします。\r\n    2. 相手の気持ちを尊重しながら、自分の気持ちを率直に伝えます。\r\n    3. 相手の意見も聞き、妥協点を探ります。\r\n  - 所要時間: 15分\r\n\r\n- \"このプログラムをすることで期待される効果\" について、相談者が感動してどうしてもプログラムに申し込んでしまいたくなるような救いの手を差し伸べる内容の文面で800字程度で記載してください。\r\n  - プログラム参加によって、怒りの感情に振り回されることが減り、穏やかな毎日を送れるようになることを具体的に説明してください。\r\n  - 怒りを感じた時に、適切に対処できるようになることで、自信を持って行動できるようになることを説明してください。\r\n  - 周囲の人との関係が改善し、より良好なコミュニケーションが取れるようになることを説明してください。\r\n  - 過去のプログラム参加者の体験談や感想を交えながら、プログラムの効果を具体的に伝え、参加意欲を高めてください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n<!-- 出力設定 -->\r\n<div class=\"box-bun\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"24\" placeholder=\"出力形式を入力してください\">\r\n## 出力フォーマット\r\n’’’’\r\n# アンガーマネジメントプログラム提案\r\n## 怒りの原因\r\n- [自身の怒りの原因]\r\n\r\n## 希望する対処法\r\n- [対処法の希望]\r\n\r\n## 怒りが起こるメカニズム\r\n\r\n## 提案プログラム\r\n1. 方法の概要:\r\n2. 具体的な実行ステップ:\r\n\r\n### このプログラムをすることで期待される効果\r\n’’’’\r\n\r\n# スタイルとトーン\r\n- 優しくて親しみやすいトーン\r\n\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n<!-- 変数設定 -->\r\n<div class=\"box-bun\">\r\n<h2>変数設定</h2>\r\n<h3>自身の怒りの原因</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"自身の怒りの原因を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>対処法の希望</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"対処法の希望を入力してください\" class=\"variable-textarea\" >\r\n</textarea>\r\n</div>\r\n\r\n<!-- 補足 -->\r\n<div class=\"box-bun\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"4\" placeholder=\"を補足を入力してください\">\r\n- 指示の復唱はしないてください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないください。\r\n</textarea>\r\n</div>\r\n\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n<a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=85\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"# あなたの役割\\n\" + (formData.get('role') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 前提条件\\n\" + (formData.get('conditions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 評価の基準\\n\" + (formData.get('hyoka') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 明確化の要件\\n\" + (formData.get('meikaku') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# リソース\\n\" + (formData.get('resource') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 実行指示\\n\" + (formData.get('instructions') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# ルール\\n\" + (formData.get('clarification_rules') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 出力形式\\n\" + (formData.get('output') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 変数設定\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##項目１=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##項目２=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\\n\";\r\n    communicationContent += \"# 補足\\n\" + (formData.get('hosoku') || '特に指示無し');\r\n\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
