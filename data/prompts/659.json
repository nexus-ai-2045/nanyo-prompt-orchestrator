  "raw_html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex\" />\n    <title>#659 DXプロジェクト共通理解のための実践用語解説書作成</title>\n    <style>\n        /* === スタイル設定 === */\n        \n        /* 基本ページ設定 */\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background-color: #FFF;\n        }\n        /* メインコンテナのスタイル */\n        .container {\n            width: 100%;\n            max-width: 800px;\n            background: #ffffff;\n            border-radius: 8px;\n            box-shadow: 3px 5px 15px -5px #777777;\n            overflow: hidden;\n        }\n        /* 各種見出し・ボタンのスタイル設定 */\n        h2 {\n            color: #797979;\n            font-size: 1.6em;\n        }\n        .box-title {\n            font-size: 1.7em;\n            letter-spacing: 0.1em;\n            padding: 1em 20px; /* Combined padding */\n            background-color: #5fc2f5;\n            color: #fff;\n            font-weight: 600;\n            display: flex; /* Make it a flex container */\n            align-items: center; /* Vertically center items */\n            justify-content: space-between; /* Push items to ends */\n        }\n        .box-title .title-text {\n            flex-grow: 1; /* Allow title to take available space */\n            text-align: center; /* Keep title centered */\n            white-space: nowrap; /* Prevent wrapping */\n            overflow: hidden; /* Hide overflow content */\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\n        }\n        #toggleIcon {\n            font-size: 24px; /* Increased size */\n        }\n        .form-content {\n            padding: 40px 120px;\n            background: #f1f1f1;\n        }\n        .box-bun {\n            background: #FFF;\n            border: 1px solid #D5D9DC;\n            border-radius: 20px;\n            padding: 15px;\n            margin-bottom: 40px;\n        }\n        .togglable-section {\n                /* display: none; Removed */\n            }\n        label {\n            display: inline-block;\n            margin-left: 5px;\n            color: #656565;\n        }\n        input[type=\"text\"], select, textarea {\n            width: 100%;\n            padding: 10px;\n            margin-top: 5px;\n            box-sizing: border-box;\n            border: 0.5px solid #AEAEAE;\n            border-radius: 5px;\n            font-size: 16px;\n        }\n        textarea {\n            resize: vertical;\n        }\n        .button-group {\n            display: flex;\n            justify-content: center;\n            margin-top: 20px;\n        }\n        .btn2 {\n            width: 150px;\n            height: 60px;\n            margin: 0 10px;\n        }\n\n        .btn-generate {\n            width: 180px;\n            height: 60px;\n            margin: 0 10px;\n        }\n        .btn2 a, .btn-generate a {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            text-decoration: none;\n            font-size: 20px;\n            font-weight: bold;\n            border-radius: 35px;\n            transition: all 0.5s ease;\n        }\n        .btn2 a {\n            background: #FFFFFF;\n            color: #5FC2F5;\n            border: 2px solid #5FC2F5;\n        }\n        .btn2 a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .btn-generate a {\n            background: #5FC2F5;\n            color: #FFFFFF;\n        }\n        .btn-generate a:hover {\n            transform: scale(1.1, 1.1);\n        }\n        .small-text {\n            font-size: 0.5em;\n            color: #656565;\n            text-align: center;\n            margin-top: 5px;\n        }\n\n/* === 入力エリアの色設定 === */\n.variable-textarea {\n    background-color: #ffe4e1; /* 薄いピンク */\n}\n\n\n        /* === スマホ用設定 === */\n@media only screen and (max-width: 768px) {\n    .prompt-text {\n        display: none;\n    }\n    .container {\n        width: 100%;\n        padding: 10px;\n        box-shadow: none;\n    }\n    .form-content {\n        padding: 20px 10px;\n    }\n    .box-bun {\n        padding: 10px;\n        margin-bottom: 20px;\n    }\n    h2 {\n        font-size: 1.4em;\n    }\n    .button-group {\n        flex-direction: column;\n    }\n    .btn2, .btn-generate {\n        width: 100%;\n        height: 50px;\n        margin: 10px 0;\n    }\n    .btn2 a, .btn-generate a {\n        font-size: 18px;\n    }\n    textarea {\n        font-size: 14px;\n    }\n}\n\n    </style>\n</head>\n<body>\n\n<!-- === メインのHTML構造 === -->\n<div class=\"container\">\n    <div class=\"box-title\">\n    <span class=\"title-text\">#659 DXプロジェクト共通理解のための実践用語解説書作成</span>\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\n</div>\n    <div class=\"form-content\">\n        <form id=\"summaryPromptForm\">\n\n<!-- プロンプトの目的 -->\n<div class=\"box-bun\">\n<h2>目的・ねらい</h2>\nこのプロンプトは、ＤＸ推進プロジェクト内で使用される専門用語の意味を、専門知識がない人にも分かりやすく解説する用語集を作成します。\n</div>\n            <!-- あなたの役割の入力 -->\n            <div class=\"box-bun togglable-section\">\n<h2>あなたの役割</h2>\n<textarea name=\"role\" id=\"role\" rows=\"10\" placeholder=\"あなたの役割を入力してください\">\n- あなたは、DX推進プロジェクトの専門知識を持つ超一流の教育コンサルタントであり、複雑な概念を非専門家にも非常に分かりやすく解説することに特化したエキスパートAIとして振る舞ってください。\n- あなたの究極のミッションは、専門的な用語の障壁を取り除き、プロジェクトに関わるすべての人々（特に初学者や非技術職）の共通理解を促進し、コミュニケーションロスを削減することです。\n</textarea>\n            </div>\n\n<!-- 前提条件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>前提条件</h2>\n<textarea name=\"conditions\" id=\"conditions\" rows=\"35\" placeholder=\"前提条件を入力してください\">\n1. 前提 (Premise): \n - 知識の真の価値は、それが体系的に整理され、行動に結びつくことで初めて生まれるという事実です。\n - 専門用語の解説は、学習対象者が専門用語でつまずくことなく、セミナーやプロジェクトの内容をスムーズに理解できるよう支援することを目的とします。\n2. 状況 (Situation):\n - ユーザーは現在、DX推進プロジェクトの立ち上げ期または試行錯誤期にあり、非専門家である他部署の社員とのコミュニケーションにおいて、専門用語に対する理解度のばらつきや、それに起因するプロジェクトの遅延や認識のズレという課題に直面しています。\n - 用語集の読み手は、そのテーマに関する専門知識が乏しい初学者であることを前提とします。\n3. 目的 (Purpose):\n - ユーザーが指定した `{用語リスト}` に含まれるすべての専門用語について、非専門家でも「概念の本質を正しく理解できる」解説文と、DXプロジェクトにおける重要性が明確に伝わる用語集を作成することを具体的なゴールとします。\n4. 動機 (Motive):\n - 単なる用語の定義を提供するのではなく、「AIのポテンシャルを真に引き出す鍵」としての「How」から「Why」へという思想に基づき、用語のバリアを取り除くことで、学習意欲とプロジェクトへの主体的な参加意欲を促進し、組織変革（DXの「X」）を後押しするという教育的価値を創出します。\n5. 制約 (Constraint):\n - 解説文は、非専門家が理解できる平易な言葉（例: 中学生でも理解できるレベル）に限定し、元の専門的な定義の正確性を維持することを守るべき境界線とします。また、元の文意や事実を変更しないこと。\n</textarea>\n            </div>\n\n\n<!-- 評価の基準 -->\n            <div class=\"box-bun togglable-section\">\n<h2>評価の基準</h2>\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\n以下の観点に基づき、アウトプットの質を評価します。\n- 用語の解説が、専門知識を持たない読み手にとって直感的かつ深く理解できる水準であるか。\n- すべての解説文に、平易な言葉での言い換え、比喩、または具体的な事例が含まれているか。\n- 用語の重要性（Why）が、DX推進プロジェクトの文脈と関連付けて論理的に説明されているか。\n- 提示された専門的な定義が、元の情報を正確に反映しているか。\n</textarea>\n            </div>\n\n\n<!-- 明確化の要件 -->\n            <div class=\"box-bun togglable-section\">\n<h2>明確化の要件</h2>\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"16\" placeholder=\"明確化の要件を入力してください\">\nAIが最高の成果物を作成できるように、以下の点を明確にしてください。\n1. 専門用語の平易化: 解説は、専門用語を直接使用せず（平易な言葉に言い換える）こと。\n2. 共感と具体性: 比喩、具体例、または日常生活との関連付けを必ず用いること。特に、DX推進プロジェクトにおける具体的な活用シーンや背景（トランスフォーメーションの側面）を説明すること。\n3. 読者の前提知識レベル: 読者は、DX推進における基礎知識がほとんどない「初学者」レベルであることを前提としてください。\n4. アウトプットの再現性: 各用語に対する回答は、指定された [#出力フォーマット] の構成要素を完全に満たすこと。\n</textarea>\n            </div>\n\n\n<!-- リソース -->\n            <div class=\"box-bun togglable-section\">\n<h2>リソース</h2>\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\nAIは以下の知識・リソースを参照し、分析・提案を行います。\n- ユーザーが提供する `{DX推進プロジェクトの概要}`と `{用語リスト}`。\n- DX推進、ITツール、ビジネスプロセス改革に関する専門知識と事例データベース。\n- 平易な言葉への変換、比喩、具体例の知識データベース。\n</textarea>\n            </div>\n\n\n            <!-- 実行指示 -->\n            <div class=\"box-bun togglable-section\">\n<h2>実行指示</h2>\n<textarea name=\"instructions\" id=\"instructions\" rows=\"27\" placeholder=\"実行指示を入力してください\">\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\n- 読者の理解を促進する用語解説書を生成してください。\n\n## STEP:\n1. 専門的な定義の記述: \n - ユーザーが指定した `{用語リスト}` の各用語について、学術的または専門家間で一般的に認められている正確な定義を簡潔に記述する。\n2. 平易な言葉への変換:\n - STEP1の定義を、比喩や身近な例（例: 日常生活、家事、スポーツなど）を用いて、非専門家（初学者）でも直感的に理解できる平易な言葉で解説する。\n3. プロジェクトでの重要性の説明:\n - その用語がDX推進プロジェクトにおいて「なぜ重要なのか」という文脈や背景を具体的に説明し、トランスフォーメーションの視点から、その用語がプロジェクトに与える具体的な貢献や影響を明確にする。\n4. 出力形式の厳守: \n - 全体の構成は、次の [#出力フォーマット] を厳守し、 `{用語リスト}` の各用語ごとに繰り返し生成する。\n</textarea>\n            </div>\n\n            <!-- ルール -->\n            <div class=\"box-bun togglable-section\">\n<h2>ルール</h2>\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"8\" placeholder=\"ルールを入力してください\">\n- 出力は、専門的でありながらもAI初心者にも分かりやすく、丁寧で平易な言葉遣いを心がけること。\n- 曖昧な表現や抽象的な概念の羅列を避けること。\n- 生成された内容を、再度論理的整合性の観点から検証し、不明瞭な点や誤り（ハルシネーション）を修正すること。\n</textarea>\n            </div>\n\n\n<!-- 出力設定 -->\n            <div class=\"box-bun togglable-section\">\n<h2>出力形式</h2>\n<textarea name=\"output\" id=\"output\" rows=\"20\" placeholder=\"出力形式を入力してください\">\n - 以下のMarkdown形式を厳守してください。。\n```markdown\n## DXプロジェクト共通理解のための用語解説集\n\n### 用語名：{用語リストの用語名}\n\n- 専門的な定義: [正確な専門用語の定義を簡潔に記述（100字以内を推奨）]\n- 平易な解説（比喩・例示）: [非専門家向けに、比喩や身近な例を用いた解説を記述（200字以内を推奨）]\n- プロジェクトにおける重要性: [その用語がDX推進においてなぜ重要なのか、またはどのように活用されるのかを具体的に説明（200字以内を推奨）]\n\n### 用語名：{次の用語名}\n\n...（以下、同様に続く）\n```\n</textarea>\n            </div>\n\n\n<!-- ユーザー入力 -->\n            <div class=\"box-bun\">\n<h2>ユーザー入力</h2>\n<h3>DX推進プロジェクトの概要</h3>\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"10\" placeholder=\"ここにDX推進プロジェクトの概要を入力してください。\" class=\"variable-textarea\" >\n</textarea>\n<h3>用語リスト</h3>\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"10\" placeholder=\"ここに解説を依頼したい専門用語を箇条書きでリストアップしてください（例: TOC, M365, Copilot）。\" class=\"variable-textarea\" >\n</textarea>\n            </div>\n\n\n\n            <!-- 補足 -->\n            <div class=\"box-bun togglable-section\">\n<h2>補足</h2>\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"20\" placeholder=\"を補足を入力してください\">\n- 反復のために一時的な新しいファイル、スクリプト、またはヘルパーファイルを作成した場合は、タスクの最後にそれらのファイルを削除してクリーンアップしてください。\n- 指示の復唱はしないでください。\n- 自己評価はしないでください。\n- 結論やまとめは書かないでください。\n- すべて日本語で出力してください\n\n### ネガティブ制約条件\n- 専門用語をそのまま使用した解説文のみの出力は厳禁です。\n- 抽象的で一般的な概念説明のみに終始し、具体的な事例や比喩を欠いた解説は禁止します。\n- 提供された情報にない事実や情報を捏造・追加しないこと。\n- 文章の意味を変更しないこと。\n</textarea>\n            </div>\n\n\n        </form>\n        <div class=\"button-group\">\n            <div class='btn2'>\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\n            </div>\n            <div class=\"btn-generate\">\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\n            </div>\n        </div>\n    </div>\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=659\"></script>\n</div>\n\n<!-- JavaScript -->\n<script>\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\n    e.preventDefault();\n    const form = document.getElementById('summaryPromptForm');\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\n    const formData = new FormData(form);\n\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\n    communicationContent += \"##DX推進プロジェクトの概要=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\n    communicationContent += \"##用語リスト=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\n\n    // クリップボードにコピー\n    navigator.clipboard.writeText(communicationContent).then(() => {\n        alert('プロンプトがコピーされました。');\n    }).catch(err => {\n        console.error('クリップボードへのコピーに失敗しました:', err);\n        alert('プロンプトのコピーに失敗しました。');\n    });\n});\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const toggleIcon = document.getElementById('toggleIcon');\n    const togglableSections = document.querySelectorAll('.togglable-section');\n\n    // Default: All blocks should be displayed\n    // Set initial state of toggleIcon to 'hide' (×) and its title\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\n        toggleIcon.title = ''; // Initially no tooltip when visible\n    }\n\n    if (toggleIcon && togglableSections.length > 0) {\n        toggleIcon.addEventListener('click', function() {\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\n            if (isHidden) { // If currently hidden, show them\n                togglableSections.forEach(section => {\n                    section.style.display = 'block';\n                });\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\n            } else { // If currently visible, hide them\n                togglableSections.forEach(section => {\n                    section.style.display = 'none';\n                });\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\n            }\n        });\n    }\n});\n</script>\n</body>\n</html>\n",
