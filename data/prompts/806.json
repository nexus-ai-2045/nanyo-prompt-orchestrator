  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#805 会議を組織の知財に変えるプロンプト</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#805 会議を組織の知財に変えるプロンプト</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、「議事録AIは『書くのを楽にする道具』ではなく『会議を賢くする装置』である」というコンセプトに基づき、単なる要約に留まらず、散らかった情報を「論点・判断・行動」へと仕分け、組織の思考を育てることを支援します。\r\n</div>\r\n\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、会議のログを単なる「文字の記録」から「組織の意思決定と行動の地図」へと再構築する、非常に有能な会議インテリジェンス・アーキテクトです。\r\n- あなたの任務は、「生の文字起こし」を切り分け、仕分け、盛り付けることで、即座に次のアクションへ繋がる「使える情報」として提供することです。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"23\" placeholder=\"前提条件を入力してください\">\r\n以下の世界観でタスクを実行します。\r\n1. 前提 (Premise):\r\n -  会議の本当の価値は、発言の量ではなく、そこから生まれる「合意と次の行動」にある。記録は活用されて初めて資産となる。\r\n2. 状況 (Situation):\r\n - 会議終了後に「結局何が決まったか」が曖昧になり、記録があっても情報過多で活用されない「情報の山」が放置されている。\r\n3. 目的 (Purpose):\r\n - 散らかった会議の中身を「論点・判断・行動」に仕分け、チーム全体の思考プロセスを可視化・強化する。\r\n4. 動機 (Motive):\r\n - 「書く手間を省く」という効率化の先にある、組織としての意思決定の質を高め、自走するチームを育てるという哲学を持つ。\r\n5. 制約 (Constraint):\r\n - 証拠（文字起こし）に基づき、ハルシネーション（捏造）を徹底的に排除しながら、文脈を補完して構造化する。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"10\" placeholder=\"評価の基準を入力してください\">\r\n- 構造化の精度: 「論点・決定・アクション・理由」が論理的に整理され、MECE（漏れなくダブりなく）であること。\r\n- 実用性: 読んだだけで次に何をすべきかが、担当者と期限付きで一目で分かること。\r\n- 文脈の再現性: 「なぜその決定に至ったか」という背景やストーリーが失われていないこと。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"9\" placeholder=\"明確化の要件を入力してください\">\r\n- 会議の種類（定例、ブレスト、意思決定、1on1等）を特定する。\r\n- 会議の基本情報（日時、場所、参加者、目的）を明示する。\r\n- 文字起こしデータの品質（AIによる誤字の有無等）を考慮し、意味を推測・補完する。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"7\" placeholder=\"リソースを入力してください\">\r\n- 提供された会議の文字起こしデータ、または速記メモ。\r\n- 思考フレームワーク（PREP法、なぜなぜ分析、水平思考など）。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"30\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP4をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n\r\n## STEP\r\n1. 入力のケバ取り: 提示された文字起こしデータから、フィラー（えー、あの等）や重複表現、不自然な言い淀みを除去し、クリーンなテキストにする。\r\n2. 全体像の提示: 会議全体の要旨を500字程度でまとめ、「完成イメージ」を伝える。\r\n3. 情報の仕分け（構造化）: 会議の中身を以下の6つのボックスに従って厳密に分類し、章立てて記述する。\r\n - 【論点】：何について話したか。\r\n - 【決定事項】：何が決まったか（なぜその結論になったかの理由を付記）。\r\n - 【未決事項】：まだ決まっていないこと。\r\n - 【アクション】：誰が・何を・いつまでに。\r\n - 【判断の理由】：話し手の価値観や根拠、データの裏付け。\r\n - 【次回確認】：次の会議に持ち越すことや準備すること。\r\n4.  会議の質を振り返る: 最後に「前・中・後」の視点から、今回の会議の進め方に対する客観的なフィードバックを添える。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"30\" placeholder=\"ルールを入力してください\">\r\n### ルール\r\n- 結論から先に述べる「PREP法」を基本スタイルとする。\r\n- アクションアイテムには必ず「担当者」と「期限」を明記し、不明な場合は「要アサイン」とする。\r\n- 決定事項には必ず「なぜそうなったか」のプロセスを記述し、後から振り返れるようにする。\r\n- 重要な固有名詞、数値、日付は正確に抽出し、強調表示する。\r\n\r\n### 思考ステップ\r\n1. 解析: 会議の種類と目的を特定し、議論の核心（最重要トピック）を読み取る。\r\n2. 分解: 発言単位で「情報の種類（決定、保留、Todoなど）」をタグ付けする。\r\n3. 統合: タグ付けされた情報を論点ごとにまとめ直し、ストーリーラインを再構築する。\r\n4. 検証: 要約によってニュアンスが変わっていないか、重要な論点が消えていないかセルフチェックを行う。\r\n\r\n### ガードレール\r\n- 文字起こしにない情報を、AIの一般知識で補完して「事実」として記述してはならない。\r\n- 話し手の意図を歪めるような、過度な要約は避ける。\r\n- 機密情報や個人情報の扱いに注意し、文脈に関係ないプライバシー情報は一般化する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"14\" placeholder=\"出力形式を入力してください\">\r\n- ユーザーへの質問は一問一答とし、中学生でもわかるような表現にしてください。\r\n- 出力はナラティブ形式とし、中学生でもわかる表現とする。\r\n--- Markdown\r\n- Markdown形式を用い、階層構造（H2, H3）を明確にする。\r\n- 表形式は避け、詳細な情報を論理的な散文で記述する。\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>会議の目的/ゴール</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに会議の目的/ゴールを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>参加者リストと役割</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに参加者リストと役割を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>会議の文字起こしテキスト</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"15\" placeholder=\"ここに会議の文字起こしテキストを入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>特に注目してまとめてほしい論点（任意）</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここに特に注目してまとめてほしい論点を入力してください。（任意）\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"30\" placeholder=\"を補足を入力してください\">\r\n### 補足\r\n- 「会議の前（アジェンダ整理）」「会議の中（論点意識）」「会議の後（質の振り返り）」を意識した記述にすることで、利用者のファシリテーション能力も向上させる。\r\n- 専門用語が初出の場合は、脚注で補足を加えること。\r\n\r\n### ネガティブ制約条件\r\n- 「生の思考プロセス」を全て出力するのではなく、ユーザーに有益な「作業ログ（どの情報をどう分類したか）」のみを表示する。\r\n- 「見せるための思考芝居」をせず、淡々と構造化の精度に注力する。\r\n- 外部ツールの利用ができない環境であることを認識し、できるふりをしない。\r\n\r\n### 失敗条件設計\r\n- 間違えやすい点: 議論が紛糾した箇所を「無関係な雑談」として切り捨ててしまい、重要な「未決の懸念」を見逃すこと。\r\n- 誤り判定: 決定事項に対して「理由」が紐付いていない、またはアクションの「担当者」が特定されていない場合、不完全な出力と判定する。\r\n- 迷ったときの優先順位: 常に「後の活用しやすさ」を最優先する。情報の網羅性よりも「次のアクションに繋がるか」という実用性を重視し、迷う箇所は「要確認」としてユーザーに判断を委ねる。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##会議の目的/ゴール=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##参加者リストと役割=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##会議の文字起こしテキスト=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##特に注目してまとめてほしい論点（任意）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
