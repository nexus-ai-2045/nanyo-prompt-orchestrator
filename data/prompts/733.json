  "raw_html": "<!DOCTYPE html>\r\n<html lang=\"ja\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"robots\" content=\"noindex\" />\r\n    <title>#733 KPI達成に向けたロジック構築とモニタリング支援</title>\r\n    <style>\r\n        /* === スタイル設定 === */\r\n        \r\n        /* 基本ページ設定 */\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 20px;\r\n            box-sizing: border-box;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            background-color: #FFF;\r\n        }\r\n        /* メインコンテナのスタイル */\r\n        .container {\r\n            width: 100%;\r\n            max-width: 800px;\r\n            background: #ffffff;\r\n            border-radius: 8px;\r\n            box-shadow: 3px 5px 15px -5px #777777;\r\n            overflow: hidden;\r\n        }\r\n        /* 各種見出し・ボタンのスタイル設定 */\r\n        h2 {\r\n            color: #797979;\r\n            font-size: 1.6em;\r\n        }\r\n        .box-title {\r\n            font-size: 1.7em;\r\n            letter-spacing: 0.1em;\r\n            padding: 1em 20px; /* Combined padding */\r\n            background-color: #5fc2f5;\r\n            color: #fff;\r\n            font-weight: 600;\r\n            display: flex; /* Make it a flex container */\r\n            align-items: center; /* Vertically center items */\r\n            justify-content: space-between; /* Push items to ends */\r\n        }\r\n        .box-title .title-text {\r\n            flex-grow: 1; /* Allow title to take available space */\r\n            text-align: center; /* Keep title centered */\r\n            white-space: nowrap; /* Prevent wrapping */\r\n            overflow: hidden; /* Hide overflow content */\r\n            text-overflow: ellipsis; /* Show ellipsis for truncated text */\r\n        }\r\n        #toggleIcon {\r\n            font-size: 24px; /* Increased size */\r\n        }\r\n        .form-content {\r\n            padding: 40px 120px;\r\n            background: #f1f1f1;\r\n        }\r\n        .box-bun {\r\n            background: #FFF;\r\n            border: 1px solid #D5D9DC;\r\n            border-radius: 20px;\r\n            padding: 15px;\r\n            margin-bottom: 40px;\r\n        }\r\n        .togglable-section {\r\n                /* display: none; Removed */\r\n            }\r\n        label {\r\n            display: inline-block;\r\n            margin-left: 5px;\r\n            color: #656565;\r\n        }\r\n        input[type=\"text\"], select, textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            margin-top: 5px;\r\n            box-sizing: border-box;\r\n            border: 0.5px solid #AEAEAE;\r\n            border-radius: 5px;\r\n            font-size: 16px;\r\n        }\r\n        textarea {\r\n            resize: vertical;\r\n        }\r\n        .button-group {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n        .btn2 {\r\n            width: 150px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n\r\n        .btn-generate {\r\n            width: 180px;\r\n            height: 60px;\r\n            margin: 0 10px;\r\n        }\r\n        .btn2 a, .btn-generate a {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            width: 100%;\r\n            height: 100%;\r\n            text-decoration: none;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            border-radius: 35px;\r\n            transition: all 0.5s ease;\r\n        }\r\n        .btn2 a {\r\n            background: #FFFFFF;\r\n            color: #5FC2F5;\r\n            border: 2px solid #5FC2F5;\r\n        }\r\n        .btn2 a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .btn-generate a {\r\n            background: #5FC2F5;\r\n            color: #FFFFFF;\r\n        }\r\n        .btn-generate a:hover {\r\n            transform: scale(1.1, 1.1);\r\n        }\r\n        .small-text {\r\n            font-size: 0.5em;\r\n            color: #656565;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n/* === 入力エリアの色設定 === */\r\n.variable-textarea {\r\n    background-color: #ffe4e1; /* 薄いピンク */\r\n}\r\n\r\n\r\n        /* === スマホ用設定 === */\r\n@media only screen and (max-width: 768px) {\r\n    .prompt-text {\r\n        display: none;\r\n    }\r\n    .container {\r\n        width: 100%;\r\n        padding: 10px;\r\n        box-shadow: none;\r\n    }\r\n    .form-content {\r\n        padding: 20px 10px;\r\n    }\r\n    .box-bun {\r\n        padding: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n    h2 {\r\n        font-size: 1.4em;\r\n    }\r\n    .button-group {\r\n        flex-direction: column;\r\n    }\r\n    .btn2, .btn-generate {\r\n        width: 100%;\r\n        height: 50px;\r\n        margin: 10px 0;\r\n    }\r\n    .btn2 a, .btn-generate a {\r\n        font-size: 18px;\r\n    }\r\n    textarea {\r\n        font-size: 14px;\r\n    }\r\n}\r\n\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- === メインのHTML構造 === -->\r\n<div class=\"container\">\r\n    <div class=\"box-title\">\r\n    <span class=\"title-text\">#733 KPI達成に向けたロジック構築とモニタリング支援</span>\r\n    <span id=\"toggleIcon\" style=\"cursor:pointer;\">☰</span>\r\n</div>\r\n    <div class=\"form-content\">\r\n        <form id=\"summaryPromptForm\">\r\n\r\n<!-- プロンプトの目的 -->\r\n<div class=\"box-bun\">\r\n<h2>目的・ねらい</h2>\r\nこのプロンプトは、ユーザーが提供する抽象的な事業目的を「活動・行動・成果」の3段階に分解し、それぞれにKPIを設定することで、実効性の高いモニタリング体制を構築することを支援します。\r\n</div>\r\n            <!-- あなたの役割の入力 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>あなたの役割</h2>\r\n<textarea name=\"role\" id=\"role\" rows=\"9\" placeholder=\"あなたの役割を入力してください\">\r\n- あなたは、行政施策や事業経営におけるロジックモデル構築と、数値管理（KPIマネジメント）の専門家です。\r\n- 事業の目的を「活動・行動・成果」の3階層に分解し、それぞれの因果関係を科学的に証明・数値化することで、確実な目標達成を支援する戦略パートナーとして振る舞ってください。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 前提条件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>前提条件</h2>\r\n<textarea name=\"conditions\" id=\"conditions\" rows=\"28\" placeholder=\"前提条件を入力してください\">\r\n1. 前提 (Premise): \r\n - 事業の成功は、単なる活動の積み上げではなく、活動（アウトプット）が住民や顧客の行動変容（中間アウトカム）を引き起こし、それが最終的な価値（最終アウトカム）に繋がるという論理的な因果関係によってのみ担保されるという信念を思考のOSとします。\r\n2. 状況 (Situation):\r\n - ユーザーは事業目的を掲げているが、日々の活動がどのように最終的な成果に結びついているかのロジックが不明瞭であり、モニタリングすべき適切な指標が設定できていない状況にあります。\r\n3. 目的 (Purpose):\r\n - 抽象的な事業目的を「活動・行動・成果」の3段階に分解し、それぞれにSMART原則（具体的、測定可能、達成可能、関連性、期限付き）に基づいたKPIを設定することで、実効性の高いモニタリング体制を構築することを目指します。\r\n4. 視点 (Perspective):\r\n - 「How（どう動くか）」の前に「Why（なぜ、何のために）」を再定義し、既存の成功パターンに固執しない「探索モード」で真の課題解決に資する指標を特定する哲学を採用します。\r\n5. 制約 (Constraint):\r\n - アンケートやヒアリングなどのバイアスがかかる擬似的な数値化ではなく、行動ログや統計データを用いた科学的・客観的な数値化アプローチを最優先とします。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 評価の基準 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>評価の基準</h2>\r\n<textarea name=\"hyoka\" id=\"hyoka\" rows=\"12\" placeholder=\"評価の基準を入力してください\">\r\n- 提示されたロジックモデルにおいて、③アウトプットから①最終アウトカムに至るまでの因果関係に論理的な飛躍がないか。\r\n- 設定された各KPIがSMART原則を完全に満たしており、現場で計測可能かつ客観的なものであるか。\r\n- 提案内容が「現在の困りごと」の解決に留まらず、ユーザーが目指す「理想の姿（To-Be）」に基づいた逆算的な設計になっているか。\r\n- 専門用語が平易な言葉に変換されており、現場職員が一読してモニタリングの重要性を理解できるか。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- 明確化の要件 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>明確化の要件</h2>\r\n<textarea name=\"meikaku\" id=\"meikaku\" rows=\"13\" placeholder=\"明確化の要件を入力してください\">\r\nAIが最高のパフォーマンスを発揮できるよう、以下の情報をユーザーから引き出し、不足があれば補完してください。\r\n- 検討対象となる「事業名」とその「全体目的」を明確にする。\r\n- 事業の対象者（ターゲット）の詳細な属性と、現在抱えている具体的な課題（Pain）を特定する。\r\n- 理想の状態（To-Be）として、どのような社会的変化や顧客の変化を期待しているかを定義する。\r\n- 利用可能なデータソース（何を持って計測可能とするか）の確認を行う。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- リソース -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>リソース</h2>\r\n<textarea name=\"resource\" id=\"resource\" rows=\"10\" placeholder=\"リソースを入力してください\">\r\n- 思考フレームワーク：論点思考（イシュー特定）、なぜなぜ分析、SMART原則。\r\n- 構成モデル：ロジックモデル（アウトプット、中間アウトカム、最終アウトカム）。\r\n- 科学的数値化手法：物理学的・統計学的手法を用いた説明変数の抽出。\r\n- ナレッジ：自治体DX、組織変革（Xスキル）、EBPMの原則。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n            <!-- 実行指示 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>実行指示</h2>\r\n<textarea name=\"instructions\" id=\"instructions\" rows=\"36\" placeholder=\"実行指示を入力してください\">\r\n上記の「前提条件」「明確化の要件」を踏まえ、以下「ルール」に従いSTEP1～STEP5をステップバイステップで実行し、「評価の基準」を満たした成果物を作成してください。\r\n- ユーザーから入力された「事業の全体像」を基に、以下のステップバイステップの手順で思考を深め、ロジックを再構築してください。\r\n- 以下の2つのフェーズを順番に、一つずつ実行してください。\r\n- 各STEPの終了時には必ず「次のステップに進みますか？」とユーザーに問いかけ、承認または追加の指示を得てから次へ進んでください。\r\n\r\n## STEP\r\nフェーズ1：逆算型ロジックの積み上げ設計\r\n1. まず、日々の業務で発生する具体的な「③活動レベル（アウトプット）」を洗い出し、その実施量や品質を測るKPIを設定してください。\r\n2. 次に、それらの活動によって対象者にどのような具体的な変化や「②行動レベルの成果（中間アウトカム）」が生じるべきかを推論し、行動変容を測るKPIを設定してください。\r\n3. 最後に、それらの行動変容が最終的にどのような社会的価値や「①最終的な成果（アウトカム）」に結びつくかを言語化し、事業の成功を象徴するKGIを特定してください。\r\n\r\nフェーズ2：一貫性の検証と出力\r\n4. 構築したロジックを再度「最終成果から活動」へと逆流させて検証し、矛盾や飛躍がないか自己批判を行ってください。\r\n5. 検証済みのロジックと各指標を、指定された出力様式に従って構造化し、ユーザーに提示してください。\r\n</textarea>\r\n            </div>\r\n\r\n            <!-- ルール -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>ルール</h2>\r\n<textarea name=\"clarification_rules\" id=\"clarification_rules\" rows=\"25\" placeholder=\"ルールを入力してください\">\r\n- 思考LLMのポテンシャルを真に引き出すため、推論過程において不確実な点は「不明」「要確認」と正直に明示し、推測で埋めないでください。\r\n- 文章のリズムを重視し、連続する文で同じ語尾を繰り返す書き方を避けてください。\r\n- 専門用語を使用する場合は、中学生でも理解できるよう簡潔な解説を括弧書きで加えてください。\r\n- 提案されるKPIは、誰が・いつ・どのように測定するのかが実務レベルでイメージできる内容にしてください。\r\n\r\n### 思考ステップ\r\n1. [Draft] 事業の全体像を4W1H（誰が、いつ、どこで、何を、どのように）で分解し、分析ゴールを設定する。\r\n2. [Expand] 活動から成果に至るパスにおいて、見落とされている盲点や潜在的なリスクを水平思考で洗い出す。\r\n3. [Narrow] 洗い出した要素から、KGI達成に最も寄与度の高い変数（KPI）を絞り込み、相関関係を特定する。\r\n4. [Finalize] 構造化されたロジックとアクションプランとして最終成果物を整形する。\r\n</textarea>\r\n            </div>\r\n\r\n<!-- 出力設定 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>出力形式</h2>\r\n<textarea name=\"output\" id=\"output\" rows=\"28\" placeholder=\"出力形式を入力してください\">\r\n以下の構成に基づき、散文形式で出力してください。\r\n--- Markdown\r\n#### 1. 事業ロジックの全体設計図\r\n[事業名と全体目的を1文で要約]\r\n\r\n#### 2. 活動レベル（アウトプット）の定義と指標\r\n- 活動内容の具体：\r\n- KPI（活動の量・質）：\r\n- なぜこの活動が必要か（ロジックの根拠）：\r\n\r\n#### 3. 行動レベルの成果（中間アウトカム）の定義と指標\r\n- 期待される行動変容：\r\n- KPI（対象者の変化）：\r\n- アウトプットからの因果関係解説：\r\n\r\n#### 4. 最終的な成果（最終アウトカム）の定義と指標\r\n- 達成したい最終的価値：\r\n- KGI（最上位指標）：\r\n- 全体のロジックに対する総括：\r\n\r\n#### 5. モニタリング運用のためのアドバイス\r\n[KPIを継続的に収集し、PDCAを回すための具体的な実行ヒント]\r\n---\r\n</textarea>\r\n            </div>\r\n\r\n\r\n<!-- ユーザー入力 -->\r\n            <div class=\"box-bun\">\r\n<h2>ユーザー入力</h2>\r\n<h3>事業名</h3>\r\n<textarea name=\"hensu1\" id=\"hensu1\" rows=\"5\" placeholder=\"ここに事業名を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>事業の最終目的</h3>\r\n<textarea name=\"hensu2\" id=\"hensu2\" rows=\"5\" placeholder=\"ここに事業の最終目的を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>現在の主な活動</h3>\r\n<textarea name=\"hensu3\" id=\"hensu3\" rows=\"10\" placeholder=\"ここに現在の主な活動を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n<h3>ターゲット（住民・顧客）</h3>\r\n<textarea name=\"hensu4\" id=\"hensu4\" rows=\"5\" placeholder=\"ここにターゲット（住民・顧客）を入力してください。\" class=\"variable-textarea\" >\r\n</textarea>\r\n            </div>\r\n\r\n\r\n\r\n            <!-- 補足 -->\r\n            <div class=\"box-bun togglable-section\">\r\n<h2>補足</h2>\r\n<textarea name=\"hosoku\" id=\"hosoku\" rows=\"18\" placeholder=\"を補足を入力してください\">\r\n- ユーザーの入力が不足している場合は、最適なKPIを提案するための「逆質問」を優先してください。\r\n- 指示の復唱はしないでください。\r\n- 自己評価はしないでください。\r\n- 結論やまとめは書かないでください。\r\n- すべて日本語で出力してください\r\n\r\n### ネガティブ制約条件\r\n- 表形式での出力は、いかなる場合も禁止します。\r\n- 「頑張る」「意識を高める」といった精神論や、数値化不可能な抽象的な言葉を指標として設定しないでください。\r\n- 元の事業目的にない架空の成果を捏造しないでください。\r\n- 冗長な前置きや「承知いたしました」といった挨拶文は一切不要です。\r\n</textarea>\r\n            </div>\r\n\r\n\r\n        </form>\r\n        <div class=\"button-group\">\r\n            <div class='btn2'>\r\n                <a href=\"http://www.city.nanyo.yamagata.jp/dxchosei/5793\">戻る</a>\r\n            </div>\r\n            <div class=\"btn-generate\">\r\n                <a href=\"#\" id=\"generateButton\">プロンプト作成</a>\r\n                <div class=\"small-text\">クリップボードにコピーされます。</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n<script type=\"text/javascript\" src=\"/download_prompt/download.php?dsp_count=730\"></script>\r\n</div>\r\n\r\n<!-- JavaScript -->\r\n<script>\r\ndocument.getElementById('generateButton').addEventListener('click', function(e) {\r\n    e.preventDefault();\r\n    const form = document.getElementById('summaryPromptForm');\r\n    let communicationContent = \"以下はあなたへの指示の内容です。\\n\\n\";\r\n    const formData = new FormData(form);\r\n\r\n    communicationContent += \"<あなたの役割>\\n\" + (formData.get('role') || '特に指示無し\\n') + \"</あなたの役割>\\n\\n\";\r\n    communicationContent += \"<前提条件>\\n\" + (formData.get('conditions') || '特に指示無し\\n') + \"</前提条件>\\n\\n\";\r\n    communicationContent += \"<評価の基準>\\n\" + (formData.get('hyoka') || '特に指示無し\\n') + \"</評価の基準>\\n\\n\";\r\n    communicationContent += \"<明確化の要件>\\n\" + (formData.get('meikaku') || '特に指示無し\\n') + \"</明確化の要件>\\n\\n\";\r\n    communicationContent += \"<リソース>\\n\" + (formData.get('resource') || '特に指示無し\\n') + \"</リソース>\\n\\n\";\r\n    communicationContent += \"<実行指示>\\n\" + (formData.get('instructions') || '特に指示無し\\n') + \"</実行指示>\\n\\n\";\r\n    communicationContent += \"<ルール>\\n\" + (formData.get('clarification_rules') || '特に指示無し\\n') + \"</ルール>\\n\\n\";\r\n    communicationContent += \"<出力形式>\\n\" + (formData.get('output') || '特に指示無し\\n') + \"</出力形式>\\n\\n\";\r\n    communicationContent += \"<ユーザー入力>\" + (formData.get('hensu') || '') + \"\\n\";\r\n    communicationContent += \"##事業名=\" + (formData.get('hensu1') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##事業の最終目的=\" + (formData.get('hensu2') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##現在の主な活動=\" + (formData.get('hensu3') || '特に指示無し') + \"\\n\";\r\n    communicationContent += \"##ターゲット（住民・顧客）=\" + (formData.get('hensu4') || '特に指示無し') + \"\\n</ユーザー入力>\\n\\n\";\r\n    communicationContent += \"<補足>\\n\" + (formData.get('hosoku') || '特に指示無し\\n') + \"</補足>\\n\";\r\n\r\n    // クリップボードにコピー\r\n    navigator.clipboard.writeText(communicationContent).then(() => {\r\n        alert('プロンプトがコピーされました。');\r\n    }).catch(err => {\r\n        console.error('クリップボードへのコピーに失敗しました:', err);\r\n        alert('プロンプトのコピーに失敗しました。');\r\n    });\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const toggleIcon = document.getElementById('toggleIcon');\r\n    const togglableSections = document.querySelectorAll('.togglable-section');\r\n\r\n    // Default: All blocks should be displayed\r\n    // Set initial state of toggleIcon to 'hide' (×) and its title\r\n    if (toggleIcon) { // Ensure toggleIcon exists before setting its properties\r\n        toggleIcon.innerHTML = '×'; // Initially show 'hide' icon\r\n        toggleIcon.title = ''; // Initially no tooltip when visible\r\n    }\r\n\r\n    if (toggleIcon && togglableSections.length > 0) {\r\n        toggleIcon.addEventListener('click', function() {\r\n            const isHidden = togglableSections[0].style.display === 'none'; // Check current display state\r\n            if (isHidden) { // If currently hidden, show them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'block';\r\n                });\r\n                toggleIcon.innerHTML = '×'; // Change icon to 'hide'\r\n                toggleIcon.title = 'プロンプト非表示'; // No tooltip when visible\r\n            } else { // If currently visible, hide them\r\n                togglableSections.forEach(section => {\r\n                    section.style.display = 'none';\r\n                });\r\n                toggleIcon.innerHTML = '☰'; // Change icon to 'show'\r\n                toggleIcon.title = 'プロンプト表示'; // Set title for 'show' state\r\n            }\r\n        });\r\n    }\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n",
